<amll:meta key="musicName" value="相爱很难"/>
<amll:meta key="artists" value="张学友"/>
<amll:meta key="artists" value="梅艳芳"/>
<amll:meta key="album" value="他在那里"/>
<amll:meta key="appleMusicId" value="1442703504"/></metadata></head><body dur="3:43.253" ttm:agent="v3"><div begin="18.335" end="46.047" itunes:songPart="Verse" ttm:agent="v1"><p begin="18.335" end="24.628" itunes:key="L1" ttm:agent="v1"><span begin="18.335" end="18.842">最</span><span begin="18.842" end="20.608">好</span><span begin="21.084" end="21.596">有生</span><span begin="21.596" end="23.734">一日都爱下</span><span begin="23.734" end="24.628">去</span></p><p begin="25.497" end="33.161" itunes:key="L2" ttm:agent="v1"><span begin="25.497" end="25.909">但</span><span begin="25.909" end="26.402">谁</span><span begin="26.402" end="27.208">人</span><span begin="27.290" end="27.774">能将</span><span begin="27.774" end="29.438">恋爱当做</span><span begin="29.438" end="30.346">终</span><span begin="30.346" end="31.049">生</span><span begin="31.049" end="31.422">兴</span><span begin="31.422" end="33.161">趣</span></p><p begin="32.506" end="38.943" itunes:key="L3" ttm:agent="v2"><span begin="32.506" end="33.125">生</span><span begin="33.125" end="34.022">活</span><span begin="35.317" end="35.764">其实</span><span begin="35.764" end="36.618">旨在</span><span begin="36.618" end="37.143">找</span><span begin="37.143" end="37.363">到</span><span begin="37.363" end="37.940">个</span><span begin="37.940" end="38.339">伴</span><span begin="38.339" end="38.943">侣</span></p><p begin="39.770" end="46.047" itunes:key="L4" ttm:agent="v2"><span begin="39.770" end="40.322">面对</span><span begin="40.322" end="40.723">现</span><span begin="40.723" end="41.279">实</span><span begin="41.631" end="42.090">热恋</span><span begin="42.090" end="42.485">很</span><span begin="42.485" end="42.789">快</span><span begin="42.789" end="43.198">变</span><span begin="43.275" end="43.833">长</span><span begin="43.833" end="44.367">流</span><span begin="44.561" end="45.132">细</span><span begin="45.132" end="46.047">水</span></p></div><div begin="46.976" end="1:07.547" itunes:songPart="PreChorus" ttm:agent="v1"><p begin="46.976" end="54.128" itunes:key="L5" ttm:agent="v1"><span begin="46.976" end="47.439">可惜</span><span begin="47.439" end="48.528">我</span><span begin="48.851" end="49.302">不智</span><span begin="49.302" end="49.635">或</span><span begin="49.635" end="49.989">侥</span><span begin="49.989" end="50.558">幸</span> <span begin="50.823" end="51.159">对</span><span begin="51.159" end="51.975">火花</span><span begin="51.975" end="53.021">天生敏</span><span begin="53.096" end="54.128">感</span></p><p begin="54.221" end="57.945" itunes:key="L6" ttm:agent="v2"><span begin="54.221" end="54.599">不</span><span begin="54.599" end="55.390">过</span><span begin="55.731" end="56.372">两只手</span><span begin="56.372" end="56.871">拉</span><span begin="56.871" end="57.065">得</span><span begin="57.065" end="57.476">太</span><span begin="57.476" end="57.945">紧</span></p><p begin="58.237" end="1:07.547" itunes:key="L7" ttm:agent="v3"><span begin="58.237" end="59.139">爱到过了</span><span begin="59.139" end="59.493">界</span><span begin="59.493" end="1:00.280">那对爱</span><span begin="1:00.280" end="1:00.745">人</span> <span begin="1:01.062" end="1:01.702">同时亦</span><span begin="1:01.702" end="1:02.331">最</span><span begin="1:02.331" end="1:02.669">易</span><span begin="1:02.669" end="1:03.373">变成</span><span begin="1:03.373" end="1:04.024">一</span><span begin="1:04.024" end="1:04.922">对</span><span begin="1:04.922" end="1:05.326">敌</span><span begin="1:05.326" end="1:07.547">人</span></p></div><div begin="1:08.436" end="1:37.530" itunes:songPart="Chorus"><p begin="1:08.436" end="1:15.694" itunes:key="L8" ttm:agent="v3"><span begin="1:08.436" end="1:08.945">也许</span><span begin="1:08.945" end="1:09.292">相</span><span begin="1:09.292" end="1:09.598">爱</span><span begin="1:09.598" end="1:09.925">很</span><span begin="1:09.925" end="1:10.798">难</span> <span begin="1:11.061" end="1:12.580">就难在其实双方</span><span begin="1:12.580" end="1:13.504">各有各</span><span begin="1:13.504" end="1:14.345">寄望</span><span begin="1:14.345" end="1:14.824">怎</span><sp