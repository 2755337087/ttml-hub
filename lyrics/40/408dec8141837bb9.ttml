<amll:meta key="album" value="Cherish the moment"/>
<amll:meta key="appleMusicId" value="6764019485"/></metadata></head><body dur="4:27.553" ttm:agent="v1000"><div begin="15.165" end="42.351" itunes:songPart="Verse" ttm:agent="v2"><p begin="15.165" end="23.090" itunes:key="L1" ttm:agent="v2"><span begin="15.165" end="16.201">是谁</span><span begin="16.297" end="17.084">将一</span><span begin="17.084" end="17.945">生</span><span begin="18.080" end="18.976">的时</span><span begin="18.976" end="20.044">光</span><span begin="20.208" end="20.685">给了</span><span begin="20.685" end="23.090">柴米油盐</span></p><p begin="23.726" end="28.403" itunes:key="L2" ttm:agent="v2"><span begin="23.726" end="25.405">平淡的岁月</span><span begin="25.764" end="26.376">因</span><span begin="26.376" end="27.411">她不平</span><span begin="27.411" end="28.403">凡</span></p><p begin="29.191" end="36.982" itunes:key="L3" ttm:agent="v3"><span begin="29.191" end="30.002">谁</span><span begin="30.142" end="32.664">一遍遍不厌其</span><span begin="32.664" end="33.591">烦</span><span begin="33.946" end="36.129">对你嘘寒问</span><span begin="36.129" end="36.982">暖</span></p><p begin="37.418" end="42.351" itunes:key="L4" ttm:agent="v3"><span begin="37.418" end="37.921">却招</span><span begin="37.921" end="39.110">来不解</span> <span begin="39.110" end="41.000">招来你对她的</span><span begin="41.000" end="42.351">烦</span></p></div><div begin="45.562" end="1:13.786" itunes:songPart="Chorus" ttm:agent="v1"><p begin="45.562" end="52.160" itunes:key="L5" ttm:agent="v1"><span begin="45.562" end="49.073">为何年轻总是不能</span><span begin="49.782" end="51.119">去理解</span><span begin="51.119" end="52.160">对方</span></p><p begin="52.919" end="59.082" itunes:key="L6" ttm:agent="v1"><span begin="52.919" end="55.647">把最亲的人生疏</span><span begin="55.647" end="56.290">到</span><span begin="56.687" end="57.810">路人的</span><span begin="57.810" end="59.082">模样</span></p><p begin="1:00.175" end="1:05.960" itunes:key="L7" ttm:agent="v1"><span begin="1:00.175" end="1:02.915">为何我们不能</span><span begin="1:03.546" end="1:05.960">多一些体谅</span></p><p begin="1:06.581" end="1:13.786" itunes:key="L8" ttm:agent="v1"><span begin="1:06.581" end="1:09.985">趁天空还拥有夕阳</span> <span begin="1:10.197" end="1:11.927">趁她还在</span><span begin="1:12.434" end="1:13.786">身旁</span></p></div><div begin="1:42.673" end="2:09.761" itunes:songPart="Verse" ttm:agent="v2"><p begin="1:42.673" end="1:50.844" itunes:key="L9" ttm:agent="v3"><span begin="1:42.673" end="1:43.709">是谁</span><span begin="1:43.832" end="1:44.592">将一</span><span begin="1:44.592" end="1:45.453">生</span><span begin="1:45.551" end="1:46.428">的时</span><span begin="1:46.428" end="1:47.552">光</span><span begin="1:47.716" end="1:48.193">给了</span><span begin="1:48.193" end="1:50.844">柴米油盐</span></p><p begin="1:51.169" end="1:56.019" itunes:key="L10" ttm:agent="v3"><span begin="1:51.169" end="1:52.880">平淡的岁月</span><span begin="1:53.251" end="1:53.819">因</span><span begin="1:53.819" end="1:54.737">她不平</span><span begin="1:54.737" end="1:56.019">凡</span></p><p begin="1:56.666" end="2:04.457" itunes:key="L11" ttm:agent="v2"><span begin="1:56.666" end="1:57.477">谁</span><span begin="1:57.617" end="2:00.139">一遍遍不厌其</span><span begin="2:00.139" end="2:01.066">烦</span><span begin="2:01.385" end="2:03.434">对你嘘寒问</span><span begin="2:03.434" end="2:04.457">暖</span></p><p begin="2:04.786" end="2:09.761" itunes:key="L12" ttm:agent="v2"><span begin="2:04.786" end="2:05.279">却招</span><span begin="2:05.279" end="2:06.468">来不解</span> <span begin="2:06.468" end="2:08.358">招来你对她的</span><span begin="2:08.358" end="2:09.761">烦</span></p></div><div begin="2:13.023" end="2:40.221" itunes:songPart="Chorus" ttm:agent="v1"><p begin="2:13.023" end="2:19.826" itunes:key="L13" ttm:agent="v1"><span begin="2:13.023" end="2:16.524">为何年轻总是不能</span><span begin="2:17.233" end="2:18.570">去理解</span><span begin="2:18.570" end="2:19.826">对方</span></p><p begin="2:20.319" end="2:26.512" itunes:key="L14" ttm:agent="v1"><span begin="2:20.319" end="2:23.047">把最亲的人生疏</span><span begin="2:23.047" end="2:23.690">到</span><span begin="2:24.122" end="2:25.210">路人的</span><span begin="2:25.210" end="2:26.512">模样</span></p><p begin="2:27.541" end="2:33.418" itunes:key="L15" ttm:agent="v1"><span begin="2:27.541" end="2:30.281">为何我们不能</span><span begin="2:30.912" end="2:33.418">多一些体谅</span></p><p begin="2:33.977" end="2:40.221" itunes:key="L16" ttm:agent="v1"><span begin="2:33.977" end="2:37.381">趁天空还拥有夕阳</span> <span begin="2:37.593" end="2:38.949">趁她还在</span><span begin="2:38.949" end="2:40.221">身旁</span></p></div><div begin="2:40.481" end="3:08.450" itunes:songPart="Chorus"><p begin="2:40.481" end="2:47.124" itunes:key="L17" ttm:agent="v1000"><span begin="2:40.481" end="2:42.851">别让爱你的人</span><span begin="2:42.851" end="2:43.985">受伤</span> <span begin="2:44.472" end="2:46.362">她要的很简</span><span begin="2:46.362" end="2:47.124">单</span></p><p begin="2:47.744" end="2:54.038" itunes:key="L18" ttm:agent="v1000"><span begin="2:47.744" end="2:50.191">只想你不忙回</span><span begin="2:50.191" end="2:51.014">家</span> <span begin="2:51.144" end="2:53.158">陪她吃顿晚</span><span begin="2:53.158" end="2:54.038">餐</span></p><p begin="2:54.613" end="3:00.942" itunes:key="L19" ttm:agent="v1000"><span begin="2:54.613" end="2:57.123">别嫌她絮叨没</span><span begin="2:57.123" end="2:57.821">完</span> <span begin="2:57.923" end="3:00.085">你好她才心</span><span begin="3:00.085" end="3:00.942">安</span></p><p begin="3:01.421" end="3:08.450" itunes:key="L20" ttm:agent="v1"><span begin="3:01.421" end="3:03.540">趁一切都还</span><span begin="3:03.540" end="3:04.629">不晚</span> <span begin="3:04.823" end="3:06.523">别让爱成</span><span begin="3:06.523" end="3:08.450">遗憾</span></p></div><div begin="3:09.654" end="3:36.748" itunes:songPart="Chorus"><p begin="3:09.654" end="3:16.252" itunes:key="L21" ttm:agent="v1"><span begin="3:09.654" end="3:12.969">为何年轻总是不能</span><span begin="3:13.874" end="3:15.211">去理解</span><span begin="3:15.211" end="3:16.252">对方</span></p><p begin="3:16.958" end="3:23.121" itunes:key="L22" ttm:agent="v1"><span begin="3:16.958" end="3:19.686">把最亲的人生疏</span><span begin="3:19.686" end="3:20.329">到</span><span begin="3:20.726" end="3:21.849">路人的</span><span begin="3:21.849" end="3:23.121">模样</span></p><p begin="3:24.143" end="3:29.928" itunes:key="L23" ttm:agent="v1000"><span begin="3:24.143" end="3:26.883">为何我们不能</span><span begin="3:27.514" end="3:29.928">多一些体谅</span></p><p begin="3:30.525" end="3:36.748" itunes:key="L24" ttm:agent="v1000"><span begin="3:30.525" end="3:33.929">趁天空还拥有夕阳</span> <span begin="3:34.141" end="3:35.526">趁她还在</span><span begin="3:35.526" end="3:36.748">身旁</span></p></div><div begin="3:37.048" end="4:06.895" itunes:songPart="Chorus"><p begin="3:37.048" end="3:43.691" itunes:key="L25" ttm:agent="v1000"><span begin="3:37.048" end="3:39.418">别让爱你的人</span><span begin="3:39.418" end="3:40.552">受伤</span> <span begin="3:41.039" end="3:42.929">她要的很简</span><span begin="3:42.929" end="3:43.691">单</span></p><p begin="3:44.274" end="3:50.568" itunes:key="L26" ttm:agent="v1000"><span begin="3:44.274" end="3:46.721">只想你不忙回</span><span begin="3:46.721" end="3:47.544">家</span> <span begin="3:47.674" end="3:49.688">陪她吃顿晚</span><span begin="3:49.688" end="3:50.568">餐</span></p><p begin="3:51.123" end="3:57.452" itunes:key="L27" ttm:agent="v1000"><span begin="3:51.123" end="3:53.633">别嫌她絮叨没</span><span begin="3:53.633" end="3:54.331">完</span> <span begin="3:54.433" end="3:56.595">你好她才心</span><span begin="3:56.595" end="3:57.452">安</span></p><p begin="3:58.011" end="4:06.895" itunes:key="L28" ttm:agent="v1"><span begin="3:58.011" end="4:00.161">趁一切都还</span><span begin="4:00.161" end="4:01.239">不晚</span> <span begin="4:01.627" end="4:04.287">别让爱成</span><span begin="4:05.773" end="4:06.895">遗憾</span></p></div></body></tt>