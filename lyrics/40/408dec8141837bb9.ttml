<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v1000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>潇彬</songwriter></songwriters></iTunesMetadata>
