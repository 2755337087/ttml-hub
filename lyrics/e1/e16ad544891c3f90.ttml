<amll:meta key="musicName" value="天空没有极限 (粤)"/>
<amll:meta key="artists" value="邓紫棋"/>
<amll:meta key="album" value="I AM GLORIA"/>
<amll:meta key="appleMusicId" value="1818539846"/></metadata></head><body dur="4:39.029"><div begin="15.540" end="29.782" itunes:songPart="Verse"><p begin="15.540" end="19.056" itunes:key="L1" ttm:agent="v1"><span begin="15.540" end="16.127">当你</span><span begin="16.127" end="17.041">不笑不喊</span> <span begin="17.041" end="17.868">不吃不喝</span><span begin="17.868" end="18.596">不应</span><span begin="18.596" end="19.056">对</span></p><p begin="19.091" end="22.691" itunes:key="L2" ttm:agent="v1"><span begin="19.091" end="19.715">当你</span><span begin="19.715" end="20.608">不说一句</span> <span begin="20.608" end="21.469">一切抑压</span><span begin="21.469" end="22.163">于心</span><span begin="22.163" end="22.691">里</span></p><p begin="22.691" end="27.455" itunes:key="L3" ttm:agent="v1"><span begin="22.691" end="23.242">当理</span><span begin="23.242" end="23.967">想消</span><span begin="23.967" end="24.516">退</span> <span begin="24.659" end="25.027">当你</span><span begin="25.027" end="25.665">思绪</span><span begin="25.665" end="26.683">荒草</span><span begin="26.683" end="27.128">遍</span><span begin="27.128" end="27.455">地</span></p><p begin="27.610" end="29.782" itunes:key="L4" ttm:agent="v1"><span begin="27.610" end="27.979">一</span><span begin="27.979" end="28.461">早</span><span begin="28.461" end="29.344">变废</span><span begin="29.344" end="29.782">墟</span></p></div><div begin="29.824" end="44.935" itunes:songPart="Verse"><p begin="29.824" end="33.282" itunes:key="L5" ttm:agent="v1"><span begin="29.824" end="30.452">当那</span><span begin="30.452" end="31.308">风雨早已</span><span begin="31.308" end="32.247">冲刷一切</span><span begin="32.247" end="32.491">的</span><span begin="32.491" end="32.895">兴</span><span begin="32.895" end="33.282">趣</span></p><p begin="33.462" end="36.881" itunes:key="L6" ttm:agent="v1"><span begin="33.462" end="33.819">当</span><span begin="33.819" end="34.910">最初满希冀</span><span begin="34.910" end="35.814">的你早已</span><span begin="35.814" end="36.019">经</span><span begin="36.