1">の</span><span begin="0:30.021" end="0:31.104">PLANET</span> <span begin="0:32.823" end="0:33.508">回</span><span begin="0:33.508" end="0:33.689">り</span><span begin="0:33.689" end="0:34.299">続</span><span begin="0:34.299" end="0:34.550">け</span><span begin="0:34.550" end="0:35.235">て</span></p><p begin="0:37.436" end="0:45.723" itunes:key="L4" ttm:agent="v1"><span begin="0:37.436" end="0:37.643">い</span><span begin="0:37.643" end="0:37.976">つ</span><span begin="0:37.976" end="0:38.226">も</span><span begin="0:38.226" end="0:38.845">君</span><span begin="0:38.845" end="0:39.034">の</span><span begin="0:39.034" end="0:39.405">そ</span><span begin="0:39.405" end="0:39.673">ば</span><span begin="0:39.673" end="0:40.185">で</span> <span begin="0:41.876" end="0:42.226">ほ</span><span begin="0:42.226" end="0:42.533">く</span><span begin="0:42.533" end="0:42.764">ろ</span><span begin="0:42.764" end="0:43.425">数</span><span begin="0:43.425" end="0:43.606">え</span><span begin="0:43.606" end="0:44.184">て</span><span begin="0:44.496" end="0:44.766">た</span><span begin="0:44.766" end="0:45.107">け</span><span begin="0:45.107" end="0:45.314">れ</span><span begin="0:45.314" end="0:45.723">ど</span></p><p begin="0:46.867" end="0:55.437" itunes:key="L5" ttm:agent="v1"><span begin="0:46.867" end="0:47.386">サ</span><span begin="0:47.386" end="0:47.623">ヨ</span><span begin="0:47.623" end="0:47.937">ナ</span><span begin="0:47.937" end="0:48.143">ラ</span><span begin="0:48.143" end="0:48.717">なん</span><span begin="0:48.717" end="0:49.254">て</span><span begin="0:49.254" end="0:49.928">な</span><span begin="0:49.928" end="0:50.527">い</span><span begin="0:50.527" end="0:51.217">よ</span> <span begin="0:51.545" end="0:52.166">今日</span><span begin="0:52.166" end="0:52.476">か</span><span begin="0:52.476" end="0:52.707">ら</span><span begin="0:52.707" end="0:53.027">軌</span><span begin="0:53.027" end="0:53.667">道</span><span begin="0:53.667" end="0:53.846">を</span><span begin="0:53.846" end="0:54.450">外</span