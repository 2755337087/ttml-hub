<amll:meta key="artists" value="张学友"/>
<amll:meta key="album" value="过敏世界"/>
<amll:meta key="appleMusicId" value="1443085238"/></metadata></head><body dur="4:02.120"><div begin="14.927" end="41.449" itunes:songPart="Verse"><p begin="14.927" end="20.694" itunes:key="L1" ttm:agent="v1"><span begin="14.927" end="15.467">近日</span><span begin="15.467" end="16.177">像</span><span begin="16.177" end="18.159">每样话题</span><span begin="18.159" end="19.451">总不适</span><span begin="19.451" end="19.862">合</span><span begin="19.862" end="20.694">你</span></p><p begin="22.196" end="28.077" itunes:key="L2" ttm:agent="v1"><span begin="22.196" end="22.692">近日</span><span begin="22.692" end="23.023">夜</span><span begin="23.023" end="23.749">深相</span><span begin="23.749" end="24.459">聚</span> <span begin="24.502" end="26.656">飘起一抹冷</span><span begin="26.656" end="26.987">漠</span><span begin="26.987" end="27.523">空</span><span begin="27.523" end="28.077">气</span></p><p begin="28.507" end="35.305" itunes:key="L3" ttm:agent="v1"><span begin="28.507" end="29.071">在这</span><span begin="29.071" end="29.794">天</span> <span begin="30.418" end="30.840">是</span><span begin="30.840" end="32.539">你事无大</span><span begin="32.539" end="33.449">小</span><span begin="33.449" end="33.959">多</span><span begin="33.959" end="34.202">么</span><span begin="34.202" end="34.807">生</span><span begin="34.807" end="35.305">气</span></p><p begin="36.504" end="41.449" itunes:key="L4" ttm:agent="v1"><span begin="36.504" end="37.522">谁人</span><span begin="37.522" end="37.841">亦</span><span begin="37.841" end="38.470">可</span><span begin="38.470" end="39.420">知你</span><span begin="39.420" end="39.814">将</span><span begin="39.814" end="40.479">别</span><span begin="40.479" end="41.449">离</span></p></div><div begin="43.760" end="1:10.999" itunes:songPart="Verse"><p begin="43.760" end="49.571" itunes:key="L5" ttm:agent="v1"><span begin="43.760" end="44.329">落寞</span><span begin="44.329" end="44.988">地</span><span begin="44.988" end="46.967">躺在睡床</span><span begin="46.967" end="47.945">试试</span><span begin="47.945" end="48.281">抱</span><span begin="48.281" end="48.928">紧</span><span begin="48.928" end="49.571">你</span></p><p begin="50.973" end="57.081" itunes:key="L6" ttm:agent="v1"><span begin="50.973" end="51.584">但是</span><span begin="51.584" end="51.972">目</span><span begin="51.972" end="52.274">光</span><span begin="52.274" end="52.739">躲</span><span begin="52.739" end="53.110">避</span><span begin="53.110" end="53.370">令</span><span begin="53.370" end="55.557">我可感到你</span><span begin="55.557" end="55.876">在</span><span begin="55.876" end="56.513">喘</span><span begin="56.513" end="57.081">气</span></p><p begin="57.294" end="1:04.117" itunes:key="L7" ttm:agent="v1"><span begin="57.294" end="57.847">没说</span><span begin="57.847" end="58.578">出</span> <span begin="59.415" end="59.720">亦</span><span begin="59.720" end="1:01.470">领会谁在</span><span begin="1:01.470" end="1:03.277">撩动</span><span begin="1:03.277" end="1:04.117">你</span></p><p begin="1:04.127" end="1:07.637" itunes:key="L8" ttm:agent="v1"><span begin="1:04.127" end="1:05.076">抛开苦痛</span><span begin="1:05.076" end="1:05.543">去</span><span begin="1:05.543" end="1:05.862">解</span><span begin="1:05.862" end="1:06.477">脱</span><span begin="1:06.477" end="1:06.776">自</span><span begin="1:06.776" end="1:07.637">己</span></p><p begin="1:07.788" end="1:10.999" itunes:key="L9" ttm:agent="v1"><span begin="1:07.788" end="1:08.754">让你那些</span><span begin="1:08.754" end="1:09.626">冷却热情</span><span begin="1:09.626" end="1:10.194">另有</span><span begin="1:10.194" end="1:10.519">生</span><span begin="1:10.519" end="1:10.999">机</span></p></div><div begin="1:11.109" end="1:25.508" itunes:songPart="Chorus"><p begin="1:11.109" end="1:14.632" itunes:key="L10" ttm:agent="v1"><span begin="1:11.109" end="1:12.299">离开我以后</span><span begin="1:12.299" end="1:12.577">我</span><span begin="1:12.577" end="1:12.998">会</span><span begin="1:12.998" end="1:13.275">习</span><span begin="1:13.275" end="1:13.704">惯</span><span begin="1:13.704" end="