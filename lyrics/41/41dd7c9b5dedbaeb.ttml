<amll:meta key="album" value="好人"/>
<amll:meta key="appleMusicId" value="1803347325"/></metadata></head><body dur="4:39.396"><div begin="34.257" end="1:04.156" itunes:songPart="Verse"><p begin="34.257" end="40.360" itunes:key="L1" ttm:agent="v1"><span begin="34.257" end="34.941">一开</span><span begin="34.941" end="35.719">始</span><span begin="35.719" end="36.490">我们</span><span begin="36.490" end="37.621">约定</span><span begin="37.621" end="38.981">写好剧</span><span begin="38.981" end="40.360">本</span></p><p begin="42.245" end="48.228" itunes:key="L2" ttm:agent="v1"><span begin="42.245" end="43.035">到结</span><span begin="43.035" end="43.786">尾</span><span begin="43.786" end="44.921">你转动</span><span begin="44.921" end="45.729">时</span><span begin="45.729" end="46.472">间的</span><span begin="46.472" end="47.000">齿</span><span begin="47.000" end="48.228">轮</span></p><p begin="50.259" end="56.090" itunes:key="L3" ttm:agent="v1"><span begin="50.259" end="51.068">迷茫</span><span begin="51.068" end="51.712">的</span><span begin="51.712" end="52.929">我还剩</span><span begin="52.929" end="53.718">下</span><span begin="53.718" end="54.991">多少戏</span><span begin="54.991" end="56.090">份</span></p><p begin="56.660" end="1:04.156" itunes:key="L4" ttm:agent="v1"><span begin="56.660" end="57.263">请不</span><span begin="57.263" end="57.948">要</span><span begin="57.948" end="58.995">说不要</span><span begin="58.995" end="1:00.157">问</span> <span begin="1:00.686" end="1:01.876">请不要</span><span begin="1:01.979" end="1:03.155">演太认</span><span begin="1:03.155" end="1:04.156">真</span></p></div><div begin="1:06.293" end="1:36.589" itunes:songPart="Verse"><p begin="1:06.293" end="1:12.100" itunes:key="L5" ttm:agent="v1"><span begin="1:06.293" end="1:07.016">你的</span><span begin="1:07.016" end="1:07.695">眼</span><span begin="1:07.695" end="1:08.916">神坚定</span><span begin="1:08.916" end="1:09.775">说</span><span begin="1:09.775" end="1:10.915">我陷太</span><span begin="1:10.915" end="1:12.100">深</span></p><p begin="1:14.242" end="1:20.227" itunes:key="L6" ttm:agent="v1"><span begin="1:14.242" end="1:15.053">感谢</span><span begin="1:15.053" end="1:15.695">我</span><span begin="1:15.695" end="1:17.001">曾参与</span><span begin="1:17.001" end="1:17.793">过</span><span begin="1:17.793" end="1:18.922">你的人</span><span begin="1:18.922" end="1:20.227">生</span></p><p begin="1:22.037" end="1:28.074" itunes:key="L7" ttm:agent="v1"><span begin="1:22.037" end="1:22.748">在这</span><span begin="1:22.748" end="1:22.999">个</span><span begin="1:22.999" end="1:23.691">城</span><span begin="1:23.691" end="1:25.063">市都是</span><span begin="1:25.063" end="1:25.784">无</span><span begin="1:25.784" end="1:26.948">奈的灵</span><span begin="1:26.948" end="1:28.074">魂</span></p><p begin="1:28.658" end="1:36.589" itunes:key="L8" ttm:agent="v1"><span begin="1:28.658" end="1:29.241">谁丢</span><span begin="1:29.241" end="1:29.961">下</span><span begin="1:29.961" end="1:30.902">我一个</span><span begin="1:30.902" end="1:31.859">人</span> <span begin="1:32.661" end="1:33.232">在痛</span><span begin="1:33.232" end="1:33.777">苦</span><span begin="1:33.777" end="1:35.078">里面翻</span><span begin="1:35.078" end="1:36.589">腾</span></p></div><div begin="1:37.034" end="2:11.955" itunes:songPart="Chorus"><p begin="1:37.034" end="1:44.657" itunes:key="L9" ttm:agent="v1"><span begin="1:37.034" end="1:37.987">你说我</span><span begin="1:37.987" end="1:38.761">是</span><span begin="1:38.761" end="1:39.501">个好</span><span begin="1:39.501" end="1:40.542">人</span> <span begin="1:40.917" end="1:42.012">请别入</span><span begin="1:42.012" end="1:42.763">戏</span><span begin="1:42.763" end="1:43.050">太</span><span begin="1:43.050" end="1:44.657">深</span></p><p begin="1:45.025" end="1:52.817" itunes:key="L10" ttm:agent="v1"><span begin="1:45.025" end="1:46.049">那为什</span><span begin="1:46.049" end="1:46.793">幺</span><span begin="1:46.793" end="1:48.036">你眼中</span><span begin="1:48.036" end="1:49.120">会有</span> <span begin="1:49.120" end="1:49.779">遗</span><span begin="1:49.779" end="1:50.037">憾</span><span begin="1:50.037" end="1:50.805">和</span><span begin="1:50.805" end="1:51.064">泪</span><span begin="1:51.064" end="1:52.817">痕</span></p><p begin="1:52.993" end="2:00.439" itunes:key="L11" ttm:agent="v1"><span begin="1:52.993" end="1:53.999">你说我</span><span begin="1:53.999" end="1:54.853">是</span><span begin="1:54.853" end="1:55.592">个好</span><span begin="1:55.592" end="1:56.683">人</span> <span begin="1:56.934" end="1:58.126">请把持</span><span begin="1:58.126" end="1:59.061">好温</span><span begin="1:59.061" end="2:00.439">度</span></p><p begin="2:00.651" end="2:04.646" itunes:key="L12" ttm:agent="v1"><span begin="2:00.651" end="2:01.800">说怕烧</span><span begin="2:01.800" end="2:03.129">断暧昧</span><span begin="2:03.129" end="2:03.441">的</span><span begin="2:03.441" end="2:04.646">线</span></p><p begin="2:05.044" end="2:11.955" itunes:key="L13" ttm:agent="v1"><span begin="2:05.044" end="2:05.326">我</span><span begin="2:05.326" end="2:06.871">懂了</span> <span begin="2:06.967" end="2:08.275">认真才</span><span begin="2:08.275" end="2:09.053">会</span><span begin="2:09.053" end="2:11.955">输</span></p></div><div begin="2:28.218" end="2:58.912" itunes:songPart="Verse"><p begin="2:28.218" end="2:34.145" itunes:key="L14" ttm:agent="v1"><span begin="2:28.218" end="2:29.012">怪自</span><span begin="2:29.012" end="2:29.759">己</span><span begin="2:29.759" end="2:31.025">没天分</span><span begin="2:31.025" end="2:31.716">留</span><span begin="2:31.716" end="2:32.806">住你的</span><span begin="2:32.806" end="2:34.145">人</span></p><p begin="2:36.279" end="2:42.447" itunes:key="L15" ttm:agent="v1"><span begin="2:36.279" end="2:36.999">祝我</span><span begin="2:36.999" end="2:37.739">幸</span><span begin="2:37.739" end="2:39.026">福还能</span><span begin="2:39.026" end="2:39.775">遇</span><span begin="2:39.775" end="2:40.977">见对的</span><span begin="2:40.977" end="2:42.447">人</span></p><p begin="2:43.991" end="2:50.308" itunes:key="L16" ttm:agent="v1"><span begin="2:43.991" end="2:45.005">在这个</span><span begin="2:45.005" end="2:45.732">城</span><span begin="2:45.732" end="2:47.041">市都是</span><span begin="2:47.041" end="2:47.759">孤</span><span begin="2:47.759" end="2:48.890">独的灵</span><span begin="2:48.890" end="2:50.308">魂</span></p><p begin="2:50.682" end="2:58.912" itunes:key="L17" ttm:agent="v1"><span begin="2:50.682" end="2:51.203">你丢</span><span begin="2:51.203" end="2:52.969">下我一个</span><span begin="2:52.969" end="2:54.123">人</span> <span begin="2:54.671" end="2:55.230">在痛</span><span begin="2:55.230" end="2:55.778">苦</span><span begin="2:55.778" end="2:57.094">里面翻</span><span begin="2:57.094" end="2:58.912">腾</span></p></div><div begin="2:59.036" end="3:34.663" itunes:songPart="Chorus"><p begin="2:59.036" end="3:06.659" itunes:key="L18" ttm:agent="v1"><span begin="2:59.036" end="2:59.989">你说我</span><span begin="2:59.989" end="3:00.763">是</span><span begin="3:00.763" end="3:01.503">个好</span><span begin="3:01.503" end="3:02.544">人</span> <span begin="3:02.919" end="3:04.014">请别入</span><span begin="3:04.014" end="3:04.765">戏</span><span begin="3:04.765" end="3:05.052">太</span><span begin="3:05.052" end="3:06.659">深</span></p><p begin="3:07.041" end="3:14.833" itunes:key="L19" ttm:agent="v1"><span begin="3:07.041" end="3:08.065">那为什</span><span begin="3:08.065" end="3:08.809">幺</span><span begin="3:08.809" end="3:10.052">你眼中</span><span begin="3:10.052" end="3:11.136">会有</span> <span begin="3:11.136" end="3:11.795">遗</span><span begin="3:11.795" end="3:12.053">憾</span><span begin="3:12.053" end="3:12.821">和</span><span begin="3:12.821" end="3:13.080">泪</span><span begin="3:13.080" end="3:14.833">痕</span></p><p begin="3:15.075" end="3:22.521" itunes:key="L20" ttm:agent="v1"><span begin="3:15.075" end="3:16.081">你说我</span><span begin="3:16.081" end="3:16.935">是</span><span begin="3:16.935" end="3:17.674">个好</span><span begin="3:17.674" end="3:18.765">人</span> <span begin="3:19.016" end="3:20.208">请把持</span><span begin="3:20.208" end="3:21.143">好温</span><