<amll:meta key="musicName" value="这麼近(那麼远)"/>
<amll:meta key="artists" value="张学友"/>
<amll:meta key="album" value="过敏世界"/>
<amll:meta key="appleMusicId" value="1443085367"/></metadata></head><body dur="6:15.699"><div begin="7.732" end="34.788" itunes:songPart="Verse"><p begin="7.732" end="11.278" itunes:key="L1" ttm:agent="v1"><span begin="7.732" end="8.494">一天一天</span> <span begin="8.494" end="9.243">日日夜夜</span> <span begin="9.243" end="9.827">面</span><span begin="9.827" end="10.326">对</span><span begin="10.326" end="11.278">面</span></p><p begin="12.859" end="18.111" itunes:key="L2" ttm:agent="v1"><span begin="12.859" end="13.726">既相</span><span begin="13.726" end="15.093">处</span> <span begin="16.158" end="17.107">也同</span><span begin="17.107" end="18.111">眠</span></p><p begin="23.734" end="27.662" itunes:key="L3" ttm:agent="v1"><span begin="23.734" end="24.579">一点一点</span> <span begin="24.579" end="25.494">逐渐逐渐</span> <span begin="25.494" end="25.929">便</span><span begin="25.929" end="26.395">发</span><span begin="26.395" end="27.662">现</span></p><p begin="28.847" end="34.788" itunes:key="L4" ttm:agent="v1"><span begin="28.847" end="29.798">纵相</span><span begin="29.798" end="31.084">对</span> <span begin="32.162" end="33.104">却无</span><span begin="33.104" end="34.788">言</span></p></div><div begin="39.949" end="1:08.481" itunes:songPart="PreChorus"><p begin="39.949" end="44.989" itunes:key="L5" ttm:agent="v1"><span begin="39.949" end="40.306">静静</span><span begin="40.306" end="40.656">默默</span><span begin="40.656" end="41.090">望</span><span begin="41.090" end="41.306">着</span><span begin="41.306" end="41.757">熟</span><span begin="41.757" end="42.338">悉</span><span begin="42.338" end="43.221">的</span><span begin="43.589" end="44.317">背</span><span begin="44.317" end="44.989">面</span></p><p begin="46.639" end="51.424" itunes:key="L6" ttm:agent="v1"><span begin="46.639" end="47.370">一弯身影</span> <span begin="47.370" end="47.804">原</span><span begin="47.804" end="48.087">来</span><span begin="48.087" end="48.554">离</span><span begin="48.554" end="49.071">我</span><span begin="49.071" end="49.6