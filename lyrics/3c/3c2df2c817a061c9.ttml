<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Charlie Puth</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">Selena Gomez</ttm:name></ttm:agent><ttm:agent type="group" xml:id="v3"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Charlie Puth</songwriter><songwriter>J. Kasher</songwriter><songwriter>Selena Gomez</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我们不再交流</text><text for="L2">我们不再交流</text><text for="L3">我们不再交流</text><text for="L4">不再像过去那样</text><text for="L5">我们不再相爱</text><text for="L6">这一切究竟是为了什么</text><text for="L7">噢 我们不再交流</text><text for="L8">不再像过去那样</text><text for="L9">听说你已经遇到了</text><text for="L10">你心仪的那个人</text><text for="L11">真希望我能早点发觉 那个人并不是我</text><text for="L12">因为就算过了这么久 我依然在想</text><text for="L13">为什么我无法像你一样</text><text for="L14">如此潇洒地放下过去</text><text for="L15">不想知道</text><text for="L16">你今晚会穿什么样的衣裙</text><text for="L17">他会不会紧紧拥你入怀</text><text for="L18">就像我从前那样</text><text for="L19">我太过沉迷</text><text for="L20">早该明白你的爱不过是一场游戏</text><text for="L21">如今你在我脑海中挥之不去</text><text for="L22">噢 太遗憾了</text><text for="L23">我们不再交流</text><text for="L24">我们不再交流</text><text for="L25">我们不再交流</text><text for="L26">不再像过去那样</text><text for="L27">我们不再相爱</text><text for="L28">这一切究竟是为了什么</text><text for="L29">噢 我们不再交流</text><text for="L30">不再像过去那样</text><text for="L31">我只希望你的枕边人</text><text for="L32">懂得如何像我一样爱你</text><text for="L33">你离开我一定是有理由的</text><text for="L34">我时不时会觉得 你可能希望我</text><text for="L35">突然出现在你家门前</text><text for="L36">可我生怕那只是我自作多情</text><text for="L37">不想知道</text><text for="L38">你会不会凝望她的双眸</text><text for="L39">她会不会紧紧拥你入怀</text><text for="L40">就像我从前那样</text><text for="L41">我太过沉迷</text><text for="L42">早该明白你的爱不过是一场游戏</text><text for="L43">如今你在我脑海中挥之不去</text><text for="L44">噢 太遗憾了</text><text for="L45">我们不再交流</text><text for="L46">我们不再交流</text><text for="L47">我们不再交流</text><text for="L48">不再像过去那样</text><text for="L49">我们不再相爱</text><text for="L50">这一切究竟是为了什么 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(我们不再 我们不再)</span></text><text for="L51">噢 我们不再交流</text><text for="L52">不再像过去那样</text><text for="L53">不再像过去那样</text><text for="L54">不想知道</text><text for="L55">你今晚会穿什么样的衣裙</text><text for="L56">他能不能恰到好处地满足你</text><text for="L57">就像我从前那样</text><text for="L58">我太过沉迷</text><text for="L59">早该明白你的爱不过是一场游戏</text><text for="L60">如今你在我脑海中挥之不去</text><text for="L61">噢 太遗憾了</text><text for="L62">我们不再交流</text><text for="L63">我们不再交流</text><text for="L64">我们不再交流</text><text for="L65">不再像过去那样</text><text for="L66">我们不再相爱</text><text for="L67">这一切究竟是为了什么</text><text for="L68">噢 我们不再交流</text><text for="L69">不再像过去那样</text><text for="L70">我们不再交谈 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(不想知道你今晚会穿什么样的衣裙)</span></text><text for="L71">像我以前那样 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(如果他紧紧地抱着你)</span></text><text for="L72">我们不再交谈 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(我太过沉迷)</span></text><text for="L73"><span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(早该知道你的爱只是一场游戏)</span></text><text for="L74"><span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(现在我无法将你从我的脑海中抹去)</span></text><text for="L75">噢 太遗憾了</text><text for="L76">我们不再交流</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="We Don’t Talk Anymore (feat. Selena Gomez)"/><amll:meta key="musicName" value="We Don't Talk Anymore"/><amll:meta key="artists" value="Charlie Puth"/><amll:meta key="artists" value="Selena Gomez"/><amll:meta key="album" value="Nine Track Mind"/><amll:meta key="ncmMusicId" value="401249910"/><amll:meta key="appleMusicId" value="1041127302"/></metadata></head><body><div begin="0:00.500" end="0:19.384" itunes:songPart="Chorus"><p begin="0:00.500" end="0:02.216" itunes:key="L1" ttm:agent="v1"><span begin="0:00.500" end="0:00.807">We</span> <span begin="0:00.807" end="0:01.073">don't</span> <span begin="0:01.073" end="0:01.337">talk</span> <span begin="0:01.337" end="0:02.216">anymore</span></p><p begin="0:02.970" end="0:04.534" itunes:key="L2" ttm:agent="v1"><span begin="0:02.970" end="0:03.250">We</span> <span begin="0:03.250" end="0:03.501">don't</span> <span begin="0:03.501" end="0:03.767">talk</span> <span begin="0:03.767" end="0:04.534">anymore</span></p><p begin="0:05.272" end="0:06.952" itunes:key="L3" ttm:agent="v1"><span begin="0:05.272" end="0:05.517">We</span> <span begin="0:05.517" end="0:05.811">don't</span> <span begin="0:05.811" end="0:06.112">talk</span> <span begin="0:06.112" end="0:06.952">anymore</span></p><p begin="0:06.961" end="0:09.841" itunes:key="L4" ttm:agent="v1"><span begin="0:06.961" end="0:07.321">Like</span> <span begin="0:07.321" end="0:07.721">we</span> <span begin="0:07.721" end="0:08.353">used</span> <span begin="0:08.353" end="0:08.953">to</span> <span begin="0:08.953" end="0:09.841">do</span></p><p begin="0:10.225" end="0:11.749" itunes:key="L5" ttm:agent="v1"><span begin="0:10.225" end="0:10.430">We</span> <span begin="0:10.430" end="0:10.697">don't</span> <span begin="0:10.697" end="0:10.948">love</span> <span begin="0:10.948" end="0:11.749">anymore</span></p><p begin="0:12.452" end="0:14.060" itunes:key="L6" ttm:agent="v1"><span begin="0:12.452" end