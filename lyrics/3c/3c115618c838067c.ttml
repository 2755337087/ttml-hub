54.813" end="1:55.145">罪</span></p><p begin="1:55.466" end="2:00.527" itunes:key="L38" ttm:agent="v1"><span begin="1:55.466" end="1:56.714">但至少可以少点</span><span begin="1:56.714" end="1:57.257">枪声</span> <span begin="1:57.416" end="1:57.686">少</span><span begin="1:57.686" end="1:57.845">点</span><span begin="1:57.845" end="1:58.327">刀刃</span> <span begin="1:58.495" end="1:58.766">少</span><span begin="1:58.766" end="1:58.885">点</span><span begin="1:58.885" end="1:59.437">流血</span> <span begin="1:59.576" end="2:00.527">多点体面</span></p><p begin="2:00.697" end="2:04.712" itunes:key="L39" ttm:agent="v1"><span begin="2:00.697" end="2:03.905">即便人心不管在哪都是冰冷 但至少可以</span><span begin="2:03.905" end="2:04.712">少点恐惧</span></p><p begin="2:04.712" end="2:07.040" itunes:key="L40" ttm:agent="v1"><span begin="2:04.712" end="2:04.897">关</span><span begin="2:04.897" end="2:05.377">于我的</span><span begin="2:05.377" end="2:05.927">家人</span> <span begin="2:05.927" end="2:06.385">不止是</span><span begin="2:06.385" end="2:06.797">血</span><span begin="2:06.797" end="2:07.040">缘</span></p><p begin="2:07.040" end="2:09.202" itunes:key="L41" ttm:agent="v1"><span begin="2:07.040" end="2:07.330">Check</span> <span begin="2:07.330" end="2:07.446">my</span> <span begin="2:07.446" end="2:07.839">gold</span> <span begin="2:07.839" end="2:07.982">chain</span> <span begin="2:08.150" end="2:08.400">翻</span><span begin="2:08.400" end="2:08.521">到</span><span begin="2:08.521" end="2:08.798">背</span><span begin="2:08.798" end="2:09.202">面</span></p><p begin="2:09.532" end="2:12.202" itunes:key="L42" ttm:agent="v1"><span begin="2:09.532" end="2:10.160">每节上</span><span begin="2:10.160" end="2:10.269">都</span><span begin="2:10.269" end="2:11.190">清晰刻着一</span><span begin="2:11.190" end="2:11.290">个</span><span begin="2:11.290" end="2:11.560">逝</span><span begin="2:11.560" end="2:11.701">者</span><span begin="2:11.701" end="2:12.202">名字</span></p><p begin="2:12.400" end="2:14.991" itunes:key="L43" ttm:agent="v1"><span b