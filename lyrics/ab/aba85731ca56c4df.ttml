<amll:meta key="artists" value="Dear Jane"/>
<amll:meta key="album" value="Infinity &amp; Eternity"/>
<amll:meta key="appleMusicId" value="1455490144"/></metadata></head><body dur="4:03.594"><div begin="14.306" end="39.397" itunes:songPart="Verse"><p begin="14.306" end="17.491" itunes:key="L1" ttm:agent="v1"><span begin="14.306" end="15.141">经过一</span><span begin="15.141" end="15.628">些</span><span begin="15.628" end="16.019">秋</span><span begin="16.019" end="16.501">与</span><span begin="16.501" end="17.491">冬</span></p><p begin="18.879" end="26.032" itunes:key="L2" ttm:agent="v1"><span begin="18.879" end="19.768">回忆</span><span begin="19.768" end="21.433">中</span> <span begin="22.310" end="23.128">无端</span><span begin="23.128" end="23.967">为</span><span begin="23.967" end="24.351">你</span><span begin="24.351" end="25.010">动</span><span begin="25.010" end="26.032">容</span></p><p begin="27.593" end="30.948" itunes:key="L3" ttm:agent="v1"><span begin="27.593" end="28.146">挥去</span><span begin="28.146" end="28.544">一</span><span begin="28.544" end="29.021">些</span><span begin="29.021" end="29.317">惊</span><span begin="29.317" end="29.831">与</span><span begin="29.831" end="30.948">恐</span></p><p begin="32.192" end="39.397" itunes:key="L4" ttm:agent="v1"><span begin="32.192" end="33.087">人海</span><span begin="33.087" end="34.511">中</span> <span begin="35.505" end="36.454">谁得</span><span begin="36.454" end="37.259">着</span><span begin="37.295" end="37.696">你</span><span begin="37.696" end="38.368">认</span><span begin="38.368" end="39.397">同</span></p></div><div begin="39.658" end="52.098" itunes:songPart="Verse"><p begin="39.658" end="46.273" itunes:key="L5" ttm:agent="v1"><span begin="39.658" end="41.439">在那些争</span><span begin="41.439" end="42.189">拗</span><span begin="42.189" end="43.036">中</span> <span begin="43.112" end="43.838">我有</span><span begin="43.838" end="44.245">心</span><span begin="44.245" end="44.797">不</span><span begin="44.797" end="45.610">够</span><span begin="45.610" end="46.273">用</span></p><p begin="46.283" end="52.098" itunes:key="L6" ttm:agent="v1"><span begin="46.283" end="47.252">两眼</span><span begin="47.252" end="47.527">一</span><span begin="47.527" end="48.128">黑</span> <span begin="48.128" end="49.664">然后</span><span begin="49.712" end="50.622">失</span><span begin="50.622" end="52.098">控</span></p></div><div begin="52.428" end="1:22.153" itunes:songPart="Chorus"><p begin="52.428" end="59.085" itunes:key="L7" ttm:agent="v1"><span begin="52.428" end="52.921">无谓</span><span begin="52.921" end="53.546">再</span><span begin="53.546" end="55.081">关心</span><span begin="55.081" end="55.957">你</span> <span begin="56.022" end="56.845">我没</span><span begin="56.845" end="57.330">资</span><span begin="57.330" end="58.410">格慰问</span><span begin="58.410" end="59.085">你</span></p><p begin="59.195" end="1:05.711" itunes:key="L8" ttm:agent="v1"><span begin="59.195" end="59.678">无谓</span><span begin="59.678" end="1:00.151">再</span><span begin="1:00.151" end="1:01.793">骚扰</span><span begin="1:01.793" end="1:02.706">你</span> <span begin="1:02.753" end="1:03.471">我没</span><span begin="1:03.471" end="1:03.969">这</span><span begin="1:03.969" end="1:05.043">块厚面</span><span begin="1:05.043" end="1:05.711">皮</span></p><p begin="1:05.781" end="1:12.789" itunes:key="L9" ttm:agent="v1"><span begin="1:05.781" end="1:06.351">无限</span><span begin="1:06.351" end="1:06.867">次</span><span begin="1:06.867" end="1:08.518">对不</span><span begin="1:08.518" end="1:09.272">起</span> <span begin="1:09.385" end="1:09.752">放</span><span begin="1:09.752" end="1:10.157">在</span><span begin="1:10.157" end="1:10.630">心</span><span begin="1:10.630" end="1:10.911">里</span><span begin="1:10.911" end="1:11.661">等心</span><span begin="1:11.661" end="1:12.789">死</span></p><p begin="1:12.899" end="1:22.153" itunes:key="L10" ttm:agent="v1"><span begin="1:12.899" end="1:14.747">难道我与</span><span begin="1:14.747" end="1:15.466">他</span><span begin="1:15.466" end="1:16.416">相</span><span begin="1:16.416" end="1:17.502">比</span> <span begin="1:18.182" end="1:18.579">尚</span><span begin="1:18.579" end="1:18.942">有</span><span begin="1:18.942" end="1:20.018">一线生</span><span begin="1:20.018" end="1:22.153">机</span></p></div><div begin="1:34.223" end="1:46.226" itunes:songPart="Verse"><p begin="1:34.223" end="1:37.590" itunes:key="L11" ttm:agent="v1"><span begin="1:34.223" end="1:34.851">当然</span><span begin="1:34.851" end="1:35.283">他</span><span begin="1:35.283" end="1:35.618">不</span><span begin="1:35.618" end="1:35.873">肯</span><span begin="1:35.873" end="1:36.254">放</span><span begin="1:36.254" end="1:37.590">手</span></p><p begin="1:38.831" end="1:46.226" itunes:key="L12" ttm:agent="v1"><span begin="1:38.831" end="1:39.681">如果</span><span begin="1:39.681" end="1:40.579">准</span><span begin="1:40.579" end="1:41.761">我</span> <span begin="1:42.240" end="1:43.081">重新</span><span begin="1:43.081" end="1:43.940">学</span><span begin="1:43.940" end="1:45.058">过可会</span><span begin="1:45.058" end="1:45.606">白</span><span begin="1:45.606" end="1:46.226">头</span></p></div><div begin="1:46.236" end="2:05.629" itunes:songPart="Verse"><p begin="1:46.236" end="1:52.881" itunes:key="L13" ttm:agent="v1"><span begin="1:46.236" end="1:48.009">骂战中不</span><span begin="1:48.009" end="1:48.852">撤</span><span begin="1:48.852" end="1:49.703">走</span> <span begin="1:49.753" end="1:50.597">负责</span><span begin="1:50.597" end="1:50.821">的</span><span begin="1:50.821" end="1:51.526">不</span><span begin="1:51.526" end="1:52.356">押</span><span begin="1:52.356" end="1:52.881">后</span></p><p begin="1:52.891" end="1:59.491" itunes:key="L14" ttm:agent="v1"><span begin="1:52.891" end="1:53.995">做错</span><span begin="1:53.995" end="1:54.254">的</span><span begin="1:54.254" end="1:54.816">不</span><span begin="1:54.816" end="1:55.641">怕</span><span begin="1:55.641" end="1:56.379">丑</span> <span begin="1:56.490" end="1:58.079">别挣扎说</span><span begin="1:58.079" end="1:58.379">没</span><span begin="1:58.379" end="1:59.491">有</span></p><p begin="1:59.601" end="2:05.629" it