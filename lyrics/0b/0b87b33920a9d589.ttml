<amll:meta key="album" value="离别总是那么突然"/>
<amll:meta key="appleMusicId" value="1678666286"/></metadata></head><body dur="4:02.789"><div begin="20.394" end="41.480" itunes:songPart="Intro"><p begin="20.394" end="26.506" itunes:key="L1" ttm:agent="v1"><span begin="20.394" end="20.903">离</span><span begin="20.903" end="22.583">别</span><span begin="22.583" end="22.919">总</span><span begin="22.919" end="23.697">是</span><span begin="23.697" end="24.818">那么突</span><span begin="24.818" end="26.506">然</span></p><p begin="28.141" end="35.949" itunes:key="L2" ttm:agent="v1"><span begin="28.141" end="28.570">我</span><span begin="28.570" end="29.738">在</span><span begin="29.738" end="30.581">你留给</span><span begin="30.581" end="31.705">我的人</span><span begin="31.705" end="33.110">间</span><span begin="33.110" end="33.795">呼吸</span><span begin="33.795" end="35.949">着</span></p><p begin="36.530" end="41.480" itunes:key="L3" ttm:agent="v1"><span begin="36.530" end="37.633">你</span><span begin="37.633" end="38.625">的离</span><span begin="38.625" end="41.480">开</span></p></div><div begin="42.744" end="1:21.272" itunes:songPart="Chorus"><p begin="42.744" end="48.411" itunes:key="L4" ttm:agent="v1"><span begin="42.744" end="43.641">我梦</span><span begin="43.641" end="44.757">见</span><span begin="45.152" end="46.099">自己</span><span begin="46.099" end="46.339">的</span><span begin="46.339" end="48.411">余生</span></p><p begin="49.719" end="56.606" itunes:key="L5" ttm:agent="v1"><span begin="49.719" end="50.129">似</span><span begin="50.129" end="51.179">禅</span> <span begin="52.271" end="53.543">參破了</span><span begin="53.543" end="55.242">生死</span><span begin="55.242" end="56.606">相依</span></p><p begin="56.616" end="1:02.527" itunes:key="L6" ttm:agent="v1"><span begin="56.616" end="57.401">原</span><span begin="57.401" end="58.959">来轮回只</span><span begin="58.959" end="59.648">是</span><span begin="59.918" end="1:00.697">一</span><span begin="1:00.697" end="1:01.468">种思</span><span begin="1:01.468" end="1:02.527">念</span></p><p begin="1:02.774" end="1:09.297" itunes:key="L7" ttm:agent="v1"><span begin="1:02.774" end="1:03.986">生死流</span><span begin="1:03.986" end="1:05.811">转</span> <span begin="1:06.087" end="1:07.452">从未迷</span><span begin="1:07.452" end="1:09.297">途</span></p><p begin="1:09.665" end="1:12.577" itunes:key="L8" ttm:agent="v1"><span begin="1:09.665" end="1:10.829">因为</span><span begin="1:10.829" end="1:11.620">思念</span><span begin="1:11.620" end="1:12.577">你</span></p><p begin="1:13.086" end="1:21.272" itunes:key="L9" ttm:agent="v1"><span begin="1:13.086" end="1:14.081">是我唯</span><span begin="1:14.081" end="1:15.679">一的</span><span begin="1:16.459" end="1:17.436">归</span><span begin="1:17.436" end="1:21.272">宿</span></p></div><div begin="1:32.777" end="1:45.057" itunes:songPart="Verse"><p begin="1:32.777" end="1:36.267" itunes:key="L10" ttm:agent="v1"><span begin="1:32.777" end="1:33.452">宿</span><span begin="1:33.452" end="1:33.611">命</span><span begin="1:33.611" end="1:34.261">是</span><span begin="1:34.261" end="1:35.325">一支暗</span><span begin="1:35.325" end="1:36.267">箭</span></p><p begin="1:36.303" end="1:39.601" itunes:key="L11" ttm:agent="v1"><span begin="1:36.303" end="1:36.833">速</span><span begin="1:36.833" end="1:37.024">度</span><span begin="1:37.024" end="1:37.762">是</span><span begin="1:37.762" end="1:38.829">一种抗</span><span begin="1:38.829" end="1:39.601">辩</span></p><p begin="1:39.783" end="1:45.057" itunes:key="L12" ttm:agent="v1"><span begin="1:39.783" end="1:40.464">爱你</span><span begin="1:40.464" end="1:41.542">却</span><span begin="1:41.542" end="1:42.340">无可</span><span begin="1:42.340" end="1:43.515">赦</span><span begin="1:43.515" end="1:45.057">免</span></p></div><div begin="1:45.338" end="1:58.394" itunes:songPart="Verse"><p begin="1:45.338" end="1:48.769" itunes:key="L13" ttm:agent="v1"><span begin="1:45.338" end="1:45.856">这余</span><span begin="1:45.856" end="1:46.753">生</span> <span begin="1:46.753" end="1:47.768">无人可</span><span begin="1:47.768" end="1:48.769">见</span></p><p begin="1:49.080" end="1:52.141" itunes:key="L14" ttm:agent="v1"><span begin="1:49.080" end="1:50.732">想你有生</span><span begin="1:50.732" end="1:51.093">之</span><span begin="1:51.093" end="1:52.141">年</span></p><p begin="1:52.175" end="1:58.394" itunes:key="L15" ttm:agent="v1"><span begin="1:52.175" end="1:52.644">用</span><span begin="1:52.644" end="1:53.675">我</span><span begin="1:53.968" end="1:54.423">自</span><span begin="1:54.423" end="1:55.269">己</span><span begin="1:55.269" end="1:56.075">祭</span><span begin="1:56.075" end="1:58.394">奠</span></p></div><div begin="1:58.700" end="2:39.438" itunes:songPart="Chorus"><p begin="1:58.700" end="2:04.767" itunes:key="L16" ttm:agent="v1"><span begin="1:58.700" end="1:59.623">我梦</span><span begin="1:59.623" end="2:00.713">见</span><span begin="2:01.231" end="2:02.233">自己</span><span begin="2:02.233" end="2:02.473">的</span><span begin="2:02.473" end="2:02.984">余</span><span begin="2:02.984" end="2:04.767">生</span></p><p begin="2:05.757" end="2:12.557" itunes:key="L17" ttm:agent="v1"><span begin="2:05.757" end="2:06.167">似</span><span begin="2:06.167" end="2:07.217">禅</span> <span begin="2:08.309" end="2:09.581">參破了</span><span begin="2:09.581" end="2:11.280">生死</span><span begin="2:11.280" end="2:12.557">相依</span></p><p begin="2:12.567" end="2:18.308" itunes:key="L18" ttm:agent="v1"><span begin="2:12.567" end="2:13.352">原</span><span begin="2:13.352" end="2:14.910">来轮回只</span><span begin="2:14.910" end="2:15.599">是</span><span begin="2:15.830" end="2:16.616">一</span><span begin="2:16.616" end="2:17.451">种思</span><span begin="2:17.451" end="2:18.308">念</span></p><p begin="2:18.591" end="2:25.114" itunes:key="L19" ttm:agent="v1"><span begin="2:18.591" end="2:19.803">生死流</span><span begin="2:19.803" end="2:21.687">转</span> <span begin="2:21.904" end="2:23.269">从未迷</span><span begin="2:23.269" end="2:25.114">途</span></p><p begin="2:25.400" end="2:28.489" itunes:key="L20" ttm:agent="v1"><span begin="2:25.400" end="2:26.564">因为</span><span begin="2:26.564" end="2:27.355">思念</span><span begin="2:27.355" end="2:28.489">你</span></p><p begin="2:28.499" end="2:39.438" itunes:key="L21" ttm:agent="v1"><span begin="2:28.499" end="2:29.900">是我唯</span><span begin="2:29.900" end="2:31.387">一的</span><span begin="2:31.872" end="2:32.886">归</span><span begin="2:32.886" end="2:39.438">宿</span></p></div><div begin="2:45.960" end="3:27.493" itunes:songPart="Chorus"><p begin="2:45.960" end="2:51.570" itunes:key="L22" ttm:agent="v1"><span begin="2:45.960" end="2:46.883">我梦</span><span begin="2:46.883" end="2:47.826">见</span><span begin="2:48.383" end="2:49.221">自己</span><span begin="2:49.221" end="2:49.461">的</span><span begin="2:49.461" end="2:49.941">余</span><span begin="2:49.941" end="2:51.570">生</span></p><p begin="2:52.697" end="2:58.998" itunes:key="L23" ttm:agent="v1"><span begin="2:52.697" end="2:53.107">似</span><span begin="2:53.107" end="2:54.054">禅</span> <span begin="2:55.064" end="2:56.201">參破了</span><span begin="2:56.201" end="2:57.829">生死</span><span begin="2:57.829" end="2:58.998">相依</span></p><p begin="2:59.008" end="3:04.919" itunes:key="L24" ttm:agent="v1"><span begin="2:59.008" end="2:59.793">原</span><span begin="2:59.793" end="3:01.304">来轮回只</span><span begin="3:01.304" end="3:02.040">是</span><span begin="3:02.290" end="3:03.049">一</span><span begin="3:03.049" end="3:03.967">种思</span><span begin="3:03.967" end="3:04.919">念</span></p><p begin="3:05.048" end="3:11.681" itunes:key="L25" ttm:agent="v1"><span begin="3:05.048" end="3:06.260">生死流</span><span begin="3:06.260" end="3:08.085">转</span> <span begin="3:08.361" end="3:09.726">从未迷</span><span begin="3:09.726" end="3:11.681">途</span></p><p begin="3:11.690" end="3:16.088" itunes:key="L26" ttm:agent="v1"><span begin="3:11.690" end="3:12.232">因</span><span begin="3:12.232" end="3:13.360">为</span><span begin="3:13.360" end="3:14.096">思念</span><span begin="3:14.096" end="3:16.088">你</span></p><p begin="3:17.004" end="3:27.493" i