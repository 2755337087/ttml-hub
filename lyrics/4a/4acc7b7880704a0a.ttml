<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Anson Long-Seabra</songwriter><songwriter>Jeremy Fedryk</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我想Peter Pan说的没错</text><text for="L2">长大成人就是浪费时间</text><text for="L3">所以我觉得我会远走高飞</text><text for="L4">确定路线 奔向美好的日子</text><text for="L5">我翱翔天际 寻找第二颗容身的星球</text><text for="L6">一往无前 迎接清晨的到来</text><text for="L7">我知道我会安然无恙</text><text for="L8">因为我知道Peter Pan说的没错</text><text for="L9">我只是个生活在小镇上的迷茫男孩</text><text for="L10">我还是幼稚的孩童 但现在我已长大成人</text><text for="L11">试着取得成功 但我却手足无措</text><text for="L12">多么希望我年少轻狂 我会变成什么模样</text><text for="L13">现在已是深更半夜 我待在家里</text><text for="L14">所以我与我的影子为伴</text><text for="L15">我为他演唱我所有悲伤的歌</text><text for="L16">我们默不作声 但他哼唱着</text><text for="L18">童话故事并不是真的</text><text for="L19">我应该怎么办</text><text for="L20">我想Peter Pan说的没错</text><text for="L21">长大成人就是浪费时间</text><text for="L22">所以我觉得我会远走高飞</text><text for="L23">确定路线 奔向美好的日子</text><text for="L24">我翱翔天际 寻找第二颗容身的星球</text><text for="L25">一往无前 迎接清晨的到来</text><text for="L26">我知道我会安然无恙</text><text for="L27">因为我知道Peter Pan说的没错</text><text for="L28">如今日子感觉前途渺茫</text><text for="L29">依然觉得自己停留在十八岁 但我已疲惫不堪</text><text for="L30">所以我幻想着我可以成为什么样的人</text><text for="L31">如果我让时间倒流</text><text for="L32">回到妈妈给我讲故事的那一刻 故事是这样的</text><text for="L33">一群孩子 一个女孩和一个水手</text><text for="L34">遇到一个身穿绿衣服的男孩 我以为那个男孩就是我</text><text for="L35">但我觉得梦想并非注定如此</text><text for="L37">童话故事并不是真的</text><text for="L38">我应该怎么办</text><text for="L39">我想Peter Pan说的没错</text><text for="L40">长大成人就是浪费时间</text><text for="L41">所以我觉得我会远走高飞</text><text for="L42">确定路线 奔向美好的日子</text><text for="L43">我翱翔天际 寻找第二颗容身的星球</text><text for="L44">一往无前 迎接清晨的到来</text><text for="L45">我知道我会安然无恙</text><text for="L46">因为我知道Peter Pan说的没错</text><text for="L47">我并不在乎我能否抵达梦幻岛</text><text for="L48">因为遥远的天空总好过</text><text for="L49">我现在的生活以及我驻足的地方</text><text for="L50">所以最后再说一遍 我想</text><text for="L51">我想Peter Pan说的没错</text><text for="L52">长大成人就是浪费时间</text><text for="L53">所以我觉得我会远走高飞</text><text for="L54">确定路线 奔向美好的日子</text><text for="L55">我翱翔天际 寻找第二颗容身的星球</text><text for="L56">一往无前 迎接清晨的到来</text><text for="L57">我知道我会安然无恙</text><text for="L58">因为我知道Peter Pan说的没错</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="Peter Pan Was Right"/><amll:meta key="artists" value="Anson Seabra"/><amll:meta key="album" value="Peter Pan Was Right"/><amll:meta key="album" value="Peter Pan Was Right - Single"/><amll:meta key="qqMusicId" value="004aCnku1D8zav"/><amll:meta key="ncmMusicId" value="1942594143"/><amll:meta key="appleMusicId" value="1620964778"/><amll:meta key="isrc" value="QZPY62200098"/></metadata></head><body><div begin="0:00.208" end="0:23.191" itunes:songPart="Chorus"><p begin="0:00.208" end="0:02.723" itunes:key="L1" ttm:agent="v1"><span begin="0:00.208" end="0:00.558">I</span> <span begin="0:00.558" end="0:00.850">guess</span> <span begin="0:00.850" end="0:01.236">Pe</span><span begin="0:01.236" end="0:01.458">ter</span> <span begin="0:01.458" end="0:01.989">Pan</span> <span begin="0:01.989" end="0:02.358">was</span> <span begin="0:02.358" end="0:02.723">right</span></p><p begin="0:03.004" end="0:05.542" itunes:key="L2" ttm:agent="v1"><span begin="0:03.004" end="0:03.384">Gro</span><span begin="0:03.384" end="0:03.801">wing</span> <span begin="0:03.801" end="0:04.170">up's</span> <span begin="0:04.170" end="0:04.483">a</span> <span begin="0:04.483" end="0:04.894">waste</span> <span begin="0:04.894" 