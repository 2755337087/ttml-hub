<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">响个不停有什么不好</text><text for="L2">青春有什么不好</text><text for="L3">为什么这停不下来</text><text for="L4">也无法停止的韵律节拍</text><text for="L5">在我的身体中鸣响着</text><text for="L6">唯有从耳机里流出的音律</text><text for="L7">让我成为了我</text><text for="L8">天空染作赤红</text><text for="L9">而我的内心又是什么颜色呢</text><text for="L10">告诉我吧</text><text for="L11">我该朝着何处前进？</text><text for="L12">我一直在寻找着</text><text for="L13">那对我无比重要的某物</text><text for="L14">看啊！</text><text for="L15">倘若尽是总有一日会失去之物</text><text for="L16">就用力铭刻于心吧</text><text for="L17">如今！</text><text for="L18">无论是悲惨的夜晚还是傻笑度过的时光</text><text for="L19">那个啊 还有那未道出后续的时光</text><text for="L20">（现在我抵达了</text><text for="L21">人生的春天）</text><text for="L22">响个不停有什么不好</text><text for="L23">青春有什么不好</text><text for="L24">为什么那想要触及</text><text for="L25">却无法触及的未来</text><text for="L26">如今也令我陷入迷茫</text><text for="L27">大家都不知晓的那个乐队的歌曲</text><text for="L28">我只想给你聆听</text><text for="L29">一切都美丽得令人悲伤</text><text for="L30">总感觉啊 变得寂寞起来了</text><text for="L31">书桌之上没有属于我们的答案</text><text for="L32">一直隐藏着的</text><text for="L33">那句无比重要的话语</text><text for="L34">如今！看啊！</text><text for="L35">必须传达了啊</text><text for="L36">比如与他人描绘不同梦想的事情</text><text for="L37">还有与你曾经争嘴过的事情</text><text for="L38">这一切对我来说都是最棒的礼物</text><text for="L39">送给长大后的我的礼物</text><text for="L40">如此坚信又有什么不好</text><text for="L41">告诉我吧</text><text for="L42">我该朝着何处前进？</text><text for="L43">心是透明的！</text><text for="L44">重要之物就存在于此</text><text for="L45">看啊！</text><text for="L46">心脏不停地告诉我</text><text for="L47">「走吧 迈向更前方」</text><text for="L48">前方</text><text for="L49">无论是悲惨的夜晚还是傻笑度过的时光</text><text for="L50">那个啊 还有那道出后续的笑容</text><text for="L51">（现在我抵达了</text><text for="L52">人生的春天）</text><text for="L53">响个不停有什么不好</text><text for="L54">青春有什么不好</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="なにが悪い"/><amll:meta key="artists" value="結束バンド"/><amll:meta key="album" value="結束バンド"/><amll:meta key="appleMusicId" value="1657318881"/></metadata></head><body><div begin="0:00.465" end="3:31.158"><p begin="0:00.465" end="0:02.487" itunes:key="L1" ttm:agent="v1"><span begin="0:00.465" end="0:00.565">鳴</span><span begin="0:00.565" end="0:00.852">り</span><span begin="0:00.852" end="0:00.952">止</span><span begin="0:00.952" end="0:01.251">ま</span><span begin="0:01.251" end="0:01.551">なくて</span><span begin="0:01.551" end="0:01.890">な</span><span begin="0:01.890" end="0:01.993">に</span><span begin="0:01.993" end="0:02.214">が</span><span begin="0:02.214" end="0:02.487">悪い</span></p><p begin="0:02.497" end="0:06.723" itunes:key="L2" ttm:agent="v1"><span begin="0:02.497" end="0:02.829">青</span><span begin="0:02.829" end="0:03.186">春</span><span begin="0:03.186" end="0:03.439">で</span><span begin="0:03.439" end="0:03.953">なにが</span><span begin="0:03.953" end="0:06.346">悪</span><span begin="0:06.346" end="0:06.723">い</span></p><p begin="0:13.570" end="0:15.526" itunes:key="L3" ttm:agent="v1"><span begin="0:13.570" end="0:13.827">ねぇ</span><span begin="0:13.827" end="0:14.197">どうし</span><span begin="0:14.197" end="0:14.587">て</span><span begin="0:14.587" end="0:14.819">止</span><span begin="0:14.819" end="0:15.153">まら</span><span begin="0:15.153" end="0:15.426">な</span><span begin="0:15.426" end="0:15.526">い</span></p><p begin="0:15.536" end="0:17.617" itunes:key="L4" ttm:agent="v1"><span begin="0:15.536" end="0:15.972">止め</span><span begin="0:15.972" end="0:16.212">らん</span><span begin="0:16.212" end="0:16.530">な</span><span begin="0:16.530" end="0:16.639">い</span><span begin="0:16.639" end="0:16.868">リ</span><span begin="0:16.868" end="0:17.101">ズム</span><span begin="0:17.101" end="0:17.617">が</span></p><p begin="0:17.627" end="0:21.425" itunes:key="L5" ttm:agent="v1"><span begin="0:17.627" end="0:18.400">身</span><span begin="0:18.400" end="0:18.760">体</span><span begin="0:18.760" end="0:18.893">の</span><span begin="0:18.893" end="0:19.526">中</span><span begin="0:19.526" end="0:20.251">響</span><span begin="0:20.251" end="0:20.868">いて</span><span begin="0:20.868" end="0:21.425">いる</span></p><p begin="0:21.435" end="0:25.525" itunes:key="L6" ttm:agent="v1"><span begin="0:21.435" end="0:21.848">イヤ</span><span begin="0:21.848" end="0:22.129">フォ</span><span begin="0:22.129" end="0:22.490">ン</span><span begin="0:22.490" end="0:22.887">から</span><span begin="0:22.887" end="0:23.440">流</span><span begin="0:23.440" end="0:23.790">れる</span><span begin="0:23.790" end="0:24.424">メロ</span><span begin="0:24.424" end="0:25.094">ディだけ</span><span begin="0:25.094" end="0:25.525">が</span></p><p begin="0:25.535" end="0:30.329" itunes:key="L7" ttm:agent="v1"><span begin="0:25.535" end="0:26.395">僕</span><span begin="0:26.395" end="0:26.825">を</span><span begin="0:26.825" end="0:27.303">僕</span><span begin="0:27.303" end="0:27.762">で</span><span begin="0:27.762" end="0:28.028">い</span><span begin="0:28.028" end="0:28.772">させ</span><span begin="0:28.772" end="0:29.264">て</span><span begin="0:29.264" end="0:29.816">くれ</span><span begin="0:29.816" end="0:30.329">た</span></p><p begin="0:30.703" end="0:34.564" itunes:key="L8" ttm:agent="v1"><span begin="0:30.703" end="0:31.482">赤</span><span begin="0:31.645" end="0:32.450">色</span><span begin="0:32.619" end="0:32.943">に</span><span begin="0:32.943" end="0:33.732">染まる</span><span begin="0:33.732" end="0:34.564">空</span></p><p begin="0:34.687" end="0:40.174" itunes:key="L9" ttm:agent="v1"><span begin="0:34.687" end="0:35.416">僕の</span><span begin="0:35.416" end="0:36.403">心</span><span begin="0:36.403" end="0:36.735">は</span><span begin="0:36.735" end="0:37.261">何</span><span begin="0:37.261" end="0:37.725">色</span><span begin="0:37.725" end="0:38.174">なん</span><span begin="0:38.174" end="0:38.334">だ</span><span begin="0:38.334" end="0:39.507">ろ</span><span begin="0:39.507" end="0:40.174">う</span></p><p begin="0:40.699" end="0:41.861" itunes:key="L10" ttm:agent="v1"><span begin="0:40.699" end="0:41.861">おしえて</span></p><p begin="0:41.871" end="0:46.402" itunes:key="L11" ttm:agent="v1"><span begin="0:41.871" end="0:42.541">僕</span><span begin="0:42.541" end="0:42.775">は</span><span begin="0:42.775" end="0:43.550">何処</span><span begin="0:43.550" end="0:43.777">へ</span><span begin="0:43.777" end="0:44.223">向</span><span begin="0:44.223" end="0:44.816">かえ</span><span begin="0:44.816" end="0:45.320">ば</span><span begin="0:45.320" end="0:46.402">いい？</span></p><p begin="0:46.412" end="0:49.419" itunes:key="L12" ttm:agent="v1"><span begin="0:46.412" end="0:46.699">ずっ</span><span begin="0:46.699" end="0:46.983">と</span><span begin="0:46.983" end="0:47.502">探</span><span begin="0:47.502" end="0:47.986">し</span><span begin="0:47.986" end="0:48.222">て</span><span begin="0:48.222" end="0:49.419">いた</span></p><p begin="0:49.492" end="0:51.908" itunes:key="L13" ttm:agent="v1"><span begin="0:49.492" end="0:50.211">大切</span><span begin="0:50.211" end="0:50.700">な</span><span begin="0:50.700" end="0:51.419">何か</span><span begin="0:51.419" end="0:51.908">を</span></p><p begin="0:51.872" end="0:52.604" itunes:key="L14" ttm:agent="v2000"><span begin="0:51.872" end="0:52.604">ほら！</span></p><p begin="0:52.612" end="0:58.299" itunes:key="L15" ttm:agent="v1"><span begin="0:52.612" end="0:53.367">いつか</span><span begin="0:53.367" end="0:53.622">失</span><span begin="0:53.622" end="0:54.047">く</span><span begin="0:54.047" end="0:54.390">し</span><span begin="0:54.390" end="0:54.634">て</span><span begin="0:54.634" end="0:55.010">し</span><span begin="0:55.010" end="0:55.411">まう</span><span begin="0:55.411" end="0:55.935">もの</span><span begin="0:55.935" end="0:56.984">ばかり</span><span begin="0:56.984" end="0:57.306">な</span><span begin="0:57.306" end="0:58.299">ら</span></p><p begin="0:58.309" end="1:00.756" itunes:key="L16" ttm:agent="v1"><span begin="0:58.309" end="0:58.766">強く</span><span begin="0:58.766" end="0:59.316">刻</span><span begin="0:59.316" end="0:59.821">ん</span><span begin="0:59.821" end="0:59.954">で</span><span begin="0:59.954" end="1:00.485">おこ</span><span begin="1:00.485" end="1:00.756">う</span></p><p begin="1:00.760" end="1:01.426" itunes:key="L17" ttm:agent="v2000"><span begin="1:00.760" end="1:01.426">今！</span></p><p begin="1:01.436" end="1:04.855" itunes:key="L18" ttm:agent="v1"><span begin="1:01.436" end="1:02.419">惨めな</span><span begin="1:02.419" end="1:03.029">夜</span><span begin="1:03.029" end="1:03.430">も</span><span begin="1:03.430" end="1:03.777">バカ</span><span begin="1:03.777" end="1:04.320">笑</span><span begin="1:04.320" end="1:04.430">い</span><span begin="1:04.430" end="1:04.855">も</span></p><p begin="1:04.865" end="1:09.153" itunes:key="L19" ttm:agent="v1"><span begin="1:04.865" end="1:05.401">あ</span><span begin="1:05.401" end="1:05.811">のね</span> <span begin="1:05.851" end="1:06.394">そ</span><span begin="1:06.394" end="1:06.503">の</span><span begin="1:06.503" end="1:06.862">後が</span><span begin="1:06.862" end="1:07.225">言え</span><span begin="1:07.225" end="1:07.990">なかっ</span><span begin="1:07.990" end="1:08.176">た</span><span begin="1:08.176" end="1:08.459">日</span><span begin="1:08.459" end="1:09.153">も</span></p><p begin="1:09.607" end="1:11.513" itunes:key="L20" ttm:agent="v2000"><span begin="1:09.607" end="1:10.152">(あいむ</span><span begin="1:10.152" end="1:10.695">あらいぶ</span><span begin="1:10.695" end="1:11.129">なう</span><span begin="1:11.129" end="1:11.513">いぇ</span></p><p begin="1:11.623" end="1:13.261" itunes:key="L21" ttm:agent="v2000"><span begin="1:11.623" end="1:12.133">すぷりんぐ</span><span begin="1:12.133" end="1:12.700">た