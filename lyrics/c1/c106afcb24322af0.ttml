hub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="一半一半 (Live)"/><amll:meta key="musicName" value="一半一半（Live）"/><amll:meta key="artists" value="希林娜依高"/><amll:meta key="artists" value="欧阳娣娣"/><amll:meta key="artists" value="王晓赟子"/><amll:meta key="artists" value="谢可寅"/><amll:meta key="artists" value="袁一琦"/><amll:meta key="artists" value="欧阳娣娣 (Didi Ouyang)"/><amll:meta key="album" value="超燃青春的合唱 第3期 (Live)"/><amll:meta key="album" value="超燃青春的合唱 第3期"/><amll:meta key="qqMusicId" value="000rxEA33M4oaJ"/><amll:meta key="appleMusicId" value="6768744862"/></metadata></head><body><div begin="0:15.779" end="1:10.275" itunes:songPart="Verse"><p begin="0:15.779" end="0:19.292" itunes:key="L1" ttm:agent="v1000"><span begin="0:15.779" end="0:17.479">无力感在把眼泪一</span><span begin="0:17.479" end="0:17.785">点</span><span begin="0:17.785" end="0:18.190">一点</span><span begin="0:18.190" end="0:18.587">吞</span><span begin="0:18.587" end="0:19.292">噬</span></p><p begin="0:19.292" end="0:22.519" itunes:key="L2" ttm:agent="v1000"><span begin="0:19.292" end="0:19.492">空</span><span begin="0:19.492" end="0:19.797">旷</span><span begin="0:19.797" end="0:19.898">的</span><span begin="0:19.898" end="0:20.201">街</span><span begin="0:20.201" end="0:20.806">道早没</span><span begin="0:20.806" end="0:21.110">了</span><span begin="0:21.110" end="0:21.312">一</span><span begin="0:21.312" end="0:21.614">点</span><span begin="0:21.614" end="0:22.519">声</span></p><p begin="0:22.824" end="0:25.445" itunes:key="L3" ttm:agent="v1000"><span begin="0:22.824" end="0:23.118">那</span><span begin="0:23.118" end="0:24.941">天回到我们俩熟悉的</span><span begin="0:24.941" end="0:25.345">城</span><span begin="0:25.345" end="0:25.445">市</span></p><p begin="0:25.445" end="0:29.269" itunes:key="L4" ttm:agent="v1000"><span begin="0:25.445" end="0:26.250">马路上关</span><span begin="0:26.250" end="0:26.351">闭</span><span begin="0:26.351" end="0:27.763">的灯有一半熟悉</span><span begin="0:27.763" end="0:28.068">一</span><span begin="0:28.068" end="0:28.269">半</span><span begin="0:28.269" end="0:29.269">生</span></p><p begin="0:29.774" end="0:31.327" itunes:key="L5" ttm:agent="v1"><span begin="0:29.774" end="0:30.981">酒精让我一半</span><span begin="0:30.981" end="0:31.276">温</span><span begin="0:31.276" end="0:31.327">热</span></p><p begin="0:31.276" end="0:32.085" itunes:key="L6" ttm:agent="v1000"><span begin="0:31.276" end="0:32.085">一半冷</span></p><p begin="0:32.085" end="0:34.091" itunes:key="L7" ttm:agent="v1"><span begin="0:32.085" end="0:34.091">可你扮演着成熟 我一半</span></p><p begin="0:34.091" end="0:36.002" itunes:key="L8" ttm:agent="v1000"><span begin="0:34.091" end="0:34.395">没</span><span begin="0:34.395" end="0:34.997">感觉一</span><span begin="0:34.997" end="0:35.308">半</span><span begin="0:35.308" end="0:36.002">疼</span></p><p begin="0:36.410" end="0:37.307" itunes:key="L9" ttm:agent="v1"><span begin="0:36.410" end="0:37.307">就最后变成</span></p><p begin="0:37.307" end="0:39.224" itunes:key="L10" ttm:agent="v1000"><span begin="0:37.307" end="0:37.617">一</span><span begin="0:37.617" end="0:37.920">半</span><span begin="0:37.920" end="0:38.719">猜忌 一半</span><span begin="0:38.719" end="0:39.224">问</span></p><p begin="0:39.536" end="0:47.365" itunes:key="L11" ttm:agent="v1000"><span begin="0:39.536" end="0:39.728">我</span><span begin="0:39.728" end="0:40.034">可</span><span begin="0:40.034" end="0:40.635">能是自</span><span begin="0:40.635" end="0:40.936">己</span><span begin="0:40.936" end="0:41.038">一</span><span begin="0:41.038" end="0:41.343">半</span><span begin="0:41.343" end="0:42.152">爱你 一半</span><span begin="0:42.152" end="0:42.753">恨</span><span ttm:role="x-bg" begin="0:42.633" end="0:47.365"><span begin="0:42.633" end="0:47.365">(Ah)</span></span></p><p begin="0:43.155" end="0:45.782" itunes:key="L12" ttm:agent="v1"><span begin="0:43.155" end="0:43.357">这</span><span begin="0:43.357" end="0:43.660">离</span><span begin="0:43.660" end="0:44.861">别是我灵感的</span><span begin="0:44.861" end="0:45.267">秤</span><span begin="0:45.267" end="0:45.782">砣</span></p><p begin="0:45.782" end="0:51.360" itunes:key="L13" ttm:agent="v1"><span begin="0:45.782" end="0:46.365">我内</span><span begin="0:46.365" end="0:46.466">心</span><span begin="0:46.466" end="0:46.668">的</span><span begin="0:46.668" end="0:47.063">痛</span><span begin="0:47.063" end="0:47.471">是不</span><span begin="0:47.471" end="0:47.970">对</span><span begin="0:47.970" end="0:48.070">等</span><span begin="0:48.070" end="0:48.272">的</span><span begin="0:48.272" end="0:48.770">沉</span><span begin="0:48.770" end="0:49.174">默</span> <span begin="0:49.174" end="0:49.876">Yeah</span><span ttm:role="x-bg" begin="0:48.134" end="0:51.360"><span begin="0:48.134" end="0:48.840">(沉</span><span begin="0:48.840" end="0:49.240">默</span> <span begin="0:49.240" end="0:51.360">Yeah)</span></span></p><p begin="0:50.079" end="0:52.409" itunes:key="L14" ttm:agent="v1000"><span begin="0:50.079" end="0:51.088">思念是困住</span><span begin="0:51.088" end="0:51.392">我</span><span begin="0:51.392" end="0:51.493">俩</span><span begin="0:51.493" end="0:51.706">的</span><span begin="0:51.706" end="0:52.103">绳</span><span begin="0:52.103" end="0:52.409">索</span></p><p begin="0:52.633" end="0:58.017" itunes:key="L15" ttm:agent="v1000"><span begin="0:52.633" end="0:53.013">就算</span><span begin="0:53.013" end="0:53.413">血肉</span><span begin="0:53.413" end="0:53.818">模</span><span begin="0:53.818" end="0:54.414">糊我也</span><span begin="0:54.414" end="0:54.817">没</span><span begin="0:54.817" end="0:54.918">办</span><span begin="0:54.918" end="0:55.122">法</span><span begin="0:55.122" end="0:55.632">挣</span><span begin="0:55.632" end="0:56.028">脱</span> <span begin="0:56.028" end="0:56.841">Yeah</span><span ttm:role="x-bg" begin="0:52.944" end="0:58.017"><span begin="0:52.944" end="0:55.149">(Wu</span> <span begin="0:55.534" end="0:55.802">挣</span><span begin="0:55.802" end="0:56.208">脱</span> <span begin="0:56.208" end="0:58.017">Yeah)</span></span></p><p begin="0:57.133" end="1:02.379" itunes:key="L16" ttm:agent="v1000"><span begin="0:57.133" end="0:57.236">完</span><span begin="0:57.236" end="0:57.641">美的</span><span begin="0:57.641" end="0:58.139">你</span><span begin="0:58.139" end="0:58.544">终于</span><span begin="0:58.544" end="0:59.347">接受</span><span begin="0:59.347" end="0:59.549">放</span><span begin="0:59.549" end="0:59.649">过</span><span begin="0:59.649" end="1:00.448">剩下</span><span begin="1:00.448" end="1:00.752">的</span><span begin="1:00.752" end="1:01.158">我</span><span begin="1:01.158" end="1:02.262">走</span><span ttm:role="x-bg" begin="0:59.562" end="1:02.379"><span begin="0:59.562" end="0:59.958">(剩</span><span begin="0:59.958" end="1:00.467">下</span><span begin="1:00.467" end="1:00.869">的</span><span begin="1:00.869" end="1:01.175">我</span><span begin="1:01.175" end="1:02.379">走)</span></span></p><p begin="1:02.566" end="1:05.974" itunes:key="L17" ttm:agent="v1000"><span begin="1:02.566" end="1:03.166">我接受</span><span begin="1:03.166" end="1:03.463">这</span><span begin="1:03.463" end="1:03.867">结</span><span begin="1:03.867" end="1:04.363">果</span> <span begin="1:04.363" end="1:04.566">你</span><span begin="1:04.566" end="1:05.475">画的杰</span><span begin="1:05.475" end="1:05.974">作</span></p><p begin="1:05.974" end="1:10.275" itunes:key="L18" ttm:agent="v1000"><span begin="1:05.974" end="1:06.374">我找</span><span begin="1:06.374" end="1:06.477">不</span><span begin="1:06.477" end="1:06.883">到</span><span begin="1:06.883" end="1:07.181">线</span><span begin="1:07.181" end="1:07.382">索</span> <span begin="1:07.382" end="1:07.483">像</span><span begin="1:07.483" end="1:08.091">被牵着</span><span begin="1:08.091" end="1:08.950">走</span><span ttm:role="x-bg" begin="1:07.557" end="1:10.275"><span begin="1:07.557" end="1:10.275">(Wu)</span></span></p></div><div begin="1:08.669" end="1:44.170" itunes:songPart="Chorus"><p begin="1:08.669" end="1:09.979" itunes:key="L19" ttm:agent="v1000