<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">蔡徐坤</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Fussy</songwriter><songwriter>Jacob Ray</songwriter><songwriter>Jonathan Cunningham</songwriter><songwriter>Kurtis Wells</songwriter><songwriter>Mark McKenna</songwriter><songwriter>蔡徐坤</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">想要永沦爱河 女孩</text><text for="L2">你知道我深爱着你</text><text for="L3">这不是秘密 你心知肚明</text><text for="L4">我对你渴望至极</text><text for="L5">那毛毯之下藏着什么</text><text for="L6">给更美妙的事物腾出空间 宝贝</text><text for="L7">你可以轻易将我征服</text><text for="L8">你是否愿意应允</text><text for="L9">拜托别看得太远 亲爱的</text><text for="L10">因为我想沉溺在坏习惯里 噢</text><text for="L11">若是由我做主</text><text for="L12">我甘愿将灵魂交付于你</text><text for="L13">我像一具行尸走肉</text><text for="L14">我像一具行尸走肉</text><text for="L15">被你的身体环绕</text><text for="L16">紧贴着我的骨骼</text><text for="L17">我像一具行尸走肉</text><text for="L18">我像一具行尸走肉</text><text for="L19">感情升温 比天气还要炽热 女孩</text><text for="L20">让我为你降降温</text><text for="L21">你知道我苦苦期盼</text><text for="L22">沛雨甘霖 宝贝</text><text for="L23">拜托别看得太远 亲爱的</text><text for="L24">因为我想让你惊声尖叫 哦</text><text for="L25">若是由我做主</text><text for="L26">我甘愿将灵魂交付于你</text><text for="L27">我像一具行尸走肉</text><text for="L28">我像一具行尸走肉</text><text for="L29">被你的身体环绕</text><text for="L30">紧贴着我的骨骼</text><text for="L31">我像一具行尸走肉</text><text for="L32">我像一具行尸走肉</text><text for="L33">没错 你就是我的挚爱</text><text for="L34">没错 你就是我的挚爱</text><text for="L35">没错 你就是我的挚爱</text><text for="L36">没错 你就是我的挚爱</text><text for="L37">拜托别看得太远 亲爱的</text><text for="L38">因为我想让你惊声尖叫 噢 宝贝 宝贝</text><text for="L39">若是由我做主</text><text for="L40">我甘愿将灵魂交付于你</text><text for="L41">我像一具行尸走肉</text><text for="L42">行尸走肉</text><text for="L43">行尸走肉</text><text for="L44">被你的身体环绕</text><text for="L45">紧贴着我的骨骼</text><text for="L46">没有你在身边</text><text for="L47">我就像一具行尸走肉 行尸走肉 行尸走肉</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Deadman"/><amll:meta key="artists" value="蔡徐坤"/><amll:meta key="album" value="Deadman"/><amll:meta key="album" value="Deadman - Single"/><amll:meta key="album" value="KUN"/><amll:meta key="qqMusicId" value="000e5ren4ZiL3U"/><amll:meta key="ncmMusicId" value="2708984802"/><amll:meta key="appleMusicId" value="1812117271"/><amll:meta key="appleMusicId" value="1861571914"/><amll:meta key="isrc" value="QM6P42575146"/></metadata></head><body><div begin="0:18.450" end="0:48.735" itunes:songPart="Verse"><p begin="0:18.450" end="0:20.694" itunes:key="L1" ttm:agent="v1"><span begin="0:18.450" end="0:18.853">Wanna</span> <span begin="0:18.853" end="0:19.053">be</span> <span begin="0:19.053" end="0:19.219">in</span> <span begin="0:19.219" end="0:19.378">it</span> <span begin="0:19.378" end="0:19.911">forever</span> <span begin="0:19.911" end="0:20.694">girl</span></p><p begin="0:22.490" end="0:24.838" itunes:key="L2" ttm:agent="v1"><span begin="0:22.490" end="0:22.718">You</span> <span begin="0:22.718" end="0:22.918">know</span> <span begin="0:22.918" end="0:23.393">I</span> <span begin="0:23.393" end="0:23.953">adore</span> <span begin="0:23.953" end="0:24.838">ya</span></p><p begin="0:26.470" end="0:28.546" itunes:key="L3" ttm:agent="v1"><span begin="0:26.470" end="0:26.823">No</span> <span begin="0:26.823" end="0:27.505">secret</span> <span begin="0:27.505" end="0:27.855">you</span> <span begin="0:27.855" end="0:28.179">know</span> <span begin="0:28.179" end="0:28.546">that</span></p><p begin="0:30.490" end="0:32.659" itunes:key="L4" ttm:agent="v1"><span begin="0:30.490" end="0:30.906">I</span> <span begin="0:30.906" end="0:31.231">wa