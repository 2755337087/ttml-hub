<amll:meta key="appleMusicId" value="6775736716"/></metadata></head><body dur="4:18.867"><div begin="1.125" end="26.978" itunes:songPart="Verse"><p begin="1.125" end="7.490" itunes:key="L1" ttm:agent="v1"><span begin="1.125" end="2.628">阳光下</span><span begin="2.628" end="4.130">的泡沫</span> <span begin="4.580" end="5.504">是彩</span><span begin="5.504" end="6.427">色</span><span begin="6.427" end="7.490">的</span></p><p begin="8.186" end="14.534" itunes:key="L2" ttm:agent="v1"><span begin="8.186" end="9.197">就像</span><span begin="9.197" end="10.067">被骗</span><span begin="10.067" end="11.220">的我</span> <span begin="11.713" end="12.567">是幸</span><span begin="12.567" end="13.499">福</span><span begin="13.499" end="14.534">的</span></p><p begin="15.297" end="21.576" itunes:key="L3" ttm:agent="v1"><span begin="15.297" end="16.125">追究</span><span begin="16.125" end="17.211">什么</span><span begin="17.211" end="18.180">对错</span> <span begin="18.815" end="19.665">你的</span><span begin="19.665" end="21.576">谎言</span></p><p begin="22.292" end="26.978" itunes:key="L4" ttm:agent="v1"><span begin="22.292" end="24.754">基于你还爱</span><span begin="24.754" end="26.978">我</span></p></div><div begin="28.328" end="54.027" itunes:songPart="Verse"><p begin="28.328" end="35.516" itunes:key="L5" ttm:agent="v1"><span begin="28.328" end="29.732">美丽的</span><span begin="29.732" end="30.401">泡</span><span begin="30.401" end="31.606">沫</span> <span begin="32.040" end="33.778">虽然一刹</span><span begin="33.778" end="35.516">花火</span></p><p begin="35.628" end="42.447" itunes:key="L6" ttm:agent="v1"><span begin="35.628" end="36.886">你所有</span><span begin="36.886" end="37.400">承</span><span begin="37.400" end="38.524">诺</span> <span begin="39.037" end="40.742">虽然都太</span><span begin="40.742" end="42.447">脆弱</span></p><p begin="42.636" end="49.464" itunes:key="L7" ttm:agent="v1"><span begin="42.636" end="43.917">但爱像</span><span begin="43.917" end="44.417">泡</span><span begin="44.417" end="45.738">沫</span> <span begin="46.153" end="47.912">如果能够</span><span begin="47.912" end="49.464">看破</span></p><p begin="49.738" end="54.027" itunes:key="L8" ttm:agent="v1"><span begin="49.738" end="50.973">有什么</span><span begin="50.973" end="51.529">难</span><span begin="51.529" end="54.027">过</span></p></div><div begin="57.680" end="1:23.296" itunes:songPart="Verse"><p begin="57.680" end="1:04.368" itunes:key="L9" ttm:agent="v1"><span begin="57.680" end="59.457">早该知道</span><span begin="59.457" end="1:00.598">泡沫</span> <span begin="1:01.024" end="1:01.698">一</span><span begin="1:01.698" end="1:02.237">触</span><span begin="1:02.237" end="1:02.979">就</span><span begin="1:02.979" end="1:04.368">破</span></p><p begin="1:04.589" end="1:11.359" itunes:key="L10" ttm:agent="v1"><span begin="1:04.589" end="1:06.821">就像已伤的</span><span begin="1:06.821" end="1:07.621">心</span> <span begin="1:08.217" end="1:09.113">不胜</span><span begin="1:09.113" end="1:11.359">折磨</span></p><p begin="1:11.763" end="1:18.653" itunes:key="L11" ttm:agent="v1"><span begin="1:11.763" end="1:13.973">也不是谁的</span><span begin="1:13.973" end="1:14.729">错</span> <span begin="1:15.279" end="1:16.158">谎言</span><span begin="1:16.158" end="1:17.080">再</span><span begin="1:17.080" end="1:18.653">多</span></p><p begin="1:18.730" end="1:23.296" itunes:key="L12" ttm:agent="v1"><span begin="1:18.730" end="1:19.653">基于</span><span begin="1:19.653" end="1:21.122">你还爱</span><span begin="1:21.122" end="1:23.296">我</span></p></div><div begin="1:25.083" end="1:50.393" itunes:songPart="Verse"><p begin="1:25.083" end="1:31.999" itunes:key="L13" ttm:agent="v1"><span begin="1:25.083" end="1:26.225">美丽的</span><span begin="1:26.225" end="1:26.748">泡</span><span begin="1:26.748" end="1:28.062">沫</span> <span begin="1:28.541" end="1:30.413">虽然一刹</span><span begin="1:30.413" end="1:31.999">花火</span></p><p begin="1:32.038" end="1:38.857" itunes:key="L14" ttm:agent="v1"><span begin="1:32.038" end="1:33.296">你所有</span><span begin="1:33.296" end="1:33.810">承</span><span begin="1:33.810" end="1:34.934">诺</span> <span begin="1:35.447" end="1:37.152">虽然都太</span><span begin="1:37.152" end="1:38.857">脆弱</span></p><p begin="1:39.202" end="1:46.072" itunes:key="L15" ttm:agent="v1"><span begin="1:39.202" end="1:40.430">爱本是</span><span begin="1:40.430" end="1:40.951">泡</span><span begin="1:40.951" end="1:42.240">沫</span> <span begin="1:42.638" end="1:44.355">如果能够</span><span begin="1:44.355" end="1:46.072">看破</span></p><p begin="1:46.272" end="1:50.393" itunes:key="L16" ttm:agent="v1"><span begin="1:46.272" end="1:47.556">有什么</span><span begin="1:47.556" end="1:48.137">难</span><span begin="1:48.137" end="1:50.393">过</span></p></div><div begin="1:53.209" end="2:40.571" itunes:songPart="PreChorus"><p begin="1:53.209" end="2:00.217" itunes:key="L17" ttm:agent="v1"><span begin="1:53.209" end="1:54.553">再美的</span><span begin="1:54.553" end="1:55.067">花</span><span begin="1:55.067" end="1:56.339">朵</span> <span begin="1:56.583" end="1:58.465">盛开过就</span><span begin="1:58.465" end="2:00.217">凋落</span></p><p begin="2:00.359" end="2:07.302" itunes:key="L18" ttm:agent="v1"><span begin="2:00.359" end="2:02.063">再亮眼的</span><span begin="2:02.063" end="2:03.436">星</span> <span begin="2:03.831" end="2:05.566">一闪过就</span><span begin="2:05.566" end="2:07.302">坠落</span></p><p begin="2:07.419" end="2:14.383" itunes:key="L19" ttm:agent="v1"><span begin="2:07.419" end="2:08.675">爱本是</span><span begin="2:08.675" end="2:09.169">泡</span><span begin="2:09.169" end="2:10.287">沫</span> <span begin="2:10.828" end="2:12.642">如果能够</span><span begin="2:12.642" end="2:14.383">看破</span></p><p begin="2:14.416" end="2:18.591" itunes:key="L20" ttm:agent="v1"><span begin="2:14.416" end="2:15.759">有什么</span><span begin="2:15.759" end="2:16.289">难</span><span begin="2:16.289" end="2:18.591">过</span></p><p begin="2:21.503" end="2:25.716" itunes:key="L21" ttm:agent="v1"><span begin="2:21.503" end="2:22.608">为什么</span><span begin="2:22.608" end="2:23.293">难</span><span begin="2:23.293" end="2:25.716">过</span></p><p begin="2:28.526" end="2:33.406" itunes:key="L22" ttm:agent="v1"><span begin="2:28.526" end="2:29.950">有什么</span><span begin="2:29.950" end="2:30.340">难</span><span begin="2:30.340" end="2:33.406">过</span></p><p begin="2:35.666" end="2:40.571" itunes:key="L23" ttm:agent="v1"><span begin="2:35.666" end="2:36.999">为什么</span><span begin="2:36.999" end="2:37.566">难</span><span begin="2:37.566" end="2:40.571">过</span></p></div><div begin="2:46.150" end="3:12.158" itunes:songPart="Chorus"><p begin="2:46.150" end="2:53.194" itunes:key="L24" ttm:agent="v1"><span begin="2:46.150" end="2:47.469">全都是</span><span begin="2:47.469" end="2:47.947">泡</span><span begin="2:47.947" end="2:49.353">沫</span> <span begin="2:49.672" end="2:51.433">只一刹的</span><span begin="2:51.433" end="2:53.194">花火</span></p><p begin="2:53.317" end="3:00.281" itunes:key="L25" ttm:agent="v1"><span begin="2:53.317" end="2:54.501">你所有</span><span begin="2:54.501" end="2:55.084">承</span><span begin="2:55.084" end="2:56.468">诺</span> <span begin="2:56.751" end="2:58.516">全部都太</span><span begin="2:58.516" end="3:00.281">脆弱</span></p><p begin="3:00.349" end="3:07.126" itunes:key="L26" ttm:agent="v1"><span begin="3:00.349" end="3:01.589">而你的</span><span begin="3:01.589" end="3:02.130">轮</span><span begin="3:02.130" end="3:03.454">廓</span> <span begin="3:03.772" end="3:05.605">怪我没有</span><span begin="3:05.605" end="3:07.126">看破</span></p><p begin="3:07.360" end="3:12.158" itunes:key="L27" ttm:agent="v1"><span begin="3:07.360" end="3:08.725">才如此</span><span begin="3:08.725" end="3:09.184">难</span><span begin="3:09.184" end="3:12.158">过</span></p></div><div begin="3:14.429" end="3:39.650" itunes:songPart="Chorus"><p begin="3:14.429" end="3:21.448" itunes:key="L28" ttm:agent="v1"><span begin="3:14.429" end="3:15.679">相爱的</span><span begin="3:15.679" end="3:16.278">把</span><span begin="3:16.278" end="3:17.556">握</span> <span begin="3:17.841" end="3:19.693">要如何再</span><span begin="3:19.693" end="3:21.448">搜索</span></p><p begin="3:21.481" end="3:28.460" itunes:key="L29" ttm:agent="v1"><span begin="3:21.481" end="3:22.643">相拥着</span><span begin="3:22.643" end="3:23.262">寂</span><span begin="3:23.262" end="3:24.663">寞</span> <span begin="3:25.011" end="3:26.715">难道就不</span><span begin="3:26.715" end="3:28.460">寂寞</span></p><p begin="3:28.549" end="3:35.549" itunes:key="L30" ttm:agent="v1"><span begin="3:28.549" end="3:29.909">爱本是</span><span begin="3:29.909" end="3:30.463">泡</span><span begin="3:30.463" end="3:31.643">沫</span> <span begin="3:32.102" end="3:33.799">怪我没有</span><span begin="3:33.799" end="3:35.549">看破</span></p><p begin="3:35.585" end="3:39.650" itunes:key="L31" ttm:agent="v1"><span begin="3:35.585" end="3:36.940">才如此</span><span begin="3:36.940" end="3:37.540">难</span><span begin="3:37.540" end="3:39.650">过</span></p></div><div begin="3:43.631" end="4:09.493" itunes:songPart="Outro"><p begin="3:43.631" end="3:50.311" itunes:key="L32" ttm:agent="v1"><span begin="3:43.631" end="3:45.291">在雨下的</span><span begin="3:45.291" end="3:45.812">泡</span><span begin="3:45.812" end="3:46.599">沫</span> <span begin="3:46.966" end="3:47.937">一触</span><span begin="3:47.937" end="3:48.641">就</span><span begin="3:48.641" end="3:50.311">破</span></p><p begin="3:50.682" end="3:57.370" itunes:key="L33" ttm:agent="v1"><span begin="3:50.682" end="3:52.475">当初炽热</span><span begin="3:52.475" end="3:52.824">的</span><span begin="3:52.824" end="3:53.673">心</span> <span begin="3:54.026" end="3:54.938">早已</span><span begin="3:54.938" end="3:57.370">沉没</span></p><p begin="3:57.582" end="4:04.358" itunes:key="L34" ttm:agent="v1"><span begin="3:57.582" end="3:59.006">说什么</span><span begin="3:59.006" end="4:00.624">你爱我</span> <span begin="4:01.100" end="4:01.941">如果</span><span begin="4:01.941" end="4:04.358">骗我</span></p><p begin="4:04.684" end="4:09.493" itunes:key="L35" ttm:agent="v1"><span begin="4:04.684" end="4:06.549">我宁愿你</span><span begin="4:06.549" end="4:07.176">沉</span><span begin="4:07.176" end="4:09.493">默</span></p></div></body></tt>