<amll:meta key="appleMusicId" value="1801146360"/></metadata></head><body dur="5:00.153"><div begin="18.670" end="46.646" itunes:songPart="Verse"><p begin="18.670" end="24.092" itunes:key="L1" ttm:agent="voice"><span begin="18.670" end="19.015">燃</span><span begin="19.015" end="19.471">烧</span><span begin="19.471" end="20.593">吧</span> <span begin="21.255" end="21.495">那</span><span begin="21.495" end="22.472">星火</span><span begin="22.472" end="22.791">已</span><span begin="22.791" end="23.234">燎</span><span begin="23.234" end="24.092">原</span></p><p begin="25.133" end="31.666" itunes:key="L2" ttm:agent="voice"><span begin="25.133" end="25.721">错</span><span begin="25.721" end="26.559">位的</span><span begin="26.559" end="26.998">时</span><span begin="26.998" end="28.133">间</span> <span begin="28.963" end="29.350">拿</span><span begin="29.350" end="30.335">什么</span><span begin="30.335" end="30.686">和</span><span begin="30.686" end="31.666">解</span></p><p begin="33.628" end="39.194" itunes:key="L3" ttm:agent="voice"><span begin="33.628" end="33.939">可</span><span begin="33.939" end="34.440">笑</span><span begin="34.440" end="35.251">吧</span> <span begin="36.207" end="36.454">像</span><span begin="36.454" end="37.464">宿命</span><span begin="37.464" end="37.803">的</span><span begin="37.803" end="38.256">箴</span><span begin="38.256" end="39.194">言</span></p><p begin="40.139" end="46.646" itunes:key="L4" ttm:agent="voice"><span begin="40.139" end="41.104">顷刻</span><span begin="41.104" end="41.626">霎</span><span begin="41.626" end="41.929">那</span><span begin="41.929" end="42.804">间</span> <span begin="43.894" end="44.930">再等</span><span begin="44.930" end="45.408">亿</span><span begin="45.408" end="45.771">万</span><span begin="45.771" end="46.646">年</span></p></div><div begin="48.663" end="1:13.039" itunes:songPart="PreChorus"><p begin="48.663" end="58.016" itunes:key="L5" ttm:agent="voice"><span begin="48.663" end="50.520">绕过</span><span begin="50.520" end="52.126">冬夜</span> <span begin="52.387" end="54.379">我要</span><span begin="54.379" end="56.188">回到</span><span begin="56.188" end="56.730">那</span><span begin="56.730" end="58.016">天</span></p><p begin="1:03.528" end="1:13.039" itunes:key="L6" ttm:agent="voice"><span begin="1:03.528" end="1:05.475">任凭</span><span begin="1:05.475" end="1:07.403">火光</span> <span begin="1:07.403" end="1:09.315">刺进</span><span begin="1:09.315" end="1:10.944">我的</span><span begin="1:11.212" end="1:11.790">双</span><span begin="1:11.790" end="1:13.039">眼</span></p></div><div begin="1:17.265" end="1:47.063" itunes:songPart="Chorus"><p begin="1:17.265" end="1:24.138" itunes:key="L7" ttm:agent="voice"><span begin="1:17.265" end="1:18.260">我等</span><span begin="1:18.260" end="1:18.722">你</span><span begin="1:18.722" end="1:19.988">啊</span> <span begin="1:20.044" end="1:20.598">在</span><span begin="1:20.598" end="1:20.975">日</span><span begin="1:20.975" end="1:21.259">落</span><span begin="1:21.259" end="1:21.969">之</span><span begin="1:21.969" end="1:22.461">前</span><span begin="1:22.461" end="1:24.138">吧</span></p><p begin="1:24.755" end="1:32.132" itunes:key="L8" ttm:agent="voice"><span begin="1:24.755" end="1:25.281">平</span><span begin="1:25.281" end="1:26.174">原的</span><span begin="1:26.174" end="1:27.539">火</span> <span begin="1:27.539" end="1:28.099">照</span><span begin="1:28.099" end="1:28.409">亮</span><span begin="1:28.409" end="1:28.778">整</span><span begin="1:28.778" end="1:29.401">片</span><span begin="1:29.401" end="1:29.836">晚</span><span begin="1:29.836" end="1:32.132">霞</span></p><p begin="1:32.643" end="1:39.992" itunes:key="L9" ttm:agent="voice"><span begin="1:32.643" end="1:33.722">所以</span><span begin="1:33.722" end="1:34.733">我</span> <span begin="1:35.029" end="1:35.501">在</span><span begin="1:35.501" end="1:36.511">缝隙</span><span begin="1:36.511" end="1:36.853">之</span><span begin="1:36.853" end="1:37.469">中</span><span begin="1:37.469" end="1:38.373">望向</span><span begin="1:38.373" end="1:38.753">了</span><span begin="1:38.753" end="1:39.103">夜</span><span begin="1:39.103" end="1:39.992">空</span></p><p begin="1:40.163" end="1:47.063" itunes:key="L10" ttm:agent="voice"><span begin="1:40.163" end="1:40.641">时</span><span begin="1:40.641" end="1:41.019">间</span><span begin="1:41.019" end="1:41.276">的</span><span begin="1:41.276" end="1:42.118">谎话</span> <span begin="1:42.118" end="1:42.561">生</span><span begin="1:42.561" end="1:42.867">命</span><span begin="1:42.867" end="1:43.089">的</span><span begin="1:43.089" end="1:44.036">沙哑</span> <span begin="1:44.036" end="1:44.769">避而</span><span begin="1:44.769" end="1:45.229">不</span><span begin="1:45.229" end="1:47.063">答</span></p></div><div begin="1:47.371" end="2:22.350" itunes:songPart="Chorus"><p begin="1:47.371" end="1:54.479" itunes:key="L11" ttm:agent="voice"><span begin="1:47.371" end="1:47.844">我</span><span begin="1:47.844" end="1:48.767">等你</span><span begin="1:48.767" end="1:50.083">啊</span> <span begin="1:50.083" end="1:50.554">在</span><span begin="1:50.554" end="1:50.900">忘</span><span begin="1:50.900" end="1:51.326">记</span><span begin="1:51.326" end="1:51.928">之</span><span begin="1:51.928" end="1:52.421">前</span><span begin="1:52.421" end="1:54.479">吧</span></p><p begin="1:54.758" end="2:02.314" itunes:key="L12" ttm:agent="voice"><span begin="1:54.758" end="1:55.688">平原</span><span begin="1:55.688" end="1:56.206">的</span><span begin="1:56.206" end="1:57.592">火</span> <span begin="1:57.592" end="1:58.454">燃烧</span><span begin="1:58.454" end="1:58.884">整</span><span begin="1:58.884" end="1:59.454">片</span><span begin="1:59.454" end="1:59.821">晚</span><span begin="1:59.821" end="2:02.314">霞</span></p><p begin="2:02.669" end="2:09.884" itunes:key="L13" ttm:agent="voice"><span begin="2:02.669" end="2:03.714">然后</span><span begin="2:03.714" end="2:04.848">呢</span> <span begin="2:04.900" end="2:05.952">谁在</span><span begin="2:05.952" end="2:06.785">期待</span><span begin="2:06.785" end="2:07.347">中</span><span begin="2:07.347" end="2:08.340">撕碎</span><span begin="2:08.340" end="2:08.772">了</span><span begin="2:08.772" end="2:09.168">年</span><span begin="2:09.168" end="2:09.884">华</span></p><p begin="2:10.169" end="2:22.350" itunes:key="L14" ttm:agent="voice"><span begin="2:10.169" end="2:10.648">任</span><span begin="2:10.648" end="2:10.950">凭</span><span begin="2:10.950" end="2:11.225">命</span><span begin="2:11.225" end="2:12.099">运的</span><span begin="2:12.099" end="2:13.066">践踏</span> <span begin="2:13.066" end="2:14.026">都别</span><span begin="2:14.026" end="2:14.712">笑</span><span begin="2:14.712" end="2:15.042">我</span><span begin="2:15.042" end="2:16.656">傻</span> <span begin="2:17.752" end="2:18.533">笑</span><span begin="2:18.533" end="2:18.936">我</span><span begin="2:18.936" end="2:22.350">傻</span></p></div><div begin="2:33.624" end="2:46.827" itunes:songPart="Verse"><p begin="2:33.624" end="2:39.316" itunes:key="L15" ttm:agent="voice"><span begin="2:33.624" end="2:33.969">燃</span><span begin="2:33.969" end="2:34.425">烧</span><span begin="2:34.425" end="2:35.971">吧</span> <span begin="2:36.209" end="2:36.449">那</span><span begin="2:36.449" end="2:37.426">星火</span><span begin="2:37.426" end="2:37.745">已</span><span begin="2:37.745" end="2:38.188">燎</span><span begin="2:38.188" end="2:39.316">原</span></p><p begin="2:40.170" end="2:46.827" itunes:key="L16" ttm:agent="voice"><span begin="2:40.170" end="2:41.135">顷刻</span><span begin="2:41.135" end="2:41.657">霎</span><span begin="2:41.657" end="2:41.960">那</span><span begin="2:41.960" end="2:42.835">间</span> <span begin="2:43.925" end="2:44.961">再等</span><span begin="2:44.961" end="2:45.439">亿</span><span begin="2:45.439" end="2:45.802">万</span><span begin="2:45.802" end="2:46.827">年</span></p></div><div begin="2:48.619" end="3:00.008" itunes:songPart="PreChorus"><p begin="2:48.619" end="3:00.008" itunes:key="L17" ttm:agent="voice"><span begin="2:48.619" end="2:50.566">任凭</span><span begin="2:50.566" end="2:52.494">火光</span> <span begin="2:52.494" end="2:54.406">刺进</span><span begin="2:54.406" end="2:56.142">我的</span><span begin="2:56.142" end="2:56.881">双</span><span begin="2:56.881" end="3:00.008">眼</span></p></div><div begin="3:02.274" end="3:32.072" itunes:songPart="Chorus"><p begin="3:02.274" end="3:09.540" itunes:key="L18" ttm:agent="voice"><span begin="3:02.274" end="3:03.269">我等</span><span begin="3:03.269" end="3:03.731">你</span><span begin="3:03.731" end="3:05.057">啊</span> <span begin="3:05.057" end="3:05.607">在</span><span begin="3:05.607" end="3:05.984">日</span><span begin="3:05.984" end="3:06.268">落</span><span begin="3:06.268" end="3:06.978">之</span><span begin="3:06.978" end="3:07.470">前</span><span begin="3:07.470" end="3:09.540">吧</span></p><p begin="3:09.763" end="3:17.313" itunes:key="L19" ttm:agent="voice"><span begin="3:09.763" end="3:10.289">平</span><span begin="3:10.289" end="3:11.182">原的</span><span begin="3:11.182" end="3:12.547">火</span> <span begin="3:12.547" end="3:13.107">照</span><span begin="3:13.107" end="3:13.417">亮</span><span begin="3:13.417" end="3:13.786">整</span><span begin="3:13.786" end="3:14.409">片</span><span begin="3:14.409" end="3:14.844">晚</span><span begin="3:14.844" end="3:17.313">霞</span></p><p begin="3:17.712" end="3:25.160" itunes:key="L20" ttm:agent="voice"><span begin="3:17.712" end="3:18.741">如果</span><span begin="3:18.741" end="3:20.038">能</span> <span begin="3:20.038" end="3:20.539">再</span><span begin="3:20.539" end="3:21.494">回到</span><span begin="3:21.494" end="3:21.810">最</span><span begin="3:21.810" end="3:22.272">初</span><span begin="3:22.380" end="3:23.404">拾起</span><span begin="3:23.404" end="3:23.780">我</span><span begin="3:23.780" end="3:24.166">们</span><span begin="3:24.166" end="3:25.160">啊</span></p><p begin="3:25.170" end="3:32.072" itunes:key="L21" ttm:agent="voice"><span begin="3:25.170" end="3:25.488">任</span><span begin="3:25.488" end="3:25.960">时</span><span begin="3:25.960" end="3:26.244">间</span><span begin="3:26.244" end="3:27.097">敲打</span> <span begin="3:27.097" end="3:27.511">紧</span><span begin="3:27.511" end="3:27.875">抱</span><span begin="3:27.875" end="3:28.118">着</span><span begin="3:28.118" end="3:29.039">你啊</span> <span begin="3:29.039" end="3:29.888">不去</span><span begin="3:29.888" end="3:30.487">挣</span><span begin="3:30.487" end="3:32.072">扎</span></p></div><div begin="3:32.249" end="4:09.690" itunes:songPart="Chorus"><p begin="3:32.249" end="3:39.518" itunes:key="L22" ttm:agent="voice"><span begin="3:32.249" end="3:32.722">我</span><span begin="3:32.722" end="3:33.645">等你</span><span begin="3:33.645" end="3:34.961">啊</span> <span begin="3:34.961" end="3:35.432">在</span><span begin="3:35.432" end="3:35.778">忘</span><span begin="3:35.778" end="3:36.204">记</span><span begin="3:36.204" end="3:36.806">之</span><span begin="3:36.806" end="3:37.299">前</span><span begin="3:37.299" end="3:39.518">吧</span></p><p begin="3:39.748" end="3:47.512" itunes:key="L23" ttm:agent="voice"><span begin="3:39.748" end="3:40.678">平原</span><span begin="3:40.678" end="3:41.196">的</span><span begin="3:41.196" end="3:42.582">火</span> <span begin="3:42.582" end="3:43.329">燃烧</span><span begin="3:43.329" end="3:43.827">整</span><span begin="3:43.827" end="3:44.444">片</span><span begin="3:44.444" end="3:44.811">晚</span><span begin="3:44.811" end="3:47.512">霞</span></p><p begin="3:47.719" end="3:55.090" itunes:key="L24" ttm:agent="voice"><span begin="3:47.719" end="3:48.596">我相</span><span begin="3:48.596" end="3:50.036">信</span> <span begin="3:50.036" end="3:50.524">在</span><span begin="3:50.524" end="3:51.020">下</span><span begin="3:51.020" end="3:51.317">个</span><span begin="3:51.317" end="3:51.740">清</span><span begin="3:51.740" end="3:52.453">晨</span><span begin="3:52.453" end="3:53.373">你就</span><span begin="3:53.373" end="3:53.750">会</span><span begin="3:53.750" end="3:54.122">到</span><span begin="3:54.122" end="3:55.090">达</span></p><p begin="3:55.220" end="4:09.690" itunes:key="L25" ttm:agent="voice"><span begin="3:55.220" end="3:55.620">点</span><span begin="3:55.620" end="3:55.919">燃</span><span begin="3:55.919" end="3:56.238">这</span><span begin="3:56.238" end="3:57.120">破晓</span><span begin="3:57.120" end="3:58.018">以后</span> <span begin="3:58.018" end="3:58.991">平原</span><span begin="3:58.991" end="3:59.724">之</span><span begin="3:59.724" end="4:00.158">上</span><span begin="4:00.158" end="4:02.477">的</span><span begin="4:02.760" end="4:03.300">火</span><span begin="4:03.300" end="4:03.600">焰</span><span begin="4:03.600" end="4:09.690">吧</span></p></div></body></tt>