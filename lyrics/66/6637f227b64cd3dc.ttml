222">了</span></p><p begin="51.723" end="57.061" itunes:key="L7" ttm:agent="v1"><span begin="51.723" end="52.179">也</span><span begin="52.179" end="52.963">许</span><span begin="52.963" end="53.826">时间</span><span begin="53.826" end="55.026">是一种</span><span begin="55.026" end="55.842">解</span><span begin="55.842" end="57.061">药</span></p><p begin="57.435" end="1:03.616" itunes:key="L8" ttm:agent="v1"><span begin="57.435" end="57.778">也</span><span begin="57.778" end="58.639">是我</span><span begin="58.639" end="59.195">现</span><span begin="59.457" end="1:00.298">在正</span><span begin="1:00.298" end="1:01.530">服下的</span><span begin="1:01.530" end="1:02.330">毒</span><span begin="1:02.330" end="1:03.616">药</span></p></div><div begin="1:03.849" end="1:29.537" itunes:songPart="Chorus"><p begin="1:03.849" end="1:09.980" itunes:key="L9" ttm:agent="v1"><span begin="1:03.849" end="1:04.380">看</span><span begin="1:04.380" end="1:05.212">不见</span><span begin="1:05.212" end="1:05.980">你的</span><span begin="1:05.980" end="1:06.796">笑 我</span><span begin="1:06.796" end="1:07.580">怎么</span><span begin="1:07.580" end="1:08.409">睡得</span><span begin="1:08.409" end="1:09.980">着</span></p><p begin="1:10.301" end="1:16.545" itunes:key="L10" ttm:agent="v1"><span begin="1:10.301" end="1:10.848">你</span><span begin="1:10.848" end="1:11.678">的声</span><span begin="1:11.678" end="1:12.510">音这</span><span begin="1:12.510" end="1:13.310">么近</span> <span begin="1:13.310" end="1:14.110">我却</span><span begin="1:14.110" end="1:14.945">抱不</span><span begin="1:14.945" end="1:16.545">到</span></p><p begin="1:16.859" end="1:22.984" itunes:key="L11" ttm:agent="v1"><span begin="1:16.859" end="1:17.333">没</span><span begin="1:17.333" end="1:18.219">有地</span><span begin="1:18.219" end="1:19.035">球</span> <span begin="1:19.287" end="1:20.133">太阳</span><span begin="1:20.133" end="1:21.435">还是会</span><span begin="1:21.435" end="1:22.984">绕</span></p><p begin="1:23.332" end="1:29.537" itunes:key="L12" ttm:agent="v1"><span begin="1:23.332" end="1:23.814">没</span><span begin="1:23.814" end="1:24.671">有理</span><span begin="1:24.671" end="1:25.521">由</span> <span begin="1:25.864" end="1:26.305">我</span><span begin="1:26.305" end="1:27.030">也能</span><span begin="1:27.030" end="1:27.670">自</span><span begin="1:27.670" end="1:28.145">己</span><span begin="1:28.145" end="1:29.537">走</span></p></div><div begin="1:29.828" end="1:55.889" itunes:songPart="Chorus"><p begin="1:29.828" end="1:35.994" itunes:key="L13" ttm:agent="v1"><span begin="1:29.828" end="1:30.327">你</span><span begin="1:30.327" end="1:31.143">要离</span><span begin="1:31.143" end="1:32.042">开</span> <span begin="1:32.327" end="1:33.575">我知道</span><span begin="1:33.575" end="1:34.394">很简</span><span begin="1:34.394" end="1:35.994">单</span></p><p begin="1:36.350" end="1:42.755" itunes:key="L14" ttm:agent="v1"><span begin="1:36.350" end="1:36.751">你</span><span begin="1:36.751" end="1:37.263">说</span><span begin="1:37.263" end="1:37.590">依</span><span begin="1:37.590" end="1:38.504">赖</span> <span begin="1:38.727" end="1:40.038">是我们</span><span begin="1:40.038" end="1:40.904">的阻</span><span begin="1:40.904" end="1:42.755">碍</span></p><p begin="1:42.836" end="1:49.882" itunes:key="L15" ttm:agent="v1"><span begin="1:42.836" end="1:43.260">就</span><span begin="1:43.260" end="1:44.149">算放</span><span begin="1:44.149" end="1:44.933">开</span> <span begin="1:45.314" end="1:45.683">但</span><span begin="1:45.683" end="1:47.333">能不能别</span><span begin="1:47.333" end="1:49.047">没收我的</span><span begin="1:49.047" end="1:49.882">爱</span></p><p begin="1:50.128" end="1:55.889" itunes:key="L16" ttm:agent="v1"><span begin="1:50.128" end="1:50.546">当</span><span begin="1:50.546" end="1:52.147">作我最后</span><span begin="1:52.147" end="1:53.423">才</span><span begin="1:53.423" end="1:53.837">明</span><span begin="1:53.837" end="1:55.889">白</span></p></div><div begin="1:56.586" end="2:21.427" itunes:songPart="Verse"><p begin="1:56.586" end="2:02.195"