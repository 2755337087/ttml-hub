<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>门尼</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">早安 晚安</text><text for="L2">我们心知这一切毫无意义</text><text for="L3">不断挣扎 不断燃烧</text><text for="L4">不停追逐 反复周旋</text><text for="L5">我爱你 爱意在缓缓消解</text><text for="L6">你的心 我的命 原因谁分得清</text><text for="L7">预制的 理智的</text><text for="L8">我们的最后一次分手</text><text for="L9">记好了 我们谁都不准提</text><text for="L10">趁一切还来得及</text><text for="L11">丢了就看不到过没过期</text><text for="L12">合照要删 删 删</text><text for="L13">倒着删 倒着回到相遇那天起</text><text for="L14">我从没有爱过你</text><text for="L15">放弃的问题就不是问题</text><text for="L16">别回头看 别再试探</text><text for="L17">万一有个笨蛋忽然而来地追赶</text><text for="L18">怎么办</text><text for="L19">怎么办</text><text for="L20">敢不敢</text><text for="L21">台词早被时间腌透 无法收回或回收</text><text for="L22">流水线标准的生活 不会受难和难受</text><text for="L23">要稳稳妥妥 稳稳妥妥</text><text for="L24">别一错再错 一拖再拖</text><text for="L25">说好的预制的分手 拖多久才足够</text><text for="L26">那未雨绸缪的念头 偷偷在经历苦甜之前</text><text for="L27">预知没有以后 才有了之后</text><text for="L28">都知道我们只是不甘寂寞</text><text for="L29">什么狗屁天长地久</text><text for="L30">你换季 会过敏 别忘补点维C</text><text for="L31">你加餐 别太晚</text><text for="L32">苏打在左手边第三栏</text><text for="L33">记好了 我们谁都不准提</text><text for="L34">趁一切还来得及</text><text for="L35">丢了就看不到过没过期</text><text for="L36">合照要删 删 删</text><text for="L37">倒着删 倒着回到相遇那天起</text><text for="L38">我从没有爱过你</text><text for="L39">放弃的问题就不是问题</text><text for="L40">别回头看 别再试探</text><text for="L41">万一有个笨蛋忽然而来地追赶</text><text for="L42">怎么办</text><text for="L43">怎么办</text></translation></translations></iTunesMetadata><amll:meta key