<amll:meta key="musicName" value="葡萄成熟时"/>
<amll:meta key="artists" value="陈奕迅"/>
<amll:meta key="album" value="U 87"/>
<amll:meta key="appleMusicId" value="1443375474"/></metadata></head><body dur="4:37.040"><div begin="15.891" end="45.694"><p begin="15.891" end="19.856" itunes:key="L1" ttm:agent="v1"><span begin="15.891" end="16.750">差不多</span><span begin="16.750" end="17.186">冬</span><span begin="17.186" end="17.722">至</span><span begin="17.769" end="18.676">一早一晚</span><span begin="18.676" end="18.920">还</span><span begin="18.920" end="19.856">是有雨</span></p><p begin="19.866" end="25.167" itunes:key="L2" ttm:agent="v1"><span begin="19.866" end="20.659">当初的</span><span begin="20.659" end="21.120">坚</span><span begin="21.120" end="21.725">持</span><span begin="21.757" end="23.562">现已令你</span><span begin="23.562" end="24.544">很怀</span><span begin="24.544" end="25.167">疑</span></p><p begin="25.654" end="30.445" itunes:key="L3" ttm:agent="v1"><span begin="25.654" end="26.133">很</span><span begin="26.133" end="26.854">怀疑</span><span begin="26.865" end="27.558">你最尾</span><span begin="27.558" end="28.511">等到</span><span begin="28.511" end="29.254">只有这</span><span begin="29.254" end="29.516">枯</span><span begin="29.516" end="30.445">枝</span></p><p begin="31.565" end="35.422" itunes:key="L4" ttm:agent="v1"><span begin="31.565" end="32.471">苦恋几</span><span begin="32.471" end="32.888">多</span><span begin="32.888" end="33.366">次</span><span begin="33.366" end="34.845">悉心栽种全力</span><span begin="34.845" end="35.422">灌注</span></p><p begin="35.432" end="40.758" itunes:key="L5" ttm:agent="v1"><span begin="35.432" end="36.343">所得竟</span><span begin="36.343" end="36.889">不</span><span begin="36.889" end="37.343">如</span><span begin="37.343" end="39.121">别个后辈</span><span begin="39.121" end="39.621">收</span><span begin="39.621" end="39.997">成</span><span begin="39.997" end="40.758">时</span></p><p begin="41.158" end="45.694" itunes:key="L6" ttm:agent="v1"><span begin="41.158" end="41.683">这</span><span begin="41.683" end="41.945">一</span><span begin="41.945" end="42.658">次</span><span begin="42.865" end="