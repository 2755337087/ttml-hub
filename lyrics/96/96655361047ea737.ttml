<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">门尼</ttm:name></ttm:agent><ttm:agent type="other" xml:id="v2000"><ttm:name type="full">BB仔</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>门尼</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">看着落单的餐椅 忽然好想你</text><text for="L2">今夜的掌声零星 满地瓜子壳</text><text for="L3">我要把梦都换成 最好的东西</text><text for="L4">都给你 等等我 我的小姑娘</text><text for="L5">店外门把结了冰 忽然好想你</text><text for="L6">为你种的绿巴黎 竟然枯萎了</text><text for="L7">只要回来的是你 我就等着你</text><text for="L8">亲爱的 我爱你 别灰心</text><text for="L9">我依然爱你</text><text for="L10">可世界仍下着雨</text><text for="L11">我依然爱你</text><text for="L12">可世界仍下着雨</text><text for="L13">我说着落叶在倾听</text><text for="L14">我存了半罐的硬币</text><text for="L15">是为了能在夜里碰到你 En</text><text for="L16">我爱你胸口的潮汐</text><text for="L17">我爱画窗户留下的雾气</text><text for="L18">可是我 不敢提起</text><text for="L19">离开街角的微醺 忽然好想你</text><text for="L20">对了 有个好消息 保证你满意</text><text for="L21">我要带你去领奖 奖金换婚礼</text><text for="L22">告诉你 等等我 我的小姑娘</text><text for="L23">我用有你的报纸 包了风信子</text><text for="L24">紫色却染透了我 最爱的琥珀</text><text for="L25">只要开心的是你 我就很开心</text><text for="L26">亲爱的 我爱你 我爱你</text><text for="L27">我依然爱你</text><text for="L28">可世界仍下着雨</text><text for="L29">我依然爱你</text><text for="L30">可世界仍下着雨</text><text for="L31">我说着落叶在倾听</text><text for="L32">我存了半瓶的香槟</text><text for="L33">是为了能在夜里碰到你 Ah</text><text for="L34">我爱你胸口的潮汐</text><text for="L35">我爱画窗户留下的雾气</text><text for="L36">可是我 不敢提起</text><text for="L37">我依然爱你</text><text for="L38">可世界仍下着雨</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub"