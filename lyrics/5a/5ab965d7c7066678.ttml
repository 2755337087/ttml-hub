<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="group" xml:id="v1000"/><ttm:agent type="other" xml:id="v2000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>周杰伦</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="爸 我回来了 (Live)"/><amll:meta key="musicName" value="爸 我回來了 (Live)"/><amll:meta key="musicName" value="Dad, I'm home (Live)"/><amll:meta key="artists" value="周杰伦"/><amll:meta key="artists" value="周杰倫"/><amll:meta key="artists" value="Jay Chou"/><amll:meta key="album" value="周杰伦地表最强世界巡回演唱会"/><amll:meta key="album" value="周杰倫地表最強世界巡迴演唱會"/><amll:meta key="album" value="周杰伦地表最强世界巡回演唱会 (Live)"/><amll:meta key="album" value="Jay Chou The Invincible Concert Tour"/><amll:meta key="qqMusicId" value="001NfK092X8KsZ"/><amll:meta key="appleMusicId" value="1721465134"/><amll:meta key="appleMusicId" value="1485220322"/><amll:meta key="isrc" value="TWK971901215"/></metadata></head><body><div begin="0:24.871" end="1:47.841" itunes:songPart="Verse"><p begin="0:24.871" end="0:29.208" itunes:key="L1" ttm:agent="v1"><span begin="0:24.871" end="0:25.951">其实我回家就</span><span begin="0:25.951" end="0:26.241">想</span><span begin="0:26.241" end="0:26.851">要阻止</span><span begin="0:27.022" end="0:27.172">一</span><span begin="0:27.172" end="0:27.582">切</span> <span begin="0:27.582" end="0:28.212">让家庭</span><span begin="0:28.212" end="0:28.392">回到</span><span begin="0:28.392" end="0:29.208">过去甜甜</span></p><p begin="0:29.208" end="0:33.178" itunes:key="L2" ttm:agent="v1"><span begin="0:29.208" end="0:29.336">温</span><span begin="0:29.336" end="0:29.605">馨</span><span begin="0:29.605" end="0:30.107">的欢乐</span><span begin="0:30.107" end="0:30.747">香味</span> <span begin="0:30.947" end="0:32.067">虽然这是我编</span><span begin="0:32.067" end="0:32.326">造出</span><span begin="0:32.326" end="0:32.565">来</span><span begin="0:32.565" end="0:32.667">的</span><span begin="0:32.667" end="0:33.178">事实</span></p><p begin="0:33.394" end="0:37.220" itunes:key="L3" ttm:agent="v1"><span begin="0:33.394" end="0:33.693">有点讽</span><span begin="0:33.693" end="0:34.224">刺 有点酸</span><span begin="0:34.224" end="0:34.544">性</span> <span begin="0:34.544" end="0:34.682">但</span><span begin="0:34.682" end="0:35.665">它确在这快</span><span begin="0:35.665" end="0:35.901">乐社</span><span begin="0:35.901" end="0:37.220">会发生产生共鸣</span></p><p begin="0:37.349" end="0:41.269" itunes:key="L4" ttm:agent="v1"><span begin="0:37.349" end="0:38.897">产生共鸣来阻止一切</span><span begin="0:38.897" end="0:39.149">暴力</span> <span begin="0:39.149" end="0:39.428">眼泪</span><span begin="0:39.428" end="0:40.318">随着音符吸</span><span begin="0:40.421" end="0:40.526">入血</span><span begin="0:40.526" end="0:40.709">液</span><span begin="0:40.709" end="0:41.269">情绪</span></p><p begin="0:41.269" end="0:44.993" itunes:key="L5" ttm:agent="v1"><span begin="0:41.269" end="0:41.408">从</span><span begin="0:41.537" end="0:42.617">小到大 你叫我</span><span begin="0:42.617" end="0:43.396">学习你 把你</span><span begin="0:43.396" end="0:43.807">当榜</span><span begin="0:43.807" end="0:44.094">样</span> <span begin="0:44.094" end="0:44.105">好</span><span begin="0:44.105" end="0:44.386">多</span><span begin="0:44.386" end="0:44.695">的假</span><span begin="0:44.824" end="0:44.993">像</span></p><p begin="0:45.003" end="0:49.144" itunes:key="L6" ttm:agent="v1"><span begin="0:45.003" end="0:45.121">妈</span><span begin="0:45.121" end="0:45.372">妈</span><span begin="0:45.372" end="0:45.522">常</span><span begin="0:45.522" end="0:45.773">说</span> <span begin="0:45.943" end="0:46.282">乖</span> <span begin="0:46.282" end="0:46.491">听</span><span begin="0:46.491" end="0:46.640">你爸</span><span begin="0:46.640" end="0:46.930">的</span><span begin="0:46.930" end="0:47.392">话</span> <span begin="0:47.392" end="0:47.982">你叫我</span><span begin="0:48.083" end="0:48.800">怎么跟你</span><span begin="0:48.800" end="0:49.144">像！</span></p><p begin="0:49.994" end="0:51.147" itunes:key="L7" ttm:agent="v1"><span begin="0:49.994" end="0:50.414">你走</span><span begin="0:50.414" end="0:51.147">开！</span></p><p begin="0:51.230" end="0:56.040" itunes:key="L8" ttm:agent="v1"><span begin="0:51.230" end="0:51.760">不</span><span begin="0:51.760" end="0:52.163">要</span><span begin="0:52.163" end="0:52.467">再</span><span begin="0:52.467" end="0:52.971">这样</span><span begin="0:52.971" end="0:53.398">打我</span><span begin="0:53.398" end="0:54.129">妈</span><span begin="0:54.129" end="0:56.040">妈</span></p><p begin="0:57.027" end="1:02.518" itunes:key="L9" ttm:agent="v1"><span begin="0:57.027" end="0:57.846">Oh 我</span><span begin="0:57.846" end="0:58.455">说</span><span begin="0:58.455" end="0:58.765">的</span><span begin="0:58.765" end="1:00.454">话 你甘会</span><span begin="1:00.454" end="1:02.518">听？</span></p><p begin="1:03.970" end="1:08.021" itunes:key="L10" ttm:agent="v1"><span begin="1:03.970" end="1:04.384">不</span><span begin="1:04.384" end="1:04.707">要</span><span begin="1:04.707" end="1:05.109">再</span><span begin="1:05.109" end="1:05.312">这</span><span begin="1:05.312" end="1:05.513">样</span><span begin="1:05.513" end="1:05.965">打</span><span begin="1:05.965" end="1:06.328">我</span><span begin="1:06.328" end="1:06.742">妈</span><span begin="1:06.742" end="1:08.021">妈</span></p><p begin="1:09.706" end="1:15.902" itunes:key="L11" ttm:agent="v1"><span begin="1:09.706" end="1:10.264">Oh</span> <span begin="1:10.264" end="1:11.076">难道</span><span begin="1:11.076" end="1:11.335">你</span><span begin="1:11.335" end="1:12.233">手 不</span><span begin="1:12.233" end="1:12.995">会痛</span><span begin="1:12.995" end="1:15.902">吗？</span></p><p begin="1:16.720" end="1:20.454" itunes:key="L12" ttm:agent="v2000"><span begin="1:16.720" end="1:18.251">不要再这样</span><span begin="1:18.251" end="1:18.962">打我</span><span begin="1:18.962" end="1:19.367">妈</span><span begin="1:19.367" end="1:20.454">妈</span></p><p begin="1:19.766" end="1:23.016" itunes:key="L13" ttm:agent="v2000"><span begin="1:19.766" end="1:20.170">不</span><span begin="1:20.170" end="1:20.588">要</span><span begin="1:20.588" end="1:21.803">再这样打</span><span begin="1:21.803" end="1:22.203">我</span><span begin="1:22.203" end="1:22.505">妈</span><span begin="1:22.505" end="1:23.016">妈</span></p><p begin="1:23.026" end="1:27.169" itunes:key="L14" ttm:agent="v2000"><span begin="1:23.026" end="1:23.964">难道你</span><span begin="1:23.964" end="1:24.512">手</span> <span begin="1:24.512" end="1:24.843">不</span><span begin="1:24.843" end="1:25.336">会</span><span begin="1:25.336" end="1:25.822">痛</span><span begin="1:25.822" end="1:27.169">吗?</span></p><p begin="1:25.976" end="1:29.308" itunes:key="L15" ttm:agent="v2000"><span begin="1:25.976" end="1:26.844">难道</span><span begin="1:26.844" end="1:27.065">你</span><span begin="1:27.065" end="1:27.626">手</span> <span begin="1:27.626" end="1:27.955">不</span><span begin="1:27.955" end="1:29.308">会痛吗?</span></p><p begin="1:29.304" end="1:32.496" itunes:key="L16" ttm:agent="v1"><span begin="1:29.304" end="1:29.593">12</span><span begin="1:29.593" end="1:29.995">34</span><span begin="1:29.995" end="1:30.245">56</span><span begin="1:30.245" end="1:30.540">7</span><span begin="1:30.540" end="1:30.942">8</span> <span begin="1:30.942" end="1:31.153">12</span><span begin="1:31.153" end="1:32.496">345678</span></p><p begin="1:29.306" end="1:33.537" itunes:key="L17" ttm:agent="v2000"><span begin="1:29.306" end="1:30.809">不要再这样</span><span begin="1:30.809" end="1:31.714">打我</span><span begin="1:31.714" end="1:32.015">妈</span><span begin="1:32.015" end="1:33.537">妈</span></p><p begin="1:32.634" end="1:36.266" itunes:key="L18" ttm:agent="v1"><span begin="1:32.634" end="1:33.065">我叫你</span><span begin="1:33.065" end="1:33.725">爸</span> <span begin="1:33.725" end="1:33.894">你</span><span begin="1:33.894" end="1:34.175">打</span><span begin="1:34.175" end="1:34.285">我</span><span begin="1:34.285" end="1:34.786">妈</span> <span begin="1:34.916" end="1:35.154">这样</span><span begin="1:35.154" end="1:35.415">对吗</span> <span begin="1:35.415" end="1:35.715">干嘛</span><span begin="1:35.715" end="1:36.135">这</span><span begin="1:36.135" end="1:36.266">样</span></p><p begin="1:35.628" end="1:40.157" itunes:key="L19" ttm:agent="v2000"><span begin="1:35.628" end="1:37.945">我说的话 你甘</span><span begin="1:37.945" end="1:38.238">会</span><span begin="1:38.238" end="1:40.157">听？</span></p><p begin="1:36.523" end="1:38.064" itunes:key="L20" ttm:agent="v1"><span begin="1:36.523" end="1:36.848">何</span><span begin="1:36.848" end="1:37.948">必让酒牵鼻子</span><span begin="1:37.948" end="1:38.064">走</span></p><p begin="1:38.079" end="1:40.131" itunes:key="L21" ttm:agent="v1"><span begin="1:38.079" end="1:38.612">瞎</span> <span begin="1:38.612" end="1:39.094">说都说</span><span begin="1:39.094" end="1:39.354">不</span><span begin="1:39.354" end="1:39.963">听</span> <span begin="1:39.963" end="1:40.131">听</span></p><p begin="1:40.250" end="1:41.760" itunes:key="L22" ttm:agent="v1"><span begin="1:40.250" end="1:40.359">痛</span><span begin="1:40.469" end="1:40.698">是</span><span begin="1:40.698" end="1:41.078">我们在</span><span begin="1:41.078" end="1:41.760">痛</span></p><p begin="1:41.847" end="1:47.841" itunes:key="L23" ttm:agent="v1000"><span begin="1:41.847" end="1:42.664">不要</span><span begin="1:42.664" end="1:43.080">再</span><span begin="1:43.080" end="1:43.473">这样</span><span begin="1:43.473" end="1:43.889">打</span><span begin="1:43.889" end="1:44.294">我</span><span begin="1:44.294" end="1:44.607">妈</span><span begin="1:44.607" end="1:47.841">妈</span></p></div></body></tt>