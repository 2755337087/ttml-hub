<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>姚若龙</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="慢冷 (Live)"/>
<amll:meta key="artists" value="李荣浩"/>
<amll:meta key="album" value="2022中国好声音 第1期 (Live)"/>
<amll:meta key="appleMusicId" value="1652705352"/></metadata></head><body dur="2:44.321"><div begin="11.109" end="29.099" itunes:songPart="Verse"><p begin="11.109" end="13.672" itunes:key="L1" ttm:agent="v1"><span begin="11.109" end="12.129">说</span><span begin="12.129" end="12.830">完</span><span begin="12.830" end="13.672">了</span></p><p begin="15.050" end="18.876" itunes:key="L2" ttm:agent="v1"><span begin="15.050" end="16.356">好像话都</span><span begin="16.356" end="17.214">说</span><span begin="17.386" end="18.014">完</span><span begin="18.014" end="18.876">了</span></p><p begin="20.197" end="24.150" itunes:key="L3" ttm:agent="v1"><span begin="20.197" end="21.613">总是沉默</span><span begin="21.613" end="22.550">对</span><span begin="22.550" end="23.199">坐</span><span begin="23.199" end="24.150">着</span></p><p begin="25.479" end="29.099" itunes:key="L4" ttm:agent="v1"><span begin="25.479" end="26.834">眼里是浓</span><span begin="26.834" end="27.615">浓</span><span begin="27.760" end="28.042">夜</span><span begin="28.042" end="29.099">色</span></p></div><div begin="31.050" end="54.931" itunes:songPart="Verse"><p begin="31.050" end="34.605" itunes:key="L5" ttm:agent="v1"><span begin="31.050" end="32.013">感情是</span><span begin="32.013" end="33.007">偏</span><span begin="33.007" end="33.672">执</span><span begin="33.672" end="34.605">的</span></p><p begin="35.821" end="39.797" itunes:key="L6" ttm:agent="v1"><span begin="35.821" end="37.259">越爱越是</span><span begin="37.259" end="38.238">偏</span><span begin="38.238" end="38.898">执</span><span begin="38.898" end="39.797">的</span></p><p begin="41.036" end="45.019" itunes:key="L7" ttm:agent="v1"><span begin="41.036" end="42.459">不相信我</span><span begin="42.459" end="43.484">看</span><span begin="43.484" end="44.142">到</span><span begin="44.142" end="45.019">的</span></p><p begin="46.313" end="54.931" itunes:key="L8" ttm:agent="v1"><span begin="46.313" end="47.641">硬要说裂</span><span begin="47.641" end="49.239">缝</span> <span begin="49.626" end="50.005">不</span><span begin="50.005" end="50.757">过</span><span begin="51.487" end="51.917">是</span><span begin="51.917" end="52.888">皱</span><span begin="52.888" end="54.931">褶</span></p></div><div begin="56.759" end="1:18.096" itunes:songPart="Chorus"><p begin="56.759" end="1:02.051" itunes:key="L9" ttm:agent="v1"><span begin="56.759" end="57.494">怎</span><span begin="57.494" end="58.054">幺</span><span begin="58.054" end="1:00.725">先炽热的却先变冷</span><span begin="1:00.725" end="1:02.051">了</span></p><p begin="1:02.297" end="1:07.208" itunes:key="L10" ttm:agent="v1"><span begin="1:02.297" end="1:04.626">慢热的却停不了</span> <span begin="1:04.626" end="1:05.923">还在沸腾</span><span begin="1:05.923" end="1:07.208">着</span></p><p begin="1:07.493" end="1:11.774" itunes:key="L11" ttm:agent="v1"><span begin="1:07.493" end="1:09.755">看时光任性快跑</span> <span begin="1:09.755" end="1:11.122">随意就转</span><span begin="1:11.122" end="1:11.774">折</span></p><p begin="1:12.084" end="1:18.096" itunes:key="L12" ttm:agent="v1"><span begin="1:12.084" end="1:13.443">慢冷的人</span><span begin="1:13.443" end="1:14.477">啊</span> <span begin="1:14.660" end="1:15.709">会自我</span><span begin="1:15.709" end="1:16.391">折</span><span begin="1:16.391" end="1:18.096">磨</span></p></div><div begin="1:18.302" end="1:37.798" itunes:songPart="Chorus"><p begin="1:18.302" end="1:22.951" itunes:key="L13" ttm:agent="v1"><span begin="1:18.302" end="1:21.605">冲动的人向来听不见挽</span><span begin="1:21.605" end="1:22.951">留</span></p><p begin="1:23.178" end="1:28.338" itunes:key="L14" ttm:agent="v1"><span begin="1:23.178" end="1:26.826">这世界大得让你很难不旅</span><span begin="1:26.826" end="1:28.338">游</span></p><p begin="1:28.684" end="1:30.968" itunes:key="L15" ttm:agent="v1"><span begin="1:28.684" end="1:30.426">浪漫让你温</span><span begin="1:30.426" end="1:30.968">柔</span></p><p begin="1:31.305" end="1:37.798" itunes:key="L16" ttm:agent="v1"><span begin="1:31.305" end="1:33.092">也让你最惹</span><span begin="1:33.092" end="1:34.010">人</span><span begin="1:34.246" end="1:34.978">泪</span><span begin="1:34.978" end="1:37.798">流</span></p></div><div begin="1:38.536" end="1:59.552" itunes:songPart="Chorus"><p begin="1:38.536" end="1:43.848" itunes:key="L17" ttm:agent="v1"><span begin="1:38.536" end="1:39.235">怎</span><span begin="1:39.235" end="1:39.750">幺</span><span begin="1:39.750" end="1:42.488">先炽热的却先变冷</span><span begin="1:42.488" end="1:43.848">了</span></p><p begin="1:44.023" end="1:48.944" itunes:key="L18" ttm:agent="v1"><span begin="1:44.023" end="1:46.352">慢热的却停不了</span> <span begin="1:46.352" end="1:47.674">还在沸腾</span><span begin="1:47.674" end="1:48.944">着</span></p><p begin="1:49.190" end="1:53.501" itunes:key="L19" ttm:agent="v1"><span begin="1:49.190" end="1:51.532">看时光任性快跑</span> <span begin="1:51.532" end="1:52.862">随意就转</span><span begin="1:52.862" end="1:53.501">折</span></p><p begin="1:53.840" end="1:59.552" itunes:key="L20" ttm:agent="v1"><span begin="1:53.840" end="1:55.194">慢冷的人</span><span begin="1:55.194" end="1:56.126">啊</span> <span begin="1:56.401" end="1:57.429">会自我</span><span begin="1:57.429" end="1:58.101">折</span><span begin="1:58.101" end="1:59.552">磨</span></p></div><div begin="1:59.975" end="2:26.320" itunes:songPart="Chorus"><p begin="1:59.975" end="2:04.654" itunes:key="L21" ttm:agent="v1"><span begin="1:59.975" end="2:03.325">冲动的人向来听不见挽</span><span begin="2:03.325" end="2:04.654">留</span></p><p begin="2:04.916" end="2:10.016" itunes:key="L22" ttm:agent="v1"><span begin="2:04.916" end="2:08.577">这世界大得让你很难不旅</span><span begin="2:08.577" end="2:10.016">游</span></p><p begin="2:10.404" end="2:12.648" itunes:key="L23" ttm:agent="v1"><span begin="2:10.404" end="2:12.168">浪漫让你温</span><span begin="2:12.168" end="2:12.648">柔</span></p><p begin="2:13.048" end="2:26.320" itunes:key="L24" ttm:agent="v1"><span begin="2:13.048" end="2:14.857">也让你最惹</span><span begin="2:14.857" end="2:17.677">人</span><span begin="2:19.531" end="2:20.542">泪</span><span begin="2:20.542" end="2:26.320">流</span></p></div></body></tt>