<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.080"><songwriters><songwriter>Fred Irie</songwriter><songwriter>MOE.</songwriter><songwriter>艾热AIR</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="真空地带"/>
<amll:meta key="artists" value="艾热AIR"/>
<amll:meta key="artists" value="Jony J"/>
<amll:meta key="artists" value="MOE."/>
<amll:meta key="album" value="艾·思集"/>
<amll:meta key="appleMusicId" value="1863898798"/></metadata></head><body dur="4:30.627"><div begin="35.178" end="58.008" itunes:songPart="Verse"><p begin="35.178" end="38.034" itunes:key="L1" ttm:agent="v1"><span begin="35.178" end="35.909">我怀疑过</span><span begin="35.909" end="36.326">她</span> <span begin="36.326" end="37.642">就算从小环境耳濡目</span><span begin="37.642" end="38.034">染</span></p><p begin="38.052" end="40.705" itunes:key="L2" ttm:agent="v1"><span begin="38.052" end="39.702">不愿被他人的道德教条捆</span><span begin="39.702" end="39.873">绑</span> <span begin="39.873" end="40.044">而</span><span begin="40.044" end="40.587">肩扛负</span><span begin="40.587" end="40.705">担</span></p><p begin="40.705" end="43.491" itunes:key="L3" ttm:agent="v1"><span begin="40.705" end="40.900">我</span><span begin="40.900" end="41.181">想</span> <span begin="41.381" end="43.001">我讨厌周围充满严肃</span><span begin="43.001" end="43.113">的</span><span begin="43.113" end="43.301">眼</span><span begin="43.301" end="43.491">神</span></p><p begin="43.491" end="46.237" itunes:key="L4" ttm:agent="v1"><span begin="43.491" end="43.658">但</span><span begin="43.658" end="44.164">谢谢妈</span><span begin="44.164" end="44.279">妈</span> <span begin="44.279" end="44.394">你</span><span begin="44.394" end="44.595">从</span><span begin="44.595" end="44.791">没有</span><span begin="44.791" end="46.046">让我身处惶恐不</span><span begin="46.046" end="46.237">安</span></p><p begin="46.905" end="49.076" itunes:key="L5" ttm:agent="v1"><span begin="46.905" end="48.897">让我了解我们需要更先进的思</span><span begin="48.897" end="49.076">想</span></p><p begin="49.076" end="52.140" itunes:key="L6" ttm:agent="v1"><span begin="49.076" end="49.440">而不是</span><span begin="49.440" end="51.813">困在保守封建里再放任它们滋</span><span begin="51.813" end="52.140">长</span></p><p begin="52.140" end="55.034" itunes:key="L7" ttm:agent="v1"><span begin="52.140" end="52.386">阅尽</span><span begin="52.386" end="52.770">众生</span><span begin="52.770" end="53.028">象</span> <span begin="53.252" end="53.849">开始敬畏</span><span begin="53.849" end="54.191">所有的</span><span begin="54.191" end="54.695">超前试</span><span begin="54.695" end="55.034">想</span></p><p begin="55.034" end="58.008" itunes:key="L8" ttm:agent="v1"><span begin="55.034" end="56.257">就像过去人类以为</span><span begin="56.257" end="56.593">飞</span> <span begin="56.775" end="57.128">只能靠</span><span begin="57.128" end="57.429">长出</span><span begin="57.429" end="57.625">翅</span><span begin="57.625" end="58.008">膀</span></p></div><div begin="58.678" end="1:09.537" itunes:songPart="Verse"><p begin="58.678" end="1:01.268" itunes:key="L9" ttm:agent="v1"><span begin="58.678" end="59.203">你要速度</span><span begin="59.203" end="59.529">快</span> <span begin="59.701" end="59.966">但你</span><span begin="59.966" end="1:00.294">追不上</span><span begin="1:00.294" end="1:00.673">科技</span><span begin="1:00.673" end="1:00.893">产</span><span begin="1:00.893" end="1:01.268">品</span></p><p begin="1:01.470" end="1:04.110" itunes:key="L10" ttm:agent="v1"><span begin="1:01.470" end="1:01.795">你嫌</span><span begin="1:01.795" end="1:02.150">速度</span><span begin="1:02.150" end="1:02.417">慢</span> <span begin="1:02.545" end="1:03.337">回忆你成长过</span><span begin="1:03.337" end="1:03.543">程的</span><span begin="1:03.543" end="1:03.799">场</span><span begin="1:03.799" end="1:04.110">景</span></p><p begin="1:04.457" end="1:06.762" itunes:key="L11" ttm:agent="v1"><span begin="1:04.457" end="1:05.260">几十年的记录</span><span begin="1:05.260" end="1:06.636">就几张照片是唯一的奖</span><span begin="1:06.636" end="1:06.762">品</span></p><p begin="1:06.762" end="1:09.537" itunes:key="L12" ttm:agent="v1"><span begin="1:06.762" end="1:06.966">快</span><span begin="1:06.966" end="1:07.262">看</span> <span begin="1:07.551" end="1:08.308">又有一颗流星</span><span begin="1:08.308" end="1:08.952">刚刚划过</span><span begin="1:08.952" end="1:09.236">房</span><span begin="1:09.236" end="1:09.537">顶</span></p></div><div begin="1:09.913" end="1:21.408" itunes:songPart="Verse"><p begin="1:09.913" end="1:12.606" itunes:key="L13" ttm:agent="v1"><span begin="1:09.913" end="1:10.130">我</span><span begin="1:10.130" end="1:10.841">确定了每个人</span><span begin="1:10.841" end="1:12.022">都有信仰其实都</span><span begin="1:12.022" end="1:12.234">叫</span><span begin="1:12.234" end="1:12.606">爱</span></p><p begin="1:12.805" end="1:15.513" itunes:key="L14" ttm:agent="v1"><span begin="1:12.805" end="1:13.665">超自然感觉</span><span begin="1:13.665" end="1:15.128">像有魔法带着兜帽</span> <span begin="1:15.128" end="1:15.513">但</span></p><p begin="1:15.693" end="1:18.357" itunes:key="L15" ttm:agent="v1"><span begin="1:15.693" end="1:15.891">也</span><span begin="1:15.891" end="1:16.099">只有</span><span begin="1:16.099" end="1:17.210">时间才够资历</span><span begin="1:17.210" end="1:17.992">让你受教</span> <span begin="1:17.992" end="1:18.357">但</span></p><p begin="1:18.733" end="1:21.408" itunes:key="L16" ttm:agent="v1"><span begin="1:18.733" end="1:19.765">在我心里只有</span><span begin="1:19.765" end="1:20.031">家</span><span begin="1:20.031" end="1:20.956">才该叫修道</span><span begin="1:20.956" end="1:21.408">院</span></p></div><div begin="1:21.792" end="1:32.535" itunes:songPart="Verse"><p begin="1:21.792" end="1:23.883" itunes:key="L17" ttm:agent="v1"><span begin="1:21.792" end="1:22.029">如果</span><span begin="1:22.029" end="1:22.271">文</span><span begin="1:22.271" end="1:22.536">字</span><span begin="1:22.536" end="1:23.034">可以概括</span><span begin="1:23.034" end="1:23.222">这个</span><span begin="1:23.222" end="1:23.428">世</span><span begin="1:23.428" end="1:23.883">界</span></p><p begin="1:23.981" end="1:26.861" itunes:key="L18" ttm:agent="v1"><span begin="1:23.981" end="1:24.236">那麼</span><span begin="1:24.236" end="1:24.436">出</span><span begin="1:24.436" end="1:24.720">生</span> <span begin="1:24.909" end="1:25.280">经历</span> <span begin="1:25.280" end="1:25.650">死去</span><span begin="1:25.650" end="1:26.520">三个词就足</span><span begin="1:26.520" end="1:26.861">够</span></p><p begin="1:27.342" end="1:29.636" itunes:key="L19" ttm:agent="v1"><span begin="1:27.342" end="1:27.506">我</span><span begin="1:27.506" end="1:27.706">爱</span><span begin="1:27.706" end="1:28.513">这过程中的</span><span begin="1:28.513" end="1:29.243">真善美与</span><span begin="1:29.243" end="1:29.403">污</span><span begin="1:29.403" end="1:29.636">垢</span></p><p begin="1:29.636" end="1:32.535" itunes:key="L20" ttm:agent="v1"><span begin="1:29.636" end="1:29.985">当了段</span><span begin="1:29.985" end="1:30.836">素食主义者</span><span begin="1:30.836" end="1:32.052">又忽然释然开始</span><span begin="1:32.052" end="1:32.263">吃</span><span begin="1:32.263" end="1:32.535">肉</span></p></div><div begin="1:33.158" end="1:44.301" itunes:songPart="Verse"><p begin="1:33.158" end="1:35.580" itunes:key="L21" ttm:agent="v1"><span begin="1:33.158" end="1:33.742">一直在寻</span><span begin="1:33.742" end="1:34.106">找</span><span begin="1:34.106" end="1:34.289">我的</span><span begin="1:34.289" end="1:34.835">祖源</span><span begin="1:34.835" end="1:35.033">我的</span><span begin="1:35.033" end="1:35.213">基</span><span begin="1:35.213" end="1:35.580">因</span></p><p begin="1:35.471" end="1:38.143" itunes:key="L22" ttm:agent="v1"><span begin="1:35.471" end="1:36.136">让我联想</span><span begin="1:36.136" end="1:37.392">几只蝙蝠挥翅后</span><span begin="1:37.392" end="1:38.002">震荡的逆</span><span begin="1:38.002" end="1:38.143">境</span></p><p begin="1:38.154" end="1:41.309" itunes:key="L23" ttm:agent="v1"><span begin="1:38.154" end="1:38.956">但保持信心</span><span begin="1:38.956" end="1:39.164">朋</span><span begin="1:39.164" end="1:39.397">友</span> <span begin="1:39.705" end="1:40.072">我们在</span><span begin="1:40.072" end="1:40.784">变得越来</span><span begin="1:40.784" end="1:40.966">越</span><span begin="1:40.966" end="1:41.309">好</span></p><p begin="1:41.339" end="1:44.301" itunes:key="L24" ttm:agent="v1"><span begin="1:41.339" end="1:41.783">这是当</span><span begin="1:41.783" end="1:42.058">然</span> <span begin="1:42.058" end="1:42.421">这是必</span><span begin="1:42.421" end="1:42.623">须</span> <span begin="1:42.623" end="1:42.955">站一起</span><span begin="1:42.955" end="1:43.812">让我们团结一</span><span begin="1:43.812" end="1:44.301">心</span></p></div><div begin="1:44.596" end="1:56.276" itunes:songPart="Verse"><p begin="1:44.596" end="1:47.048" itunes:key="L25" ttm:agent="v1"><span begin="1:44.596" end="1:44.968">我决</span><span begin="1:44.968" end="1:45.225">定</span><span begin="1:45.364" end="1:45.515">不</span><span begin="1:45.515" end="1:45.707">再</span><span begin="1:45.707" end="1:46.769">总是自己消化这</span><span begin="1:46.769" end="1:47.048">些</span></p><p begin="1:47.127" end="1:50.022" itunes:key="L26" ttm:agent="v1"><span begin="1:47.127" end="1:47.445">他们的</span><span begin="1:47.445" end="1:48.182">概念确实厉</span><span begin="1:48.182" end="1:48.399">害但</span><span begin="1:48.399" end="1:48.759">我也有</span><span begin="1:48.759" end="1:49.603">我自己的哲</span><span begin="1:49.603" end="1:50.022">学</span></p><p begin="1:50.303" end="1:53.285" itunes:key="L27" ttm:agent="v1"><span begin="1:50.303" end="1:51.906">比如心跳停止后的爸爸</span><span begin="1:51.906" end="1:52.302">算不算</span><span begin="1:52.302" end="1:52.727">跟世界</span><span begin="1:52.727" end="1:52.926">和</span><span begin="1:52.926" end="1:53.285">解</span></p><p begin="1:53.407" end="1:56.276" itunes:key="L28" ttm:agent="v1"><span begin="1:53.407" end="1:53.796">早晚</span><span begin="1:53.796" end="1:54.145">我会也</span><span begin="1:54.145" end="1:54.505">知足的</span><span begin="1:54.505" end="1:54.680">奔</span><span begin="1:54.680" end="1:54.780">赴</span> <span begin="1:54.780" end="1:54.880">再</span><span begin="1:54.880" end="1:55.273">庆祝那</span><span begin="1:55.273" end="1:55.622">久违的</span><span begin="1:55.622" end="1:55.860">阔</span><span begin="1:55.860" end="1:56.276">别</span></p></div><div begin="1:56.521" end="2:19.413" itunes:songPart="Verse"><p begin="1:56.521" end="1:59.277" itunes:key="L29" ttm:agent="v1"><span begin="1:56.521" end="1:57.774">就算没有敞开心扉</span> <span begin="1:57.774" end="1:58.152">(它们也</span><span begin="1:58.152" end="1:58.497">住得</span><span begin="1:58.497" end="1:58.814">进</span><span begin="1:58.814" end="1:59.277">去)</span></p><p begin="1:59.178" end="2:02.157" itunes:key="L30" ttm:agent="v1"><span begin="1:59.178" end="1:59.951">就算你关紧</span><span begin="1:59.951" end="2:00.177">门</span><span begin="2:00.177" end="2:00.558">窗</span> <span begin="2:00.619" end="2:01.044">(它们也</span><span begin="2:01.044" end="2:01.402">住得</span><span begin="2:01.402" end="2:01.756">进</span><span begin="2:01.756" end="2:02.157">去)</span></p><p begin="2:02.058" end="2:05.042" itunes:key="L31" ttm:agent="v1"><span begin="2:02.058" end="2:02.871">就算你不愿意</span><span begin="2:02.871" end="2:03.058">相</span><span begin="2:03.058" end="2:03.418">信</span> <span begin="2:03.598" end="2:03.942">(它们也</span><span begin="2:03.942" end="2:04.289">住得</span><span begin="2:04.289" end="2:04.577">进</span><span begin="2:04.577" end="2:05.042">去)</span></p><p begin="2:04.872" end="2:07.818" itunes:key="L32" ttm:agent="v1"><span begin="2:04.872" end="2:05.662">自己跟自己</span><span begin="2:05.662" end="2:05.940">抗</span><span begin="2:05.940" end="2:06.092">争</span> <span begin="2:06.092" end="2:07.215">(谁敢说没有过这样的</span><span begin="2:07.215" end="2:07.428">境</span><span begin="2:07.428" end="2:07.818">遇)</span></p><p begin="2:07.838" end="2:10.766" itunes:key="L33" ttm:agent="v1"><span begin="2:07.838" end="2:08.980">就算没有敞开</span><span begin="2:08.980" end="2:09.260">心</span><span begin="2:09.260" end="2:09.441">扉</span> <span begin="2:09.441" end="2:09.708">(它们也</span><span begin="2:09.708" end="2:10.083">住得</span><span begin="2:10.083" end="2:10.283">进</span><span begin="2:10.283" end="2:10.766">去)</span></p><p begin="2:10.838" end="2:13.686" itunes:key="L34" ttm:agent="v1"><span begin="2:10.838" end="2:11.802">就算关紧门</span><span begin="2:11.802" end="2:12.197">窗</span> <span begin="2:12.197" end="2:12.601">(它们也</span><span begin="2:12.601" end="2