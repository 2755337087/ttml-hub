<amll:meta key="album" value="慢人理论"/>
<amll:meta key="appleMusicId" value="1757660918"/></metadata></head><body dur="3:51.283"><div begin="15.055" end="29.312" itunes:songPart="Verse"><p begin="15.055" end="18.372" itunes:key="L1" ttm:agent="v1"><span begin="15.055" end="15.983">习惯了</span><span begin="15.983" end="17.194">用吻唤醒</span><span begin="17.194" end="18.372">清晨</span></p><p begin="18.864" end="22.082" itunes:key="L2" ttm:agent="v1"><span begin="18.864" end="19.804">记不得</span><span begin="19.804" end="21.016">并肩多少</span><span begin="21.016" end="22.082">黄昏</span></p><p begin="22.592" end="24.675" itunes:key="L3" ttm:agent="v1"><span begin="22.592" end="23.057">有时</span><span begin="23.057" end="23.764">候烦了</span><span begin="23.764" end="24.675">累了</span></p><p begin="24.955" end="29.312" itunes:key="L4" ttm:agent="v1"><span begin="24.955" end="25.602">聊几句</span><span begin="25.602" end="26.494">趣闻</span> <span begin="26.494" end="26.751">就</span><span begin="26.751" end="28.192">睡得</span><span begin="28.192" end="29.312">安稳</span></p></div><div begin="30.082" end="43.513" itunes:songPart="Verse"><p begin="30.082" end="33.281" itunes:key="L5" ttm:agent="v1"><span begin="30.082" end="30.888">不必总</span><span begin="30.888" end="32.233">是用表白</span><span begin="32.233" end="33.281">确认</span></p><p begin="33.880" end="37.187" itunes:key="L6" ttm:agent="v1"><span begin="33.880" end="34.762">不一定</span><span begin="34.762" end="36.013">仪式感都</span><span begin="36.013" end="37.187">满分</span></p><p begin="37.627" end="39.938" itunes:key="L7" ttm:agent="v1"><span begin="37.627" end="38.048">不是</span><span begin="38.048" end="38.769">热情</span><span begin="38.769" end="39.938">退温</span></p><p begin="40.577" end="43.513" itunes:key="L8" ttm:agent="v1"><span begin="40.577" end="41.354">是爱</span><span begin="41.354" end="42.165">得更</span><span begin="42.165" end="43.513">深</span></p></div><div begin="45.074" end="1:13.847" itunes:songPart="PreChorus"><p begin="45.074" end="51.566" itunes:key="L9" ttm:agent="v1"><span begin="45.074" end="45.578">那些</span><span begin="45.578" end="47.262">千变万化</span><span begin="47.262" end="48.410">着的</span><span begin="48.746" end="50.060">平凡日</span><span begin="50.060" end="51.566">常</span></p><p begin="52.597" end="59.181" itunes:key="L10" ttm:agent="v1"><span begin="52.597" end="53.965">都是属于</span><span begin="53.965" end="55.347">我和你的</span><span begin="55.546" end="55.912">闪</span><span begin="55.912" end="56.903">耀</span><span begin="56.903" end="57.285">宝</span><span begin="57.285" end="59.181">藏</span></p><p begin="1:00.080" end="1:07.193" itunes:key="L11" ttm:agent="v1"><span begin="1:00.080" end="1:01.719">因为彼此成</span><span begin="1:01.719" end="1:03.261">长</span> <span begin="1:03.792" end="1:05.423">互为彼此疗</span><span begin="1:05.423" end="1:07.193">伤</span></p><p begin="1:07.634" end="1:13.847" itunes:key="L12" ttm:agent="v1"><span begin="1:07.634" end="1:08.479">如果有</span><span begin="1:08.479" end="1:09.351">奇迹</span> <span begin="1:09.593" end="1:11.135">奇迹就是</span><span begin="1:11.135" end="1:11.644">这</span><span begin="1:11.644" end="1:13.847">样</span></p></div><div begin="1:14.151" end="1:29.157" itunes:songPart="Chorus"><p begin="1:14.151" end="1:17.481" itunes:key="L13" ttm:agent="v1"><span begin="1:14.151" end="1:14.583">Write</span> <span begin="1:14.583" end="1:15.098">for</span> <span begin="1:15.098" end="1:17.481">you</span></p><p begin="1:17.810" end="1:21.610" itunes:key="L14" ttm:agent="v1"><span begin="1:17.810" end="1:18.325">Sing</span> <span begin="1:18.325" end="1:18.821">for</span> <span begin="1:18.821" end="1:21.610">you</span></p><p begin="1:22.489" end="1:26.685" itunes:key="L15" ttm:agent="v1"><span begin="1:22.489" end="1:23.048">时间</span><span begin="1:23.048" end="1:24.771">无法消融</span> <span begin="1:24.878" end="1:26.685">平淡之中</span></p><p begin="1:26.792" end="1:29.157" itunes:key="L16" ttm:agent="v1"><span begin="1:26.792" end="1:28.283">无数微小的</span><span begin="1:28.283" end="1:29.157">心动</span></p></div><div begin="1:29.167" end="1:51.207" itunes:songPart="Chorus"><p begin="1:29.167" end="1:32.306" itunes:key="L17" ttm:agent="v1"><span begin="1:29.167" end="1:29.656">There</span> <span begin="1:29.656" end="1:30.028">for</span> <span begin="1:30.028" end="1:32.306">you</span></p><p begin="1:32.854" end="1:37.214" itunes:key="L18" ttm:agent="v1"><span begin="1:32.854" end="1:33.319">All</span> <span begin="1:33.319" end="1:33.865">for</span> <span begin="1:33.865" end="1:37.214">you</span></p><p begin="1:37.575" end="1:43.720" itunes:key="L19" ttm:agent="v1"><span begin="1:37.575" end="1:38.017">不用</span> <span begin="1:38.017" end="1:40.898">刻意地 复杂地 喧闹地</span> <span begin="1:40.898" end="1:41.473">证明</span><span begin="1:41.473" end="1:42.062">什</span><span begin="1:42.062" end="1:43.720">幺</span></p><p begin="1:45.051" end="1:51.207" itunes:key="L20" ttm:agent="v1"><span begin="1:45.051" end="1:45.597">我们</span> <span begin="1:45.597" end="1:48.558">默契地 简单地 安静地</span> <span begin="1:48.805" end="1:49.668">相爱</span><span begin="1:49.668" end="1:51.207">着</span></p></div><div begin="2:05.688" end="2:34.479" itunes:songPart="PreChorus"><p begin="2:05.688" end="2:12.180" itunes:key="L21" ttm:agent="v1"><span begin="2:05.688" end="2:06.192">那些</span><span begin="2:06.192" end="2:07.876">千变万化</span><span begin="2:07.876" end="2:09.024">着的</span><span begin="2:09.360" end="2:10.674">平凡日</span><span begin="2:10.674" end="2:12.180">常</span></p><p begin="2:13.212" end="2:19.796" itunes:key="L22" ttm:agent="v1"><span begin="2:13.212" end="2:14.580">都是属于</span><span begin="2:14.580" end="2:15.962">我和你的</span><span begin="2:16.131" end="2:16.489">闪</span><span begin="2:16.489" end="2:17.518">耀</span><span begin="2:17.518" end="2:18.028">宝</span><span begin="2:18.028" end="2:19.796">藏</span></p><p begin="2:20.664" end="2:27.787" itunes:key="L23" ttm:agent="v1"><span begin="2:20.664" end="2:22.323">因为彼此成</span><span begin="2:22.323" end="2:23.865">长</span> <span begin="2:24.396" end="2:26.027">互为彼此疗</span><span begin="2:26.027" end="2:27.787">伤</span></p><p begin="2:28.236" end="2:34.479" itunes:key="L24" ttm:agent="v1"><span begin="2:28.236" end="2:29.081">如果有</span><span begin="2:29.081" end="2:29.982">奇迹</span> <span begin="2:30.195" end="2:31.737">奇迹就是</span><span begin="2:31.737" end="2:32.246">这</span><span begin="2:32.246" end="2:34.479">样</span></p></div><div begin="2:34.749" end="2:49.744" itunes:songPart="Chorus"><p begin="2:34.749" end="2:38.079" itunes:key="L25" ttm:agent="v1"><span begin="2:34.749" end="2:35.181">Write</span> <span begin="2:35.181" end="2:35.696">for</span> <span begin="2:35.696" end="2:38.079">you</span></p><p begin="2:38.486" end="2:42.286" itunes:key="L26" ttm:agent="v1"><span begin="2:38.486" end="2:39.001">Sing</span> <span begin="2:39.001" end="2:39.497">for</span> <span begin="2:39.497" end="2:42.286">you</span></p><p begin="2:43.123" end="2:47.319" itunes:key="L27" ttm:agent="v1"><span begin="2:43.123" end="2:43.682">时间</span><span begin="2:43.682" end="2:45.405">无法消融</span> <span begin="2:45.512" end="2:47.319">平淡之中</span></p><p begin="2:47.437" end="2:49.744" itunes:key="L28" ttm:agent="v1"><span begin="2:47.437" end="2:48.928">无数微小的</span><span begin="2:48.928" end="2:49.744">心动</span></p></div><div begin="2:49.754" end="3:11.835" itunes:songPart="Chorus"><p begin="2:49.754" end="2:52.893" itunes:key="L29" ttm:agent="v1"><span begin="2:49.754" end="2:50.243">There</span> <span begin="2:50.243" end="2:50.615">for</span> <span begin="2:50.615" end="2:52.893">you</span></p><p begin="2:53.489" end="2:57.849" itunes:key="L30" ttm:agent="v1"><span begin="2:53.489" end="2:53.954">All</span> <span begin="2:53.954" end="2:54.500">for</span> <span begin="2:54.500" end="2:57.849">you</span></p><p begin="2:58.208" end="3:04.453" itunes:key="L31" ttm:agent="v1"><span begin="2:58.208" end="2:58.650">不用</span> <span begin="2:58.650" end="3:01.531">刻意地 复杂地 喧闹地</span> <span begin="3:01.531" end="3:02.10