<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">王力宏</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">黄明志</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>黄明志</songwriter></songwriters></iTunesMetadata><amll:meta key="artists" value="黄明志"/><amll:meta key="album" value="亚洲通车"/><amll:meta key="appleMusicId" value="1446369359"/><amll:meta key="musicName" value="飘向北方 (feat. 王力宏)"/><amll:meta key="musicName" value="飘向北方"/></metadata></head><body><div begin="0:09.723" end="0:32.045" itunes:songPart="Chorus"><p begin="0:09.723" end="0:14.680" itunes:key="L1" ttm:agent="v1"><span begin="0:09.723" end="0:10.889">飘向北</span><span begin="0:10.889" end="0:11.771">方</span> <span begin="0:12.202" end="0:13.583">别问我家</span><span begin="0:13.583" end="0:14.680">乡</span></p><p begin="0:14.967" end="0:20.185" itunes:key="L2" ttm:agent="v1"><span begin="0:14.967" end="0:15.672">高耸古</span><span begin="0:15.672" end="0:16.344">老的</span><span begin="0:16.344" end="0:17.555">城墙</span> <span begin="0:17.771" end="0:18.978">挡不住忧</span><span begin="0:18.978" end="0:20.185">伤</span></p><p begin="0:20.516" end="0:25.795" itunes:key="L3" ttm:agent="v1"><span begin="0:20.516" end="0:21.566">我飘向</span><span begin="0:21.566" end="0:21.895">北</span><span begin="0:21.895" end="0:22.821">方</span> <span begin="0:23.191" end="0:23.625">家人</span><span begin="0:23.625" end="0:24.289">是否</span><span begin="0:24.289" end="0:24.598">无</span><span begin="0:24.598" end="0:25.795">恙</span></p><p begin="0:26.049" end="0:32.045" itunes:key="L4" ttm:agent="v1"><span begin="0:26.049" end="