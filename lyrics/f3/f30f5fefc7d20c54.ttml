<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.200"><songwriters><songwriter>易家扬</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="谁来剪月光"/>
<amll:meta key="artists" value="陈奕迅"/>
<amll:meta key="album" value="C&#x27;mon in~"/>
<amll:meta key="appleMusicId" value="1440909321"/></metadata></head><body dur="3:32.000"><div begin="13.215" end="38.509" itunes:songPart="Verse"><p begin="13.215" end="18.879" itunes:key="L1" ttm:agent="v1"><span begin="13.215" end="14.809">我找不到</span><span begin="14.809" end="16.271">那个你曾</span><span begin="16.271" end="17.144">说</span><span begin="17.144" end="17.921">的远</span><span begin="17.921" end="18.879">方</span></p><p begin="19.625" end="25.274" itunes:key="L2" ttm:agent="v1"><span begin="19.625" end="21.159">也想不到</span><span begin="21.159" end="22.770">要怎么问</span><span begin="22.770" end="24.005">你别来</span><span begin="24.005" end="24.465">无</span><span begin="24.465" end="25.274">恙</span></p><p begin="25.572" end="30.890" itunes:key="L3" ttm:agent="v1"><span begin="25.572" end="26.089">世界</span><span begin="26.089" end="26.855">乱的</span><span begin="26.855" end="28.291">一塌糊涂</span><span begin="28.291" end="28.710">可</span><span begin="28.710" end="29.594">是</span><span begin="29.594" end="30.045">能怎</span><span begin="30.045" end="30.890">样</span></p><p begin="32.022" end="38.509" itunes:key="L4" ttm:agent="v1"><span begin="32.022" end="32.443">偶尔</span><span begin="32.443" end="33.937">抬起头来</span><span begin="33.937" end="35.502">还好有颗</span><span begin="35.502" end="38.509">月亮可赏</span></p></div><div begin="38.853" end="1:03.339" itunes:songPart="Verse"><p begin="38.853" end="44.512" itunes:key="L5" ttm:agent="v1"><span begin="38.853" end="40.429">太多回忆</span><span begin="40.429" end="41.997">要我怎么</span><span begin="41.997" end="43.509">摆进行李</span><span begin="43.509" end="44.512">箱</span></p><p begin="45.181" end="51.374" itunes:key="L6" ttm:agent="v1"><span begin="45.181" end="46.787">一直没哭</span> <span begin="46.787" end="48.346">一直走路</span> <span begin="48.346" end="49.975">走灰多少</span><span begin="49.975" end="50.838">太</span><span begin="50.838" end="51.374">阳</span></p><p begin="51.623" end="59.389" itunes:key="L7" ttm:agent="v1"><span begin="51.623" end="53.179">因为往事</span><span begin="53.179" end="54.793">没有办法</span><span begin="54.793" end="55.177">悬</span><span begin="55.177" end="55.698">赏</span> <span begin="55.947" end="56.400">隐形</span><span begin="56.400" end="57.890">在那大街</span><span begin="57.890" end="58.428">小</span><span begin="58.428" end="59.389">巷</span></p><p begin="59.917" end="1:03.339" itunes:key="L8" ttm:agent="v1"><span begin="59.917" end="1:00.444">剪</span><span begin="1:00.444" end="1:01.176">断了</span> <span begin="1:01.176" end="1:01.700">它</span><span begin="1:01.945" end="1:02.608">还嚣</span><span begin="1:02.608" end="1:03.339">张</span></p></div><div begin="1:03.569" end="1:29.022" itunes:songPart="Chorus"><p begin="1:03.569" end="1:09.240" itunes:key="L9" ttm:agent="v1"><span begin="1:03.569" end="1:04.423">我的嘴在</span><span begin="1:04.423" end="1:04.927">说</span><span begin="1:04.927" end="1:05.977">谎</span> <span begin="1:06.671" end="1:07.581">说的那么</span><span begin="1:07.581" end="1:08.120">漂</span><span begin="1:08.120" end="1:09.240">亮</span></p><p begin="1:09.948" end="1:16.037" itunes:key="L10" ttm:agent="v1"><span begin="1:09.948" end="1:10.837">说我早就</span><span begin="1:10.837" end="1:11.290">忘</span><span begin="1:11.290" end="1:11.863">了你</span><span begin="1:11.863" end="1:12.850">像月</span><span begin="1:12.850" end="1:13.406">一样</span><span begin="1:13.603" end="1:13.988">的</span><span begin="1:13.988" end="1:14.675">俏脸</span><span begin="1:14.675" end="1:16.037">庞</span></p><p begin="1:16.272" end="1:22.308" itunes:key="L11" ttm:agent="v1"><span begin="1:16.272" end="1:17.211">最怕一边</span><span begin="1:17.211" end="1:17.628">忙</span><span begin="1:17.628" end="1:18.217">啊忙</span> <span begin="1:18.366" end="1:18.798">一</span><span begin="1:18.798" end="1:19.205">边</span><span begin="1:19.205" end="1:19.387">回</span><span begin="1:19.387" end="1:19.968">想</span><span begin="1:19.968" end="1:20.401">那</span><span begin="1:20.401" end="1:21.190">旧时</span><span begin="1:21.190" end="1:22.308">光</span></p><p begin="1:22.833" end="1:29.022" itunes:key="L12" ttm:agent="v1"><span begin="1:22.833" end="1:23.559">剪不掉的</span><span begin="1:23.559" end="1:24.254">是</span><span begin="1:24.254" end="1:24.636">你</span> <span begin="1:24.804" end="1:25.599">带泪</span><span begin="1:25.599" end="1:25.882">的</span><span begin="1:25.882" end="1:26.386">脸</span> <span begin="1:26.386" end="1:26.799">还</span><span begin="1:26.799" end="1:27.463">真是</span><span begin="1:27.463" end="1:29.022">烦</span></p></div><div begin="1:42.818" end="2:07.469" itunes:songPart="Verse"><p begin="1:42.818" end="1:48.651" itunes:key="L13" ttm:agent="v1"><span begin="1:42.818" end="1:44.369">多少原因</span><span begin="1:44.369" end="1:46.009">将我绑在</span><span begin="1:46.009" end="1:47.517">半夜屋顶</span><span begin="1:47.517" end="1:48.651">上</span></p><p begin="1:49.198" end="1:55.417" itunes:key="L14" ttm:agent="v1"><span begin="1:49.198" end="1:50.865">一直没再</span><span begin="1:50.865" end="1:52.031">爱一个</span><span begin="1:52.031" end="1:52.408">人</span> <span begin="1:52.408" end="1:53.982">如今就是</span><span begin="1:53.982" end="1:54.850">这</span><span begin="1:54.850" end="1:55.417">样</span></p><p begin="1:55.698" end="2:03.807" itunes:key="L15" ttm:agent="v1"><span begin="1:55.698" end="1:57.206">因为故事</span><span begin="1:57.206" end="1:58.846">跟你说了</span><span begin="1:58.846" end="1:59.672">一半</span> <span begin="2:00.024" end="2:00.462">于是</span><span begin="2:00.462" end="2:02.111">搁在所谓</span><span begin="2:02.111" end="2:02.449">云</span><span begin="2:02.449" end="2:03.807">端</span></p><p begin="2:03.947" end="2:07.469" itunes:key="L16" ttm:agent="v1"><span begin="2:03.947" end="2:04.425">谁</span><span begin="2:04.425" end="2:05.130">忘不了</span><span begin="2:05.130" end="2:07.469">谁孤单</span></p></div><div begin="2:07.691" end="2:33.285" itunes:songPart="Chorus"><p begin="2:07.691" end="2:13.217" itunes:key="L17" ttm:agent="v1"><span begin="2:07.691" end="2:08.448">我的心在</span><span begin="2:08.448" end="2:08.892">说</span><span begin="2:08.892" end="2:10.103">谎</span> <span begin="2:10.652" end="2:11.607">说下去会</span><span begin="2:11.607" end="2:11.968">疯</span><span begin="2:11.968" end="2:13.217">狂</span></p><p begin="2:13.948" end="2:19.897" itunes:key="L18" ttm:agent="v1"><span begin="2:13.948" end="2:14.825">如果没有</span><span begin="2:14.825" end="2:15.398">月</span><span begin="2:15.398" end="2:15.898">亮</span> <span begin="2:16.039" end="2:16.329">那</span><span begin="2:16.329" end="2:16.821">些</span><span begin="2:16.821" end="2:17.565">日子</span><span begin="2:17.565" end="2:18.580">都无</span><span begin="2:18.580" end="2:19.897">妨</span></p><p begin="2:20.319" end="2:26.210" itunes:key="L19" ttm:agent="v1"><span begin="2:20.319" end="2:21.229">最怕一边</span><span begin="2:21.229" end="2:21.632">忙</span><span begin="2:21.632" end="2:22.376">啊忙</span> <span begin="2:22.376" end="2:22.778">一</span><span begin="2:22.778" end="2:23.803">边想</span><span begin="2:23.979" end="2:24.374">那</span><span begin="2:24.374" end="2:25.096">旧时</span><span begin="2:25.096" end="2:26.210">光</span></p><p begin="2:26.714" end="2:33.285" itunes:key="L20" ttm:agent="v1"><span begin="2:26.714" end="2:27.551">剪不掉的</span><span begin="2:27.551" end="2:28.300">是</span><span begin="2:28.300" end="2:28.756">你</span> <span begin="2:28.756" end="2:29.586">带笑</span><span begin="2:29.586" end="2:29.807">的</span><span begin="2:29.807" end="2:30.202">苦</span> <span begin="2:30.368" end="2:30.753">还</span><span begin="2:30.753" end="2:31.516">真</span><span begin="2:31.516" end="2:33.285">烦</span></p></div><div begin="2:33.295" end="2:58.675" itunes:songPart="Chorus"><p begin="2:33.295" end="2:39.135" itunes:key="L21" ttm:agent="v1"><span begin="2:33.295" end="2:33.950">我的嘴又</span><span begin="2:33.950" end="2:34.679">说了</span><span begin="2:34.679" end="2:35.967">谎</span> <span begin="2:36.215" end="2:37.188">说的那么</span><span begin="2:37.188" end="2:37.787">漂</span><span begin="2:37.787" end="2:39.135">亮</span></p><p begin="2:39.586" end="2:46.986" itunes:key="L22" ttm:agent="v1"><span begin="2:39.586" end="2:40.446">以为已经</span><span begin="2:40.446" end="2:40.816">忘</span><span begin="2:40.816" end="2:41.075">了</span><span begin="2:41.075" end="2:42.027">你的</span><span begin="2:42.027" end="2:42.702">那些</span><span begin="2:42.702" end="2:42.989">美</span> <span begin="2:43.127" end="2:43.627">像</span><span begin="2:43.627" end="2:45.199">月光它</span><span begin="2:45.199" end="2:46.392">剪不</span><span begin="2:46.392" end="2:46.986">断</span></p><p begin="2:47.163" end="2:52.491" itunes:key="L23" ttm:agent="v1"><span begin="2:47.163" end="2:47.658">因为</span><span begin="2:47.658" end="2:47.988">爱</span><span begin="2:47.988" end="2:48.398">早就</span><span begin="2:48.398" end="2:48.768">钻</span><span begin="2:48.768" end="2:49.598">进心</span><span begin="2:49.598" end="2:50.130">脏</span> <span begin="2:50.317" end="2:51.213">心一跳</span> <span begin="2:51.213" end="2:52.491">泪就会烫</span></p><p begin="2:52.501" end="2:58.675" itunes:key="L24" ttm:agent="v1"><span begin="2:52.501" end="2:53.273">那些带泪</span><span begin="2:53.273" end="2:53.854">的</span><span begin="2:53.854" end="2:54.170">脸</span> <span begin="2:54.373" end="2:55.275">带笑</span><span begin="2:55.275" end="2:55.877">的苦</span> <span begin="2:56.124" end="2:56.515">还</span><span begin="2:56.515" end="2:57.171">真</span><span begin="2:57.171" end="2:58.675">烦</span></p></div><div begin="2:59.129" end="3:20.014" itunes:songPart="Outro"><p begin="2:59.129" end="3:06.710" itunes:key="L25" ttm:agent="v1"><span begin="2:59.129" end="3:00.000">月亮是个</span><span begin="3:00.000" end="3:01.225">凶手</span> <span begin="3:01.225" end="3:02.181">想你</span><span begin="3:02.181" end="3:02.835">的我</span><span begin="3:03.079" end="3:03.650">是</span><span begin="3:03.650" end="3:04.656">通缉</span><span begin="3:04.656" end="3:06.710">犯</span></p><p begin="3:07.799" end="3:20.014" itunes:key="L26" ttm:agent="v1"><span begin="3:07.799" end="3:09.544">我有时候</span><span begin="3:09.544" end="3:11.289">真的很怕</span><span begin="3:11.289" end="3:12.145">望</span><span begin="3:12.145" end="3:13.422">见那</span><span begin="3:13.422" end="3:14.714">月光</span><span begin="3:14.714" end="3:16.530">中的</span><span begin="3:18.163" end="3:20.014">你</span></p></div></body></tt>