<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">徐佳莹</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.160"><songwriters><songwriter>葛大为</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="理想人生"/>
<amll:meta key="artists" value="徐佳莹"/>
<amll:meta key="album" value="理想人生"/>
<amll:meta key="appleMusicId" value="672968139"/></metadata></head><body dur="4:05.680"><div begin="13.206" end="38.841" itunes:songPart="Verse"><p begin="13.206" end="17.317" itunes:key="L1" ttm:agent="v1"><span begin="13.206" end="15.762">卸掉了</span><span begin="15.762" end="16.112">眼</span><span begin="16.112" end="17.317">线</span></p><p begin="19.826" end="25.758" itunes:key="L2" ttm:agent="v1"><span begin="19.826" end="23.198">暂时休息</span><span begin="23.198" end="24.337">吧</span> <span begin="24.337" end="24.854">笑</span><span begin="24.854" end="25.758">容</span></p><p begin="26.443" end="34.374" itunes:key="L3" ttm:agent="v1"><span begin="26.443" end="28.864">不合双</span><span begin="28.864" end="29.397">脚</span><span begin="29.397" end="30.841">的</span><span begin="30.841" end="31.186">鞋</span><span begin="31.186" end="33.071">子穿久了</span><span begin="33.071" end="33.511">会</span><span begin="33.511" end="33.787">痛</span><span begin="33.787" end="34.374">的</span></p><p begin="34.721" end="38.841" itunes:key="L4" ttm:agent="v1"><span begin="34.721" end="36.407">我不再勉</span><span begin="36.407" end="37.610">强</span><span begin="37.610" end="37.997">你</span><span begin="37.997" end="38.841">了</span></p></div><div begin="40.802" end="52.046" itunes:songPart="PreChorus"><p begin="40.802" end="45.357" itunes:key="L5" ttm:agent="v1"><span begin="40.802" end="41.381">想念</span><span begin="41.381" end="42.543">的老毛</span><span begin="42.543" end="43.313">病</span><span begin="43.313" end="44.133">不许</span><span begin="44.133" end="44.497">犯</span><span begin="44.497" end="45.357">了</span></p><p begin="45.804" end="52.046" itunes:key="L6" ttm:agent="v1"><span begin="45.804" end="47.821">明明说好不</span><span begin="47.821" end="48.249">再</span><span begin="48.249" end="48.613">挽</span><span begin="48.613" end="49.478">留</span> <span begin="49.478" end="50.349">竟然</span><span begin="50.349" end="51.059">舍不</span><span begin="51.059" end="52.046">得</span></p></div><div begin="53.218" end="1:16.756" itunes:songPart="Chorus"><p begin="53.218" end="59.054" itunes:key="L7" ttm:agent="v1"><span begin="53.218" end="56.065">我们有没有比从</span><span begin="56.065" end="57.265">前</span><span begin="57.265" end="57.731">快</span><span begin="57.731" end="59.054">乐</span></p><p begin="59.805" end="1:06.008" itunes:key="L8" ttm:agent="v1"><span begin="59.805" end="1:02.672">各自过着理想的</span><span begin="1:02.672" end="1:04.292">人</span><span begin="1:04.292" end="1:06.008">生</span></p><p begin="1:06.308" end="1:12.678" itunes:key="L9" ttm:agent="v1"><span begin="1:06.308" end="1:09.284">心里面其实比谁</span><span begin="1:09.284" end="1:10.041">都</span><span begin="1:10.041" end="1:10.307">清</span><span begin="1:10.307" end="1:10.978">楚</span><span begin="1:10.978" end="1:12.678">呢</span></p><p begin="1:12.939" end="1:16.756" itunes:key="L10" ttm:agent="v1"><span begin="1:12.939" end="1:14.185">没有人</span><span begin="1:14.185" end="1:14.592">比</span><span begin="1:14.592" end="1:14.829">你</span><span begin="1:14.829" end="1:15.394">更</span><span begin="1:15.394" end="1:15.821">适</span><span begin="1:15.821" end="1:16.756">合</span></p></div><div begin="1:28.854" end="1:54.718" itunes:songPart="Verse"><p begin="1:28.854" end="1:33.626" itunes:key="L11" ttm:agent="v1"><span begin="1:28.854" end="1:31.483">卸掉了</span><span begin="1:31.483" end="1:31.795">眼</span><span begin="1:31.795" end="1:33.626">线</span></p><p begin="1:35.494" end="1:41.636" itunes:key="L12" ttm:agent="v1"><span begin="1:35.494" end="1:38.866">暂时休息</span><span begin="1:38.866" end="1:40.005">吧</span> <span begin="1:40.005" end="1:40.522">笑</span><span begin="1:40.522" end="1:41.636">容</span></p><p begin="1:42.080" end="1:50.031" itunes:key="L13" ttm:agent="v1"><span begin="1:42.080" end="1:44.501">不合双</span><span begin="1:44.501" end="1:45.034">脚</span><span begin="1:45.034" end="1:46.478">的</span><span begin="1:46.478" end="1:46.823">鞋</span><span begin="1:46.823" end="1:48.708">子穿久了</span><span begin="1:48.708" end="1:49.148">会</span><span begin="1:49.148" end="1:49.424">痛</span><span begin="1:49.424" end="1:50.031">的</span></p><p begin="1:50.288" end="1:54.718" itunes:key="L14" ttm:agent="v1"><span begin="1:50.288" end="1:51.974">我不再勉</span><span begin="1:51.974" end="1:53.177">强</span><span begin="1:53.177" end="1:53.564">你</span><span begin="1:53.564" end="1:54.718">了</span></p></div><div begin="1:56.516" end="2:08.260" itunes:songPart="PreChorus"><p begin="1:56.516" end="2:01.076" itunes:key="L15" ttm:agent="v1"><span begin="1:56.516" end="1:56.966">软弱</span><span begin="1:56.966" end="1:59.775">的老毛病别又复</span><span begin="1:59.775" end="2:00.082">发</span><span begin="2:00.082" end="2:01.076">了</span></p><p begin="2:01.462" end="2:08.260" itunes:key="L16" ttm:agent="v1"><span begin="2:01.462" end="2:04.255">别被看穿我的好</span><span begin="2:04.255" end="2:05.051">强</span><span begin="2:05.051" end="2:05.936">只是</span><span begin="2:05.936" end="2:06.258">保</span><span begin="2:06.258" end="2:06.581">护</span><span begin="2:06.581" end="2:08.260">色</span></p></div><div begin="2:08.761" end="2:32.620" itunes:songPart="Chorus"><p begin="2:08.761" end="2:14.817" itunes:key="L17" ttm:agent="v1"><span begin="2:08.761" end="2:11.700">我们有没有比从</span><span begin="2:11.700" end="2:12.896">前</span><span begin="2:12.896" end="2:13.387">快</span><span begin="2:13.387" end="2:14.817">乐</span></p><p begin="2:15.378" end="2:21.671" itunes:key="L18" ttm:agent="v1"><span begin="2:15.378" end="2:18.245">各自过着理想的</span><span begin="2:18.245" end="2:19.865">人</span><span begin="2:19.865" end="2:21.671">生</span></p><p begin="2:21.954" end="2:28.340" itunes:key="L19" ttm:agent="v1"><span begin="2:21.954" end="2:24.834">被另双手心握紧</span><span begin="2:24.834" end="2:25.671">时</span><span begin="2:25.671" end="2:25.938">的</span><span begin="2:25.938" end="2:26.485">温</span><span begin="2:26.485" end="2:28.340">热</span></p><p begin="2:28.560" end="2:32.620" itunes:key="L20" ttm:agent="v1"><span begin="2:28.560" end="2:29.793">终究取</span><span begin="2:29.793" end="2:30.217">代</span><span begin="2:30.217" end="2:30.582">不</span><span begin="2:30.582" end="2:31.079">了</span><span begin="2:31.079" end="2:31.531">你</span><span begin="2:31.531" end="2:32.620">的</span></p></div><div begin="2:35.484" end="2:48.206" itunes:songPart="Bridge"><p begin="2:35.484" end="2:41.494" itunes:key="L21" ttm:agent="v1"><span begin="2:35.484" end="2:36.216">练习变</span><span begin="2:36.216" end="2:37.527">成</span><span begin="2:37.576" end="2:37.879">对</span><span begin="2:37.879" end="2:38.809">得起</span><span begin="2:38.809" end="2:39.494">自己的</span><span begin="2:39.494" end="2:39.908">模</span><span begin="2:39.908" end="2:41.494">样</span></p><p begin="2:41.629" end="2:48.206" itunes:key="L22" ttm:agent="v1"><span begin="2:41.629" end="2:41.963">是</span><span begin="2:41.963" end="2:43.508">不是太残</span><span begin="2:43.508" end="2:44.560">忍</span> <span begin="2:44.592" end="2:45.039">我</span><span begin="2:45.039" end="2:45.236">也</span><span begin="2:45.236" end="2:46.004">不晓</span><span begin="2:46.004" end="2:48.206">得</span></p></div><div begin="2:48.296" end="3:14.357" itunes:songPart="Chorus"><p begin="2:48.296" end="2:54.112" itunes:key="L23" ttm:agent="v1"><span begin="2:48.296" end="2:51.119">我们是不是比从</span><span begin="2:51.119" end="2:52.361">前</span><span begin="2:52.361" end="2:52.826">完</span><span begin="2:52.826" end="2:54.112">整</span></p><p begin="2:54.859" end="3:01.259" itunes:key="L24" ttm:agent="v1"><span begin="2:54.859" end="2:57.778">和谁过着理想的</span><span begin="2:57.778" end="2:59.339">人</span><span begin="2:59.339" end="3:01.259">生</span></p><p begin="3:01.389" end="3:07.757" itunes:key="L25" ttm:agent="v1"><span begin="3:01.389" end="3:04.385">心里面其实也偶</span><span begin="3:04.385" end="3:05.152">尔</span><span begin="3:05.152" end="3:05.473">惦</span><span begin="3:05.473" end="3:05.956">记</span><span begin="3:05.956" end="3:07.757">着</span></p><p begin="3:07.974" end="3:14.357" itunes:key="L26" ttm:agent="v1"><span begin="3:07.974" end="3:10.928">有个人让我最信</span><span begin="3:10.928" end="3:14.357">任</span></p></div><div begin="3:14.527" end="3:39.205" itunes:songPart="Chorus"><p begin="3:14.527" end="3:20.919" itunes:key="L27" ttm:agent="v1"><span begin="3:14.527" end="3:17.488">我终于抚平时间</span><span begin="3:17.488" end="3:18.667">的</span><span begin="3:18.667" end="3:19.083">刻</span><span begin="3:19.083" end="3:20.919">痕</span></p><p begin="3:21.128" end="3:27.528" itunes:key="L28" ttm:agent="v1"><span begin="3:21.128" end="3:23.991">也不再怀疑你的</span><span begin="3:23.991" end="3:25.736">选</span><span begin="3:25.736" end="3:27.528">择</span></p><p begin="3:27.685" end="3:34.210" itunes:key="L29" ttm:agent="v1"><span begin="3:27.685" end="3:28.579">我会</span><span begin="3:28.579" end="3:28.819">期</span><span begin="3:28.819" end="3:29.341">待</span><span begin="3:29.341" end="3:30.631">幸福 不</span><span begin="3:30.631" end="3:32.272">在乎</span><span begin="3:32.272" end="3:33.101">那会有</span><span begin="3:33.101" end="3:33.755">多曲</span><span begin="3:33.755" end="3:34.210">折</span></p><p begin="3:34.340" end="3:39.205" itunes:key="L30" ttm:agent="v1"><span begin="3:34.340" end="3:35.153">一想</span><span begin="3:35.153" end="3:35.480">到</span><span begin="3:35.480" end="3:35.967">你</span> <span begin="3:35.967" end="3:36.393">还</span><span begin="3:36.393" end="3:37.179">是</span><span begin="3:37.179" end="3:37.626">暖</span><span begin="3:37.626" end="3:39.205">的</span></p></div><div begin="3:41.323" end="3:48.159" itunes:songPart="Outro"><p begin="3:41.323" end="3:48.159" itunes:key="L31" ttm:agent="v1"><span begin="3:41.323" end="3:42.001">一想到</span><span begin="3:42.001" end="3:42.780">你</span> <span begin="3:42.780" end="3:43.275">还</span><span begin="3:43.275" end="3:44.520">是</span><span begin="3:44.917" end="3:45.860">暖</span><span begin="3:45.860" end="3:48.159">的</span></p></div></body></tt>