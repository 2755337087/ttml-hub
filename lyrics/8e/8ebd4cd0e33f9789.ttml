<amll:meta key="artists" value="杨乃文"/>
<amll:meta key="album" value="应该"/>
<amll:meta key="appleMusicId" value="157521229"/></metadata></head><body dur="4:22.467"><div begin="15.179" end="49.239" itunes:songPart="Verse"><p begin="15.179" end="23.080" itunes:key="L1" ttm:agent="v1"><span begin="15.179" end="15.939">满天</span><span begin="15.939" end="16.743">星星</span><span begin="16.743" end="17.235">在</span><span begin="17.235" end="18.397">眨眼</span> <span begin="19.032" end="19.563">他</span><span begin="19.563" end="20.301">陪在</span><span begin="20.301" end="20.975">我身</span><span begin="20.975" end="23.080">边</span></p><p begin="26.545" end="34.295" itunes:key="L2" ttm:agent="v1"><span begin="26.545" end="28.162">轻声细语</span><span begin="28.162" end="29.036">温柔</span><span begin="29.036" end="30.245">的眼</span> <span begin="30.903" end="31.712">看着</span><span begin="31.712" end="32.402">我的</span><span begin="32.402" end="34.295">脸</span></p><p begin="38.098" end="45.154" itunes:key="L3" ttm:agent="v1"><span begin="38.098" end="38.890">一枚</span><span begin="38.890" end="39.599">戒指</span><span begin="39.599" end="40.363">在我</span><span begin="40.363" end="41.256">眼前</span> <span begin="42.126" end="43.138">是他的</span><span begin="43.138" end="43.499">诺</span><span begin="43.499" end="45.154">言</span></p><p begin="45.272" end="49.239" itunes:key="L4" ttm:agent="v1"><span begin="45.272" end="45.797">爱</span><span begin="45.797" end="46.549">我</span><span begin="46.549" end="46.958">永</span><span begin="46.958" end="49.239">远</span></p></div><div begin="54.377" end="1:28.444" itunes:songPart="Verse"><p begin="54.377" end="1:02.696" itunes:key="L5" ttm:agent="v1"><span begin="54.377" end="55.834">山顶上的</span><span begin="55.834" end="57.705">微风吹</span> <span begin="58.303" end="59.368">心跟着</span><span begin="59.368" end="1:00.152">四处</span><span begin="1:00.152" end="1:02.696">飞</span></p><p begin="1:05.798" end="1:13.740" itunes:key="L6" ttm:agent="v1"><span begin="1:05.798" end="1:06.511">为了</span><span begin="1:06.511" end="1:07.313">什么</span><span begin="1:07.313" end="1:07.922">掉</span><span begin="1:07.922" end="1:09.038">眼泪</span> <span begin="1:10.130" end="1:11.008">夜色</span><span begin="1:11.152" end="1:11.792">那么</span><span begin="1:11.792" end="1:13.740">美</span></p><p begin="1:17.223" end="1:24.609" itunes:key="L7" ttm:agent="v1"><span begin="1:17.223" end="1:18.700">一段回忆</span><span begin="1:18.700" end="1:20.273">翻箱倒柜</span> <span begin="1:21.477" end="1:22.315">跟着</span><span begin="1:22.315" end="1:22.948">我在</span><span begin="1:22.948" end="1:24.609">追</span></p><p begin="1:24.625" end="1:28.444" itunes:key="L8" ttm:agent="v1"><span begin="1:24.625" end="1:25.174">想</span><span begin="1:25.174" end="1:25.790">的</span><span begin="1:25.790" end="1:26.264">是</span><span begin="1:26.264" end="1:28.444">谁</span></p></div><div begin="1:31.070" end="1:53.831" itunes:songPart="Chorus"><p begin="1:31.070" end="1:36.549" itunes:key="L9" ttm:agent="v1"><span begin="1:31.070" end="1:32.660">我很幸福</span> <span begin="1:33.735" end="1:34.272">真</span><span begin="1:34.272" end="1:34.649">的</span><span begin="1:34.649" end="1:35.131">幸</span><span begin="1:35.131" end="1:36.549">福</span></p><p begin="1:37.325" end="1:42.059" itunes:key="L10" ttm:agent="v1"><span begin="1:37.325" end="1:38.358">却渴望</span><span begin="1:38.358" end="1:39.219">得到</span><span begin="1:39.219" end="1:40.165">你的</span><span begin="1:40.219" end="1:40.617">祝</span><span begin="1:40.617" end="1:42.059">福</span></p><p begin="1:42.658" end="1:48.348" itunes:key="L11" ttm:agent="v1"><span begin="1:42.658" end="1:44.454">从今以后</span> <span begin="1:45.242" end="1:46.063">牵他</span><span begin="1:46.195" end="1:46.636">的</span><span begin="1:46.636" end="1:48.348">手</span></p><p begin="1:49.024" end="1:53.831" itunes:key="L12" ttm:agent="v1"><span begin="1:49.024" end="1:49.620">心</span> <span begin="1:50.542" end="1:51.689">为何</span><span begin="1:51.689" end="1:52.181">逗</span><span begin="1:52.181" end="1:53.831">留</span></p></div><