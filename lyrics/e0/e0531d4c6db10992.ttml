<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">周杰伦</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>古小力</songwriter><songwriter>黄凌嘉</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="花海"/><amll:meta key="artists" value="周杰伦"/><amll:meta key="album" value="魔杰座"/><amll:meta key="qqMusicId" value="003cI52o4daJJL"/><amll:meta key="appleMusicId" value="1721460703"/></metadata></head><body><div begin="0:26.763" end="1:16.596" itunes:songPart="Verse"><p begin="0:26.763" end="0:32.534" itunes:key="L1" ttm:agent="v1"><span begin="0:26.763" end="0:27.467">静止</span><span begin="0:27.467" end="0:28.476">了</span> <span begin="0:29.150" end="0:30.464">所有的</span><span begin="0:30.464" end="0:31.283">花</span><span begin="0:31.283" end="0:32.534">开</span></p><p begin="0:33.238" end="0:38.652" itunes:key="L2" ttm:agent="v1"><span begin="0:33.238" end="0:33.804">遥远</span><span begin="0:33.804" end="0:34.860">了</span> <span begin="0:35.537" end="0:36.969">清晰了</span><span begin="0:36.969" end="0:38.652">爱</span></p><p begin="0:39.490" end="0:45.441" itunes:key="L3" ttm:agent="v1"><span begin="0:39.490" end="0:40.214">天郁</span><span begin="0:40.214" end="0:41.324">闷</span> <span begin="0:42.018" end="0:43.127">爱却很</span><span begin="0:43.127" end="0:44.011">喜</span><span begin="0:44.011" end="0:45.441">欢</span></p><p begin="0:45.923" end="0:51.613" itunes:key="L4" ttm:agent="v1"><span begin="0:45.923" end="0:47.437">那时候</span><span begin="0:47.621" end="0:49.006">我不懂</span><span begin="0:49.237" end="0:49.863">这叫</span><span begin="0:49.863" end="0:51.613">爱</span></p><p begin="0:52.436" end="0:58.227" itunes:key="L5" ttm:agent="v1"><span begin="0:52.436" end="0:53.048">你喜</span><span begin="0:53.048" end="0:54.322">欢</span> <span begin="0:54.773" end="0:55.911">站在那</span><span begin="0:55.911" end="0:56.811">窗</span><span begin="0:56.811" end="0:58.227">台</span></p><p begin="0:58.750" end="1:04.284" itunes:key="L6" ttm:agent="v1"><span begin="0:58.750" end="0:59.421">你好</span><span begin="0:59.421" end="1:00.912">久</span> <span begin="1:01.201" end="1:02.475">都没再</span><span begin="1:02.475" end="1:04.284">来</span></p><p begin="1:05.175" end="1:11.656" itunes:key="L7" ttm:agent="v1"><span begin="1:05.175" end="1:05.898">彩色</span><span begin="1:05.898" end="1:07.107">的</span> <span begin="1:07.485" end="1:08.782">时间染</span><span begin="1:08.782" end="1:09.544">上</span><span begin="1:09.544" end="1:10.542">空</span><span begin="1:10.542" end="1:11.656">白</span></p><p begin="1:12.240" end="1:16.596" itunes:key="L8" ttm:agent="v1"><span begin="1:12.240" end="1:13.956">是你流的</span><span begin="1:13.956" end="1:14.781">泪</span><span begin="1:14.781" end="1:15.220">晕</span><span begin="1:15.220" end="1:16.596">开</span></p></div><div begin="1:17.182" end="2:10.642" itunes:songPart="Chorus"><p begin="1:17.182" end="1:23.296" itunes:key="L9" ttm:agent="v1"><span begin="1:17.182" end="1:18.651">不要你离</span><span begin="1:18.651" end="1:20.186">开</span> <span begin="1:20.377" end="1:21.840">距离隔不</span><span begin="1:21.840" end="1:23.296">开</span></p><p begin="1:23.564" end="1:29.572" itunes:key="L10" ttm:agent="v1"><span begin="1:23.564" end="1:25.121">思念变成</span><span begin="1:25.121" end="1:26.355">海</span> <span begin="1:26.355" end="1:27.638">在窗外</span><span begin="1:27.638" end="1:28.257">进不</span><span begin="1:28.257" end="1:29.572">来</span></p><p begin="1:29.991" end="1:35.987" itunes:key="L11" ttm:agent="v1"><span begin="1:29.991" end="1:31.490">原谅说太</span><span begin="1:31.490" end="1:32.858">快</span> <span begin="1:33.190" end="1:34.697">爱成了阻</span><span begin="1:34.697" end="1:35.987">碍</span></p><p begin="1:36.293" end="1:42.501" itunes:key="L12" ttm:agent="v1"><span begin="1:36.293" end="1:38.356">手中的风筝</span><span begin="1:38.356" end="1:39.598">放太快</span> <span begin="1:39.598" end="1:40.493">回</span><span begin="1:40.493" end="1:40.887">不</span><span begin="1:40.887" end="1:42.501">来</span></p><p begin="1:42.822" end="1:48.781" itunes:key="L13" ttm:agent="v1"><span begin="1:42.822" end="1:44.297">不要你离</span><span begin="1:44.297" end="1:45.703">开</span> <span begin="1:45.956" end="1:47.431">回忆划不</span><span begin="1:47.431" end="1:48.781">开</span></p><p begin="1:49.138" end="1:55.137" itunes:key="L14" ttm:agent="v1"><span begin="1:49.138" end="1:50.773">欠你的宠</span><span begin="1:50.773" end="1:51.956">爱</span> <span begin="1:51.956" end="1:53.644">我在等待</span><span begin="1:53.644" end="1:53.884">重</span><span begin="1:53.884" end="1:55.137">来</span></p><p begin="1:55.621" end="2:01.625" itunes:key="L15" ttm:agent="v1"><span begin="1:55.621" end="1:56.996">天空仍灿</span><span begin="1:56.996" end="1:58.539">烂</span> <span begin="1:58.764" end="2:00.340">它爱着大</span><span begin="2:00.340" end="2:01.625">海</span></p><p begin="2:01.979" end="2:10.642" itunes:key="L16" ttm:agent="v1"><span begin="2:01.979" end="2:03.487">情歌被打</span><span begin="2:03.487" end="2:04.792">败</span> <span begin="2:05.268" end="2:06.832">爱已不存</span><span begin="2:06.832" end="2:10.642">在</span></p></div><div begin="2:34.803" end="2:59.006" itunes:songPart="Verse"><p begin="2:34.803" end="2:40.405" itunes:key="L17" ttm:agent="v1"><span begin="2:34.803" end="2:35.409">你喜</span><span begin="2:35.409" end="2:36.641">欢</span> <span begin="2:37.066" end="2:38.326">站在那</span><span begin="2:38.326" end="2:39.198">窗</span><span begin="2:39.198" end="2:40.405">台</span></p><p begin="2:41.154" end="2:46.434" itunes:key="L18" ttm:agent="v1"><span begin="2:41.154" end="2:41.766">你好</span><span begin="2:41.766" end="2:43.127">久</