<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.500"><songwriters><songwriter>张简君伟</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="我想你了"/>
<amll:meta key="artists" value="周深"/>
<amll:meta key="album" value="小深情 - EP"/>
<amll:meta key="album" value="小深情"/>
<amll:meta key="appleMusicId" value="1837395767"/></metadata></head><body dur="2:56.435"><div begin="12.601" end="30.539" itunes:songPart="Verse"><p begin="12.601" end="17.617" itunes:key="L1" ttm:agent="v1"><span begin="12.601" end="16.504">几年过去了为什麼我还是</span><span begin="16.504" end="16.859">一</span><span begin="16.859" end="17.617">样</span></p><p begin="18.221" end="21.055" itunes:key="L2" ttm:agent="v1"><span begin="18.221" end="20.268">夜深了没人说</span><span begin="20.268" end="21.055">话</span></p><p begin="22.071" end="24.186" itunes:key="L3" ttm:agent="v1"><span begin="22.071" end="22.706">日子</span><span begin="22.706" end="24.186">匆忙</span></p><p begin="27.304" end="30.539" itunes:key="L4" ttm:agent="v1"><span begin="27.304" end="28.758">没空间悲</span><span begin="28.758" end="30.539">伤</span></p></div><div begin="34.935" end="55.939" itunes:songPart="Verse"><p begin="34.935" end="39.910" itunes:key="L5" ttm:agent="v1"><span begin="34.935" end="38.783">在这个不停歇的城市里面</span><span begin="38.783" end="39.165">闯</span><span begin="39.165" end="39.910">荡</span></p><p begin="40.595" end="43.718" itunes:key="L6" ttm:agent="v1"><span begin="40.595" end="42.628">我开始学会遗</span><span begin="42.628" end="43.718">忘</span></p><p begin="44.398" end="49.101" itunes:key="L7" ttm:agent="v1"><span begin="44.398" end="45.420">关于爱</span><span begin="45.420" end="46.161">情</span><span begin="46.161" end="48.325">渐渐地被边缘</span><span begin="48.325" end="49.101">化</span></p><p begin="49.979" end="55.939" itunes:key="L8" ttm:agent="v1"><span begin="49.979" end="50.979">关于幸</span><span begin="50.979" end="51.678">福</span><span begin="51.678" end="53.897">甚至都不敢想</span><span begin="53.897" end="55.939">象</span></p></div><div begin="58.736" end="1:20.499" itunes:songPart="Chorus"><p begin="58.736" end="1:04.109" itunes:key="L9" ttm:agent="v1"><span begin="58.736" end="59.718">当时的</span><span begin="59.718" end="1:01.118">我们</span><span begin="1:01.118" end="1:02.339">太轻狂</span> <span begin="1:02.469" end="1:04.109">说放就放</span></p><p begin="1:04.275" end="1:09.659" itunes:key="L10" ttm:agent="v1"><span begin="1:04.275" end="1:05.292">后来的</span><span begin="1:05.292" end="1:06.539">我们</span><span begin="1:06.557" end="1:07.957">跌跌撞撞</span> <span begin="1:08.024" end="1:09.659">受了点伤</span></p><p begin="1:09.880" end="1:15.719" itunes:key="L11" ttm:agent="v1"><span begin="1:09.880" end="1:10.843">你的脸</span><span begin="1:10.843" end="1:12.100">庞</span><span begin="1:12.120" end="1:13.727">是最温柔的</span><span begin="1:13.727" end="1:15.719">阳光</span></p><p begin="1:16.137" end="1:20.499" itunes:key="L12" ttm:agent="v1"><span begin="1:16.137" end="1:19.216">可惜了爱在不对的时间</span><span begin="1:19.216" end="1:20.499">上</span></p></div><div begin="1:21.017" end="1:47.299" itunes:songPart="Chorus"><p begin="1:21.017" end="1:26.399" itunes:key="L13" ttm:agent="v1"><span begin="1:21.017" end="1:22.058">当时的</span><span begin="1:22.058" end="1:23.321">我们</span><span begin="1:23.411" end="1:24.672">太潇洒</span> <span begin="1:24.813" end="1:26.399">故作坚强</span></p><p begin="1:26.597" end="1:31.983" itunes:key="L14" ttm:agent="v1"><span begin="1:26.597" end="1:27.606">后来的</span><span begin="1:27.606" end="1:28.843">我们</span><span begin="1:28.896" end="1:30.283">回不去了</span> <span begin="1:30.283" end="1:31.983">天真的模样</span></p><p begin="1:32.219" end="1:37.642" itunes:key="L15" ttm:agent="v1"><span begin="1:32.219" end="1:33.251">人来人</span><span begin="1:33.251" end="1:34.235">往</span> <span begin="1:34.397" end="1:35.914">有几个留在</span><span begin="1:35.914" end="1:36.997">心</span><span begin="1:36.997" end="1:37.642">上</span></p><p begin="1:37.777" end="1:42.927" itunes:key="L16" ttm:agent="v1"><span begin="1:37.777" end="1:38.404">天色</span><span begin="1:38.404" end="1:40.102">暗了</span> <span begin="1:40.452" end="1:41.125">寂寞</span><span begin="1:41.125" end="1:42.927">醒了</span></p><p begin="1:43.434" end="1:47.299" itunes:key="L17" ttm:agent="v1"><span begin="1:43.434" end="1:44.836">我想你</span><span begin="1:44.836" end="1:47.299">了</span></p></div><div begin="2:05.693" end="2:30.726" itunes:songPart="Chorus"><p begin="2:05.693" end="2:11.075" itunes:key="L18" ttm:agent="v1"><span begin="2:05.693" end="2:06.734">当时的</span><span begin="2:06.734" end="2:07.997">我们</span><span begin="2:08.087" end="2:09.348">太潇洒</span> <span begin="2:09.489" end="2:11.075">故作坚强</span></p><p begin="2:11.258" end="2:16.684" itunes:key="L19" ttm:agent="v1"><span begin="2:11.258" end="2:12.267">后来的</span><span begin="2:12.267" end="2:13.504">我们</span><span begin="2:13.557" end="2:14.944">回不去了</span> <span begin="2:14.944" end="2:16.684">天真的模样</span></p><p begin="2:16.838" end="2:22.261" itunes:key="L20" ttm:agent="v1"><span begin="2:16.838" end="2:17.862">人来人</span><span begin="2:17.862" end="2:19.064">往</span> <span begin="2:19.064" end="2:20.589">有几个留在</span><span begin="2:20.589" end="2:21.616">心</span><span begin="2:21.616" end="2:22.261">上</span></p><p begin="2:22.405" end="2:27.755" itunes:key="L21" ttm:agent="v1"><span begin="2:22.405" end="2:23.032">天色</span><span begin="2:23.032" end="2:24.845">暗了</span> <span begin="2:25.080" end="2:25.753">寂寞</span><span begin="2:25.753" end="2:27.755">醒了</span></p><p begin="2:27.938" end="2:30.726" itunes:key="L22" ttm:agent="v1"><span begin="2:27.938" end="2:28.724">我想</span><span begin="2:28.724" end="2:30.726">你了</span></p></div><div begin="2:33.556" end="2:42.676" itunes:songPart="Outro"><p begin="2:33.556" end="2:36.332" itunes:key="L23" ttm:agent="v1"><span begin="2:33.556" end="2:35.072">我想你</span><span begin="2:35.072" end="2:36.332">了</span></p><p begin="2:39.358" end="2:42.676" itunes:key="L24" ttm:agent="v1"><span begin="2:39.358" end="2:41.076">我想你</span><span begin="2:41.076" end="2:42.676">了</span></p></div></body></tt>