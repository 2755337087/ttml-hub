972" end="0:59.313">质</span></p><p begin="1:00.581" end="1:03.542" itunes:key="L10" ttm:agent="v1"><span begin="1:00.581" end="1:01.570">没空再去</span><span begin="1:01.570" end="1:01.700">对</span><span begin="1:01.700" end="1:02.191">谁</span><span begin="1:02.191" end="1:02.469">解</span><span begin="1:02.469" end="1:03.542">释</span></p><p begin="1:04.149" end="1:07.254" itunes:key="L11" ttm:agent="v1"><span begin="1:04.149" end="1:04.748">是我</span><span begin="1:04.748" end="1:05.378">自己把</span><span begin="1:05.378" end="1:06.268">自己</span><span begin="1:06.268" end="1:06.587">挟</span><span begin="1:06.587" end="1:07.254">持</span></p><p begin="1:07.254" end="1:12.698" itunes:key="L12" ttm:agent="v1"><span begin="1:07.254" end="1:09.976">不关他</span><span begin="1:09.976" end="1:10.456">的</span><span begin="1:10.456" end="1:12.698">事</span></p></div><div begin="1:13.299" end="1:41.691" itunes:songPart="Chorus"><p begin="1:13.299" end="1:15.770" itunes:key="L13" ttm:agent="v1"><span begin="1:13.299" end="1:15.219">都快忘了怎样恋一</span><span begin="1:15.219" end="1:15.390">个</span><span begin="1:15.390" end="1:15.770">爱</span></p><p begin="1:15.770" end="1:17.806" itunes:key="L14" ttm:agent="v1"><span begin="1:15.770" end="1:16.103">我</span><span begin="1:16.103" end="1:16.242">被</span><span begin="1:16.242" end="1:16.595">虚</span><span begin="1:16.595" end="1:17.164">度了的</span><span begin="1:17.164" end="1:17.806">青春</span></p><p begin="1:17.806" end="1:20.408" itunes:key="L15" ttm:agent="v1"><span begin="1:17.806" end="1:18.316">也</span><span begin="1:18.316" end="1:18.677">许</span><span begin="1:18.677" end="1:19.037">还能</span><span begin="1:19.037" end="1:19.546">活</span><span begin="1:19.546" end="1:19.768">过</span><span begin="1:19.768" end="1:20.408">来</span></p><p begin="1:20.627" end="1:22.958" itunes:key="L16" ttm:agent="v1"><span begin="1:20.627" end="1:21.188">说心疼</span><span begin="1:21.188" end="1:21.607">我</span><span begin="1:21.607" end="1:21.766">的</span><span