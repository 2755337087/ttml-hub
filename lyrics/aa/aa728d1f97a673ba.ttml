<amll:meta key="artists" value="功夫胖"/>
<amll:meta key="artists" value="GAI"/>
<amll:meta key="album" value="全家福 (My Family Picture)"/>
<amll:meta key="appleMusicId" value="1877193430"/></metadata></head><body dur="4:12.603"><div begin="23.730" end="1:13.571" itunes:songPart="Verse"><p begin="23.730" end="26.446" itunes:key="L1" ttm:agent="v1"><span begin="23.730" end="24.703">她撑着油伞</span> <span begin="24.703" end="25.881">从我身边擦肩</span><span begin="25.881" end="26.121">而</span><span begin="26.121" end="26.446">过</span></p><p begin="26.450" end="29.532" itunes:key="L2" ttm:agent="v1"><span begin="26.450" end="27.287">三月的江</span><span begin="27.287" end="27.551">南</span> <span begin="27.694" end="29.021">空气像甜糕一样</span><span begin="29.021" end="29.254">软</span><span begin="29.254" end="29.532">糯</span></p><p begin="29.538" end="32.618" itunes:key="L3" ttm:agent="v1"><span begin="29.538" end="30.550">今晚的戏院</span> <span begin="30.550" end="31.672">我敢肯定又是</span><span begin="31.672" end="32.305">高朋满</span><span begin="32.305" end="32.618">座</span></p><p begin="32.819" end="35.883" itunes:key="L4" ttm:agent="v1"><span begin="32.819" end="33.970">我在看着台上</span><span begin="33.970" end="34.234">戏</span> <span begin="34.371" end="35.515">戏中人在看着</span><span begin="35.515" end="35.883">我</span></p><p begin="35.890" end="38.759" itunes:key="L5" ttm:agent="v1"><span begin="35.890" end="37.070">她在和我对视</span> <span begin="37.070" end="38.127">但我不敢朝</span><span begin="38.127" end="38.399">她</span><span begin="38.399" end="38.759">看</span></p><p begin="38.847" end="41.897" itunes:key="L6" ttm:agent="v1"><span begin="38.847" end="39.592">我是跑堂</span><span begin="39.592" end="39.779">的</span><span begin="39.779" end="40.032">小</span><span begin="40.032" end="40.229">二</span> <span begin="40.229" end="40.418">她</span><span begin="40.418" end="40.605">是</span><span begin="40.605" end="41.005">当家</span><span begin="41.005" end="41.192">的</span><span begin="41.192" end="41.482">花</span><span begin="41.526" end="41.897">旦</span></p><p begin="41.922" end="45.153" itunes:key="L7" ttm:agent="v1"><span begin="41.922" end="43.153">她后台摆满送</span><span begin="43.153" end="43.308">的</span><span begin="43.308" end="43.661">花</span> <span begin="43.862" end="44.679">和名贵首</span><span begin="44.679" end="44.834">饰</span><span begin="44.834" end="45.153">盒</span></p><p begin="45.217" end="48.243" itunes:key="L8" ttm:agent="v1"><span begin="45.217" end="46.403">我在扫着地上</span> <span begin="46.403" end="47.401">满是花生渣</span><span begin="47.401" end="47.595">和</span><span begin="47.595" end="47.805">瓜</span><span begin="47.805" end="47.913">子</span><span begin="47.913" end="48.243">壳</span></p><p begin="48.269" end="51.247" itunes:key="L9" ttm:agent="v1"><span begin="48.269" end="48.946">和她再</span><span begin="48.946" end="49.132">次</span><span begin="49.132" end="49.376">擦</span><span begin="49.376" end="49.720">肩</span> <span begin="49.720" end="50.283">一秒钟</span><span begin="50.283" end="50.504">就</span><span begin="50.504" end="50.859">认</span><span begin="50.859" end="51.247">出</span></p><p begin="51.357" end="54.407" itunes:key="L10" ttm:agent="v1"><span begin="51.357" end="52.148">这一次我</span><span begin="52.177" end="52.551">不再</span><span begin="52.551" end="52.829">回</span><span begin="52.829" end="53.009">头</span> <span begin="53.009" end="53.587">不想又</span><span begin="53.587" end="53.910">认</span><span begin="53.910" end="54.407">输</span></p><p begin="54.467" end="57.387" itunes:key="L11" ttm:agent="v1"><span begin="54.467" end="55.229">青春等着</span><span begin="55.229" end="55.516">皱</span><span begin="55.516" end="55.868">纹</span> <span begin="56.031" end="56.828">新城等着</span><span begin="56.828" end="57.065">旧</span><span begin="57.065" end="57.387">城</span></p><p begin="57.387" end="1:00.496" itunes:key="L12" ttm:agent="v1"><span begin="57.387" end="58.377">只听到新人</span><span begin="58.377" end="58.743">笑</span> <span begin="58.743" end="59.818">没人听过旧</span><span begin="59.818" end="1:00.092">人</span><span begin="1:00.092" end="1:00.496">哭</span></p><p begin="1:01.422" end="1:04.171" itunes:key="L13" ttm:agent="v1"><span begin="1:01.422" end="1:02.095">一辈子</span><span begin="1:02.095" end="1:02.303">都</span><span begin="1:02.303" end="1:03.651">表达不出他心中</span><span begin="1:03.651" end="1:03.823">的</span><span begin="1:03.823" end="1:04.171">爱</span></p><p begin="1:04.371" end="1:05.876" itunes:key="L14" ttm:agent="v1"><span begin="1:04.371" end="1:05.154">一辈子说</span><span begin="1:05.154" end="1:05.296">不</span><span begin="1:05.296" end="1:05.515">出</span><span begin="1:05.515" end="1:05.876">口</span></p><p begin="1:05.951" end="1:07.388" itunes:key="L15" ttm:agent="v1"><span begin="1:05.951" end="1:06.913">只留下一句</span> <span begin="1:06.913" end="1:07.388">唉</span></p><p begin="1:07.620" end="1:10.126" itunes:key="L16" ttm:agent="v1"><span begin="1:07.620" end="1:08.742">为了一句话</span> <span begin="1:08.777" end="1:09.604">琢磨大半</span><span begin="1:09.604" end="1:09.902">辈</span><span begin="1:09.902" end="1:10.126">子</span></p><p begin="1:10.846" end="1:13.571" itunes:key="L17" ttm:agent="v1"><span begin="1:10.846" end="1:11.471">一句话</span> <span begin="1:11.503" end="1:12.177">一万年</span> <span begin="1:12.318" end="1:12.774">默默</span><span begin="1:12.774" end="1:13.056">等</span><span begin="1:13.056" end="1:13.571">待</span></p></div><div begin="1:12.694" end="1:37.205" itunes:songPart="Chorus" ttm:agent="v2"><p begin="1:12.694" end="1:18.290" itunes:key="L18" ttm:agent="v2"><span begin="1:12.694" end="1:13.270">帘幕</span><span begin="1:13.270" end="1:13.545">揭</span><span begin="1:13.545" end="1:14.638">开</span> <span begin="1:14.638" end="1:16.192">当歌声穿</span><span begin="1:16.192" end="1:16.546">舞</span><span begin="1:16.546" end="1:18.290">台</span></p><p begin="1:18.799" end="1:24.554" itunes:key="L19" ttm:agent="v2"><span begin="1:18.799" end="1:19.447">最为</span><span begin="1:19.447" end="1:19.679">无</span><span begin="1:19.679" end="1:20.767">奈</span> <span begin="1:20.767" end="1:22.371">台下的你</span><span begin="1:22.371" end="1:23.061">不</span><span begin="1:23.061" end="1:24.554">在</span></p><p begin="1:24.930" end="1:31.583" itunes:key="L20" ttm:agent="v2"><span begin="1:24.930" end="1:25.835">说给</span><span begin="1:25.835" end="1:27.068">她</span><span begin="1:27.068" end="1:27.429">的</span><span begin="1:27.429" end="1:27.817">话</span> <span begin="1:27.817" end="1:30.077">当眼泪朦胧掩</span><span begin="1:30.077" end="1:31.583">盖</span></p><p begin="1:32.000" end="1:37.205" itunes:key="L21" ttm:agent="v2"><span begin="1:32.000" end="1:33.198">一辈子</span><span begin="1:33.198" end="1:33.856">说</span><span begin="1:34.016" end="1:34.303">不</span><span begin="1:34.303" end="1:34.826">出</span><span begin="1:34.826" end="1:37.205">来</span></p></div><div begin="1:37.791" end="2:27.735" itunes:songPart="Verse"><p begin="1:37.791" end="1:40.908" itunes:key="L22" ttm:agent="v1"><span begin="1:37.791" end="1:38.263">沦落</span><span begin="1:38.263" end="1:38.541">天</span><span begin="1:38.541" end="1:38.898">涯</span> <span begin="1:39.051" end="1:40.199">何必在乎天南</span><span begin="1:40.199" end="1:40.528">或</span><span begin="1:40.528" end="1:40.779">地</span><span begin="1:40.779" end="1:40.908">北</span></p><p begin="1:40.908" end="1:44.104" itunes:key="L23" ttm:agent="v1"><span begin="1:40.908" end="1:41.354">不说</span><span begin="1:41.354" end="1:41.607">轮</span><span begin="1:41.607" end="1:41.962">回</span> <span begin="1:42.087" end="1:42.845">这种思想</span><span begin="1:42.845" end="1:43.212">太</span><span begin="1:43.212" end="1:43.517">过于</span><span begin="1:43.517" end="1:43.840">忌</span><span begin="1:43.840" end="1:44.104">讳</span></p><p begin="1:44.104" end="1:47.178" itunes:key="L24" ttm:agent="v1"><span begin="1:44.104" end="1:44.475">露天</span><span begin="1:44.475" end="1:45.105">电影院</span> <span begin="1:45.192" end="1:46.397">我闻到了熟悉</span><span begin="1:46.397" end="1:46.581">的</span><span begin="1:46.581" end="1:46.926">气</span><span begin="1:46.926" end="1:47.178">味</span></p><p begin="1:47.198" end="1:50.395" itunes:key="L25" ttm:agent="v1"><span begin="1:47.198" end="1:47.966">想和你说</span><span begin="1:47.966" end="1:48.235">话</span> <span begin="1:48.320" end="1:48.669">你说</span><span begin="1:48.669" end="1:49.025">嘘</span> <span begin="1:49.133" end="1:49.713">同志请</span><span begin="1:49.713" end="1:50.068">闭</span><span begin="1:50.068" end="1:50.395">嘴</span></p><p begin="1:50.056" end="1:53.099" itunes:key="L26" ttm:agent="v1"><span begin="1:50.056" end="1:50.675">那不是</span><span begin="1:50.675" end="1:51.233">皂香</span> <span begin="1:51.233" end="1:52.020">是我送你</span><span begin="1:52.020" end="1:52.196">的</span><span begin="1:52.196" end="1:52.420">玉</span><span begin="1:52.420" end="1:52.753">兰</span><span begin="1:52.753" end="1:53.099">花</span></p><p begin="1:53.146" end="1:56.215" itunes:key="L27" ttm:agent="v1"><span begin="1:53.146" end="1:53.736">我羡慕</span><span begin="1:53.736" end="1:54.173">大黄</span> <span begin="1:54.173" end="1:55.259">因为你会时常</span><span begin="1:55.259" end="1:55.530">去</span><span begin="1:55.530" end="1:55.895">玩</span><span begin="1:55.895" end="1:56.215">它</span></p><p begin="1:56.302" end="1:59.231" itunes:key="L28" ttm:agent="v1"><span begin="1:56.302" end="1:56.507">短</span><span begin="1:56.507" end="1:56.704">暂</span><span begin="1:56.704" end="1:56.804">的</span><span begin="1:56.804" end="1:57.068">相</span><span begin="1:57.068" end="1:57.390">处</span> <span begin="1:57.572" end="1:58.362">之后能否</span><span begin="1:58.362" end="1:58.615">再</span><span begin="1:58.615" end="1:58.991">见</span><span begin="1:58.991" end="1:59.231">吗</span></p><p begin="1:59.360" end="2:02.413" itunes:key="L29" ttm:agent="v1"><span begin="1:59.360" end="1:59.698">我要</span><span begin="1:59.698" end="1:59.906">去</span><span begin="1:59.906" end="2:00.568">边疆了</span> <span begin="2:00.568" end="2:01.230">你要插队</span><span begin="2:01.230" end="2:01.413">去</span><span begin="2:01.458" end="2:01.756">玉</span><span begin="2:01.756" end="2:02.007">兰</span><span begin="2:02.059" end="2:02.413">家</span></p><p begin="2:02.634" end="2:05.686" itunes:key="L30" ttm:agent="v1"><span begin="2:02.634" end="2:03.331">再次相</span><span begin="2:03.331" end="2:03.682">遇</span><span begin="2:03.682" end="2:03.860">在</span><span begin="2:03.860" end="2:04.074">甲</span><span begin="2:04.074" end="2:04.382">板</span> <span begin="2:04.382" end="2:05.008">是阴雨</span><span begin="2:05.008" end="2:05.138">的</span><span begin="2:05.138" end="2:05.462">海</span><span begin="2:05.462" end="2:05.686">上</span></p><p begin="2:05.686" end="2:08.833" itunes:key="L31" ttm:agent="v1"><span begin="2:05.686" end="2:06.897">你的长发发白</span><span begin="2:06.897" end="2:07.143">盯</span><span begin="2:07.143" end="2:07.371">着</span><span begin="2:07.466" end="2:08.065">我右手</span><span begin="2:08.065" end="2:08.228">的</span><span begin="2:08.228" end="2:08.569">拐</span><span begin="2:08.612" end="2:08.833">杖</span></p><p begin="2:08.833" end="2:11.796" itunes:key="L32" ttm:agent="v1"><span begin="2:08.833" end="2:09.967">如果当时没有</span><span begin="2:09.967" end="2:11.121">放手把你扯在</span><span begin="2:11.121" end="2:11.450">门</span><span begin="2:11.450" end="2:11.796">边</span></p><p begin="2:11.897" end="2:14.978" itunes:key="L33" ttm:agent="v1"><span begin="2:11.897" end="2:13.062">如今是否能够</span><span begin="2:13.062" end="2:13.865">相濡以沫</span> <span begin="2:13.865" end="2:14.184">隐入</span><span begin="2:14.184" end="2:14.633">尘</span><span begin="2:14.633" end="2:14.978">烟</span></p><p begin="2:15.802" end="2:18.501" itunes:key="L34" ttm:agent="v1"><span begin="2:15.802" end="2:17.327">一辈子都表达不出</span><span begin="2:17.327" end="2:17.956">他心中</span><span begin="2:17.956" end="2:18.135">的</span><span begin="2:18.135" end="2:18.501">爱</span></p><p begin="2:18.760" end="2:20.155" itunes:key="L35" ttm:agent="v1"><span begin="2:18.760" end="2:19.530">一辈子说</span><span begin="2:19.530" end="2:19.865">不出</span><span begin="2:19.865" end="2:20.155">口</sp