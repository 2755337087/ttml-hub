<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2000"/><ttm:agent type="other" xml:id="v3000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>马思唯</songwriter></songwriters></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="qqMusicId" value="288365909"/><amll:meta key="musicName" value="崂山道士"/><amll:meta key="artists" value="马思唯"/><amll:meta key="album" value="P.E.I Vol.2"/></metadata></head><body><div begin="0:04.598" end="0:30.762" itunes:songPart="Intro"><p begin="0:04.598" end="0:08.303" itunes:key="L1" ttm:agent="v2000"><span begin="0:04.598" end="0:04.847">要</span><span begin="0:04.847" end="0:05.458">学</span><span begin="0:05.458" end="0:06.358">神仙</span> <span begin="0:06.358" end="0:06.658">驾</span><span begin="0:06.658" end="0:07.316">鹤</span><span begin="0:07.316" end="0:07.707">飞</span><span begin="0:07.707" end="0:08.303">天</span></p><p begin="0:08.303" end="0:12.353" itunes:key="L2" ttm:agent="v2000"><span begin="0:08.303" end="0:08.500">点</span><span begin="0:08.500" end="0:09.151">石</span><span begin="0:09.151" end="0:09.983">成金</span> <span begin="0:09.983" end="0:10.342">妙</span><span begin="0:10.342" end="0:10.972">不</span><span begin="0:10.972" end="0:11.391">可</span><span begin="0:11.391" end="0:12.353">言</span></p><p begin="0:12.284" end="0:19.386" itunes:key="L3" ttm:agent="v2000"><span begin="0:12.284" end="0:12.771">定要</span><span begin="0:12.771" end="0:13.272">到</span><span begin="0:13.832" end="0:15.003">崂山</span><span begin="0:15.003" end="0:15.752">去</span><span begin="0:15.752" end="0:16.413">学</span><span begin="0:16.413" end="0:19.386">仙</span></p><p begin="0:15.893" end="0:20.701" itunes:key="L4" ttm:agent="v2000"><span begin="0:15.893" end="0:16.309">唉</span> <span begin="0:17.011" end="0:17.462">又</span><span begin="0:17.462" end="0:18.552">看《神仙传》</span> <span begin="0:19.262" end="0:19.688">看</span><span begin="0:19.688" end="0:19.801">的</span><span begin="0:19.801" end="0:20.579">痴头呆</span><span begin="0:20.579" end="0:20.701">脑</span></p><p begin="0:24.164" end="0:28.172" itunes:key="L5" ttm:agent="v2000"><span begin="0:24.164" end="0:24.612">你是在</span><span begin="0:24.612" end="0:25.202">做梦</span> <span begin="0:26.304" end="0:26.513">总</span> <span begin="0:26.892" end="0:27.104">总</span><span begin="0:27.241" end="0:28.172">是看《神仙传》</span></p><p begin="0:28.999" end="0:30.762" itunes:key="L6" ttm:agent="v2000"><span begin="0:28.999" end="0:29.955">真是鬼迷</span><span begin="0:29.955" end="0:30.367">心</span><span begin="0:30.367" end="0:30.637">窍</span><span begin="0:30.637" end="0:30.762">了</span></p></div><div begin="0:28.947" end="1:12.370" itunes:songPart="Verse"><p begin="0:28.947" end="0:30.572" itunes:key="L7" ttm:agent="v1"><span begin="0:28.947" end="0:29.579">Yo,</span> <span begin="0:29.579" end="0:30.187">yo,</span> <span begin="0:30.187" end="0:30.572">yo</span></p><p begin="0:30.879" end="0:33.496" itunes:key="L8" ttm:agent="v1"><span begin="0:30.879" end="0:32.207">想学功夫修炼仙术</span> <span begin="0:32.317" end="0:32.476">先</span><span begin="0:32.476" end="0:33.496">征服这条山路</span></p><p begin="0:33.512" end="0:36.067" itunes:key="L9" ttm:agent="v1"><span begin="0:33.512" end="0:33.721">我在</span><span begin="0:33.721" end="0:34.282">三清观</span><span begin="0:34.282" end="0:34.780">里录歌</span> <span begin="0:34.912" end="0:35.072">旋</span><span begin="0:35.072" end="0:36.067">律和韵脚兼顾</span></p><p begin="0:36.067" end="0:38.675" itunes:key="L10" ttm:agent="v1"><span begin="0:36.067" end="0:36.335">看我</span><span begin="0:36.335" end="0:37.347">点石成金</span> <span begin="0:37.526" end="0:37.855">把黑</span><span begin="0:37.855" end="0:38.303">的说成</span><span begin="0:38.303" end="0:38.675">白</span></p><p begin="0:38.804" end="0:41.487" itunes:key="L11" ttm:agent="v1"><span begin="0:38.804" end="0:39.232">用身体</span><span begin="0:39.232" end="0:39.451">穿</span><span begin="0:39.451" end="0:39.872">过墙壁</span> <span begin="0:39.872" end="0:40.104">想</span><span begin="0:40.104" end="0:40.894">抓我的随便</span><span begin="0:40.894" end="0:41.487">来</span></p><p begin="0:41.487" end="0:44.287" itunes:key="L12" ttm:agent="v1"><span begin="0:41.487" end="0:42.547">从嘴里吐出字句</span> <span begin="0:42.697" end="0:42.816">流</span><span begin="0:42.816" end="0:43.986">动着滑入你的耳</span><span begin="0:43.986" end="0:44.287">朵</span></p><p begin="0:44.417" end="0:46.775" itunes:key="L13" ttm:agent="v1"><span begin="0:44.417" end="0:44.563">这</span><span begin="0:44.563" end="0:45.374">感觉刺激整个</span><span begin="0:45.374" end="0:45.606">身</span><span begin="0:45.606" end="0:45.706">体</span> <span begin="0:45.706" end="0:45.935">像</span><span begin="0:45.935" end="0:46.546">被异性抚</span><span begin="0:46.546" end="0:46.775">摸</span></p><p begin="0:46.883" end="0:49.442" itunes:key="L14" ttm:agent="v1"><span begin="0:46.883" end="0:47.681">找回你自己</span> <span begin="0:47.681" end="0:47.862">来</span><span begin="0:47.862" end="0:48.591">把最真实的</span><span begin="0:48.591" end="0:49.442">声音捕捉</span></p><p begin="0:49.442" end="0:52.064" itunes:key="L15" ttm:agent="v1"><span begin="0:49.442" end="0:50.101">最猛的招</span><span begin="0:50.101" end="0:50.384">式</span> <span begin="0:50.384" end="0:50.561">新</span><span begin="0:50.561" end="0:50.872">鲜的</span><span begin="0:50.872" end="0:51.773">听觉冲击诱</span><span begin="0:51.773" end="0:52.064">惑</span></p><p begin="0:52.064" end="0:54.713" itunes:key="L16" ttm:agent="v1"><span begin="0:52.064" end="0:53.023">我随手招来了月</span><span begin="0:53.023" end="0:53.374">亮</span> <span begin="0:53.374" end="0:53.673">当我</span><span begin="0:53.673" end="0:54.023">们par</span><span begin="0:54.023" end="0:54.353">ty在晚</span><span begin="0:54.353" end="0:54.713">上</span></p><p begin="0:54.713" end="0:57.254" itunes:key="L17" ttm:agent="v1"><span begin="0:54.713" end="0:55.405">嫦娥都脱光</span><span begin="0:55.405" end="0:55.592">了衣</span><span begin="0:55.592" end="0:55.972">裳</span> <span begin="0:55.972" end="0:56.114">当</span><span begin="0:56.114" end="0:56.942">我把音乐给播</span><span begin="0:56.942" end="0:57.254">放</span></p><p begin="0:57.254" end="0:59.720" itunes:key="L18" ttm:agent="v1"><span begin="0:57.254" end="0:58.384">炫耀着新鲜招式</span> <span begin="0:58.384" end="0:58.551">变</span><span begin="0:58.551" end="0:59.720">出美食放在桌上</span></p><p begin="0:59.720" end="1:01.958" itunes:key="L19" ttm:agent="v1"><span begin="0:59.720" end="1:00.638">把酒言欢造字</span> <span begin="1:00.638" end="1:00.829">眯</span><span begin="1:00.829" end="1:01.958">着眼睛慢慢欣赏</span></p><p begin="1:01.964" end="1:03.234" itunes:key="L20" ttm:agent="v1"><span begin="1:01.964" end="1:02.461">跟着晃</span> <span begin="1:02.624" end="1:02.852">继</span><span begin="1:02.852" end="1:03.234">续</span></p><p begin="1:03.020" end="1:04.565" itunes:key="L21" ttm:agent="v1"><span begin="1:03.020" end="1:03.231">You</span> <span begin="1:03.231" end="1:03.420">wan</span><span begin="1:03.420" end="1:03.532">na</span> <span begin="1:03.532" end="1:03.782">rap</span> <span begin="1:03.883" end="1:04.203">like</span> <span begin="1:04.203" end="1:04.565">me</span></p><p begin="1:04.565" end="1:07.033" itunes:key="L22" ttm:agent="v1"><span begin="1:04.565" end="1:05.573">会说唱的神仙</span> <span begin="1:05.694" end="1:05.823">把</span><span begin="1:05.823" end="1:06.164">词句</span><span begin="1:06.164" end="1:07.033">变金币</span></p><p begin="1:07.068" end="1:09.589" itunes:key="L23" ttm:agent="v1"><span begin="1:07.068" end="1:07.358">我教</span><span begin="1:07.358" end="1:07.467">你</s