<amll:meta key="album" value="未来的昨天 - Single"/>
<amll:meta key="appleMusicId" value="1814302168"/></metadata></head><body dur="3:46.027"><div begin="22.212" end="39.890" itunes:songPart="Verse"><p begin="22.212" end="25.676" itunes:key="L1" ttm:agent="v1"><span begin="22.212" end="23.159">再挽留</span><span begin="23.159" end="23.817">也</span><span begin="23.944" end="24.368">不</span><span begin="24.368" end="25.676">对</span></p><p begin="26.865" end="30.224" itunes:key="L2" ttm:agent="v1"><span begin="26.865" end="27.545">放弃</span><span begin="27.545" end="28.273">也</span><span begin="28.680" end="30.224">不对</span></p><p begin="31.341" end="34.813" itunes:key="L3" ttm:agent="v1"><span begin="31.341" end="32.244">终于跟</span><span begin="32.244" end="33.613">你学会</span><span begin="33.613" end="34.813">飞</span></p><p begin="35.991" end="39.890" itunes:key="L4" ttm:agent="v1"><span begin="35.991" end="37.042">忘了问你</span><span begin="37.042" end="38.351">为何</span><span begin="38.590" end="39.890">下坠</span></p></div><div begin="40.461" end="57.484" itunes:songPart="Verse"><p begin="40.461" end="43.871" itunes:key="L5" ttm:agent="v1"><span begin="40.461" end="41.263">执意做</span><span begin="41.263" end="42.448">些准</span><span begin="42.448" end="43.871">备</span></p><p begin="44.938" end="48.186" itunes:key="L6" ttm:agent="v1"><span begin="44.938" end="46.436">明知无从</span><span begin="46.436" end="46.915">准</span><span begin="46.915" end="48.186">备</span></p><p begin="49.438" end="52.841" itunes:key="L7" ttm:agent="v1"><span begin="49.438" end="50.289">顾左右</span><span begin="50.289" end="51.008">而</span><span begin="51.008" end="51.471">拖</span><span begin="51.471" end="52.841">延</span></p><p begin="53.885" end="57.484" itunes:key="L8" ttm:agent="v1"><span begin="53.885" end="54.914">拖延我自</span><span begin="54.914" end="55.573">私</span><span begin="55.573" end="56.438">的表</span><span begin="56.438" end="57.484">演</span></p></div><div begin="58.796" end="1:15.496" itunes:songPart="Chorus"><p begin="58.796" end="1:03.002" itunes:key="L9" ttm:agent="v1"><span begin="58.796" end="59.730">总不说</span><span begin="59.730" end="1:01.541">量力</span><span begin="1:01.541" end="1:01.866">而</span><span begin="1:01.866" end="1:03.002">为</span></p><p begin="1:03.256" end="1:07.482" itunes:key="L10" ttm:agent="v1"><span begin="1:03.256" end="1:04.086">心虚地</span><span begin="1:04.086" end="1:06.027">相信</span><span begin="1:06.027" end="1:06.413">直</span><span begin="1:06.413" end="1:07.482">觉</span></p><p begin="1:07.821" end="1:09.771" itunes:key="L11" ttm:agent="v1"><span begin="1:07.821" end="1:08.471">是你</span><span begin="1:08.471" end="1:09.771">成全</span></p><p begin="1:10.125" end="1:15.496" itunes:key="L12" ttm:agent="v1"><span begin="1:10.125" end="1:10.916">不曾对</span><span begin="1:10.916" end="1:11.456">我</span><span begin="1:11.456" end="1:13.020">的决定</span><span begin="1:13.560" end="1:15.496">埋怨</span></p></div><div begin="1:16.907" end="1:33.133" itunes:songPart="Chorus"><p begin="1:16.907" end="1:20.763" itunes:key="L13" ttm:agent="v1"><span begin="1:16.907" end="1:17.663">也担心</span><span begin="1:17.663" end="1:19.568">互不</span><span begin="1:19.568" end="1:20.763">相欠</span></p><p begin="1:21.139" end="1:25.440" itunes:key="L14" ttm:agent="v1"><span begin="1:21.139" end="1:22.287">逐渐忘记</span><span begin="1:22.287" end="1:23.257">人</span><span begin="1:23.257" end="1:24.339">需要</span><span begin="1:24.339" end="1:25.440">挂念</span></p><p begin="1:26.034" end="1:27.862" itunes:key="L15" ttm:agent="v1"><span begin="1:26.034" end="1:26.780">不知进</span><span begin="1:26.780" end="1:27.862">退</span></p><p begin="1:28.252" end="1:33.133" itunes:key="L16" ttm:agent="v1"><span begin="1:28.252" end="1:29.054">谎称自</span><span begin="1:29.054" end="1:29.871">己</span><span begin="1:30.153" end="1:31.814">问心无</span><span begin="1:31.814" end="1:33.133">愧</span></p></div><div begin="1:52.816" end="2:10.464" itunes:songPart="Verse"><p begin="1:52.816" end="1:56.710" itunes:key="L17" ttm:agent="v1"><span begin="1:52.816" end="1:53.619">用倒数</span><span begin="1:53.619" end="1:54.551">的</span><span begin="1:54.551" end="1:54.918">明</span><span begin="1:54.918" end="1:56.710">天</span></p><p begin="1:57.386" end="2:00.657" itunes:key="L18" ttm:agent="v1"><span begin="1:57.386" end="1:58.820">等未来的</span><span begin="1:59.022" end="1:59.508">昨</span><span begin="1:59.508" end="2:00.657">天</span></p><p begin="2:01.906" end="2:05.666" itunes:key="L19" ttm:agent="v1"><span begin="2:01.906" end="2:03.323">我面向你</span><span begin="2:03.388" end="2:04.137">往后</span><span begin="2:04.137" end="2:05.666">追</span></p><p begin="2:06.405" end="2:10.464" itunes:key="L20" ttm:agent="v1"><span begin="2:06.405" end="2:08.002">捡回一些都</span><span begin="2:08.002" end="2:09.219">是</span><span begin="2:09.219" end="2:10.464">一切</span></p></div><div begin="2:10.898" end="2:28.963" itunes:songPart="Verse"><p begin="2:10.898" end="2:14.708" itunes:key="L21" ttm:agent="v1"><span begin="2:10.898" end="2:11.881">向敌对</span><span begin="2:11.881" end="2:12.524">的</span><span begin="2:12.524" end="2:12.954">时</span><span begin="2:12.954" end="2:14.708">间</span></p><p begin="2:15.423" end="2:19.567" itunes:key="L22" ttm:agent="v1"><span begin="2:15.423" end="2:16.985">最谦卑地</span><span begin="2:17.030" end="2:17.541">许</span><span begin="2:17.541" end="2:19.567">愿</span></p><p begin="2:19.965" end="2:23.521" itunes:key="L23" ttm:agent="v1"><span begin="2:19.965" end="2:21.516">既缓慢又</span><span begin="2:21.571" end="2:22.097">迫</span><span begin="2:22.097" end="2:23.521">切</span></p><p begin="2:24.568" end="2:28.963" itunes:key="L24" ttm:agent="v1"><span begin="2:24.568" end="2:25.670">越不过 却</span><span begin="2:25.670" end="2:27.115">已经越</span><span begin="2:27.115" end="2:28.963">线</span></p></div><div begin="2:29.331" end="2:46.663" itunes:songPart="Chorus"><p begin="2:29.331" end="2:33.537" itunes:key="L25" ttm:agent="v1"><span begin="2:29.331" end="2:30.265">总不说</span><span begin="2:30.265" end="2:32.076">量力</span><span begin="2:32.076" end="2:32.401">而</span><span begin="2:32.401" end="2:33.537">为</span></p><p begin="2:33.789" end="2:38.015" itunes:key="L26" ttm:agent="v1"><span begin="2:33.789" end="2:34.619">心虚地</span><span begin="2:34.619" end="2:36.560">相信</span><span begin="2:36.560" end="2:36.946">直</span><span begin="2:36.946" end="2:38.015">觉</span></p><p begin="2:38.462" end="2:40.298" itunes:key="L27" ttm:agent="v1"><span begin="2:38.462" end="2:39.243">我早厌</span><span begin="2:39.243" end="2:40.298">倦</span></p><p begin="2:40.667" end="2:46.663" itunes:key="L28" ttm:agent="v1"><span begin="2:40.667" end="2:41.418">用其他</span><span begin="2:41.418" end="2:42.888">说词迎</span><span begin="2:42.888" end="2:43.861">接</span><span begin="2:44.172" end="2:44.745">那</span><span begin="2:44.745" end="2:46.663">天</span></p></div><div begin="2:47.479" end="3:04.762" itunes:songPart="Chorus"><p begin="2:47.479" end="2:51.461" itunes:key="L29" ttm:agent="v1"><span begin="2:47.479" end="2:48.308">可是我</span><span begin="2:48.308" end="2:50.084">能力</span><span begin="2:50.084" end="2:50.423">有</span><span begin="2:50.423" end="2:51.461">限</span></p><p begin="2:51.693" end="2:56.133" itunes:key="L30" ttm:agent="v1"><span begin="2:51.693" end="2:52.814">只够拿昨</span><span begin="2:52.814" end="2:53.940">天</span><span begin="2:53.940" end="2:56.133">回应永远</span></p><p begin="2:56.530" end="2:58.407" itunes:key="L31" ttm:agent="v1"><span begin="2:56.530" end="2:57.329">不知进</span><span begin="2:57.329" end="2:58.407">退</span></p><p begin="2:58.770" end="3:04.762" itunes:key="L32" ttm:agent="v1"><span begin="2:58.770" end="2:59.641">谎称自</span><span begin="2:59.641" end="3:00.540">己</span><span begin="3:00.728" end="3:02.169">问心</span><span begin="3:02.169" end="3:02.631">无</span><span begin="3:02.631" end="3:04.762">愧</span></p></div><div begin="3:05.563" end="3:26.635" itunes:songPart="Chorus"><p begin="3:05.563" end="3:09.578" itunes:key="L33" ttm:agent="v1"><span begin="3:05.563" end="3:06.386">我害怕</span><span begin="3:06.386" end="3:08.290">记忆</span><span begin="3:08.290" end="3:09.578">变浅</span></p><p begin="3:09.864" end="3:16.161" itunes:key="L34" ttm:agent="v1"><span begin="3:09.864" end="3:11.016">只能用思</span><span begin="3:11.016" end="3:11.718">念</span><span begin="3:12.032" end="3:13.655">继续亏</span><span begin="3:13.655" end="3:16.161">欠</span></p><p begin="3:17.484" end="3:19.366" itunes:key="L35" ttm:agent="v1"><span begin="3:17.484" end="3:18.334">你没走</span><span begin="3:18.334" end="3:19.366">远</span></p><p begin="3:19.767" end="3:26.635" itunes:key="L36" ttm:agent="v1"><span begin="3:19.767" end="3:21.362">我很愿意</span><span begin="3:21.719" end="3:23.779">再骗我</span><span begin="3:24.335" end="3:24.811">一</span><span begin="3:24.811" end="3:26.635">遍</span></p></div></body></tt>