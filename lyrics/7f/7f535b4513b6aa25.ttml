<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>邓紫棋</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="泡沫"/><amll:meta key="artists" value="G.E.M. 邓紫棋"/><amll:meta key="artists" value="G.E.M.邓紫棋"/><amll:meta key="album" value="Xposed"/><amll:meta key="qqMusicId" value="001X0PDf0W4lBq"/><amll:meta key="ncmMusicId" value="233931"/></metadata></head><body><div begin="0:01.065" end="0:26.918" itunes:songPart="Verse"><p begin="0:01.065" end="0:07.430" itunes:key="L1" ttm:agent="v1"><span begin="0:01.065" end="0:04.070">阳光下的泡沫</span> <span begin="0:04.520" end="0:06.367">是彩色</span><span begin="0:06.367" end="0:07.430">的</span></p><p begin="0:08.125" end="0:14.474" itunes:key="L2" ttm:agent="v1"><span begin="0:08.125" end="0:11.160">就像被骗的我</span> <span begin="0:11.550" end="0:13.321">是幸福</span><span begin="0:13.321" end="0:14.474">的</span></p><p begin="0:15.237" end="0:21.516" itunes:key="L3" ttm:agent="v1"><span begin="0:15.237" end="0:18.120">追究什么对错</span> <span begin="0:18.536" end="0:19.582">你的</span><span begin="0:19.582" end="0:21.516">谎言</span></p><p begin="0:22.232" end="0:26.918" itunes:key="L4" ttm:agent="v1"><span begin="0:22.232" end="0:24.694">基于你还爱</span><span begin="0:24.694" end="0:26.918">我</span></p></div><div begin="0:28.398" end="0:54.148" itunes:songPart="Chorus"><p begin="0:28.398" end="0:35.456" itunes:key="L5" ttm:agent="v1"><span begin="0:28.398" end="0:29.761">美丽的</span><span begin="0:29.761" end="0:31.546">泡沫</span> <span begin="0:31.980" end="0:33.718">虽然一刹</span><span begin="0:33.718" end="0:35.456">花火</span></p><p begin="0:35.568" end="0:42.387" itunes:key="L6" ttm:agent="v1"><span begin="0:35.568" end="0:36.826">你所有</span><span begin="0:36.826" end="0:38.464">承诺</span> <span begin="0:38.977" end="0:40.682">虽然都太</span><span begin="0:40.682" end="0:42.387">脆弱</span></p><p begin="0:42.576" end="0:49.611" itunes:key="L7" ttm:agent="v1"><span begin="0:42.576" end="0:43.927">但爱像</span><span begin="0:43.927" end="0:45.678">泡沫</span> <span begin="0:46.093" end="0:47.852">如果能够</span><span begin="0:47.852" end="0:49.611">看破</span></p><p begin="0:49.678" end="0:54.148" itunes:key="L8" ttm:agent="v1"><span begin="0:49.678" end="0:51.669">有什么难</span><span begin="0:51.669" end="0:54.148">过</span></p></div><div begin="0:57.620" end="1:23.236" itunes:songPart="Verse"><p begin="0:57.620" end="1:04.308" itunes:key="L9" ttm:agent="v1"><span begin="0:57.620" end="0:59.397">早该知道</span><span begin="0:59.397" end="1:00.538">泡沫</span> <span begin="1:00.964" end="1:01.961">一触</span><span begin="1:01.961" end="1:04.308">就破</span></p><p begin="1:04.529" end="1:11.299" itunes:key="L10" ttm:agent="v1"><span begin="1:04.529" end="1:07.561">就像已伤的心</span> <span begin="1:08.157" end="1:09.053">不胜</span><span begin="1:09.053" end="1:11.299">折磨</span></p><p begin="1:11.703" end="1:18.593" itunes:key="L11" ttm:agent="v1"><span begin="1:11.703" end="1:13.913">也不是谁的</span><span begin="1:13.913" end="1:14.669">错</span> <span begin="1:15.219" end="1:16.098">谎言</span><span begin="1:16.098" end="1:18.593">再多</span></p><p begin="1:18.670" end="1:23.236" itunes:key="L12" ttm:agent="v1"><span begin="1:18.670" end="1:19.593">基于</span><span begin="1:19.593" end="1:21.062">你还爱</span><span begin="1:21.062" end="1:23.236">我</span></p></div><div begin="1:25.023" end="3:39.590" itunes:songPart="Chorus"><p begin="1:25.023" end="1:31.939" itunes:key="L13" ttm:agent="v1"><span begin="1:25.023" end="1:26.268">美丽的</span><span begin="1:26.268" end="1:28.002">泡沫</span> <span begin="1:28.481" end="1:30.353">虽然一刹</span><span begin="1:30.353" end="1:31.939">花火</span></p><p begin="1:31.978" end="1:38.992" itunes:key="L14" ttm:agent="v1"><span begin="1:31.978" end="1:33.374">你所有</span><span begin="1:33.374" end="1:35.177">承诺</span> <span begin="1:35.486" end="1:37.239">虽然都太</span><span begin="1:37.239" end="1:38.992">脆弱</span></p><p begin="1:39.142" end="1:46.012" itunes:key="L15" ttm:agent="v1"><span begin="1:39.142" end="1:40.199">爱本是</span><span begin="1:40.199" end="1:42.180">泡沫</span> <span begin="1:42.578" end="1:44.295">如果能够</span><span begin="1:44.295" end="1:46.012">看破</span></p><p begin="1:46.212" end="1:50.333" itunes:key="L16" ttm:agent="v1"><span begin="1:46.212" end="1:47.675">有什么</span><span begin="1:47.675" end="1:48.077">难</span><span begin="1:48.077" end="1:50.333">过</span></p><p begin="1:53.149" end="2:00.157" itunes:key="L17" ttm:agent="v1"><span begin="1:53.149" end="1:54.519">再美的</span><span begin="1:54.519" end="1:56.279">花朵</span> <span begin="1:56.523" end="1:58.405">盛开过就</span><span begin="1:58.405" end="2:00.157">凋落</span></p><p begin="2:00.299" end="2:07.242" itunes:key="L18" ttm:agent="v1"><span begin="2:00.299" end="2:01.753">再亮眼的</span><span begin="2:01.753" end="2:03.376">星</span> <span begin="2:03.771" end="2:05.506">一闪过就</span><span begin="2:05.506" end="2:07.242">坠落</span></p><p begin="2:07.359" end="2:14.323" itunes:key="L19" ttm:agent="v1"><span begin="2:07.359" end="2:08.615">爱本是</span><span begin="2:08.615" end="2:10.227">泡沫</span> <span begin="2:10.768" end="2:12.582">如果能够</span><span begin="2:12.582" end="2:14.323">看破</span></p><p begin="2:14.356" end="2:18.531" itunes:key="L20" ttm:agent="v1"><span begin="2:14.356" end="2:15.455">有什么</span><span begin="2:15.455" end="2:16.265">难</span><span begin="2:16.265" end="2:18.531">过</span></p><p begin="2:21.443" end="2:25.656" itunes:key="L21" ttm:agent="v1"><span begin="2:21.443" end="2:22.548">为什么</span><span begin="2:22.548" end="2:23.233">难</span><span begin="2:23.233" end="2:25.656">过</span></p><p begin="2:28.466" end="2:33.346" itunes:key="L22" ttm:agent="v1"><span begin="2:28.466" end="2:29.605">有什么</span><span begin="2:29.605" end="2:30.280">难</span><span begin="2:30.280" end="2:33.346">过</span></p><p begin="2:35.606" end="2:45.450" itunes:key="L23" ttm:agent="v1"><span begin="2:35.606" end="2:36.939">为什么</span><span begin="2:36.939" end="2:37.506">难</span><span begin="2:37.506" end="2:45.450">过</span></p><p begin="2:46.090" end="2:53.134" itunes:key="L24" ttm:agent="v1"><span begin="2:46.090" end="2:47.181">全都是</span><span begin="2:47.181" end="2:49.293">泡沫</span> <span begin="2:49.612" end="2:51.373">只一刹的</span><span begin="2:51.373" end="2:53.134">花火</span></p><p begin="2:53.257" end="3:00.221" itunes:key="L25" ttm:agent="v1"><span begin="2:53.257" end="2:54.441">你所有</span><span begin="2:54.441" end="2:55.024">承</span><span begin="2:55.024" end="2:56.408">诺</span> <span begin="2:56.691" end="2:58.456">全部都太</span><span begin="2:58.456" end="3:00.221">脆弱</span></p><p begin="3:00.289" end="3:07.297" itunes:key="L26" ttm:agent="v1"><span begin="3:00.289" end="3:01.529">而你的</span><span begin="3:01.529" end="3:03.394">轮廓</span> <span begin="3:03.712" end="3:05.545">怪我没有</span><span begin="3:05.545" end="3:07.297">看破</span></p><p begin="3:07.300" end="3:12.407" itunes:key="L27" ttm:agent="v1"><span begin="3:07.300" end="3:08.392">才如此</span><span begin="3:08.392" end="3:09.124">难</span><span begin="3:09.124" end="3:12.407">过</span></p><p begin="3:14.369" end="3:21.388" itunes:key="L28" ttm:agent="v1"><span begin="3:14.369" end="3:15.619">相爱的</span><span begin="3:15.619" end="3:17.496">把握</span> <span begin="3:17.781" end="3:19.633">要如何再</span><span begin="3:19.633" end="3:21.388">搜索</span></p><p begin="3:21.421" end="3:28.400" itunes:key="L29" ttm:agent="v1"><span begin="3:21.421" end="3:22.583">相拥着</span><span begin="3:22.583" end="3:24.603">寂寞</span> <span begin="3:24.951" end="3:26.655">难道就不</span><span begin="3:26.655" end="3:28.400">寂寞</span></p><p begin="3:28.489" end="3:35.489" itunes:key="L30" ttm:agent="v1"><span begin="3:28.489" end="3:29.849">爱本是</span><span begin="3:29.849" end="3:31.583">泡沫</span> <span begin="3:31.859" end="3:33.739">怪我没有</span><span begin="3:33.739" end="3:35.489">看破</span></p><p begin="3:35.525" end="3:39.590" itunes:key="L31" ttm:agent="v1"><span begin="3:35.525" end="3:36.880">才如此</span><span begin="3:36.880" end="3:37.480">难</span><span begin="3:37.480" end="3:39.590">过</span></p></div><div begin="3:43.571" end="4:09.433" itunes:songPart="Outro"><p begin="3:43.571" end="3:50.251" itunes:key="L32" ttm:agent="v1"><span begin="3:43.571" end="3:45.264">在雨下的</span><span begin="3:45.264" end="3:46.539">泡沫</span> <span begin="3:46.756" end="3:48.581">一触就</span><span begin="3:48.581" end="3:50.251">破</span></p><p begin="3:50.622" end="3:57.310" itunes:key="L33" ttm:agent="v1"><span begin="3:50.622" end="3:52.116">当初炽热</span><span begin="3:52.116" end="3:53.438">的心</span> <span begin="3:53.966" end="3:54.878">早已</span><span begin="3:54.878" end="3:57.310">沉没</span></p><p begin="3:57.522" end="4:04.298" itunes:key="L34" ttm:agent="v1"><span begin="3:57.522" end="3:58.752">说什么</span><span begin="3:58.752" end="4:00.564">你爱我</span> <span begin="4:00.855" end="4:01.881">如果</span><span begin="4:01.881" end="4:04.298">骗我</span></p><p begin="4:04.624" end="4:09.433" itunes:key="L35" ttm:agent="v1"><span begin="4:04.624" end="4:06.489">我宁愿你</span><span begin="4:06.489" end="4:07.116">沉</span><span begin="4:07.116" end="4:09.433">默</span></p></div></body></tt>