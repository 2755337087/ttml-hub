<amll:meta key="appleMusicId" value="1801409034"/></metadata></head><body dur="3:21.756"><div begin="16.404" end="42.716" itunes:songPart="Verse"><p begin="16.404" end="22.087" itunes:key="L1" ttm:agent="voice"><span begin="16.404" end="16.863">莫</span><span begin="16.863" end="17.268">名</span><span begin="17.268" end="17.539">又</span><span begin="17.539" end="18.054">其</span><span begin="18.054" end="18.479">妙</span> <span begin="18.620" end="19.104">爱</span><span begin="19.104" end="19.369">与</span><span begin="19.369" end="20.190">成全</span><span begin="20.190" end="20.455">就</span><span begin="20.455" end="20.917">和</span><span begin="20.917" end="22.087">解不了</span></p><p begin="22.893" end="28.522" itunes:key="L2" ttm:agent="voice"><span begin="22.893" end="23.302">我</span><span begin="23.302" end="23.744">欲</span><span begin="23.744" end="23.977">言</span><span begin="23.977" end="24.380">又</span><span begin="24.380" end="24.852">止</span> <span begin="25.081" end="25.559">就</span><span begin="25.559" end="25.783">让</span><span begin="25.783" end="26.231">心</span><span begin="26.231" end="26.855">跳</span><span begin="26.855" end="27.467">默</span><span begin="27.467" end="27.778">默</span><span begin="27.778" end="28.522">吵</span></p><p begin="30.208" end="36.940" itunes:key="L3" ttm:agent="voice"><span begin="30.208" end="30.573">可</span><span begin="30.573" end="31.024">惜</span><span begin="31.024" end="31.273">你</span><span begin="31.273" end="31.788">不</span><span begin="31.788" end="32.217">知</span><span begin="32.217" end="32.859">道</span> <span begin="32.859" end="33.175">背</span><span begin="33.175" end="33.695">向</span><span begin="33.695" end="34.034">你</span><span begin="34.034" end="34.330">时</span> <span begin="34.330" end="34.727">我</span><span begin="34.727" end="35.151">也</span><span begin="35.151" end="35.648">湿</span><span begin="35.648" end="36.019">了</span><span begin="36.019" end="36.432">眼</span><span begin="36.432" end="36.940">角</span></p><p begin="37.464" end="42.716" itunes:key="L4" ttm:agent="voice"><span begin="37.464" end="37.948">已然</span><span begin="37.948" end="38.465">是</span><span begin="38.465" end="38.820">全</span><span begin="38.820" end="39.305">力</span><span begin="39.305" end="39.610">伪</span><span begin="39.610" end="39.892">装</span> <span begin="39.892" end="40.320">最</span><span begin="40.320" end="40.699">后</span><span begin="40.699" end="41.084">的</span><span begin="41.402" end="41.768">礼</span><span begin="41.768" end="42.716">貌</span></p></div><div begin="44.535" end="58.683" itunes:songPart="PreChorus"><p begin="44.535" end="48.021" itunes:key="L5" ttm:agent="voice"><span begin="44.535" end="45.108">庆幸</span><span begin="45.108" end="45.665">是</span> <span begin="45.665" end="46.148">你给</span><span begin="46.148" end="46.607">过</span><span begin="46.607" end="47.077">温暖</span><span begin="47.077" end="47.550">拥</span><span begin="47.550" end="48.021">抱</span></p><p begin="48.289" end="51.661" itunes:key="L6" ttm:agent="voice"><span begin="48.289" end="48.807">遗憾</span><span begin="48.807" end="49.330">是</span> <span begin="49.330" end="49.795">得不</span><span begin="49.795" end="50.253">到</span><span begin="50.253" end="50.655">偏又</span><span begin="50.655" end="51.167">想</span><span begin="51.167" end="51.661">要</span></p><p begin="51.932" end="56.156" itunes:key="L7" ttm:agent="voice"><span begin="51.932" end="52.774">怎麼比</span><span begin="52.774" end="53.057">较</span><span begin="53.057" end="53.684">开端和</span><span begin="53.684" end="53.969">结</span><span begin="53.969" end="54.351">局</span> <span begin="54.503" end="55.085">哪</span><span begin="55.085" end="55.706">个潦</span><span begin="55.706" end="56.156">草</span></p><p begin="56.361" end="58.683" itunes:key="L8" ttm:agent="voice"><span begin="56.361" end="56.909">一</span><span begin="56.909" end="57.618">样忘</span><span begin="57.618" end="58.103">不</span><span begin="58.103" end="58.683">掉</span></p></div><div begin="58.904" end="1:13.461" itunes:songPart="Chorus"><p begin="58.904" end="1:02.988" itunes:key="L9" ttm:agent="voice"><span begin="58.904" end="59.963">怎麼你的</span><span begin="59.963" end="1:00.418">好</span><span begin="1:00.418" end="1:00.830">一放</span><span begin="1:00.830" end="1:01.326">手</span> <span begin="1:01.326" end="1:02.037">就消散</span><span begin="1:02.037" end="1:02.429">在</span><span begin="1:02.429" end="1:02.988">人潮</span></p><p begin="1:03.036" end="1:07.588" itunes:key="L10" ttm:agent="voice"><span begin="1:03.036" end="1:04.499">舍得让我伤心</span><span begin="1:04.499" end="1:05.035">到</span> <span begin="1:05.035" end="1:05.518">连眼</span><span begin="1:05.518" end="1:05.973">泪</span><span begin="1:05.973" end="1:06.431">都像</span><span begin="1:06.431" end="1:06.869">在</span><span begin="1:06.869" end="1:07.069">灼</span><span begin="1:07.069" end="1:07.588">烧</span></p><p begin="1:07.681" end="1:10.917" itunes:key="L11" ttm:agent="voice"><span begin="1:07.681" end="1:08.511">还好我</span><span begin="1:08.511" end="1:08.978">们</span><span begin="1:08.978" end="1:09.416">没有</span><span begin="1:09.416" end="1:09.853">运</span><span begin="1:09.853" end="1:10.917">气到老</span></p><p begin="1:11.135" end="1:13.461" itunes:key="L12" ttm:agent="voice"><span begin="1:11.135" end="1:11.711">不</span><span begin="1:11.711" end="1:12.351">用太</span><span begin="1:12.351" end="1:12.839">煎</span><span begin="1:12.839" end="1:13.461">熬</span></p></div><div begin="1:13.561" end="1:27.616" itunes:songPart="Chorus"><p begin="1:13.561" end="1:17.780" itunes:key="L13" ttm:agent="voice"><span begin="1:13.561" end="1:14.735">怎麼我的</span><span begin="1:14.735" end="1:15.182">好</span><span begin="1:15.182" end="1:15.590">一放</span><span begin="1:15.590" end="1:16.102">手</span> <span begin="1:16.102" end="1:16.826">就会被</span><span begin="1:16.826" end="1:17.191">你</span><span begin="1:17.191" end="1:17.780">忘掉</span></p><p begin="1:17.828" end="1:22.363" itunes:key="L14" ttm:agent="voice"><span begin="1:17.828" end="1:19.381">显得我有多可</span><span begin="1:19.381" end="1:19.814">笑</span> <span begin="1:19.814" end="1:20.268">连不</span><span begin="1:20.268" end="1:20.752">舍</span><span begin="1:20.752" end="1:21.192">都像</span><span begin="1:21.192" end="1:21.681">在</span><span begin="1:21.681" end="1:21.911">乞</span><span begin="1:21.911" end="1:22.363">讨</span></p><p begin="1:22.478" end="1:27.616" itunes:key="L15" ttm:agent="voice"><span begin="1:22.478" end="1:23.275">最后的</span><span begin="1:23.275" end="1:23.930">成全</span><span begin="1:23.930" end="1:24.506">是</span> <span begin="1:24.506" end="1:25.138">说再</span><span begin="1:25.138" end="1:25.716">见</span> <span begin="1:25.716" end="1:26.093">不</span><span begin="1:26.093" end="1:26.733">打</span><span begin="1:26.733" end="1:27.616">扰</span></p></div><div begin="1:43.609" end="1:57.804" itunes:songPart="PreChorus"><p begin="1:43.609" end="1:47.205" itunes:key="L16" ttm:agent="voice"><span begin="1:43.609" end="1:44.182">庆幸</span><span begin="1:44.182" end="1:44.739">是</span> <span begin="1:44.739" end="1:45.222">你给</span><span begin="1:45.222" end="1:45.681">过</span><span begin="1:45.681" end="1:46.151">温暖</span><span begin="1:46.151" end="1:46.624">拥</span><span begin="1:46.624" end="1:47.205">抱</span></p><p begin="1:47.363" end="1:50.755" itunes:key="L17" ttm:agent="voice"><span begin="1:47.363" end="1:47.881">遗憾</span><span begin="1:47.881" end="1:48.404">是</span> <span begin="1:48.404" end="1:48.869">得不</span><span begin="1:48.869" end="1:49.327">到</span><span begin="1:49.327" end="1:49.729">偏又</span><span begin="1:49.729" end="1:50.241">想</span><span begin="1:50.241" end="1:50.755">要</span></p><p begin="1:51.039" end="1:55.303" itunes:key="L18" ttm:agent="voice"><span begin="1:51.039" end="1:51.881">怎麼比</span><span begin="1:51.881" end="1:52.164">较</span><span begin="1:52.164" end="1:52.791">开端和</span><span begin="1:52.791" end="1:53.076">结</span><span begin="1:53.076" end="1:53.458">局</