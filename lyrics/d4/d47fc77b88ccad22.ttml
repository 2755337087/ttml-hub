<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.240"><songwriters><songwriter>赵雷</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="小人物"/>
<amll:meta key="artists" value="赵雷"/>
<amll:meta key="album" value="小人物 - Single"/>
<amll:meta key="album" value="小人物"/>
<amll:meta key="appleMusicId" value="1722408002"/></metadata></head><body dur="4:12.075"><div begin="28.233" end="45.883" itunes:songPart="Verse"><p begin="28.233" end="32.333" itunes:key="L1" ttm:agent="v1"><span begin="28.233" end="28.986">我已经</span><span begin="28.986" end="29.567">找</span><span begin="29.567" end="30.130">到了</span><span begin="30.130" end="30.743">我</span><span begin="30.743" end="31.556">的位</span><span begin="31.556" end="32.333">置</span></p><p begin="32.727" end="37.217" itunes:key="L2" ttm:agent="v1"><span begin="32.727" end="33.536">那需要</span><span begin="33.536" end="34.001">很</span><span begin="34.001" end="34.646">多的</span><span begin="34.646" end="35.079">时</span><span begin="35.079" end="35.808">光去</span><span begin="35.808" end="37.217">交换</span></p><p begin="37.397" end="41.478" itunes:key="L3" ttm:agent="v1"><span begin="37.397" end="39.180">虽然我有时候</span><span begin="39.180" end="39.720">还</span><span begin="39.720" end="40.657">是朦</span><span begin="40.657" end="41.478">胧</span></p><p begin="41.708" end="45.883" itunes:key="L4" ttm:agent="v1"><span begin="41.708" end="43.665">愿岁月留住我天</span><span begin="43.665" end="44.298">真</span><span begin="44.298" end="44.571">的</span><span begin="44.571" end="45.883">样子</span></p></div><div begin="46.244" end="1:04.411" itunes:songPart="Verse"><p begin="46.244" end="50.656" itunes:key="L5" ttm:agent="v1"><span begin="46.244" end="47.126">总幻想</span><span begin="47.126" end="48.269">走进绚</span><span begin="48.269" end="48.791">烂</span><span begin="48.791" end="49.095">的</span><span begin="49.095" end="50.656">生活</span></p><p begin="50.790" end="55.160" itunes:key="L6" ttm:agent="v1"><span begin="50.790" end="51.649">阴晴圆缺</span><span begin="51.649" end="52.781">总有不耐</span><span begin="52.781" end="53.377">烦</span><span begin="53.377" end="53.618">的</span><span begin="53.618" end="55.160">时刻</span></p><p begin="55.386" end="59.721" itunes:key="L7" ttm:agent="v1"><span begin="55.386" end="55.938">跌</span><span begin="55.938" end="57.317">宕起伏别把</span><span begin="57.317" end="57.845">深</span><span begin="57.845" end="58.191">情</span><span begin="58.191" end="59.721">涂抹</span></p><p begin="59.814" end="1:04.411" itunes:key="L8" ttm:agent="v1"><span begin="59.814" end="1:01.889">学不会大人物的</span><span begin="1:01.889" end="1:02.368">毅</span><span begin="1:02.368" end="1:03.153">然洒</span><span begin="1:03.153" end="1:04.411">脱</span></p></div><div begin="1:22.541" end="1:40.567" itunes:songPart="Verse"><p begin="1:22.541" end="1:26.873" itunes:key="L9" ttm:agent="v1"><span begin="1:22.541" end="1:24.507">割舍了多少才敢</span><span begin="1:24.507" end="1:25.089">于</span><span begin="1:25.089" end="1:25.369">去</span><span begin="1:25.369" end="1:26.873">承诺</span></p><p begin="1:26.958" end="1:31.458" itunes:key="L10" ttm:agent="v1"><span begin="1:26.958" end="1:28.995">四季的雨水怎能</span><span begin="1:28.995" end="1:29.570">填</span><span begin="1:29.570" end="1:29.905">满</span><span begin="1:29.905" end="1:31.458">长河</span></p><p begin="1:31.587" end="1:35.875" itunes:key="L11" ttm:agent="v1"><span begin="1:31.587" end="1:33.567">当繁华转身之后</span><span begin="1:33.567" end="1:34.139">变</span><span begin="1:34.139" end="1:34.429">得</span><span begin="1:34.429" end="1:35.875">冷落</span></p><p begin="1:36.010" end="1:40.567" itunes:key="L12" ttm:agent="v1"><span begin="1:36.010" end="1:36.637">人</span><span begin="1:36.637" end="1:38.060">物小就别去</span><span begin="1:38.060" end="1:38.713">张</span><span begin="1:38.713" end="1:39.481">扬自</span><span begin="1:39.481" end="1:40.567">责</span></p></div><div begin="1:42.880" end="2:00.764" itunes:songPart="Chorus"><p begin="1:42.880" end="1:47.282" itunes:key="L13" ttm:agent="v1"><span begin="1:42.880" end="1:43.472">不</span><span begin="1:43.472" end="1:44.931">和贪婪的</span><span begin="1:44.931" end="1:45.704">人相</span><span begin="1:45.704" end="1:47.282">对</span></p><p begin="1:47.449" end="1:51.657" itunes:key="L14" ttm:agent="v1"><span begin="1:47.449" end="1:48.015">不</span><span begin="1:48.015" end="1:49.444">为薄情寡义</span><span begin="1:49.444" end="1:50.324">的人流</span><span begin="1:50.324" end="1:51.657">泪</span></p><p begin="1:51.869" end="1:56.250" itunes:key="L15" ttm:agent="v1"><span begin="1:51.869" end="1:53.934">这世界嘲笑我的</span><span begin="1:53.934" end="1:54.770">人很</span><span begin="1:54.770" end="1:56.250">多</span></p><p begin="1:56.467" end="2:00.764" itunes:key="L16" ttm:agent="v1"><span begin="1:56.467" end="1:58.217">你只是其中一</span><span begin="1:58.217" end="2:00.764">个</span></p></div><div begin="2:01.007" end="2:18.718" itunes:songPart="Chorus"><p begin="2:01.007" end="2:05.446" itunes:key="L17" ttm:agent="v1"><span begin="2:01.007" end="2:01.644">不</span><span begin="2:01.644" end="2:02.699">为岁月</span><span begin="2:02.699" end="2:03.859">流逝蹉</span><span begin="2:03.859" end="2:05.446">跎</span></p><p begin="2:05.563" end="2:09.715" itunes:key="L18" ttm:agent="v1"><span begin="2:05.563" end="2:06.129">不</span><span begin="2:06.129" end="2:08.364">随潮流的势头去附</span><span begin="2:08.364" end="2:09.715">和</span></p><p begin="2:09.970" end="2:14.320" itunes:key="L19" ttm:agent="v1"><span begin="2:09.970" end="2:12.048">小人物的拳头时</span><span begin="2:12.048" end="2:12.534">刻</span><span begin="2:12.534" end="2:13.396">紧握</span><span begin="2:13.396" end="2:14.320">着</span></p><p begin="2:14.607" end="2:18.718" itunes:key="L20" ttm:agent="v1"><span begin="2:14.607" end="2:15.428">这正是</span><span begin="2:15.428" end="2:16.333">我的角</span><span begin="2:16.333" end="2:18.718">色</span></p></div><div begin="2:53.128" end="3:11.013" itunes:songPart="Bridge"><p begin="2:53.128" end="3:00.437" itunes:key="L21" ttm:agent="v1"><span begin="2:53.128" end="2:54.834">花开不并百花</span><span begin="2:54.834" end="2:55.407">丛</span> <span begin="2:55.407" end="2:55.906">独</span><span begin="2:55.906" end="2:57.057">立疏篱趣</span><span begin="2:57.057" end="2:57.539">未</span><span begin="2:57.539" end="3:00.437">穷</span></p><p begin="3:02.177" end="3:11.013" itunes:key="L22" ttm:agent="v1"><span begin="3:02.177" end="3:03.790">宁可枝头抱香</span><span begin="3:03.790" end="3:04.412">死</span> <span begin="3:04.412" end="3:05.034">何</span><span begin="3:05.034" end="3:06.097">曾吹落北</span><span begin="3:06.097" end="3:06.718">风</span><span begin="3:06.718" end="3:11.013">中</span></p></div><div begin="3:11.220" end="3:29.261" itunes:songPart="Chorus"><p begin="3:11.220" end="3:15.562" itunes:key="L23" ttm:agent="v1"><span begin="3:11.220" end="3:11.812">不</span><span begin="3:11.812" end="3:13.271">和贪婪的</span><span begin="3:13.271" end="3:14.044">人相</span><span begin="3:14.044" end="3:15.562">对</span></p><p begin="3:15.709" end="3:19.917" itunes:key="L24" ttm:agent="v1"><span begin="3:15.709" end="3:16.275">不</span><span begin="3:16.275" end="3:17.704">为薄情寡义</span><span begin="3:17.704" end="3:18.584">的人流</span><span begin="3:18.584" end="3:19.917">泪</span></p><p begin="3:20.179" end="3:24.560" itunes:key="L25" ttm:agent="v1"><span begin="3:20.179" end="3:22.244">这世界嘲笑我的</span><span begin="3:22.244" end="3:23.080">人很</span><span begin="3:23.080" end="3:24.560">多</span></p><p begin="3:24.785" end="3:29.261" itunes:key="L26" ttm:agent="v1"><span begin="3:24.785" end="3:26.465">你只是其中一</span><span begin="3:26.465" end="3:29.261">个</span></p></div><div begin="3:29.347" end="3:46.975" itunes:songPart="Chorus"><p begin="3:29.347" end="3:33.786" itunes:key="L27" ttm:agent="v1"><span begin="3:29.347" end="3:29.984">不</span><span begin="3:29.984" end="3:31.039">为岁月</span><span begin="3:31.039" end="3:32.199">流逝蹉</span><span begin="3:32.199" end="3:33.786">跎</span></p><p begin="3:33.813" end="3:37.965" itunes:key="L28" ttm:agent="v1"><span begin="3:33.813" end="3:34.379">不</span><span begin="3:34.379" end="3:36.614">随潮流的势头去附</span><span begin="3:36.614" end="3:37.965">和</span></p><p begin="3:38.309" end="3:42.659" itunes:key="L29" ttm:agent="v1"><span begin="3:38.309" end="3:40.387">小人物的拳头时</span><span begin="3:40.387" end="3:40.873">刻</span><span begin="3:40.873" end="3:41.735">紧握</span><span begin="3:41.735" end="3:42.659">着</span></p><p begin="3:42.864" end="3:46.975" itunes:key="L30" ttm:agent="v1"><span begin="3:42.864" end="3:43.685">这正是</span><span begin="3:43.685" end="3:44.590">我的角</span><span begin="3:44.590" end="3:46.975">色</span></p></div><div begin="3:47.363" end="4:05.045" itunes:songPart="Chorus"><p begin="3:47.363" end="3:51.474" itunes:key="L31" ttm:agent="v1"><span begin="3:47.363" end="3:48.184">这正是</span><span begin="3:48.184" end="3:49.089">我的角</span><span begin="3:49.089" end="3:51.474">色</span></p><p begin="3:51.948" end="3:56.059" itunes:key="L32" ttm:agent="v1"><span begin="3:51.948" end="3:52.769">这正是</span><span begin="3:52.769" end="3:53.674">我的角</span><span begin="3:53.674" end="3:56.059">色</span></p><p begin="3:56.463" end="4:00.574" itunes:key="L33" ttm:agent="v1"><span begin="3:56.463" end="3:57.284">这正是</span><span begin="3:57.284" end="3:58.189">我的角</span><span begin="3:58.189" end="4:00.574">色</span></p><p begin="4:01.040" end="4:05.045" itunes:key="L34" ttm:agent="v1"><span begin="4:01.040" end="4:02.254">这正是</span><span begin="4:02.254" end="4:05.045">我</span></p></div></body></tt>