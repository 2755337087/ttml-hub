<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>告五人云安</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="我天生 - 有梦版"/>
<amll:meta key="artists" value="告五人"/>
<amll:meta key="album" value="我们就像那些要命的傻瓜"/>
<amll:meta key="appleMusicId" value="1822757835"/></metadata></head><body dur="4:40.488"><div begin="1.256" end="11.447" itunes:songPart="Intro"><p begin="1.256" end="11.447" itunes:key="L1" ttm:agent="v1"><span begin="1.256" end="4.423">我天生有</span><span begin="4.423" end="5.411">病</span> <span begin="7.292" end="10.451">才会喜欢</span><span begin="10.451" end="11.447">你</span></p></div><div begin="42.181" end="1:06.088" itunes:songPart="Verse"><p begin="42.181" end="45.054" itunes:key="L2" ttm:agent="v1"><span begin="42.181" end="42.772">一杯</span><span begin="42.772" end="43.204">咖</span><span begin="43.204" end="43.911">啡</span> <span begin="43.911" end="44.282">一点</span><span begin="44.282" end="44.696">甜</span><span begin="44.696" end="45.054">点</span></p><p begin="45.394" end="48.196" itunes:key="L3" ttm:agent="v1"><span begin="45.394" end="46.222">怎么会都</span><span begin="46.222" end="46.995">是难</span><span begin="46.995" end="47.394">达的</span><span begin="47.394" end="47.798">夙</span><span begin="47.798" end="48.196">愿</span></p><p begin="48.485" end="51.188" itunes:key="L4" ttm:agent="v1"><span begin="48.485" end="48.929">萍水</span><span begin="48.929" end="49.318">相</span><span begin="49.318" end="49.950">逢</span> <span begin="49.950" end="50.420">细胞</span><span begin="50.420" end="50.838">更</span><span begin="50.838" end="51.188">迭</span></p><p begin="51.493" end="54.357" itunes:key="L5" ttm:agent="v1"><span begin="51.493" end="52.331">触碰灵魂</span><span begin="52.331" end="52.783">却</span><span begin="52.783" end="53.532">不敢让你</span><span begin="53.532" end="53.951">察</span><span begin="53.951" end="54.357">觉</span></p><p begin="54.654" end="58.047" itunes:key="L6" ttm:agent="v1"><span begin="54.654" end="55.123">我</span><span begin="55.123" end="55.312">的</span><span begin="55.312" end="56.782">意念并不</span><span begin="56.782" end="57.012">是</span><span begin="57.012" end="57.284">思</span><span begin="57.284" end="58.047">念</span></p><p begin="1:00.755" end="1:06.088" itunes:key="L7" ttm:agent="v1"><span begin="1:00.755" end="1:01.548">至少</span><span begin="1:01.548" end="1:02.172">一开</span><span begin="1:02.172" end="1:02.808">始</span><span begin="1:02.808" end="1:03.184">我是</span><span begin="1:03.184" end="1:03.916">这</span><span begin="1:03.916" end="1:04.611">么</span><span begin="1:04.611" end="1:05.388">认</span><span begin="1:05.388" end="1:06.088">为</span></p></div><div begin="1:06.813" end="1:30.840" itunes:songPart="Verse"><p begin="1:06.813" end="1:09.660" itunes:key="L8" ttm:agent="v1"><span begin="1:06.813" end="1:07.386">海水</span><span begin="1:07.386" end="1:07.799">的</span><span begin="1:07.799" end="1:08.449">蓝</span> <span begin="1:08.449" end="1:08.892">天空</span><span begin="1:08.892" end="1:09.278">诙</span><span begin="1:09.278" end="1:09.660">谐</span></p><p begin="1:09.961" end="1:13.048" itunes:key="L9" ttm:agent="v1"><span begin="1:09.961" end="1:10.820">怎么能因</span><span begin="1:10.820" end="1:11.617">为羞</span><span begin="1:11.617" end="1:12.020">怯而</span><span begin="1:12.020" end="1:12.319">妥</span><span begin="1:12.319" end="1:13.048">协</span></p><p begin="1:13.101" end="1:15.857" itunes:key="L10" ttm:agent="v1"><span begin="1:13.101" end="1:13.533">几张</span><span begin="1:13.533" end="1:13.899">考</span><span begin="1:13.899" end="1:14.652">卷</span> <span begin="1:14.652" end="1:15.040">几次</span><span begin="1:15.040" end="1:15.425">见</span><span begin="1:15.425" end="1:15.857">面</span></p><p begin="1:16.110" end="1:20.064" itunes:key="L11" ttm:agent="v1"><span begin="1:16.110" end="1:16.981">想说的话</span><span begin="1:16.981" end="1:17.366">却</span><span begin="1:17.366" end="1:18.165">无法说的</span><span begin="1:18.165" end="1:18.599">完</span><span begin="1:18.599" end="1:20.064">美</span></p><p begin="1:19.240" end="1:22.484" itunes:key="L12" ttm:agent="v1"><span begin="1:19.240" end="1:19.671">这</span><span begin="1:19.671" end="1:19.888">份</span><span begin="1:19.888" end="1:21.388">思念它若</span><span begin="1:21.388" end="1:21.604">是</span><span begin="1:21.604" end="1:21.903">直</span><span begin="1:21.903" end="1:22.484">觉</span></p><p begin="1:25.290" end="1:30.840" itunes:key="L13" ttm:agent="v1"><span begin="1:25.290" end="1:25.761">忽</span><span begin="1:25.761" end="1:26.021">然</span><span begin="1:26.021" end="1:26.446">每</span><span begin="1:26.446" end="1:27.201">天</span><span begin="1:27.201" end="1:27.828">都变得</span><span begin="1:27.828" end="1:30.086">值得纪</span><span begin="1:30.086" end="1:30.840">念</span></p></div><div begin="1:30.850" end="2:25.781" itunes:songPart="Chorus"><p begin="1:30.850" end="1:40.904" itunes:key="L14" ttm:agent="v1"><span begin="1:30.850" end="1:33.949">我天生有</span><span begin="1:33.949" end="1:35.028">病</span> <span begin="1:36.848" end="1:40.013">才毫无顾</span><span begin="1:40.013" end="1:40.904">忌</span></p><p begin="1:42.857" end="1:48.595" itunes:key="L15" ttm:agent="v1"><span begin="1:42.857" end="1:43.152">用</span><span begin="1:43.152" end="1:44.535">仅存的时</span><span begin="1:44.535" end="1:45.575">间</span> <span begin="1:45.825" end="1:46.210">框住</span><span begin="1:46.210" end="1:46.675">和</span><span begin="1:46.675" end="1:46.860">你</span><span begin="1:46.860" end="1:47.605">的关</span><span begin="1:47.605" end="1:48.595">系</span></p><p begin="1:49.052" end="1:55.239" itunes:key="L16" ttm:agent="v1"><span begin="1:49.052" end="1:49.341">没</span><span begin="1:49.341" end="1:49.645">有</span><span begin="1:49.645" end="1:49.910">放</span><span begin="1:49.910" end="1:50.600">弃</span> <span begin="1:50.627" end="1:50.852">只</span><span begin="1:50.852" end="1:51.058">想</span><span begin="1:51.058" end="1:51.461">和</span><span begin="1:51.461" end="1:52.161">你</span> <span begin="1:52.305" end="1:54.694">相依为</span><span begin="1:54.694" end="1:55.239">命</span></p><p begin="1:55.369" end="2:05.423" itunes:key="L17" ttm:agent="v1"><span begin="1:55.369" end="1:58.468">我天生有</span><span begin="1:58.468" end="1:59.547">病</span> <span begin="2:01.367" end="2:04.532">才毫无顾</span><span begin="2:04.532" end="2:05.423">忌</span></p><p begin="2:07.478" end="2:13.469" itunes:key="L18" ttm:agent="v1"><span begin="2:07.478" end="2:07.752">用</span><span begin="2:07.752" end="2:08.114">残</span><span begin="2:08.114" end="2:08.370">存</span><span begin="2:08.370" end="2:09.146">的灵</span><span begin="2:09.146" end="2:10.267">魂</span> <span begin="2:10.560" end="2:10.810">来</span><span begin="2:10.810" end="2:11.449">告诉</span><span begin="2:11.449" end="2:12.039">你</span> <span begin="2:12.039" end="2:12.351">我有</span><span begin="2:12.351" end="2:13.016">多珍</span><span begin="2:13.016" end="2:13.469">惜</span></p><p begin="2:13.628" end="2:16.543" itunes:key="L19" ttm:agent="v1"><span begin="2:13.628" end="2:13.906">虽</span><span begin="2:13.906" end="2:14.250">然</span><span begin="2:14.250" end="2:14.492">生</span><span begin="2:14.492" end="2:15.208">命</span> <span begin="2:15.298" end="2:15.474">已</span><span begin="2:15.474" end="2:15.679">经</span><span begin="2:15.679" end="2:16.071">没</span><span begin="2:16.071" end="2:16.543">有</span></p><p begin="2:16.705" end="2:25.781" itunes:key="L20" ttm:agent="v1"><span begin="2:16.705" end="2:16.975">那</span><span begin="2:16.975" end="2:17.798">么多</span><span begin="2:17.798" end="2:18.153">的</span><span begin="2:18.153" end="2:18.370">未</span><span begin="2:18.370" end="2:19.049">来</span> <span begin="2:19.073" end="2:19.297">能</span><span begin="2:19.297" end="2:19.581">够</span><span begin="2:19.581" end="2:20.076">给</span><span begin="2:20.076" end="2:25.781">你</span></p></div><div begin="2:25.921" end="2:53.738" itunes:songPart="Bridge"><p begin="2:25.921" end="2:28.861" itunes:key="L21" ttm:agent="v1"><span begin="2:25.921" end="2:28.361">在按部就班里试着摸清来不</span><span begin="2:28.361" end="2:28.861">及</span></p><p begin="2:29.036" end="2:31.968" itunes:key="L22" ttm:agent="v1"><span begin="2:29.036" end="2:31.421">在狂风暴雨中我们看见了宁</span><span begin="2:31.421" end="2:31.968">静</span></p><p begin="2:32.264" end="2:38.131" itunes:key="L23" ttm:agent="v1"><span begin="2:32.264" end="2:33.904">都还在懵</span><span begin="2:33.904" end="2:34.267">懂</span><span begin="2:34.267" end="2:34.492">年</span><span begin="2:34.492" end="2:34.881">纪</span><span begin="2:34.881" end="2:35.267">里</span> <span begin="2:35.267" end="2:35.491">伪</span><span begin="2:35.491" end="2:35.835">装</span><span begin="2:35.835" end="2:36.222">成熟</span><span begin="2:36.222" end="2:36.395">的</span><span begin="2:36.395" end="2:36.790">掌</span><span begin="2:36.790" end="2:38.131">心</span></p><p begin="2:38.298" end="2:41.141" itunes:key="L24" ttm:agent="v1"><span begin="2:38.298" end="2:40.669">在拥抱欢笑后感受眼泪的透</span><span begin="2:40.669" end="2:41.141">明</span></p><p begin="2:41.344" end="2:44.306" itunes:key="L25" ttm:agent="v1"><span begin="2:41.344" end="2:43.722">在眼泪背后发现了珍贵的光</span><span begin="2:43.722" end="2:44.306">阴</span></p><p begin="2:44.573" end="2:53.738" itunes:key="L26" ttm:agent="v1"><span begin="2:44.573" end="2:46.212">为何要在</span><span begin="2:46.212" end="2:46.530">懵</span><span begin="2:46.530" end="2:46.823">懂</span><span begin="2:46.823" end="2:47.422">里</span> <span begin="2:47.446" end="2:47.680">学</span><span begin="2:47.680" end="2:49.840">会</span> <span begin="2:49.870" end="2:50.077">面</span><span begin="2:50.077" end="2:50.333">对</span><span begin="2:50.333" end="2:50.684">命</span><span begin="2:50.684" end="2:53.738">运</span></p></div><div begin="2:53.857" end="3:47.043" itunes:songPart="Chorus"><p begin="2:53.857" end="3:04.451" itunes:key="L27" ttm:agent="v1"><span begin="2:53.857" end="2:56.956">我天生有</span><span begin="2:56.956" end="2:58.035">病</span> <span begin="2:59.855" end="3:03.020">才毫无顾</span><span begin="3:03.020" end="3:04.451">忌</span></p><p begin="3:05.925" end="3:11.633" itunes:key="L28" ttm:agent="v1"><span begin="3:05.925" end="3:06.220">用</span><span begin="3:06.220" end="3:07.603">仅存的时</span><span begin="3:07.603" end="3:08.643">间</span> <span begin="3:08.893" end="3:09.278">框住</span><span begin="3:09.278" end="3:09.743">和</span><span begin="3:09.743" end="3:09.928">你</span><span begin="3:09.928" end="3:10.673">的关</span><span begin="3:10.673" end="3:11.633">系</span></p><p begin="3:12.088" end="3:18.275" itunes:key="L29" ttm:agent="v1"><span begin="3:12.088" end="3:12.377">没</span><span begin="3:12.377" end="3:12.681">有</span><span begin="3:12.681" end="3:12.946">放</span><span begin="3:12.946" end="3:13.636">弃</span> <span begin="3:13.663" end="3:13.888">只</span><span begin="3:13.888" end="3:14.094">想</span><span begin="3:14.094" end="3:14.497">和</span><span begin="3:14.497" end="3:15.197">你</span> <span begin="3:15.341" end="3:17.730">相依为</span><span begin="3:17.730" end="3:18.275">命</span></p><p begin="3:18.441" end="3:29.355" itunes:key="L30" ttm:agent="v1"><span begin="3:18.441" end="3:21.540">我天生有</span><span begin="3:21.540" end="3:22.619">病</span> <span begin="3:24.439" end="3:27.604">才毫无顾</span><span begin="3:27.604" end="3:29.355">忌</span></p><p begin="3:30.522" end="3:36.653" itunes:key="L31" ttm:agent="v1"><span begin="3:30.522" end="3:30.796">用</span><span begin="3:30.796" end="3:31.158">残</span><span begin="3:31.158" end="3:31.414">存</span><span begin="3:31.414" end="3:32.190">的灵</span><span begin="3:32.190" end="3:33.311">魂</span> <span begin="3:33.604" end="3:33.854">来</span><span begin="3:33.854" end="3:34.493">告诉</span><span begin="3:34.493" end="3:35.083">你</span> <span begin="3:35.083" end="3:35.395">我有</span><span begin="3:35.395" end="3:36.060">多珍</span><span begin="3:36.060" end="3:36.653">惜</span></p><p begin="3:36.688" end="3:39.583" itunes:key="L32" ttm:agent="v1"><span begin="3:36.688" end="3:36.966">虽</span><span begin="3:36.966" end="3:37.310">然</span><span begin="3:37.310" end="3:37.552">生</span><span begin="3:37.552" end="3:38.268">命</span> <span begin="3:38.358" end="3:38.534">已</span><span begin="3:38.534" end="3:38.739">经</span><span begin="3:38.739" end="3:39.131">没</span><span begin="3:39.131" end="3:39.583">有</span></p><p begin="3:39.777" end="3:47.043" itunes:key="L33" ttm:agent="v1"><span begin="3:39.777" end="3:40.047">那</span><span begin="3:40.047" end="3:40.870">么多</span><span begin="3:40.870" end="3:41.225">的</span><span begin="3:41.225" end="3:41.442">未</span><span begin="3:41.442" end="3:42.121">来</span> <span begin="3:42.145" end="3:42.369">能</span><span begin="3:42.369" end="3:42.653">够</span><span begin="3:42.653" end="3:43.148">给</span><span begin="3:43.148" end="3:47.043">你</span></p></div><div begin="3:49.147" end="4:25.527" itunes:songPart="Chorus"><p begin="3:49.147" end="4:00.092" itunes:key="L34" ttm:agent="v1"><span begin="3:49.147" end="3:52.365">我就是有</span><span begin="3:52.365" end="3:53.506">病</span> <span begin="3:55.416" end="3:58.525">才会喜欢</span><span begin="3:58.525" end="4:00.092">你</span></p><p begin="4:01.069" end="4:09.830" itunes:key="L35" ttm:agent="v1"><span begin="4:01.069" end="4:01.609">祈求</span><span begin="4:01.609" end="4:01.981">未</span><span begin="4:01.981" end="4:02.176">知</span><span begin="4:02.176" end="4:02.975">的幸</span><span begin="4:02.975" end="4:03.985">运</span> <span begin="4:04.262" end="4:04.611">能够</span><span begin="4:04.611" end="4:05.034">给</span><span begin="4:05.034" end="4:05.979">你和我勇</span><span begin="4:05.979" end="4:09.830">气</span></p><p begin="4:11.897" end="4:16.337" itunes:key="L36" ttm:agent="v1"><span begin="4:11.897" end="4:12.424">让我</span><span begin="4:12.424" end="4:13.204">拥抱</span><span begin="4:13.204" end="4:13.595">你</span><span begin="4:13.595" end="4:13.837">的</span><span begin="4:13.837" end="4:14.201">姓</span><span begin="4:14.201" end="4:14.656">名</span> <span begin="4:14.710" end="4:15.385">走下</span><span begin="4:15.385" end="4:16.337">去</span></p><p begin="4:18.156" end="4:25.527" itunes:key="L37" ttm:agent="v1"><span begin="4:18.156" end="4:18.643">你永</span><span begin="4:18.643" end="4:20.364">远都会活</span><span begin="4:20.364" end="4:21.914">在</span> <span begin="4:23.524" end="4:24.129">我心</span><span begin="4:24.129" end="4:25.527">里</span></p></div></body></tt>