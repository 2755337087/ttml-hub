<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>汪苏泷</songwriter></songwriters><audio lyricOffset="-0.091" role="spatial"/></iTunesMetadata>
<amll:meta key="musicName" value="雨你 (汪苏泷概念创作集《联名》作品)"/>
<amll:meta key="artists" value="薛凯琪"/>
<amll:meta key="album" value="联名"/>
<amll:meta key="appleMusicId" value="6774655999"/></metadata></head><body dur="4:16.130"><div begin="18.834" end="47.032" itunes:songPart="Verse"><p begin="18.834" end="23.807" itunes:key="L1" ttm:agent="v1"><span begin="18.834" end="20.082">雨</span> <span begin="20.707" end="22.676">飘落在风</span><span begin="22.676" end="23.807">里</span></p><p begin="26.374" end="31.217" itunes:key="L2" ttm:agent="v1"><span begin="26.374" end="27.307">风</span> <span begin="28.357" end="30.210">把落叶吹</span><span begin="30.210" end="31.217">起</span></p><p begin="34.015" end="39.357" itunes:key="L3" ttm:agent="v1"><span begin="34.015" end="35.015">叶</span> <span begin="35.987" end="38.030">飞到我手</span><span begin="38.030" end="39.357">里</span></p><p begin="41.735" end="47.032" itunes:key="L4" ttm:agent="v1"><span begin="41.735" end="42.948">或</span> <span begin="43.501" end="45.558">在等这场</span><span begin="45.558" end="47.032">雨</span></p></div><div begin="49.443" end="1:03.394" itunes:songPart="PreChorus"><p begin="49.443" end="54.312" itunes:key="L5" ttm:agent="v1"><span begin="49.443" end="51.035">耳边</span><span begin="51.190" end="53.118">细雨的温</span><span begin="53.118" end="54.312">柔</span></p><p begin="54.995" end="56.968" itunes:key="L6" ttm:agent="v1"><span begin="54.995" end="56.968">想起那时</span></p><p begin="56.978" end="1:03.394" itunes:key="L7" ttm:agent="v1"><span begin="56.978" end="58.688">我曾</span> <span begin="58.887" end="1:00.776">牵过你的</span><span begin="1:00.776" end="1:03.394">手</span></p></div><div begin="1:03.649" end="1:32.905" itunes:songPart="Chorus"><p begin="1:03.649" end="1:09.366" itunes:key="L8" ttm:agent="v1"><span begin="1:03.649" end="1:04.625">在</span><span begin="1:04.625" end="1:08.254">滴答滴答 下完那场</span><span begin="1:08.254" end="1:09.366">雨</span></p><p begin="1:10.361" end="1:17.209" itunes:key="L9" ttm:agent="v1"><span begin="1:10.361" end="1:15.506">冷空气凝结 听不见我那句</span><span begin="1:15.506" end="1:15.856">叹</span><span begin="1:15.856" end="1:17.209">息</span></p><p begin="1:17.888" end="1:24.391" itunes:key="L10" ttm:agent="v1"><span begin="1:17.888" end="1:19.703">写给你的</span><span begin="1:19.703" end="1:20.441">信</span> <span begin="1:21.692" end="1:23.090">得不到</span><span begin="1:23.090" end="1:23.488">回</span><span begin="1:23.488" end="1:24.391">音</span></p><p begin="1:25.476" end="1:32.905" itunes:key="L11" ttm:agent="v1"><span begin="1:25.476" end="1:27.386">身边放着</span><span begin="1:27.386" end="1:31.250">为你演奏过的手风</span><span begin="1:31.250" end="1:32.905">琴</span></p></div><div begin="1:33.262" end="1:59.505" itunes:songPart="Chorus"><p begin="1:33.262" end="1:40.065" itunes:key="L12" ttm:agent="v1"><span begin="1:33.262" end="1:35.135">而我就在</span><span begin="1:35.135" end="1:38.400">嘀嗒嘀嗒 时间已</span><span begin="1:38.400" end="1:38.730">过</span><span begin="1:38.730" end="1:40.065">去</span></p><p begin="1:40.840" end="1:47.431" itunes:key="L13" ttm:agent="v1"><span begin="1:40.840" end="1:42.754">回忆里的</span><span begin="1:42.754" end="1:46.035">你 定格每一帧都</span><span begin="1:46.035" end="1:46.461">美</span><span begin="1:46.461" end="1:47.431">丽</span></p><p begin="1:48.347" end="1:55.005" itunes:key="L14" ttm:agent="v1"><span begin="1:48.347" end="1:50.350">下不停的</span><span begin="1:50.350" end="1:51.271">雨</span> <span begin="1:52.123" end="1:53.659">睁不开</span><span begin="1:53.659" end="1:54.004">眼</span><span begin="1:54.004" end="1:55.005">睛</span></p><p begin="1:55.841" end="1:59.505" itunes:key="L15" ttm:agent="v1"><span begin="1:55.841" end="1:56.663">我会</span><span begin="1:56.663" end="1:58.322">把你忘</span><span begin="1:58.322" end="1:59.505">记</span></p></div><div begin="2:14.005" end="2:42.249" itunes:songPart="Verse"><p begin="2:14.005" end="2:19.078" itunes:key="L16" ttm:agent="v1"><span begin="2:14.005" end="2:15.253">雨</span> <span begin="2:15.878" end="2:17.847">飘落在风</span><span begin="2:17.847" end="2:19.078">里</span></p><p begin="2:21.535" end="2:26.368" itunes:key="L17" ttm:agent="v1"><span begin="2:21.535" end="2:22.804">风</span> <span begin="2:23.508" end="2:25.361">把落叶吹</span><span begin="2:25.361" end="2:26.368">起</span></p><p begin="2:29.182" end="2:34.674" itunes:key="L18" ttm:agent="v1"><span begin="2:29.182" end="2:30.510">叶</span> <span begin="2:31.154" end="2:33.197">飞到我手</span><span begin="2:33.197" end="2:34.674">里</span></p><p begin="2:36.872" end="2:42.249" itunes:key="L19" ttm:agent="v1"><span begin="2:36.872" end="2:38.173">或</span> <span begin="2:38.638" end="2:40.695">在等这场</span><span begin="2:40.695" end="2:42.249">雨</span></p></div><div begin="2:44.537" end="2:58.461" itunes:songPart="PreChorus"><p begin="2:44.537" end="2:49.426" itunes:key="L20" ttm:agent="v1"><span begin="2:44.537" end="2:46.129">耳边</span><span begin="2:46.284" end="2:48.212">细雨的温</span><span begin="2:48.212" end="2:49.426">柔</span></p><p begin="2:50.127" end="2:52.035" itunes:key="L21" ttm:agent="v1"><span begin="2:50.127" end="2:52.035">想起那时</span></p><p begin="2:52.045" end="2:58.461" itunes:key="L22" ttm:agent="v1"><span begin="2:52.045" end="2:53.755">我曾</span> <span begin="2:53.954" end="2:55.843">牵过你的</span><span begin="2:55.843" end="2:58.461">手</span></p></div><div begin="2:58.686" end="3:28.079" itunes:songPart="Chorus"><p begin="2:58.686" end="3:04.533" itunes:key="L23" ttm:agent="v1"><span begin="2:58.686" end="2:59.662">在</span><span begin="2:59.662" end="3:03.291">滴答滴答 下完那场</span><span begin="3:03.291" end="3:04.533">雨</span></p><p begin="3:05.443" end="3:12.291" itunes:key="L24" ttm:agent="v1"><span begin="3:05.443" end="3:10.588">冷空气凝结 听不见我那句</span><span begin="3:10.588" end="3:10.938">叹</span><span begin="3:10.938" end="3:12.291">息</span></p><p begin="3:12.989" end="3:20.008" itunes:key="L25" ttm:agent="v1"><span begin="3:12.989" end="3:14.804">写给你的</span><span begin="3:14.804" end="3:15.814">信</span> <span begin="3:16.793" end="3:18.191">得不到</span><span begin="3:18.191" end="3:18.589">回</span><span begin="3:18.589" end="3:20.008">音</spa