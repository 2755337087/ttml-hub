<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">刘雨昕</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">戴萌</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v3"><ttm:name type="full">许佳琪</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v4"><ttm:name type="full">孔雪儿</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v5"><ttm:name type="full">刘令姿</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v6"><ttm:name type="full">陆柯燃</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v7"><ttm:name type="full">喻言</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v8"><ttm:name type="full">戴燕妮</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v9"><ttm:name type="full">乃万</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v10"><ttm:name type="full">宋昕冉</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v11"><ttm:name type="full">孙芮</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v12"><ttm:name type="full">安崎</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v13"><ttm:name type="full">王承渲</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v14"><ttm:name type="full">谢可寅</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v15"><ttm:name type="full">上官喜爱</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v16"><ttm:name type="full">金子涵</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v17"><ttm:name type="full">虞书欣</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v18"><ttm:name type="full">赵小棠</ttm:name></ttm:agent><ttm:agent type="organization" xml:id="v19"><ttm:name type="full">赵小棠</ttm:name><ttm:name type="full">刘令姿</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v20"><ttm:name type="full">曾可妮</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v21"><ttm:name type="full">徐紫茵</ttm:name></ttm:agent><ttm:agent type="group" xml:id="v1000"><ttm:name type="full">合唱</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>樊帆</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">Yes ok yo 是我们找到彼此的暗号</text><text for="L2">Yes ok yo 是你让星光在我指尖舞蹈</text><text for="L3">从那天 初次遇见</text><text for="L4">到后来 青春每一页</text><text for="L5">这段记忆 是夹在故事中那张书签</text><text for="L6">有一束光 将我照亮</text><text for="L7">当我在没人的地方 低声歌唱</text><text for="L8">跌跌撞撞 去向远方 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(跌跌撞撞 去向远方)</span></text><text for="L9">赤着脚拼命奔跑 想要向世界证明我并不渺小</text><text for="L10">谢谢你 用微笑 参与我这段年少</text><text for="L11">这是我与你的约定</text><text for="L12">一个出发时就已写下的约定</text><text for="L13">不管未来多遥远 一起到达 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(一起到达)</span></text><text for="L14">这是我与你的约定</text><text for="L15">一个永远不改变的约定</text><text for="L16">让每一个初夏 绽放着回忆里的花</text><text for="L17">多少个大雨滂沱 把风景都变得浑浊</text><text for="L18">难得是你和我 每双眼都依然清澈</text><text for="L19">直到时光 都褪了色</text><text for="L20">这场梦会在我们心中镌刻</text><text for="L21">从那天 初次遇见</text><text for="L22">到后来 青春每一页</text><text for="L23">这段记忆 是夹在故事中那张书签</text><text for="L24">有一束光 将我照亮 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(有一束光 将我照亮)</span></text><text for="L25">当我在没人的地方 低声歌唱</text><text for="L26">跌跌撞撞 去向远方 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(跌跌撞撞 去向远方)</span></text><text for="L27">赤着脚拼命奔跑 想要向世界证明我并不渺小</text><text for="L28">谢谢你 用微笑 参与我这段年少</text><text for="L29">Baby I promise</text><text for="L30">这是我与你的约定</text><text for="L31">初见时便已许下的约定</text><text for="L32">不管未来多遥远 一起到达 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(一起到达)</span></text><text for="L33">这是我与你的约定</text><text for="L34">未来也要一起实现的约定</text><text for="L35">让每一个初夏 绽放着回忆里的花</text><text for="L36">时间啊 如果回到故事开头</text><text for="L37">我依然 会选择和你们一起走</text><text for="L38">无论哪个 平行时空</text><text for="L39">都写好了同样的邂逅</text><text for="L40">写给时光的信都用青春落款</text><text for="L41">我终于在你的目光里得到了答案</text><text for="L42">所有遗憾 都被我们 变成灿烂</text><text for="L43">这是我与你的约定</text><text for="L44">心中不停默念的约定</text><text for="L45">不管未来多遥远 一起到达 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(一起到达)</span></text><text for="L46">这是我与你的约定</text><text for="L47">一个永不褪色的约定</text><text for="L48">让每一个初夏 绽放着 回忆里的花</text><text for="L49">这是我与你的约定</text><text for="L50">伴我一路前行的约定</text><text for="L51">不管未来多遥远 一起到达 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(一起到达)</span></text><text for="L52">这是我与你的约定</text><text for="L53">想起会面带微笑的约定</text><text for="L54">让每一个初夏 绽放着 回忆里的花</text><text for="L55">这是我与你的约定</text><text for="L56">铭刻在心底的约定</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="Promise (Live)"/><amll:meta key="artists" value="安崎"/><amll:meta key="artists" value="戴萌"/><amll:meta key="artists" value="戴燕妮"/><amll:meta key="artists" value="金子涵"/><amll:meta key="artists" value="孔雪儿"/><amll:meta key="artists" value="陆柯燃K"/><amll:meta key="artists" value="刘令姿"/><amll:meta key="artists" value="刘雨昕"/><amll:meta key="artists" value="NINEONE赵馨玥"/><amll:meta key="artists" value="上官喜爱"/><amll:meta key="artists" value="孙芮"/><amll:meta key="artists" value="SNH48宋昕冉"/><amll:meta key="artists" value="王承渲"/><amll:meta key="artists" value="许佳琪"/><amll:meta key="artists" value="谢可寅"/><amll:meta k