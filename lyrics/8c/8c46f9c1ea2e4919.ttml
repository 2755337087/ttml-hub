<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="1.380"><songwriters><songwriter>姜洄</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="若月亮没来(若是月亮还没来)"/>
<amll:meta key="artists" value="王宇宙Leto"/>
<amll:meta key="artists" value="乔浚丞"/>
<amll:meta key="album" value="若月亮没来(若是月亮还没来) - Single"/>
<amll:meta key="album" value="若月亮没来(若是月亮还没来)"/>
<amll:meta key="appleMusicId" value="6789437202"/></metadata></head><body dur="2:53.822"><div begin="1.753" end="29.202" itunes:songPart="Verse"><p begin="1.753" end="8.433" itunes:key="L1" ttm:agent="v1"><span begin="1.753" end="3.115">风吹过</span><span begin="3.115" end="4.892">山</span> <span begin="5.357" end="6.697">船靠了</span><span begin="6.697" end="8.433">岸</span></p><p begin="9.111" end="15.345" itunes:key="L2" ttm:agent="v1"><span begin="9.111" end="10.121">风光</span><span begin="10.121" end="11.576">呀</span> <span begin="12.223" end="13.530">一点点</span><span begin="13.530" end="15.345">看</span></p><p begin="15.701" end="22.812" itunes:key="L3" ttm:agent="v1"><span begin="15.701" end="17.010">我走向</span><span begin="17.010" end="18.774">北</span> <span begin="19.136" end="20.385">你去往</span><span begin="20.385" end="22.812">南</span></p><p begin="23.084" end="29.202" itunes:key="L4" ttm:agent="v1"><span begin="23.084" end="23.556">故</span><span begin="23.556" end="23.847">事</span><span begin="23.847" end="25.545">呀</span> <span begin="25.927" end="26.795">一篇</span><span begin="26.795" end="27.060">篇</span><span begin="27.060" end="29.202">翻</span></p></div><div begin="30.664" end="55.885" itunes:songPart="Verse" ttm:agent="v2"><p begin="30.664" end="33.204" itunes:key="L5" ttm:agent="v2"><span begin="30.664" end="31.493">好烦</span> <span begin="31.493" end="32.391">又加班到</span><span begin="32.391" end="32.822">很</span><span begin="32.822" end="33.204">晚</span></p><p begin="33.214" end="36.875" itunes:key="L6" ttm:agent="v2"><span begin="33.214" end="34.117">你搭上空</span><span begin="34.117" end="34.934">荡的</span> <span begin="34.969" end="35.855">地铁已是</span><span begin="35.855" end="36.285">末</span><span begin="36.285" end="36.875">班</span></p><p begin="37.403" end="42.198" itunes:key="L7" ttm:agent="v2"><span begin="37.403" end="38.381">好烦</span> <span begin="38.381" end="39.232">很爱却要</span><span begin="39.232" end="40.108">分开</span> <span begin="40.108" end="40.994">恋爱谈不</span><span begin="40.994" end="41.403">明</span><span begin="41.403" end="42.198">白</span></p><p begin="44.240" end="46.927" itunes:key="L8" ttm:agent="v2"><span begin="44.240" end="45.184">好烦</span> <span begin="45.184" end="46.130">接近理想</span><span begin="46.130" end="46.927">好难</span></p><p begin="46.937" end="50.532" itunes:key="L9" ttm:agent="v2"><span begin="46.937" end="47.816">却又还很</span><span begin="47.816" end="48.703">不甘</span> <span begin="48.703" end="49.543">如何拥抱</span><span begin="49.543" end="49.963">平</span><span begin="49.963" end="50.532">淡</span></p><p begin="51.147" end="55.885" itunes:key="L10" ttm:agent="v2"><span begin="51.147" end="51.981">如果</span> <span begin="51.981" end="52.937">最难得到</span><span begin="52.937" end="53.788">圆满</span> <span begin="53.788" end="54.664">不如选择</span><span begin="54.664" end="55.095">坦</span><span begin="55.095" end="55.885">然</span></p></div><div begin="57.241" end="1:23.901" itunes:songPart="Chorus"><p begin="57.241" end="1:00.478" itunes:key="L11" ttm:agent="v1"><span begin="57.241" end="59.797">若是月亮还没</span><span begin="59.797" end="1:00.478">来</span></p><p begin="1:00.657" end="1:03.868" itunes:key="L12" ttm:agent="v1"><span begin="1:00.657" end="1:03.231">路灯也可照窗</span><span begin="1:03.231" end="1:03.868">台</span></p><p begin="1:04.019" end="1:10.453" itunes:key="L13" ttm:agent="v1"><span begin="1:04.019" end="1:07.094">照着白色的山茶</span><span begin="1:07.094" end="1:07.438">花</span><span begin="1:07.567" end="1:08.361">微微</span><span begin="1:08.361" end="1:10.453">开</span></p><p begin="1:10.885" end="1:14.178" itunes:key="L14" ttm:agent="v1"><span begin="1:10.885" end="1:13.534">若是晨风还没</span><span begin="1:13.534" end="1:14.178">来</span></p><p begin="1:14.384" end="1:17.581" itunes:key="L15" ttm:agent="v1"><span begin="1:14.384" end="1:16.960">晚风也可吹入</span><span begin="1:16.960" end="1:17.581">怀</span></p><p begin="1:17.745" end="1:23.901" itunes:key="L16" ttm:agent="v1"><span begin="1:17.745" end="1:22.118">吹着那一地树影温柔摇</span><span begin="1:22.118" end="1:23.901">摆</span></p></div><div begin="1:25.062" end="1:52.896" itunes:songPart="Verse" ttm:agent="v2"><p begin="1:25.062" end="1:28.440" itunes:key="L17" ttm:agent="v2"><span begin="1:25.062" end="1:26.788">你总以为你不够好</span> <span begin="1:26.788" end="1:28.057">不够苗条和美</span><span begin="1:28.057" end="1:28.440">貌</span></p><p begin="1:28.447" end="1:31.826" itunes:key="L18" ttm:agent="v2"><span begin="1:28.447" end="1:30.180">可是完美谁能达到</span> <span begin="1:30.180" end="1:31.548">做你自己就很</span><span begin="1:31.548" end="1:31.826">好</span></p><p begin="1:31.980" end="1:35.287" itunes:key="L19" ttm:agent="v2"><span begin="1:31.980" end="1:32.819">烦恼烦恼</span><span begin="1:32.819" end="1:33.228">拥有太</span><span begin="1:33.228" end="1:33.569">少</span> <span begin="1:33.659" end="1:34.511">没有房车</span><span begin="1:34.511" end="1:34.931">没有钞</span><span begin="1:34.931" end="1:35.287">票</span></p><p begin="1:35.378" end="1:38.635" itunes:key="L20" ttm:agent="v2"><span begin="1:35.378" end="1:37.129">可爱你的人永远会</span> <span begin="1:37.129" end="1:37.943">把你当做</span><span begin="1:37.943" end="1:38.339">心尖珍</span><span begin="1:38.339" end="1:38.635">宝</span></p><p begin="1:38.645" end="1:42.051" itunes:key="L21" ttm:agent="v2"><span begin="1:38.645" end="1:38.823">我</span><span begin="1:38.823" end="1:39.967">也懂大多数的</span><span begin="1:39.967" end="1:40.123">时</span><span begin="1:40.123" end="1:40.330">候</span> <span begin="1:40.330" end="1:41.824">你只想逃离这世</span><span begin="1:41.824" end="1:42.051">界</span></p><p begin="1:42.061" end="1:45.477" itunes:key="L22" ttm:agent="v2"><span begin="1:42.061" end="1:43.443">我也懂太多的情</span><span begin="1:43.443" end="1:43.591">绪</span><span begin="1:43.591" end="1:43.801">在</span> <span begin="1:43.801" end="1:45.308">一个人失眠的深</span><span begin="1:45.308" end="1:45.477">夜</span></p><p begin="1:45.487" end="1:49.270" itunes:key="L23" ttm:agent="v2"><span begin="1:45.487" end="1:47.183">你可以是悲伤或者</span><span begin="1:47.183" end="1:47.306">埋</span><span begin="1:47.306" end="1:47.585">怨</span> <span begin="1:47.637" end="1:48.889">但请不要放弃</span><span begin="1:48.889" end="1:48.989">明</span><span begin="1:48.989" end="1:49.270">天</span></p><p begin="1:49.280" end="1:52.896" itunes:key="L24" ttm:agent="v2"><span begin="1:49.280" end="1:50.971">这一直灰暗的世界</span> <span begin="1:50.971" end="1:52.510">我想看见你的笑</span><span begin="1:52.510" end="1:52.896">脸</span></p></div><div begin="1:52.039" end="2:18.752" itunes:songPart="Chorus"><p begin="1:52.039" end="1:55.272" itunes:key="L25" ttm:agent="v1"><span begin="1:52.039" end="1:54.652">若是月亮还没</span><span begin="1:54.652" end="1:55.272">来</span></p><p begin="1:55.511" end="1:58.722" itunes:key="L26" ttm:agent="v1"><span begin="1:55.511" end="1:58.085">路灯也可照窗</span><span begin="1:58.085" end="1:58.722">台</span></p><p begin="1:58.870" end="2:05.312" itunes:key="L27" ttm:agent="v1"><span begin="1:58.870" end="2:01.945">照着白色的山茶</span><span begin="2:01.945" end="2:02.289">花</span><span begin="2:02.395" end="2:03.212">微微</span><span begin="2:03.212" end="2:05.312">开</span></p><p begin="2:05.835" end="2:09.019" itunes:key="L28" ttm:agent="v1"><span begin="2:05.835" end="2:08.404">若是晨风还没</span><span begin="2:08.404" end="2:09.019">来</span></p><p begin="2:09.160" end="2:12.389" itunes:key="L29" ttm:agent="v1"><span begin="2:09.160" end="2:11.781">晚风也可吹入</span><span begin="2:11.781" end="2:12.389">怀</span></p><p begin="2:12.565" end="2:18.752" itunes:key="L30" ttm:agent="v1"><span begin="2:12.565" end="2:16.938">吹着那一地树影温柔摇</span><span begin="2:16.938" end="2:18.752">摆</span></p></div><div begin="2:19.436" end="2:46.169" itunes:songPart="Chorus"><p begin="2:19.436" end="2:22.679" itunes:key="L31" ttm:agent="v1"><span begin="2:19.436" end="2:22.046">若是月亮还没</span><span begin="2:22.046" end="2:22.679">来</span></p><p begin="2:22.967" end="2:26.178" itunes:key="L32" ttm:agent="v1"><span begin="2:22.967" end="2:25.541">路灯也可照窗</span><span begin="2:25.541" end="2:26.178">台</span></p><p begin="2:26.368" end="2:32.747" itunes:key="L33" ttm:agent="v1"><span begin="2:26.368" end="2:29.356">照着白色的山茶</span><span begin="2:29.356" end="2:29.787">花</span><span begin="2:29.811" end="2:30.698">微微</span><span begin="2:30.698" end="2:32.747">开</span></p><p begin="2:33.198" end="2:36.491" itunes:key="L34" ttm:agent="v1"><span begin="2:33.198" end="2:35.847">若是晨风还没</span><span begin="2:35.847" end="2:36.491">来</span></p><p begin="2:36.577" end="2:39.884" itunes:key="L35" ttm:agent="v1"><span begin="2:36.577" end="2:39.264">晚风也可吹入</span><span begin="2:39.264" end="2:39.884">怀</span></p><p begin="2:40.013" end="2:46.169" itunes:key="L36" ttm:agent="v1"><span begin="2:40.013" end="2:44.386">吹着那一地树影温柔摇</span><span begin="2:44.386" end="2:46.169">摆</span></p></div></body></tt>