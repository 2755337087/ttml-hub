<amll:meta key="album" value="让世界暂停一分钟 - Single"/>
<amll:meta key="appleMusicId" value="1640618275"/></metadata></head><body dur="3:52.860"><div begin="6.425" end="25.906" itunes:songPart="Verse"><p begin="6.425" end="7.737" itunes:key="L1" ttm:agent="v1"><span begin="6.425" end="7.737">你</span></p><p begin="11.119" end="13.486" itunes:key="L2" ttm:agent="v1"><span begin="11.119" end="12.576">卷缩着身</span><span begin="12.576" end="13.486">体</span></p><p begin="18.119" end="21.425" itunes:key="L3" ttm:agent="v1"><span begin="18.119" end="18.597">想保</span><span begin="18.597" end="19.703">护那</span><span begin="19.703" end="20.621">破碎的</span><span begin="20.621" end="21.425">心</span></p><p begin="22.066" end="25.906" itunes:key="L4" ttm:agent="v1"><span begin="22.066" end="22.938">你</span><span begin="22.938" end="24.409">的背上却</span><span begin="24.504" end="24.913">汗淋</span><span begin="24.913" end="25.906">漓</span></p></div><div begin="31.665" end="51.025" itunes:songPart="Verse"><p begin="31.665" end="33.441" itunes:key="L5" ttm:agent="v1"><span begin="31.665" end="33.441">你</span></p><p begin="36.222" end="39.103" itunes:key="L6" ttm:agent="v1"><span begin="36.222" end="36.994">你总被</span><span begin="36.994" end="38.155">回忆偷</span><span begin="38.155" end="39.103">袭</span></p><p begin="43.381" end="46.730" itunes:key="L7" ttm:agent="v1"><span begin="43.381" end="43.849">像被</span><span begin="43.849" end="44.962">困</span><span begin="44.962" end="46.036">在恶梦</span><span begin="46.036" end="46.730">里</span></p><p begin="47.355" end="51.025" itunes:key="L8" ttm:agent="v1"><span begin="47.355" end="48.205">你</span><span begin="48.205" end="49.750">多希望能</span><span begin="49.750" end="50.192">被吵</span><span begin="50.192" end="51.025">醒</span></p></div><div begin="55.071" end="1:17.311" itunes:songPart="Verse"><p begin="55.071" end="58.789" itunes:key="L9" ttm:agent="v1"><span begin="55.071" end="56.383">像弱不经</span><span begin="56.383" end="58.789">风</span></p><p begin="1:01.432" end="1:04.753" itunes:key="L10" ttm:agent="v1"><span begin="1:01.432" end="1:01.848">快凋</span><span begin="1:01.848" end="1:03.038">谢的花</span><span begin="1:03.038" end="1:04.753">朵</span></p><p begin="1:07.896" end="1:11.393" itunes:key="L11" ttm:agent="v1"><span begin="1:07.896" end="1:09.249">风一吹 你</span><span begin="1:09.249" end="1:10.232">快</span><span begin="1:10.232" end="1:10.637">要坠</span><span begin="1:10.637" end="1:11.393">落</span></p><p begin="1:12.561" end="1:17.311" itunes:key="L12" ttm:agent="v1"><span begin="1:12.561" end="1:13.449">你默</span><span begin="1:13.449" end="1:13.886">默承</span><span begin="1:13.886" end="1:15.477">受太</span><span begin="1:15.477" end="1:17.311">多</span></p></div><div begin="1:20.412" end="1:43.055" itunes:songPart="Chorus"><p begin="1:20.412" end="1:26.316" itunes:key="L13" ttm:agent="v1"><span begin="1:20.412" end="1:21.701">你想让世</span><span begin="1:21.701" end="1:23.148">界</span> <span begin="1:23.544" end="1:24.807">暂停一分</span><span begin="1:24.807" end="1:26.316">钟</span></p><p begin="1:26.703" end="1:32.617" itunes:key="L14" ttm:agent="v1"><span begin="1:26.703" end="1:27.898">让翻腾的</span><span begin="1:27.898" end="1:29.507">心</span> <span begin="1:29.840" end="1:31.145">安静一分</span><span begin="1:31.145" end="1:32.617">钟</span></p><p begin="1:33.048" end="1:36.597" itunes:key="L15" ttm:agent="v1"><span begin="1:33.048" end="1:34.386">You feel a</span><span begin="1:34.386" end="1:36.597">lone</span></p><p begin="1:37.571" end="1:39.601" itunes:key="L16" ttm:agent="v1"><span begin="1:37.571" end="1:39.601">Alone</span></p><p begin="1:39.961" end="1:43.055" itunes:key="L17" ttm:agent="v1"><span begin="1:39.961" end="1:40.659">好沉</span><span begin="1:40.659" end="1:43.055">重</span></p></div><div begin="1:45.637" end="2:07.264" itunes:songPart="Verse"><p begin="1:45.637" end="1:48.324" itunes:key="L18" ttm:agent="v1"><span begin="1:45.637" end="1:47.145">来到我的怀</span><span begin="1:47.145" end="1:48.324">中</span></p><p begin="1:52.023" end="1:55.152" itunes:key="L19" ttm:agent="v1"><span begin="1:52.023" end="1:53.420">来让我为你</span><span begin="1:53.420" end="1:54.024">心</span><span begin="1:54.024" end="1:55.152">痛</span></p><p begin="1:59.324" end="2:02.546" itunes:key="L20" ttm:agent="v1"><span begin="1:59.324" end="1:59.663">让我</span><span begin="1:59.663" end="2:00.683">进</span><span begin="2:00.683" end="2:01.759">入那恶</span><span begin="2:01.759" end="2:02.546">梦</span></p><p begin="2:03.132" end="2:07.264" itunes:key="L21" ttm:agent="v1"><span begin="2:03.132" end="2:04.008">为</span><span begin="2:04.008" end="2:04.961">你画上</span><span begin="2:04.961" end="2:05.566">一</span><span begin="2:05.566" end="2:05.992">道彩</span><span begin="2:05.992" end="2:07.264">虹</span></p></div><div begin="2:10.967" end="2:33.718" itunes:songPart="Chorus"><p begin="2:10.967" end="2:16.804" itunes:key="L22" ttm:agent="v1"><span begin="2:10.967" end="2:12.235">就让世</span><span begin="2:12.235" end="2:13.750">界</span> <span begin="2:14.044" end="2:15.345">暂停一分</span><span begin="2:15.345" end="2:16.804">钟</span></p><p begin="2:17.270" end="2:23.184" itunes:key="L23" ttm:agent="v1"><span begin="2:17.270" end="2:18.465">让翻腾的</span><span begin="2:18.465" end="2:20.074">心</span> <span begin="2:20.407" end="2:21.712">安静一分</span><span begin="2:21.712" end="2:23.184">钟</span></p><p begin="2:23.598" end="2:27.148" itunes:key="L24" ttm:agent="v1"><span begin="2:23.598" end="2:24.901">You're not a</span><span begin="2:24.901" end="2:27.148">lone</span></p><p begin="2:28.130" end="2:30.126" itunes:key="L25" ttm:agent="v1"><span begin="2:28.130" end="2:30.126">Alone</span></p><p begin="2:30.292" end="2:33.718" itunes:key="L26" ttm:agent="v1"><span begin="2:30.292" end="2:31.225">我不</span><span begin="2:31.225" end="2:33.718">走</span></p></div><div begin="2:35.997" end="2:59.558" itunes:songPart="Chorus"><p begin="2:35.997" end="2:42.216" itunes:key="L27" ttm:agent="v1"><span begin="2:35.997" end="2:37.505">你想哭就</span><span begin="2:37.505" end="2:39.059">哭</span> <span begin="2:39.330" end="2:40.634">再哭几分</span><span begin="2:40.634" end="2:42.216">钟</span></p><p begin="2:42.502" end="2:48.492" itunes:key="L28" ttm:agent="v1"><span begin="2:42.502" end="2:43.837">你若想放</span><span begin="2:43.837" end="2:45.448">空</span> <span begin="2:45.641" end="2:46.956">再空几分</span><span begin="2:46.956" end="2:48.492">钟</span></p><p begin="2:48.856" end="2:52.566" itunes:key="L29" ttm:agent="v1"><span begin="2:48.856" end="2:50.159">You're not a</span><span begin="2:50.159" end="2:52.566">lone</span></p><p begin="2:55.584" end="2:59.558" itunes:key="L30" ttm:agent="v1"><span begin="2:55.584" end="2:56.506">我能</span><span begin="2:56.506" end="2:59.558">懂</span></p></div><div begin="3:01.465" end="3:23.061" itunes:songPart="Verse"><p begin="3:01.465" end="3:04.774" itunes:key="L31" ttm:agent="v1"><span begin="3:01.465" end="3:02.973">来到我的怀</span><span begin="3:02.973" end="3:04.774">中</span></p><p begin="3:07.789" end="3:11.078" itunes:key="L32" ttm:agent="v1"><span begin="3:07.789" end="3:09.176">来让我为你</span><span begin="3:09.176" end="3:09.780">心</span><span begin="3:09.780" end="3:11.078">痛</span></p><p begin="3:15.157" end="3:18.379" itunes:key="L33" ttm:agent="v1"><span begin="3:15.157" end="3:15.482">让我</span><span begin="3:15.482" end="3:16.516">进</span><span begin="3:16.516" end="3:17.592">入那恶</span><span begin="3:17.592" end="3:18.379">梦</span></p><p begin="3:18.913" end="3:23.061" itunes:key="L34" ttm:agent="v1"><span begin="3:18.913" end="3:20.176">把星星</span><span begin="3:20.176" end="3:21.276">还给你</span><span begin="3:21.425" end="3:21.911">的夜</span><span begin="3:21.911" end="3:23.061">空</span></p></div><div begin="3:27.717" end="3:35.706" itunes:songPart="Outro"><p begin="3:27.717" end="3:30.939" itunes:key="L35" ttm:agent="v1"><span begin="3:27.717" end="3:28.052">让我</span><span begin="3:28.052" end="3:29.206">进</span><span begin="3:29.206" end="3:30.219">入那恶</span><span begin="3:30.219" end="3:30.939">梦</span></p><p begin="3:31.518" end="3:35.706" itunes:key="L36" ttm:agent="v1"><span begin="3:31.518" end="3:32.781">把星星</span><span begin="3:32.781" end="3:33.881">还给你</span><span begin="3:34.030" end="3:34.516">的夜</span><span begin="3:34.516" end="3:35.706">空</span></p></div></body></tt>