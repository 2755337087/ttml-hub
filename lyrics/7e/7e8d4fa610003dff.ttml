<amll:meta key="appleMusicId" value="1641511099"/></metadata></head><body dur="3:30.603"><div begin="16.901" end="30.184" itunes:songPart="Verse"><p begin="16.901" end="21.866" itunes:key="L1" ttm:agent="v1"><span begin="16.901" end="17.894">多少年奔</span><span begin="17.894" end="19.060">波</span> <span begin="19.301" end="19.858">几万</span><span begin="19.858" end="20.642">个</span><span begin="20.642" end="21.866">路口</span></p><p begin="24.744" end="30.184" itunes:key="L2" ttm:agent="v1"><span begin="24.744" end="25.899">好不容易</span><span begin="25.899" end="27.025">我</span> <span begin="27.252" end="27.863">牵住</span><span begin="27.863" end="28.595">你</span><span begin="28.595" end="28.835">的</span><span begin="28.835" end="30.184">手</span></p></div><div begin="31.223" end="45.785" itunes:songPart="Verse"><p begin="31.223" end="35.062" itunes:key="L3" ttm:agent="v1"><span begin="31.223" end="32.246">理想是</span><span begin="32.246" end="32.701">让</span><span begin="32.701" end="35.062">你</span></p><p begin="35.408" end="39.050" itunes:key="L4" ttm:agent="v1"><span begin="35.408" end="36.723">过更好生</span><span begin="36.723" end="39.050">活</span></p><p begin="39.396" end="42.386" itunes:key="L5" ttm:agent="v1"><span begin="39.396" end="39.907">代价</span><span begin="39.907" end="40.703">却必</span><span begin="40.703" end="42.386">需</span></p><p begin="42.646" end="45.785" itunes:key="L6" ttm:agent="v1"><span begin="42.646" end="44.401">离家</span><span begin="44.401" end="44.698">漂</span><span begin="44.698" end="45.785">泊</span></p></div><div begin="47.088" end="1:17.951" itunes:songPart="Chorus"><p begin="47.088" end="50.159" itunes:key="L7" ttm:agent="v1"><span begin="47.088" end="47.876">从来就</span><span begin="47.876" end="48.654">没爱</span><span begin="48.654" end="50.159">错</span></p><p begin="51.153" end="54.233" itunes:key="L8" ttm:agent="v1"><span begin="51.153" end="51.906">错在时</span><span begin="51.906" end="52.743">间交</span><span begin="52.743" end="54.233">错</span></p><p begin="55.117" end="1:02.188" itunes:key="L9" ttm:agent="v1"><span begin="55.117" end="56.743">你是不能错</span><span begin="56.743" end="57.670">过</span> <span begin="57.670" end="1:00.468">我唯一</span><span begin="1:00.468" end="1:00.680">的</span><span begin="1:00.680" end="1:02.188">梦</span></p><p begin="1:03.072" end="1:06.143" itunes:key="L10" ttm:agent="v1"><span begin="1:03.072" end="1:03.860">从来就</span><span begin="1:03.860" end="1:04.638">没爱</span><span begin="1:04.638" end="1:06.143">错</span></p><p begin="1:07.083" end="1:10.190" itunes:key="L11" ttm:agent="v1"><span begin="1:07.083" end="1:07.849">是你相</span><span begin="1:07.849" end="1:08.729">信着</span><span begin="1:08.729" end="1:10.190">我</span></p><p begin="1:11.104" end="1:17.951" itunes:key="L12" ttm:agent="v1"><span begin="1:11.104" end="1:11.932">越过分</span><span begin="1:11.932" end="1:12.701">开尽</span><span begin="1:12.701" end="1:16.347">头 一定有</span><span begin="1:16.347" end="1:16.658">笑</span><span begin="1:16.658" end="1:17.951">容</span></p></div><div begin="1:20.900" end="1:34.071" itunes:songPart="Verse"><p begin="1:20.900" end="1:25.886" itunes:key="L13" ttm:agent="v1"><span begin="1:20.900" end="1:21.886">我眼中的</span><span begin="1:21.886" end="1:23.069">你</span> <span begin="1:23.311" end="1:23.837">多快</span><span begin="1:23.837" end="1:24.612">乐</span><span begin="1:24.612" end="1:24.939">自</span><span begin="1:24.939" end="1:25.886">由</span></p><p begin="1:28.834" end="1:34.071" itunes:key="L14" ttm:agent="v1"><span begin="1:28.834" end="1:29.847">是我不放</span><span begin="1:29.847" end="1:30.960">弃</span> <span begin="1:31.285" end="1:31.878">坚持</span><span begin="1:31.878" end="1:32.634">的</span><span begin="1:32.634" end="1:32.907">理</span><span begin="1:32.907" end="1:34.071">由</span></p></div><div begin="1:35.385" end="1:50.812" itunes:songPart="Verse"><p begin="1:35.385" end="1:39.104" itunes:key="L15" ttm:agent="v1"><span begin="1:35.385" end="1:35.892">我们</span><span begin="1:35.892" end="1:36.689">都知</span><span begin="1:36.689" end="1:39.104">道</span></p><p begin="1:39.640" end="1:41.282" itunes:key="L16" ttm:agent="v1"><span begin="1:39.640" end="1:39.935">要去</span><span begin="1:39.935" end="1:40.413">的以</span><span begin="1:40.413" end="1:41.282">后</span></p><p begin="1:43.639" end="1:47.010" itunes:key="L17" ttm:agent="v1"><span begin="1:43.639" end="1:44.373">我们的结</span><span begin="1:44.373" end="1:45.128">果</span> <span begin="1:45.554" end="1:46.279">随便他们</span><span begin="1:46.279" end="1:47.010">说</span></p><p begin="1:47.153" end="1:50.812" itunes:key="L18" ttm:agent="v1"><span begin="1:47.153" end="1:47.905">毫无保</span><span begin="1:47.905" end="1:48.423">留</span> <span begin="1:48.562" end="1:50.812">只要你懂我就足够</span></p></div><div begin="1:51.102" end="2:22.194" itunes:songPart="Chorus"><p begin="1:51.102" end="1:54.173" itunes:key="L19" ttm:agent="v1"><span begin="1:51.102" end="1:51.897">从来就</span><span begin="1:51.897" end="1:52.668">没爱</span><span begin="1:52.668" end="1:54.173">错</span></p><p begin="1:55.103" end="1:58.183" itunes:key="L20" ttm:agent="v1"><span begin="1:55.103" end="1:55.856">错在时</span><span begin="1:55.856" end="1:56.693">间交</span><span begin="1:56.693" end="1:58.183">错</span></p><p begin="1:59.125" end="2:06.196" itunes:key="L21" ttm:agent="v1"><span begin="1:59.125" end="2:00.751">你是不能错</span><span begin="2:00.751" end="2:01.678">过</span> <span begin="2:01.678" end="2:04.476">我唯一</span><span begin="2:04.476" end="2:04.688">的</span><span begin="2:04.688" end="2:06.196">梦</span></p><p begin="2:07.085" end="2:10.156" itunes:key="L22" ttm:agent="v1"><span begin="2:07.085" end="2:07.873">从来就</span><span begin="2:07.873" end="2:08.651">没爱</span><span begin="2:08.651" end="2:10.156">错</span></p><p begin="2:11.082" end="2:14.189" itunes:key="L23" ttm:agent="v1"><span begin="2:11.082" end="2:11.848">是你相</span><span begin="2:11.848" end="2:12.728">信着</span><span begin="2:12.728" end="2:14.189">我</span></p><p begin="2:15.147" end="2:22.194" itunes:key="L24" ttm:agent="v1"><span begin="2:15.147" end="2:15.975">越过分</span><span begin="2:15.975" end="2:16.744">开尽</span><span begin="2:16.744" end="2:20.390">头 一定有</span><span begin="2:20.390" end="2:20.701">笑</span><span begin="2:20.701" end="2:22.194">容</span></p></div><div begin="2:24.849" end="2:39.048" itunes:songPart="Bridge"><p begin="2:24.849" end="2:28.058" itunes:key="L25" ttm:agent="v1"><span begin="2:24.849" end="2:25.591">未来如</span><span begin="2:25.591" end="2:26.169">何</span> <span begin="2:26.169" end="2:26.606">就算</span><span begin="2:26.606" end="2:27.101">艰</span><span begin="2:27.101" end="2:28.058">涩</span></p><p begin="2:28.128" end="2:31.978" itunes:key="L26" ttm:agent="v1"><span begin="2:28.128" end="2:29.596">做不到 让你幸</span><span begin="2:29.596" end="2:30.053">福</span> <span begin="2:30.053" end="2:30.605">爱算</span><span begin="2:30.605" end="2:31.978">什么</span></p><p begin="2:32.310" end="2:34.374" itunes:key="L27" ttm:agent="v1"><span begin="2:32.310" end="2:33.572">让等待和眼</span><span begin="2:33.572" end="2:34.374">泪</span></p><p begin="2:34.404" end="2:39.048" itunes:key="L28" ttm:agent="v1"><span begin="2:34.404" end="2:34.713">最</span><span begin="2:34.713" end="2:35.478">后</span><span begin="2:35.853" end="2:36.679">都值</span><span begin="2:36.679" end="2:39.048">得</span></p></div><div begin="2:39.115" end="3:10.348" itunes:songPart="Chorus"><p begin="2:39.115" end="2:42.186" itunes:key="L29" ttm:agent="v1"><span begin="2:39.115" end="2:39.903">从来就</span><span begin="2:39.903" end="2:40.681">没爱</span><span begin="2:40.681" end="2:42.186">错</span></p><p begin="2:43.067" end="2:46.324" itunes:key="L30" ttm:agent="v1"><span begin="2:43.067" end="2:43.928">是你定</span><span begin="2:43.928" end="2:44.767">义了</span><span begin="2:44.767" end="2:46.324">我</span></p><p begin="2:47.113" end="2:54.350" itunes:key="L31" ttm:agent="v1"><span begin="2:47.113" end="2:47.884">每一句</span><span begin="2:47.884" end="2:48.712">我爱</span><span begin="2:48.712" end="2:52.381">你 亲口对</span><span begin="2:52.381" end="2:52.605">你</span><span begin="2:52.605" end="2:54.350">说</span></p><p begin="2:55.118" end="2:58.189" itunes:key="L32" ttm:agent="v1"><span begin="2:55.118" end="2:55.906">从来就</span><span begin="2:55.906" end="2:56.684">没爱</span><span begin="2:56.684" end="2:58.189">错</span></p><p begin="2:59.098" end="3:02.526" itunes:key="L33" ttm:agent="v1"><span begin="2:59.098" end="2:59.864">是你相</span><span begin="2:59.864" end="3:00.744">信着</span><span begin="3:00.744" end="3:02.526">我</span></p><p begin="3:03.118" end="3:10.348" itunes:key="L34" ttm:agent="v1"><span begin="3:03.118" end="3:03.872">用一生</span><span begin="3:03.872" end="3:04.659">做承</span><span begin="3:04.659" end="3:08.276">诺 守护你</span><span begin="3:08.276" end="3:08.564">是</span><span begin="3:08.564" end="3:10.348">我</span></p></div></body></tt>