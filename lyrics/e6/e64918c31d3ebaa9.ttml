<amll:meta key="album" value="我的存在就是爱你"/>
<amll:meta key="appleMusicId" value="1865103993"/></metadata></head><body dur="3:22.913"><div begin="14.498" end="42.906" itunes:songPart="Verse"><p begin="14.498" end="20.551" itunes:key="L1" ttm:agent="v1"><span begin="14.498" end="15.434">让</span><span begin="15.434" end="16.140">我</span><span begin="16.453" end="16.964">承</span><span begin="16.964" end="17.655">受</span> <span begin="18.151" end="18.397">你</span><span begin="18.397" end="18.852">的</span><span begin="18.852" end="19.113">哀</span><span begin="19.113" end="20.551">愁</span></p><p begin="21.661" end="28.288" itunes:key="L2" ttm:agent="v1"><span begin="21.661" end="21.891">你</span><span begin="21.891" end="23.381">⾝上痛</span><span begin="23.381" end="23.521">着</span><span begin="23.521" end="24.087">伤</span><span begin="24.087" end="24.703">⼝</span> <span begin="25.101" end="25.734">⾎泪</span><span begin="25.734" end="26.355">都</span><span begin="26.355" end="27.151">由</span><span begin="27.151" end="27.431">我</span><span begin="27.431" end="28.288">流</span></p><p begin="29.022" end="34.161" itunes:key="L3" ttm:agent="v1"><span begin="29.022" end="29.291">以</span><span begin="29.291" end="30.603">后</span> <span begin="30.603" end="30.972">感</span><span begin="30.972" end="32.006">受</span> <span begin="32.363" end="32.723">难</span><span begin="32.723" end="34.161">受</span></p><p begin="34.442" end="42.906" itunes:key="L4" ttm:agent="v1"><span begin="34.442" end="34.664">你</span><span begin="34.664" end="35.665">就牵</span><span begin="35.665" end="36.317">我</span><span begin="36.317" end="36.574">的</span><span begin="36.574" end="38.320">⼿</span> <span begin="39.221" end="39.701">不⽤</span><span begin="39.701" end="40.137">恐</span><span begin="40.137" end="40.996">惧</span><span begin="40.996" end="41.983">颤</span><span begin="41.983" end="42.906">抖</span></p></div><div begin="43.652" end="57.611" itunes:songPart="PreChorus"><p begin="43.652" end="48.493" itunes:key="L5" ttm:agent="v1"><span begin="43.652" end="44.151">没</span><span begin="44.151" end="44.487">事</span><span begin="44.487" end="45.244">的</span> <span begin="45.498" end="46.070">⼼</span><span begin="46.070" end="46.758">不是</span><span begin="46.758" end="47.429">空</span><span begin="47.429" end="48.493">壳</span></p><p begin="49.212" end="57.611" itunes:key="L6" ttm:agent="v1"><span begin="49.212" end="49.673">不</span><span begin="49.673" end="50.241">过⼀</span><span begin="50.241" end="50.781">时</span><span begin="50.781" end="50.980">你</span><span begin="50.980" end="51.740">⾛开</span><span begin="51.740" end="52.471">了</span> <span begin="52.875" end="54.082">路我</span><span begin="54.082" end="54.764">认</span><span begin="54.764" end="57.611">得</span></p></div><div begin="58.150" end="1:12.518" itunes:songPart="Chorus"><p begin="58.150" end="1:04.101" itunes:key="L7" ttm:agent="v1"><span begin="58.150" end="1:00.927">说</span> <span begin="1:00.927" end="1:02.285">我愿为了你⽽</span><span begin="1:02.285" end="1:04.101">活</span></p><p begin="1:04.416" end="1:08.971" itunes:key="L8" ttm:agent="v1"><span begin="1:04.416" end="1:05.610">只要你给我</span><span begin="1:05.610" end="1:05.902">的</span><span begin="1:05.902" end="1:06.511">结</span><span begin="1:06.511" end="1:07.138">果</span> <span begin="1:07.388" end="1:08.340">有如</span><span begin="1:08.340" end="1:08.971">果</span></p><p begin="1:09.181" end="1:12.518" itunes:key="L9" ttm:agent="v1"><span begin="1:09.181" end="1:09.745">就</span><span begin="1:09.745" end="1:10.050">没</span><span begin="1:10.050" end="1:12.518">错</span></p></div><div begin="1:12.687" end="1:34.843" itunes:songPart="Chorus"><p begin="1:12.687" end="1:18.688" itunes:key="L10" ttm:agent="v1"><span begin="1:12.687" end="1:14.944">说</span> <span begin="1:15.411" end="1:16.547">我会为了你</span><span begin="1:16.547" end="1:16.902">⽽</span><span begin="1:16.902" end="1:18.688">活</span></p><p begin="1:18.961" end="1:23.488" itunes:key="L11" ttm:agent="v1"><span begin="1:18.961" end="1:20.182">哪怕爱后来</span><span begin="1:20.182" end="1:20.461">的</span><span begin="1:20.461" end="1:21.073">结</span><span begin="1:21.073" end="1:21.636">果</span> <span begin="1:21.915" end="1:22.321">太</span><span begin="1:22.321" end="1:22.922">⾚</span><span begin="1:22.922" end="1:23.488">裸</span></p><p begin="1:23.853" end="1:34.843" itunes:key="L12" ttm:agent="v1"><span begin="1:23.853" end="1:25.265">你的存在就</span><span begin="1:25.265" end="1:28.554">是</span> <span begin="1:30.282" end="1:30.709">爱</span><span begin="1:30.709" end="1:34.843">我</span></p></div><div begin="1:45.339" end="2:14.264" itunes:songPart="Verse"><p begin="1:45.339" end="1:51.084" itunes:key="L13" ttm:agent="v1"><span begin="1:45.339" end="1:45.975">是</span><span begin="1:45.975" end="1:46.932">谁</span><span begin="1:47.282" end="1:47.743">胡</span><span begin="1:47.743" end="1:48.704">说</span> <span begin="1:48.923" end="1:49.326">什</span><span begin="1:49.326" end="1:50.054">么尽</span><span begin="1:50.054" end="1:51.084">头</span></p><p begin="1:52.682" end="1:59.022" itunes:key="L14" ttm:agent="v1"><span begin="1:52.682" end="1:52.870">我</span><span begin="1:52.870" end="1:54.247">就算暂</span><span begin="1:54.247" end="1:54.654">时</span><span begin="1:54.654" end="1:55.008">拥</span><span begin="1:55.008" end="1:55.678">有</span> <span begin="1:55.946" end="1:56.541">相爱</span><span begin="1:56.541" end="1:56.878">不</span><span begin="1:56.878" end="1:57.570">需</span><span begin="1:57.725" end="1:58.122">理</span><span begin="1:58.122" end="1:59.022">由</span></p><p begin="1:59.862" end="2:05.133" itunes:key="L15" ttm:agent="v1"><span begin="1:59.862" end="2:00.481">⾛</span><span begin="2:00.481" end="2:01.631">丢</span> <span begin="2:01.631" end="2:01.756">我</span><span begin="2:01.756" end="2:03.230">就</span> <span begin="2:03.230" end="2:03.716">守</span><span begin="2:03.716" end="2:05.133">候</span></p><p begin="2:05.396" end="2:14.264" itunes:key="L16" ttm:agent="v1"><span begin="2:05.396" end="2:05.636">等</span><span begin="2:05.636" end="2:06.138">待</span><span begin="2:06.138" end="2:06.400">我</span><span begin="2:06.400" end="2:07.278">最</span><span begin="2:07.278" end="2:07.555">拿</span><span begin="2:07.555" end="2:09.294">⼿</span> <span begin="2:10.149" end="2:10.966">管他要</span><span begin="2:10.966" end="2:12.008">撑</span><span begin="2:12.008" end="2:12.862">多</span><span begin="2:12.862" end="2:14.264">久</span></p></div><div begin="2:14.686" end="2:28.554" itunes:songPart="PreChorus"><p begin="2:14.686" end="2:19.780" itunes:key="L17" ttm:agent="v1"><span begin="2:14.686" end="2:15.121">没</span><span begin="2:15.121" end="2:15.487">事</span><span begin="2:15.487" end="2:16.133">了</span> <span begin="2:16.490" end="2:17.338">不必</span><span begin="2:17.338" end="2:18.071">太苛</span><span begin="2:18.071" end="2:19.780">责</span></p><p begin="2:20.020" end="2:28.554" itunes:key="L18" ttm:agent="v1"><span begin="2:20.020" end="2:20.655">若</span><span begin="2:20.655" end="2:20.929">你</span><span begin="2:20.929" end="2:21.686">偶尔</span><span begin="2:21.686" end="2:22.033">还</span><span begin="2:22.033" end="2:22.639">能在</span><span begin="2:22.639" end="2:23.526">这</span> <span begin="2:23.742" end="2:24.413">就</span><span begin="2:24.413" end="2:24.947">很</span><span begin="2:24.947" end="2:25.654">值</span><span begin="2:25.654" end="2:28.554">得</span></p></div><div begin="2:28.992" end="2:43.279" itunes:songPart="Chorus"><p begin="2:28.992" end="2:34.763" itunes:key="L19" ttm:agent="v1"><span begin="2:28.992" end="2:31.507">说</span> <span begin="2:31.744" end="2:33.152">我愿为了你⽽</span><span begin="2:33.152" end="2:34.763">活</span></p><p begin="2:35.355" end="2:39.787" itunes:key="L20" ttm:agent="v1"><span begin="2:35.355" end="2:36.548">只要你给我</span><span begin="2:36.548" end="2:36.798">的</span><span begin="2:36.798" end="2:37.431">结</span><span begin="2:37.431" end="2:38.106">果</span> <span begin="2:38.299" end="2:39.261">有如</span><span begin="2:39.261" end="2:39.787">果</span></p><p begin="2:40.117" end="2:43.279" itunes:key="L21" ttm:agent="v1"><span begin="2:40.117" end="2:40.629">就</span><span begin="2:40.629" end="2:40.921">没</span><span begin="2:40.921" end="2:43.279">错</span></p></div><div begin="2:43.586" end="3:06.385" itunes:songPart="Chorus"><p begin="2:43.586" end="2:49.237" itunes:key="L22" ttm:agent="v1"><span begin="2:43.586" end="2:46.099">说</span> <span begin="2:46.266" end="2:47.450">我会为了你</span><span begin="2:47.450" end="2:47.723">⽽</span><span begin="2:47.723" end="2:49.237">活</span></p><p begin="2:49.925" end="2:54.332" itunes:key="L23" ttm:agent="v1"><span begin="2:49.925" end="2:51.069">你就当是在</span><span begin="2:51.069" end="2:52.022">疼疼</span><span begin="2:52.022" end="2:52.525">我</span> <span begin="2:52.853" end="2:53.196">迎</span><span begin="2:53.196" end="2:53.825">合</span><span begin="2:53.825" end="2:54.332">我</span></p><p begin="2:54.625" end="3:06.385" itunes:key="L24" ttm:agent="v1"><span begin="2:54.625" end="2:56.232">你的存在就</span><span begin="2:56.232" end="2:59.539">是</span> <span begin="3:01.193" end="3:01.685">爱</span><span begin="3:01.685" end="3:06.385">我</span></p></div></body></tt>