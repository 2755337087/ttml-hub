<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.120"><songwriters><songwriter>施人诚</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="大眠"/>
<amll:meta key="artists" value="王心凌"/>
<amll:meta key="album" value="大眠"/>
<amll:meta key="album" value="大眠 - Single"/>
<amll:meta key="appleMusicId" value="1705380966"/></metadata></head><body dur="3:59.555"><div begin="15.135" end="42.018" itunes:songPart="Verse"><p begin="15.135" end="19.910" itunes:key="L1" ttm:agent="v1"><span begin="15.135" end="16.597">感谢他把</span><span begin="16.597" end="17.251">我</span> <span begin="18.028" end="19.201">当成傻</span><span begin="19.201" end="19.910">子</span></p><p begin="22.139" end="27.175" itunes:key="L2" ttm:agent="v1"><span begin="22.139" end="23.736">每天都哄</span><span begin="23.736" end="24.519">我</span> <span begin="25.269" end="26.442">上当一</span><span begin="26.442" end="27.175">次</span></p><p begin="29.307" end="35.390" itunes:key="L3" ttm:agent="v1"><span begin="29.307" end="30.067">清醒</span><span begin="30.067" end="30.917">一辈</span><span begin="30.917" end="31.881">子</span> <span begin="32.774" end="33.646">也就</span><span begin="33.646" end="34.518">那样</span><span begin="34.518" end="35.390">子</span></p><p begin="36.386" end="42.018" itunes:key="L4" ttm:agent="v1"><span begin="36.386" end="37.250">不介意用</span><span begin="37.250" end="37.896">爱</span> <span begin="38.331" end="39.231">来醉</span><span begin="39.231" end="40.131">生</span><span begin="40.131" end="40.655">梦</span><span begin="40.655" end="42.018">死</span></p></div><div begin="43.459" end="1:09.128" itunes:songPart="Verse"><p begin="43.459" end="48.375" itunes:key="L5" ttm:agent="v1"><span begin="43.459" end="44.278">原来</span><span begin="44.278" end="45.097">被催</span><span begin="45.097" end="45.916">眠</span> <span begin="46.339" end="47.357">真有意</span><span begin="47.357" end="48.375">思</span></p><p begin="50.427" end="56.283" itunes:key="L6" ttm:agent="v1"><span begin="50.427" end="51.612">我乐于</span><span begin="51.612" end="52.714">做个</span> <span begin="53.460" end="54.106">敬业</span><span begin="54.106" end="54.768">人</span><span begin="54.768" end="56.283">质</span></p><p begin="57.301" end="1:03.579" itunes:key="L7" ttm:agent="v1"><span begin="57.301" end="58.053">没空再去</span><span begin="58.053" end="58.609">对谁</span><span begin="58.609" end="59.181">解</span><span begin="59.181" end="1:00.308">释</span> <span begin="1:00.768" end="1:01.596">是我自己</span><span begin="1:01.596" end="1:02.540">把自己</span><span begin="1:02.540" end="1:03.579">挟持</span></p><p begin="1:03.773" end="1:09.128" itunes:key="L8" ttm:agent="v1"><span begin="1:03.773" end="1:05.112">不关</span><span begin="1:05.558" end="1:07.010">他的</span><span begin="1:07.010" end="1:09.128">事</span></p></div><div begin="1:09.657" end="1:37.884" itunes:songPart="Chorus"><p begin="1:09.657" end="1:12.163" itunes:key="L9" ttm:agent="v1"><span begin="1:09.657" end="1:10.402">都快忘了</span><span begin="1:10.402" end="1:11.162">怎样恋</span><span begin="1:11.162" end="1:11.670">一个</span><span begin="1:11.670" end="1:12.163">爱</span></p><p begin="1:12.161" end="1:16.599" itunes:key="L10" ttm:agent="v1"><span begin="1:12.161" end="1:13.299">我被虚度了的</span><span begin="1:13.299" end="1:14.017">青春</span> <span begin="1:14.017" end="1:14.663">也许还</span><span begin="1:14.663" end="1:15.109">能</span><span begin="1:15.109" end="1:15.854">活过</span><span begin="1:15.854" end="1:16.599">来</span></p><p begin="1:16.770" end="1:19.122" itunes:key="L11" ttm:agent="v1"><span begin="1:16.770" end="1:17.554">说心疼我的</span><span begin="1:17.554" end="1:18.338">更应该</span><span begin="1:18.338" end="1:19.122">明白</span></p><p begin="1:19.240" end="1:23.164" itunes:key="L12" ttm:agent="v1"><span begin="1:19.240" end="1:20.221">我当然会沉醉</span><span begin="1:20.221" end="1:20.914">个</span><span begin="1:20.914" end="1:21.793">痛</span><span begin="1:21.793" end="1:23.164">快</span></p><p begin="1:23.828" end="1:26.226" itunes:key="L13" ttm:agent="v1"><span begin="1:23.828" end="1:24.627">就让我陪他</span><span begin="1:24.627" end="1:25.202">恋完</span><span begin="1:25.202" end="1:25.714">这场</span><span begin="1:25.714" end="1:26.226">爱</span></p><p begin="1:26.227" end="1:30.785" itunes:key="L14" ttm:agent="v1"><span begin="1:26.227" end="1:26.875">只求心花</span><span begin="1:26.875" end="1:27.523">终于</span><span begin="1:27.523" end="1:28.171">盛开</span> <span begin="1:28.172" end="1:28.879">就没有</span><span begin="1:28.879" end="1:29.546">别的</span><span begin="1:29.546" end="1:30.785">期待</span></p><p begin="1:30.871" end="1:37.884" itunes:key="L15" ttm:agent="v1"><span begin="1:30.871" end="1:31.668">等梦完</span><span begin="1:31.668" end="1:32.465">醒来</span> <span begin="1:32.821" end="1:33.960">再去收拾</span><span begin="1:34.556" end="1:35.215">残</span><span begin="1:35.215" end="1:37.884">骸</span></p></div><div begin="1:53.973" end="2:19.796" itunes:songPart="Verse"><p begin="1:53.973" end="1:59.589" itunes:key="L16" ttm:agent="v1"><span begin="1:53.973" end="1:55.559">原来被催</span><span begin="1:55.559" end="1:56.335">眠</span> <span begin="1:56.781" end="1:58.212">真有意</span><span begin="1:58.212" end="1:59.589">思</span></p><p begin="2:01.075" end="2:07.186" itunes:key="L17" ttm:agent="v1"><span begin="2:01.075" end="2:02.174">我乐于</span><span begin="2:02.174" end="2:02.780">做</span><span begin="2:02.780" end="2:03.461">个</span> <span begin="2:04.130" end="2:04.803">敬业</span><span begin="2:04.803" end="2:05.468">人</span><span begin="2:05.468" end="2:07.186">质</span></p><p begin="2:08.006" end="2:14.134" itunes:key="L18" ttm:agent="v1"><span begin="2:08.006" end="2:08.752">没空再去对</span><span begin="2:08.752" end="2:09.715">谁解</span><span begin="2:09.715" end="2:10.678">释</span> <span begin="2:11.128" end="2:12.169">是我自己</span><span begin="2:12.169" end="2:13.008">把自己</span><span begin="2:13.008" end="2:14.134">挟持</span></p><p begin="2:14.321" end="2:19.796" itunes:key="L19" ttm:agent="v1"><span begin="2:14.321" end="2:15.571">不关</span><span begin="2:16.034" end="2:17.536">他的</span><span begin="2:17.536" end="2:19.796">事</span></p></div><div begin="2:20.240" end="2:49.097" itunes:songPart="Chorus"><p begin="2:20.240" end="2:22.542" itunes:key="L20" ttm:agent="v1"><span begin="2:20.240" end="2:20.915">都快忘了</span><span begin="2:20.915" end="2:21.628">怎样恋</span><span begin="2:21.628" end="2:22.085">一个</span><span begin="2:22.085" end="2:22.542">爱</span></p><p begin="2:22.600" end="2:27.064" itunes:key="L21" ttm:agent="v1"><span begin="2:22.600" end="2:23.688">我被虚度了的</span><span begin="2:23.688" end="2:24.576">青春</span> <span begin="2:24.576" end="2:25.731">也许还能</span><span begin="2:25.731" end="2:27.064">活过来</span></p><p begin="2:27.270" end="2:29.635" itunes:key="L22" ttm:agent="v1"><span begin="2:27.270" end="2:28.026">说心疼我的</span><span begin="2:28.026" end="2:28.854">更应该</span><span begin="2:28.854" end="2:29.635">明白</span></p><p begin="2:29.773" end="2:33.938" itunes:key="L23" ttm:agent="v1"><span begin="2:29.773" end="2:30.972">我当然会沉醉</span><span begin="2:30.972" end="2:31.435">个</span><span begin="2:31.435" end="2:31.985">痛</span><span begin="2:31.985" end="2:33.938">快</span></p><p begin="2:34.256" end="2:36.636" itunes:key="L24" ttm:agent="v1"><span begin="2:34.256" end="2:35.331">就让我陪他</span><span begin="2:35.331" end="2:35.766">恋完</span><span begin="2:35.766" end="2:36.201">这场</span><span begin="2:36.201" end="2:36.636">爱</span></p><p begin="2:36.745" end="2:41.287" itunes:key="L25" ttm:agent="v1"><span begin="2:36.745" end="2:37.409">只求心花</span><span begin="2:37.409" end="2:37.945">终于</span><span begin="2:37.945" end="2:38.597">盛开</span> <span begin="2:38.778" end="2:39.385">就没有</span><span begin="2:39.385" end="2:40.126">别的</span><span begin="2:40.126" end="2:41.287">期待</span></p><p begin="2:41.439" end="2:49.097" itunes:key="L26" ttm:agent="v1"><span begin="2:41.439" end="2:42.144">等梦完</span><span begin="2:42.144" end="2:42.879">醒来</span> <span begin="2:43.349" end="2:44.573">再去收拾</span><span begin="2:45.073" end="2:45.637">残</span><span begin="2:45.637" end="2:49.097">骸</span></p></div><div begin="2:50.031" end="3:04.994" itunes:songPart="Bridge"><p begin="2:50.031" end="2:52.950" itunes:key="L27" ttm:agent="v1"><span begin="2:50.031" end="2:50.354">如果</span><span begin="2:50.354" end="2:51.061">不失去</span><span begin="2:51.061" end="2:51.576">理</span><span begin="2:51.576" end="2:52.950">智</span></p><p begin="2:53.523" end="2:56.057" itunes:key="L28" ttm:agent="v1"><span begin="2:53.523" end="2:53.909">爱情</span><span begin="2:53.909" end="2:54.295">要从</span><span begin="2:54.295" end="2:54.681">何</span><span begin="2:54.681" end="2:55.232">开</span><span begin="2:55.232" end="2:56.057">始</span></p><p begin="2:56.238" end="2:59.836" itunes:key="L29" ttm:agent="v1"><span begin="2:56.238" end="2:56.909">傻傻的</span><span begin="2:56.909" end="2:57.774">骗子</span> <span begin="2:57.958" end="2:58.767">和骗人的</span><span begin="2:58.767" end="2:59.836">傻子</span></p><p begin="3:00.242" end="3:04.994" itunes:key="L30" ttm:agent="v1"><span begin="3:00.242" end="3:00.966">才可能</span><span begin="3:00.966" end="3:02.104">一生一</span><span begin="3:02.104" end="3:04.994">世</span></p></div><div begin="3:06.038" end="3:35.365" itunes:songPart="Chorus"><p begin="3:06.038" end="3:08.528" itunes:key="L31" ttm:agent="v1"><span begin="3:06.038" end="3:06.757">都快忘了</span><span begin="3:06.757" end="3:07.578">怎样恋</span><span begin="3:07.578" end="3:08.053">一个</span><span begin="3:08.053" end="3:08.528">爱</span></p><p begin="3:08.641" end="3:13.100" itunes:key="L32" ttm:agent="v1"><span begin="3:08.641" end="3:09.698">我被虚度了的</span><span begin="3:09.698" end="3:10.433">青春</span> <span begin="3:10.433" end="3:11.302">也许还能</span><span begin="3:11.302" end="3:12.198">活过</span><span begin="3:12.198" end="3:13.100">来</span></p><p begin="3:13.220" end="3:15.492" itunes:key="L33" ttm:agent="v1"><span begin="3:13.220" end="3:14.029">说心疼我的</span><span begin="3:14.029" end="3:14.745">更应该</span><span begin="3:14.745" end="3:15.492">明白</span></p><p begin="3:15.704" end="3:19.159" itunes:key="L34" ttm:agent="v1"><span begin="3:15.704" end="3:16.453">我当然会</span><span begin="3:16.453" end="3:17.306">沉醉个</span><span begin="3:17.306" end="3:18.067">痛</span><span begin="3:18.067" end="3:19.159">快</span></p><p begin="3:20.174" end="3:22.649" itunes:key="L35" ttm:agent="v1"><span begin="3:20.174" end="3:20.684">就让我</span><span begin="3:20.684" end="3:21.126">陪他</span><span begin="3:21.126" end="3:21.611">恋完</span><span begin="3:21.611" end="3:22.050">这场</span><span begin="3:22.050" end="3:22.649">爱</span></p><p begin="3:22.768" end="3:27.239" itunes:key="L36" ttm:agent="v1"><span begin="3:22.768" end="3:23.359">只求心花</span><span begin="3:23.359" end="3:23.816">终于</span><span begin="3:23.816" end="3:24.497">盛开</span> <span begin="3:24.497" end="3:24.965">就</span><span begin="3:24.965" end="3:25.433">没有</span><span begin="3:25.433" end="3:25.869">别的</span><span begin="3:25.869" end="3:27.239">期待</span></p><p begin="3:27.408" end="3:35.365" itunes:key="L37" ttm:agent="v1"><span begin="3:27.408" end="3:28.022">等梦完</span><span begin="3:28.022" end="3:28.645">醒来</span> <span begin="3:29.160" end="3:30.023">再去收</span><span begin="3:30.023" end="3:30.965">拾</span><span begin="3:31.569" end="3:32.260">残</span><span begin="3:32.260" end="3:35.365">骸</span></p></div></body></tt>