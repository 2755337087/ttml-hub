<amll:meta key="appleMusicId" value="1756554164"/></metadata></head><body dur="6:08.000"><div begin="28.556" end="53.290" itunes:songPart="Verse"><p begin="28.556" end="34.638" itunes:key="L1" ttm:agent="v1"><span begin="28.556" end="29.799">风的</span><span begin="29.799" end="31.085">脚印</span> <span begin="31.300" end="31.920">湖底</span><span begin="31.920" end="32.942">的</span><span begin="32.942" end="33.458">眼</span><span begin="33.458" end="34.638">睛</span></p><p begin="34.648" end="40.897" itunes:key="L2" ttm:agent="v1"><span begin="34.648" end="36.178">你是</span><span begin="36.178" end="37.223">超越</span><span begin="37.223" end="38.962">形容的</span><span begin="39.318" end="40.897">奇迹</span></p><p begin="41.054" end="46.023" itunes:key="L3" ttm:agent="v1"><span begin="41.054" end="42.399">而我</span> <span begin="42.618" end="43.037">天</span><span begin="43.037" end="44.652">选的弱</span><span begin="44.652" end="46.023">者</span></p><p begin="46.792" end="53.290" itunes:key="L4" ttm:agent="v1"><span begin="46.792" end="47.870">奉命跟</span><span begin="47.870" end="49.609">随</span><span begin="49.847" end="50.916">你呼</span><span begin="50.916" end="53.290">吸</span></p></div><div begin="54.101" end="1:19.545" itunes:songPart="Verse"><p begin="54.101" end="1:00.094" itunes:key="L5" ttm:agent="v1"><span begin="54.101" end="55.377">笑的</span><span begin="55.377" end="56.995">眼睛</span> <span begin="56.995" end="57.549">滚烫</span><span begin="57.549" end="58.553">的</span><span begin="58.553" end="1:00.094">声音</span></p><p begin="1:00.284" end="1:06.379" itunes:key="L6" ttm:agent="v1"><span begin="1:00.284" end="1:00.651">你</span><span begin="1:00.651" end="1:01.791">是</span><span begin="1:01.791" end="1:02.828">我最</span><span begin="1:02.828" end="1:03.883">后一</span><span begin="1:03.883" end="1:04.918">个</span><span begin="1:04.994" end="1:06.379">秘密</span></p><p begin="1:06.647" end="1:11.959" itunes:key="L7" ttm:agent="v1"><span begin="1:06.647" end="1:08.078">而你</span> <span begin="1:08.140" end="1:08.691">玩</span><span begin="1:08.691" end="1:10.183">你的游</span><span begin="1:10.183" end="1:11.959">戏</span></p><p begin="1:12.474" end="1:19.545" itunes:key="L8" ttm:agent="v1"><span begin="1:12.474" end="1:13.601">停下</span><span begin="1:13.601" end="1:15.479">来</span> <span begin="1:15.479" end="1:16.633">又走</span><span begin="1:16.633" end="1:19.545">开</span></p></div><div begin="1:22.184" end="2:11.835" itunes:songPart="Chorus"><p begin="1:22.184" end="1:31.638" itunes:key="L9" ttm:agent="v1"><span begin="1:22.184" end="1:23.132">你只</span><span begin="1:23.132" end="1:25.674">活在</span> <span begin="1:25.783" end="1:26.264">我</span><span begin="1:26.264" end="1:27.847">汹</span><span begin="1:27.847" end="1:29.771">涌脑</span><span begin="1:29.771" end="1:31.638">海</span></p><p begin="1:31.753" end="1:37.926" itunes:key="L10" ttm:agent="v1"><span begin="1:31.753" end="1:32.672">一见</span><span begin="1:32.672" end="1:34.545">面</span> <span begin="1:34.760" end="1:35.911">就毁</span><span begin="1:35.911" end="1:37.926">灭</span></p><p begin="1:38.039" end="1:44.785" itunes:key="L11" ttm:agent="v1"><span begin="1:38.039" end="1:39.088">在想</span><span begin="1:39.088" end="1:40.669">象</span><span begin="1:40.669" end="1:41.876">的荒</span><span begin="1:41.876" end="1:44.785">野</span></p><p begin="1:47.622" end="1:57.599" itunes:key="L12" ttm:agent="v1"><span begin="1:47.622" end="1:48.690">但你存</span><span begin="1:48.690" end="1:51.163">在</span> <span begin="1:51.401" end="1:51.848">真</span><span begin="1:51.848" end="1:53.497">实</span><span begin="1:53.497" end="1:55.122">地存</span><span begin="1:55.122" end="1:57.599">在</span></p><p begin="1:57.609" end="2:03.540" itunes:key="L13" ttm:agent="v1"><span begin="1:57.609" end="1:58.293">一出</span><span begin="1:58.293" end="2:00.236">现</span> <span begin="2:00.422" end="2:01.465">就改</span><span begin="2:01.465" end="2:03.540">变</span></p><p begin="2:03.673" end="2:11.835" itunes:key="L14" ttm:agent="v1"><span begin="2:03.673" end="2:04.720">我枯</span><span begin="2:04.720" end="2:06.274">萎</span><span begin="2:06.274" end="2:07.533">的世</span><span begin="2:07.533" end="2:11.835">界</span></p></div><div begin="3:27.644" end="3:52.618" itunes:songPart="Verse"><p begin="3:27.644" end="3:33.467" itunes:key="L15" ttm:agent="v1"><span begin="3:27.644" end="3:30.269">事件随机</span> <span begin="3:30.593" end="3:31.039">但情</span><span begin="3:31.039" end="3:32.260">绪</span><span begin="3:32.260" end="3:33.467">稳定</span></p><p begin="3:33.663" end="3:39.921" itunes:key="L16" ttm:agent="v1"><span begin="3:33.663" end="3:34.366">而你永</span><span begin="3:34.366" end="3:35.352">远</span><span begin="3:35.352" end="3:36.467">只对</span><span begin="3:36.467" end="3:37.470">你自</span><span begin="3:37.470" end="3:38.514">己</span><span begin="3:38.514" end="3:39.921">沉迷</span></p><p begin="3:40.234" end="3:45.436" itunes:key="L17" ttm:agent="v1"><span begin="3:40.234" end="3:40.755">捕</span><span begin="3:40.755" end="3:41.917">获</span> <span begin="3:41.917" end="3:42.149">一</span><span begin="3:42.149" end="3:43.843">时的快</span><span begin="3:43.843" end="3:45.436">乐</span></p><p begin="3:45.899" end="3:52.618" itunes:key="L18" ttm:agent="v1"><span begin="3:45.899" end="3:47.008">只一</span><span begin="3:47.008" end="3:48.944">时</span> <span begin="3:48.944" end="3:49.791">我</span><span begin="3:49.791" end="3:50.169">懂</span><span begin="3:50.169" end="3:52.618">的</span></p></div><div begin="3:53.369" end="4:18.710" itunes:songPart="Verse"><p begin="3:53.369" end="3:59.265" itunes:key="L19" ttm:agent="v1"><span begin="3:53.369" end="3:54.991">给你繁</span><span begin="3:54.991" end="3:56.201">星</span> <span begin="3:56.201" end="3:56.761">也给</span><span begin="3:56.761" end="3:57.789">你</span><span begin="3:57.789" end="3:59.265">流云</span></p><p begin="3:59.435" end="4:05.602" itunes:key="L20" ttm:agent="v1"><span begin="3:59.435" end="4:00.905">给予</span><span begin="4:01.049" end="4:03.070">并不会将</span><span begin="4:03.070" end="4:04.228">我</span><span begin="4:04.228" end="4:05.602">耗尽</span></p><p begin="4:05.813" end="4:11.317" itunes:key="L21" ttm:agent="v1"><span begin="4:05.813" end="4:06.326">但</span><span begin="4:06.326" end="4:07.417">你</span><span begin="4:07.417" end="4:09.628">有你的问</span><span begin="4:09.628" end="4:11.317">题</span></p><p begin="4:11.602" end="4:18.710" itunes:key="L22" ttm:agent="v1"><span begin="4:11.602" end="4:12.707">我看</span><span begin="4:12.707" end="4:14.741">来</span> <span begin="4:14.741" end="4:15.736">不可</span><span begin="4:15.736" end="4:18.710">爱</span></p></div><div begin="4:21.472" end="5:11.786" itunes:songPart="Chorus"><p begin="4:21.472" end="4:30.706" itunes:key="L23" ttm:agent="v1"><span begin="4:21.472" end="4:22.420">你只</span><span begin="4:22.420" end="4:24.962">活在</span> <span begin="4:25.071" end="4:25.552">我</span><span begin="4:25.552" end="4:27.135">汹</span><span begin="4:27.135" end="4:29.059">涌脑</span><span begin="4:29.059" end="4:30.706">海</span></p><p begin="4:31.047" end="4:36.930" itunes:key="L24" ttm:agent="v1"><span begin="4:31.047" end="4:31.966">一见</span><span begin="4:31.966" end="4:33.839">面</span> <span begin="4:34.054" end="4:35.205">就毁</span><span begin="4:35.205" end="4:36.930">灭</span></p><p begin="4:37.280" end="4:44.026" itunes:key="L25" ttm:agent="v1"><span begin="4:37.280" end="4:38.329">在想</span><span begin="4:38.329" end="4:39.910">象</span><span begin="4:39.910" end="4:41.117">的荒</span><span begin="4:41.117" end="4:44.026">野</span></p><p begin="4:46.911" end="4:56.631" itunes:key="L26" ttm:agent="v1"><span begin="4:46.911" end="4:47.927">是个</span><span begin="4:47.927" end="4:50.399">例外</span> <span begin="4:50.592" end="4:51.091">你</span><span begin="4:51.091" end="4:53.718">真的</span><span begin="4:53.718" end="4:54.193">存</span><span begin="4:54.193" end="4:56.631">在</span></p><p begin="4:56.641" end="5:02.712" itunes:key="L27" ttm:agent="v1"><span begin="4:56