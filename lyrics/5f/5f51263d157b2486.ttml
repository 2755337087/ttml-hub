<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.300"><songwriters><songwriter>徐世珍</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="暴风雪"/>
<amll:meta key="artists" value="李佳薇"/>
<amll:meta key="album" value="爱的风暴"/>
<amll:meta key="appleMusicId" value="1102541880"/></metadata></head><body dur="4:08.767"><div begin="19.854" end="37.494" itunes:songPart="Verse"><p begin="19.854" end="24.600" itunes:key="L1" ttm:agent="v1"><span begin="19.854" end="20.838">爱了就</span><span begin="20.838" end="21.425">别</span><span begin="21.425" end="22.182">后悔</span> <span begin="22.182" end="23.159">来了就</span><span begin="23.159" end="23.837">别</span><span begin="23.837" end="24.600">后退</span></p><p begin="24.610" end="28.056" itunes:key="L2" ttm:agent="v1"><span begin="24.610" end="25.801">明知道</span><span begin="25.801" end="26.563">有</span><span begin="26.563" end="26.932">危</span><span begin="26.932" end="28.056">险</span></p><p begin="29.033" end="33.522" itunes:key="L3" ttm:agent="v1"><span begin="29.033" end="29.406">也要</span><span begin="29.406" end="30.454">伸出手</span><span begin="30.454" end="31.051">再</span><span begin="31.051" end="32.597">把你抱紧</span><span begin="32.597" end="33.522">一些</span></p><p begin="33.782" end="37.494" itunes:key="L4" ttm:agent="v1"><span begin="33.782" end="34.249">像最</span><span begin="34.249" end="35.270">后一天</span><span begin="35.270" end="36.610">一样珍</span><span begin="36.610" end="37.494">贵</span></p></div><div begin="38.204" end="56.866" itunes:songPart="Verse"><p begin="38.204" end="43.272" itunes:key="L5" ttm:agent="v1"><span begin="38.204" end="39.001">是我</span><span begin="39.001" end="40.219">自己不看不听</span><span begin="40.219" end="42.207">也不理谁的</span><span begin="42.207" end="42.470">规</span><span begin="42.470" end="43.272">劝</span></p><p begin="43.456" end="46.973" itunes:key="L6" ttm:agent="v1"><span begin="43.456" end="44.834">我已经对</span><span begin="44.834" end="45.425">孤</span><span begin="45.425" end="46.186">单厌</span><span begin="46.186" end="46.973">倦</span></p><p begin="47.804" end="49.867" itunes:key="L7" ttm:agent="v1"><span begin="47.804" end="48.588">是你</span><span begin="48.588" end="49.867">爱到不管不顾</span></p><p begin="49.877" end="56.866" itunes:key="L8" ttm:agent="v1"><span begin="49.877" end="51.896">让我在刹那</span><span begin="51.896" end="52.063">之</span><span begin="52.063" end="52.746">间</span> <span begin="52.808" end="53.382">整颗</span><span begin="53.382" end="54.205">心</span><span begin="54.377" end="54.611">被</span><span begin="54.611" end="55.422">你</span><span begin="55.422" end="55.805">袭</span><span begin="55.805" end="56.866">卷</span></p></div><div begin="57.046" end="1:33.916" itunes:songPart="Chorus"><p begin="57.046" end="1:06.701" itunes:key="L9" ttm:agent="v1"><span begin="57.046" end="58.262">你的爱像一场</span><span begin="58.262" end="1:01.689">暴风雪</span> <span begin="1:01.758" end="1:03.089">失去一切我也</span><span begin="1:03.089" end="1:06.701">无所谓</span></p><p begin="1:07.064" end="1:15.549" itunes:key="L10" ttm:agent="v1"><span begin="1:07.064" end="1:09.014">就算痛到流</span><span begin="1:09.014" end="1:09.768">泪</span> <span begin="1:09.820" end="1:11.253">我敢说我活</span><span begin="1:11.253" end="1:12.607">得不惭</span><span begin="1:12.607" end="1:15.549">愧</span></p><p begin="1:16.252" end="1:25.918" itunes:key="L11" ttm:agent="v1"><span begin="1:16.252" end="1:17.435">不怕爱像一场</span><span begin="1:17.435" end="1:20.865">暴风雪</span> <span begin="1:21.016" end="1:22.187">重新排列一个</span><span begin="1:22.187" end="1:25.918">新世界</span></p><p begin="1:26.219" end="1:33.916" itunes:key="L12" ttm:agent="v1"><span begin="1:26.219" end="1:28.155">寂寞的确安</span><span begin="1:28.155" end="1:28.736">全</span> <span begin="1:28.932" end="1:30.435">是爱让人有</span><span begin="1:30.435" end="1:31.029">勇</span><span begin="1:31.029" end="1:31.815">气摧</span><span begin="1:31.815" end="1:33.916">毁</span></p></div><div begin="1:36.641" end="1:54.445" itunes:songPart="Verse"><p begin="1:36.641" end="1:40.833" itunes:key="L13" ttm:agent="v1"><span begin="1:36.641" end="1:37.614">让过去</span><span begin="1:37.614" end="1:38.163">都</span><span begin="1:38.163" end="1:39.016">埋在</span><span begin="1:39.016" end="1:40.040">冰雪之</span><span begin="1:40.040" end="1:40.833">间</span></p><p begin="1:41.073" end="1:44.697" itunes:key="L14" ttm:agent="v1"><span begin="1:41.073" end="1:41.455">我空</span><span begin="1:41.455" end="1:43.757">手与你远走高</span><span begin="1:43.757" end="1:44.697">飞</span></p><p begin="1:46.137" end="1:50.419" itunes:key="L15" ttm:agent="v1"><span begin="1:46.137" end="1:47.223">幸不幸</span><span begin="1:47.223" end="1:47.763">福</span><span begin="1:47.763" end="1:49.380">只在一念</span><span begin="1:49.380" end="1:49.614">之</span><span begin="1:49.614" end="1:50.419">间</span></p><p begin="1:50.599" end="1:54.445" itunes:key="L16" ttm:agent="v1"><span begin="1:50.599" end="1:53.454">何必执着每一句誓</span><span begin="1:53.454" end="1:54.445">言</span></p></div><div begin="1:54.957" end="2:13.655" itunes:songPart="Verse"><p begin="1:54.957" end="2:00.055" itunes:key="L17" ttm:agent="v1"><span begin="1:54.957" end="1:55.754">是我</span><span begin="1:55.754" end="1:56.972">自己不看不听</span><span begin="1:56.972" end="1:58.960">也不理谁的</span><span begin="1:58.960" end="1:59.223">规</span><span begin="1:59.223" end="2:00.055">劝</span></p><p begin="2:00.283" end="2:04.060" itunes:key="L18" ttm:agent="v1"><span begin="2:00.283" end="2:01.661">我已经对</span><span begin="2:01.661" end="2:02.252">孤</span><span begin="2:02.252" end="2:03.013">单厌</span><span begin="2:03.013" end="2:04.060">倦</span></p><p begin="2:04.588" end="2:06.651" itunes:key="L19" ttm:agent="v1"><span begin="2:04.588" end="2:05.372">是你</span><span begin="2:05.372" end="2:06.651">爱到不管不顾</span></p><p begin="2:06.666" end="2:13.655" itunes:key="L20" ttm:agent="v1"><span begin="2:06.666" end="2:08.685">让我在刹那</span><span begin="2:08.685" end="2:08.852">之</span><span begin="2:08.852" end="2:09.535">间</span> <span begin="2:09.597" end="2:10.171">整颗</span><span begin="2:10.171" end="2:10.994">心</span><span begin="2:11.166" end="2:11.400">被</span><span begin="2:11.400" end="2:12.211">你</span><span begin="2:12.211" end="2:12.594">袭</span><span begin="2:12.594" end="2:13.655">卷</span></p></div><div begin="2:13.862" end="2:52.539" itunes:songPart="Chorus"><p begin="2:13.862" end="2:23.517" itunes:key="L21" ttm:agent="v1"><span begin="2:13.862" end="2:15.078">你的爱像一场</span><span begin="2:15.078" end="2:18.505">暴风雪</span> <span begin="2:18.574" end="2:19.905">失去一切我也</span><span begin="2:19.905" end="2:23.517">无所谓</span></p><p begin="2:23.856" end="2:32.441" itunes:key="L22" ttm:agent="v1"><span begin="2:23.856" end="2:25.806">就算痛到流</span><span begin="2:25.806" end="2:26.560">泪</span> <span begin="2:26.612" end="2:28.045">我敢说我活</span><span begin="2:28.045" end="2:29.399">得不惭</span><span begin="2:29.399" end="2:32.441">愧</span></p><p begin="2:33.113" end="2:42.779" itunes:key="L23" ttm:agent="v1"><span begin="2:33.113" end="2:34.296">不怕爱像一场</span><span begin="2:34.296" end="2:37.726">暴风雪</span> <span begin="2:37.877" end="2:39.048">重新排列一个</span><span begin="2:39.048" end="2:42.779">新世界</span></p><p begin="2:43.030" end="2:52.539" itunes:key="L24" ttm:agent="v1"><span begin="2:43.030" end="2:44.966">寂寞的确安</span><span begin="2:44.966" end="2:45.547">全</span> <span begin="2:45.743" end="2:47.246">是爱让人有</span><span begin="2:47.246" end="2:47.840">勇</span><span begin="2:47.840" end="2:48.637">气摧</span><span begin="2:48.637" end="2:52.539">毁</span></p></div><div begin="2:53.460" end="3:20.055" itunes:songPart="Bridge"><p begin="2:53.460" end="3:02.142" itunes:key="L25" ttm:agent="v1"><span begin="2:53.460" end="2:54.617">那些虚有其表</span><span begin="2:54.617" end="2:55.812">的日子</span> <span begin="2:56.220" end="2:57.045">面对爱的</span><span begin="2:57.045" end="2:58.170">风雪一</span><span begin="2:58.170" end="3:00.125">碰</span><span begin="3:00.125" end="3:02.142">就碎</span></p><p begin="3:02.254" end="3:20.055" itunes:key="L26" ttm:agent="v1"><span begin="3:02.254" end="3:04.031">我的心意已</span><span begin="3:04.031" end="3:04.812">决</span> <span begin="3:04.960" end="3:06.460">哪怕万劫不</span><span begin="3:06.460" end="3:07.897">复也依</span><span begin="3:07.897" end="3:09.460">然</span><span begin="3:09.632" end="3:10.765">头也不</span><span begin="3:10.765" end="3:20.055">回</span></p></div><div begin="3:13.867" end="3:51.881" itunes:songPart="Chorus"><p begin="3:13.867" end="3:23.770" itunes:key="L27" ttm:agent="v1"><span begin="3:13.867" end="3:15.083">你的爱像一场</span><span begin="3:15.083" end="3:18.510">暴风雪</span> <span begin="3:18.579" end="3:19.910">失去一切我也</span><span begin="3:19.910" end="3:23.770">无所谓</span></p><p begin="3:23.780" end="3:32.355" itunes:key="L28" ttm:agent="v1"><span begin="3:23.780" end="3:25.730">就算痛到流</span><span begin="3:25.730" end="3:26.484">泪</span> <span begin="3:26.597" end="3:27.969">我敢说我活</span><span begin="3:27.969" end="3:29.436">得不惭</span><span begin="3:29.436" end="3:32.355">愧</span></p><p begin="3:32.974" end="3:42.950" itunes:key="L29" ttm:agent="v1"><span begin="3:32.974" end="3:34.182">我们卷入爱的</span><span begin="3:34.182" end="3:37.652">暴风雪</span> <span begin="3:37.783" end="3:39.040">我们只有彼此</span><span begin="3:39.040" end="3:42.950">能依偎</span></p><p begin="3:42.960" end="3:51.881" itunes:key="L30" ttm:agent="v1"><span begin="3:42.960" end="3:44.967">生命再无残</span><span begin="3:44.967" end="3:45.743">缺</span> <span begin="3:45.804" end="3:47.217">因为有了你</span><span begin="3:47.217" end="3:48.458">真心以</span><span begin="3:48.458" end="3:51.881">对</span></p></div><div begin="3:53.443" end="4:01.950" itunes:songPart="Outro"><p begin="3:53.443" end="4:01.950" itunes:key="L31" ttm:agent="v1"><span begin="3:53.443" end="3:54.439">爱了就</span><span begin="3:54.439" end="3:55.038">别</span><span begin="3:55.038" end="3:55.823">后悔</span> <span begin="3:55.823" end="3:56.858">来了就</span><span begin="3:56.858" end="3:57.408">别</span><span begin="3:57.408" end="3:58.160">后退</span> <span begin="3:58.160" end="3:59.319">跟昨天</span><span begin="3:59.319" end="4:00.569">说再</span><span begin="4:00.569" end="4:01.950">见</span></p></div></body></tt>