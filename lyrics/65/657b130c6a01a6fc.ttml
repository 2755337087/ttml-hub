<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">卢广仲</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>周谷淳</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="死在你的胸怀"/>
<amll:meta key="artists" value="卢广仲"/>
<amll:meta key="album" value="死在你的胸怀"/>
<amll:meta key="album" value="死在你的胸怀 - Single"/>
<amll:meta key="appleMusicId" value="1839368234"/></metadata></head><body dur="3:32.013"><div begin="22.747" end="41.949" itunes:songPart="Verse"><p begin="22.747" end="27.050" itunes:key="L1" ttm:agent="v1"><span begin="22.747" end="25.593">我孤独的 寂寞着 承受</span><span begin="25.593" end="27.050">你的无助</span></p><p begin="27.130" end="32.236" itunes:key="L2" ttm:agent="v1"><span begin="27.130" end="27.826">却</span><span begin="27.826" end="31.593">又掩饰着 微笑的 撑起我的肩</span><span begin="31.593" end="32.236">膀</span></p><p begin="32.593" end="36.316" itunes:key="L3" ttm:agent="v1"><span begin="32.593" end="33.172">扮演</span><span begin="33.172" end="33.799">着</span><span begin="33.799" end="34.165">你</span><span begin="34.165" end="35.026">的</span><span begin="35.026" end="36.316">依赖</span></p><p begin="36.628" end="41.949" itunes:key="L4" ttm:agent="v1"><span begin="36.628" end="40.406">擦干你的泪 却弄湿了我的喜</span><span begin="40.406" end="41.949">欢</span></p></div><div begin="43.295" end="1:03.637" itunes:songPart="Verse"><p begin="43.295" end="48.305" itunes:key="L5" ttm:agent="v1"><span begin="43.295" end="46.390">拥抱的 亲吻的表情符号</span> <span begin="46.390" end="46.746">对</span><span begin="46.746" end="47.904">你来</span><span begin="47.904" end="48.305">说</span></p><p begin="48.315" end="51.625" itunes:key="L6" ttm:agent="v1"><span begin="48.315" end="50.499">是没有杀伤力的</span><span begin="50.499" end="51.625">爱</span></p><p begin="51.805" end="56.542" itunes:key="L7" ttm:agent="v1"><span begin="51.805" end="53.318">就像是一把</span><span begin="53.318" end="53.962">枪</span><span begin="53.962" end="54.364">没</span><span begin="54.364" end="55.609">了子</span><span begin="55.609" end="56.542">弹</span></p><p begin="56.863" end="1:03.637" itunes:key="L8" ttm:agent="v1"><span begin="56.863" end="58.395">偶尔可以欺</span><span begin="58.395" end="59.371">骗陌生</span><span begin="59.371" end="1:00.559">人来就</span><span begin="1:00.559" end="1:03.637">范</span></p></div><div begin="1:06.483" end="1:26.575" itunes:songPart="Chorus"><p begin="1:06.483" end="1:15.042" itunes:key="L9" ttm:agent="v1"><span begin="1:06.483" end="1:06.926">我</span><span begin="1:06.926" end="1:08.212">们是</span><span begin="1:08.212" end="1:10.674">一辈子都</span><span begin="1:10.674" end="1:12.091">不能</span> <span begin="1:12.265" end="1:13.833">化解的无</span><span begin="1:13.833" end="1:15.042">奈</span></p><p begin="1:15.536" end="1:19.289" itunes:key="L10" ttm:agent="v1"><span begin="1:15.536" end="1:17.051">偶而得到你</span><span begin="1:17.051" end="1:17.956">的</span><span begin="1:17.956" end="1:18.401">宠</span><span begin="1:18.401" end="1:19.289">爱</span></p><p begin="1:19.579" end="1:26.575" itunes:key="L11" ttm:agent="v1"><span begin="1:19.579" end="1:23.373">却永远不会跨过界限 得到你</span><span begin="1:23.373" end="1:24.065">的</span><span begin="1:24.065" end="1:26.575">爱</span></p></div><div begin="1:26.868" end="1:46.395" itunes:songPart="Chorus"><p begin="1:26.868" end="1:35.356" itunes:key="L12" ttm:agent="v1"><span begin="1:26.868" end="1:27.663">我们</span><span begin="1:27.663" end="1:28.457">是</span><span begin="1:28.457" end="1:30.745">一辈子都</span><span begin="1:30.886" end="1:32.366">不能</span> <span begin="1:32.440" end="1:33.450">化解的</span><span begin="1:33.450" end="1:34.042">无</span><span begin="1:34.042" end="1:35.356">奈</span></p><p begin="1:35.705" end="1:39.553" itunes:key="L13" ttm:agent="v1"><span begin="1:35.705" end="1:37.298">偶而恐吓你</span><span begin="1:37.298" end="1:38.198">来</span><span begin="1:38.198" end="1:38.545">关</span><span begin="1:38.545" end="1:39.553">怀</span></p><p begin="1:39.802" end="1:46.395" itunes:key="L14" ttm:agent="v1"><span begin="1:39.802" end="1:41.360">却不能饮弹</span><span begin="1:41.360" end="1:43.607">自尽 死在你的胸</span><span begin="1:43.607" end="1:46.395">怀</span></p></div><div begin="1:56.623" end="2:16.657" itunes:songPart="Verse"><p begin="1:56.623" end="2:01.519" itunes:key="L15" ttm:agent="v1"><span begin="1:56.623" end="1:59.674">拥抱的 亲吻的表情符号</span> <span begin="1:59.674" end="2:00.562">对你</span><span begin="2:00.562" end="2:01.143">来</span><span begin="2:01.143" end="2:01.519">说</span></p><p begin="2:01.529" end="2:04.905" itunes:key="L16" ttm:agent="v1"><span begin="2:01.529" end="2:03.725">是没有杀伤力的</span><span begin="2:03.725" end="2:04.905">爱</span></p><p begin="2:05.076" end="2:09.813" itunes:key="L17" ttm:agent="v1"><span begin="2:05.076" end="2:06.589">就像是一把</span><span begin="2:06.589" end="2:07.233">枪</span><span begin="2:07.233" end="2:07.635">没</span><span begin="2:07.635" end="2:08.880">了子</span><span begin="2:08.880" end="2:09.813">弹</span></p><p begin="2:10.134" end="2:16.657" itunes:key="L18" ttm:agent="v1"><span begin="2:10.134" end="2:11.666">偶尔可以欺</span><span begin="2:11.666" end="2:12.642">骗陌生</span><span begin="2:12.642" end="2:13.830">人来就</span><span begin="2:13.830" end="2:16.657">范</span></p></div><div begin="2:28.765" end="2:39.965" itunes:songPart="Chorus"><p begin="2:28.765" end="2:32.518" itunes:key="L19" ttm:agent="v1"><span begin="2:28.765" end="2:30.280">偶而得到你</span><span begin="2:30.280" end="2:31.185">的</span><span begin="2:31.185" end="2:31.630">宠</span><span begin="2:31.630" end="2:32.518">爱</span></p><p begin="2:32.849" end="2:39.965" itunes:key="L20" ttm:agent="v1"><span begin="2:32.849" end="2:36.643">却永远不会跨过界限 得到你</span><span begin="2:36.643" end="2:37.335">的</span><span begin="2:37.335" end="2:39.965">爱</span></p></div><div begin="2:40.165" end="2:58.961" itunes:songPart="Chorus"><p begin="2:40.165" end="2:48.653" itunes:key="L21" ttm:agent="v1"><span begin="2:40.165" end="2:40.960">我们</span><span begin="2:40.960" end="2:41.754">是</span><span begin="2:41.754" end="2:44.042">一辈子都</span><span begin="2:44.183" end="2:45.663">不能</span> <span begin="2:45.737" end="2:46.747">化解的</span><span begin="2:46.747" end="2:47.339">无</span><span begin="2:47.339" end="2:48.653">奈</span></p><p begin="2:49.009" end="2:52.857" itunes:key="L22" ttm:agent="v1"><span begin="2:49.009" end="2:50.602">偶而恐吓你</span><span begin="2:50.602" end="2:51.502">来</span><span begin="2:51.502" end="2:51.849">关</span><span begin="2:51.849" end="2:52.857">怀</span></p><p begin="2:53.047" end="2:58.961" itunes:key="L23" ttm:agent="v1"><span begin="2:53.047" end="2:54.605">却不能饮弹</span><span begin="2:54.605" end="2:56.852">自尽 死在你的胸</span><span begin="2:56.852" end="2:58.961">怀</span></p></div><div begin="2:59.427" end="3:22.633" itunes:songPart="Outro"><p begin="2:59.427" end="3:09.581" itunes:key="L24" ttm:agent="v1"><span begin="2:59.427" end="3:01.374">我想死在你</span><span begin="3:01.374" end="3:04.853">的</span> <span begin="3:05.247" end="3:05.785">胸</span><span begin="3:05.785" end="3:09.581">怀</span></p><p begin="3:19.448" end="3:22.633" itunes:key="L25" ttm:agent="v1"><span begin="3:19.448" end="3:20.518">你的胸</span><span begin="3:20.518" end="3:22.633">怀</span></p></div></body></tt>