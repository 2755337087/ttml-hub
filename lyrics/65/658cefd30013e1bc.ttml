<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Stephen Mok</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">远离故土的万千城市</text><text for="L2">漫步遥远的未知</text><text for="L3">有幸得以诉说</text><text for="L4">走过新旧相叠的匆匆步履</text><text for="L5">一丝笑颜再次浮现</text><text for="L6">湛蓝的天 充满欢愉的生活</text><text for="L7">世事沧桑由此展开</text><text for="L8">我们所幻想的便都聚集于此吧</text><text for="L9">晨曦中开启旅程</text><text for="L10">回忆蔓延的故地</text><text for="L11">与记忆中的名一起相随</text><text for="L12">这一生或与此忆相守</text><text for="L13">依稀记忆中的琐碎小事</text><text for="L14">划破黑夜的爽朗笑声</text><text for="L15">穿过拥挤的人潮</text><text for="L16">直至旅途尽头</text><text for="L17">乘着拂晓晨光踏上归路</text><text for="L18">众人皆熟知的故地</text><text for="L19">熟悉不过的脸孔</text><text for="L20">一个称之为家的地方</text><text for="L21">若有何疑问 何疑惑</text><text for="L22">我将寻根问底</text><text for="L23">明日我将在何处醒来？</text><text for="L24">晨曦中开启旅程</text><text for="L25">回忆蔓延的故地</text><text for="L26">与记忆中的名一起相随</text><text for="L27">这一生或与此忆相守</text><text for="L28">依稀记忆中的琐碎小事</text><text for="L29">划破黑夜的爽朗笑声</text><text for="L30">穿过拥挤的人潮</text><text for="L31">直至旅途尽头</text><text for="L32">乘着拂晓晨光踏上归路</text><text for="L33">众人皆熟知的故地</text><text for="L34">熟悉的脸孔</text><text for="L35">一个称之为家的地方</text><text for="L36">若有何疑问 何疑惑</text><text for="L37">我将寻根问底</text><text for="L38">明日我将在何处醒来？</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="Sleep Alone (From "Les Aventures d' Anthony")"/><amll:meta key="musicNam