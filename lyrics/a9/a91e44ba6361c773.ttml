<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="zh-Hans" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>陈科妤</songwriter></songwriters></iTunesMetadata>
<amll:meta key="musicName" value="爱情讯息 (LIVE)"/>
<amll:meta key="artists" value="郭静"/>
<amll:meta key="album" value="爱情讯息 (LIVE)"/>
<amll:meta key="album" value="爱情讯息 (LIVE) - Single"/>
<amll:meta key="appleMusicId" value="1850416197"/></metadata></head><body dur="2:41.000"><div begin="16.495" end="41.927" itunes:songPart="Verse"><p begin="16.495" end="22.770" itunes:key="L1" ttm:agent="v1"><span begin="16.495" end="17.156">那又怎</span><span begin="17.156" end="18.103">样</span> <span begin="19.505" end="19.892">让自</span><span begin="19.892" end="20.420">己</span><span begin="20.420" end="22.770">习惯这个频率</span></p><p begin="22.921" end="29.170" itunes:key="L2" ttm:agent="v1"><span begin="22.921" end="23.506">或许是</span><span begin="23.506" end="24.532">吧</span> <span begin="25.670" end="25.888">爱</span><span begin="25.888" end="29.170">情不是个完美旋律</span></p><p begin="29.349" end="35.519" itunes:key="L3" ttm:agent="v1"><span begin="29.349" end="29.710">如果</span><span begin="29.710" end="32.012">可以 偶尔任性</span><span begin="32.012" end="32.930">应该</span><span begin="33.042" end="33.692">也没</span><span begin="33.692" end="35.519">关系</span></p><p begin="35.680" end="41.927" itunes:key="L4" ttm:agent="v1"><span begin="35.680" end="36.286">心情也</span><span begin="36.286" end="36.806">会</span><span begin="36.806" end="38.435">下起大雨</span><span begin="38.435" end="39.381">不会</span><span begin="39.423" end="40.083">太美</span><span begin="40.083" end="41.927">丽啊</span></p></div><div begin="42.139" end="1:08.213" itunes:songPart="Verse"><p begin="42.139" end="48.369" itunes:key="L5" ttm:agent="v1"><span begin="42.139" end="42.729">那就追</span><span begin="42.729" end="43.621">吧</span> <span begin="44.716" end="46.308">不要让自</span><span begin="46.308" end="46.833">己</span><span begin="46.833" end="48.369">放弃决定</span></p><p begin="48.546" end="56.131" itunes:key="L6" ttm:agent="v1"><span begin="48.546" end="49.208">每次相</span><span begin="49.208" end="50.175">遇</span> <span begin="51.283" end="52.345">都会有</span><span begin="52.345" end="54.694">一种让人感动</span><span begin="54.694" end="56.131">的美丽</span></p><p begin="56.331" end="1:01.034" itunes:key="L7" ttm:agent="v1"><span begin="56.331" end="57.507">每天一张</span><span begin="57.507" end="58.806">开眼睛</span><span begin="58.838" end="1:00.268">就会想到</span><span begin="1:00.268" end="1:01.034">你</span></p><p begin="1:01.279" end="1:08.213" itunes:key="L8" ttm:agent="v1"><span begin="1:01.279" end="1:01.914">想知</span><span begin="1:01.914" end="1:02.620">道</span> <span begin="1:02.693" end="1:03.495">在窗外</span><span begin="1:03.495" end="1:05.005">的雨滴</span> <span begin="1:05.005" end="1:06.734">写些什么秘</span><span begin="1:06.734" end="1:08.213">密</span></p></div><div begin="1:08.875" end="1:21.515" itunes:songPart="Chorus"><p begin="1:08.875" end="1:11.951" itunes:key="L9" ttm:agent="v1"><span begin="1:08.875" end="1:09.470">想念变</span><span begin="1:09.470" end="1:10.093">成</span><span begin="1:10.093" end="1:11.951">空气在叹息</span></p><p begin="1:12.113" end="1:15.108" itunes:key="L10" ttm:agent="v1"><span begin="1:12.113" end="1:12.714">多么想</span><span begin="1:12.714" end="1:13.249">要</span><span begin="1:13.249" end="1:15.108">躺在你怀里</span></p><p begin="1:15.338" end="1:21.515" itunes:key="L11" ttm:agent="v1"><span begin="1:15.338" end="1:15.898">那是爱</span><span begin="1:15.898" end="1:16.458">情</span> <span begin="1:16.458" end="1:17.834">带来的讯</span><span begin="1:17.834" end="1:21.515">息让自己傻的很确定</span></p></div><div begin="1:21.747" end="1:34.389" itunes:songPart="Chorus"><p begin="1:21.747" end="1:24.686" itunes:key="L12" ttm:agent="v1"><span begin="1:21.747" end="1:22.294">爱情总</span><span begin="1:22.294" end="1:22.901">是</span><span begin="1:22.901" end="1:24.686">不能被预期</span></p><p begin="1:24.879" end="1:27.888" itunes:key="L13" ttm:agent="v1"><span begin="1:24.879" end="1:25.492">需要勇</span><span begin="1:25.492" end="1:26.102">气</span><span begin="1:26.102" end="1:27.888">来面对决心</span></p><p begin="1:28.109" end="1:34.389" itunes:key="L14" ttm:agent="v1"><span begin="1:28.109" end="1:28.713">调整呼</span><span begin="1:28.713" end="1:29.223">吸</span> <span begin="1:29.223" end="1:30.017">写下</span> <span begin="1:30.082" end="1:31.037">不管多</span><span begin="1:31.037" end="1:31.641">少</span><span begin="1:31.641" end="1:33.076">时间我会</span><span begin="1:33.076" end="1:34.389">等你</span></p></div><div begin="1:34.808" end="1:59.503" itunes:songPart="Bridge"><p begin="1:34.808" end="1:40.871" itunes:key="L15" ttm:agent="v1"><span begin="1:34.808" end="1:35.920">相信</span> <span begin="1:35.920" end="1:36.385">要相</span><span begin="1:36.385" end="1:37.087">信</span> <span begin="1:37.087" end="1:38.355">幸福它终将</span><span begin="1:38.355" end="1:39.422">会越</span><span begin="1:39.422" end="1:39.995">靠越</span><span begin="1:39.995" end="1:40.871">近</span></p><p begin="1:41.127" end="1:46.868" itunes:key="L16" ttm:agent="v1"><span begin="1:41.127" end="1:44.711">恋爱的人总害怕听见寂</span><span begin="1:44.711" end="1:45.474">寞</span><span begin="1:45.474" end="1:46.064">的声</span><span begin="1:46.064" end="1:46.868">音</span></p><p begin="1:47.150" end="1:59.503" itunes:key="L17" ttm:agent="v1"><span begin="1:47.150" end="1:49.120">每次假装遇</span><span begin="1:49.120" end="1:50.028">见你</span> <span begin="1:50.028" end="1:52.555">总想像</span><span begin="1:52.555" end="1:53.076">能</span><span begin="1:53.076" end="1:54.470">够有</span><span begin="1:54.470" end="1:56.493">浪漫的乐</span><span begin="1:56.493" end="1:59.503">章</span></p></div><div begin="2:00.053" end="2:12.692" itunes:songPart="Chorus"><p begin="2:00.053" end="2:03.129" itunes:key="L18" ttm:agent="v1"><span begin="2:00.053" end="2:00.648">想念变</span><span begin="2:00.648" end="2:01.271">成</span><span begin="2:01.271" end="2:03.129">空气在叹息</span></p><p begin="2:03.305" end="2:06.300" itunes:key="L19" ttm:agent="v1"><span begin="2:03.305" end="2:03.906">多么想</span><span begin="2:03.906" end="2:04.441">要</span><span begin="2:04.441" end="2:06.300">躺在你怀里</span></p><p begin="2:06.515" end="2:12.692" itunes:key="L20" ttm:agent="v1"><span begin="2:06.515" end="2:07.075">那是爱</span><span begin="2:07.075" end="2:07.635">情</span> <span begin="2:07.635" end="2:09.011">带来的讯</span><span begin="2:09.011" end="2:12.692">息让自己傻的很确定</span></p></div><div begin="2:12.955" end="2:27.244" itunes:songPart="Chorus"><p begin="2:12.955" end="2:16.024" itunes:key="L21" ttm:agent="v1"><span begin="2:12.955" end="2:13.502">爱情总</span><span begin="2:13.502" end="2:14.109">是</span><span begin="2:14.109" end="2:16.024">不能被预期</span></p><p begin="2:16.099" end="2:19.308" itunes:key="L22" ttm:agent="v1"><span begin="2:16.099" end="2:16.712">需要勇</span><span begin="2:16.712" end="2:17.322">气</span><span begin="2:17.322" end="2:19.308">来面对决心</span></p><p begin="2:19.515" end="2:27.244" itunes:key="L23" ttm:agent="v1"><span begin="2:19.515" end="2:20.289">调整呼</span><span begin="2:20.289" end="2:20.846">吸</span> <span begin="2:20.846" end="2:21.706">写下</span> <span begin="2:21.706" end="2:21.969">不</span><span begin="2:21.969" end="2:22.404">管</span><span begin="2:22.404" end="2:22.632">多</span><span begin="2:22.632" end="2:23.047">少</span><span begin="2:23.047" end="2:24.671">时间我会</span><span begin="2:24.671" end="2:25.307">等</span><span begin="2:25.307" end="2:27.244">你</span></p></div></body></tt>