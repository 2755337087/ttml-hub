<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">任然</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">刘兆宇</ttm:name></ttm:agent><ttm:agent type="group" xml:id="v1000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>池舟</songwriter><songwriter>刘兆宇</songwriter></songwriters></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="梦哑 (说唱版)"/><amll:meta key="musicName" value="夢啞 (說唱版)"/><amll:meta key="artists" value="任然"/><amll:meta key="artists" value="刘兆宇"/><amll:meta key="artists" value="劉兆宇"/><amll:meta key="artists" value="Renran"/><amll:meta key="album" value="梦哑 (说唱版) - Single"/><amll:meta key="album" value="夢啞 (說唱版) - Single"/><amll:meta key="appleMusicId" value="6810372452"/><amll:meta key="isrc" value="HKD012956798"/></metadata></head><body><div begin="0:00.730" end="0:15.252" itunes:songPart="Intro"><p begin="0:00.730" end="0:04.430" itunes:key="L1" ttm:agent="v1"><span begin="0:00.730" end="0:03.290">爱一个人要学会放</span><span begin="0:03.290" end="0:04.430">下</span></p><p begin="0:05.200" end="0:09.850" itunes:key="L2" ttm:agent="v1"><span begin="0:05.200" end="0:08.430">奢望幸福却也要不惜代</span><span begin="0:08.430" end="0:09.850">价</span></p><p begin="0:10.402" end="0:13.852" itunes:key="L3" ttm:agent="v1"><span begin="0:10.402" end="0:13.852">一场好梦经得起几次惊吓</span></p><p begin="0:14.282" end="0:15.252" itunes:key="L4" ttm:agent="v1"><span begin="0:14.282" end="0:15.252">你去哪</span></p></div><div begin="0:17.340" end="0:59.117" itunes:songPart="Verse"><p begin="0:17.340" end="0:20.090" itunes:key="L5" ttm:agent="v2"><span begin="0:17.340" end="0:17.800">有多久</span><span begin="0:17.800" end="0:18.330">没见</span> <span begin="0:18.330" end="0:18.990">我还是没</span><span begin="0:18.990" end="0:19.320">变</span> <span begin="0:19.320" end="0:19.880">像以前一</span><span begin="0:19.880" end="0:20.090">样</span></p><p begin="0:20.090" end="0:22.750" itunes:key="L6" ttm:agent="v2"><span begin="0:20.090" end="0:20.290">只</span><span begin="0:20.290" end="0:21.520">是一个人的生活 难</span><span begin="0:21.520" end="0:22.750">免多了一些随便</span></p><p begin="0:23.287" end="0:25.978" itunes:key="L7" ttm:agent="v2"><span begin="0:23.287" end="0:24.090">想念到底多</span><span begin="0:24.090" end="0:24.310">么</span><span begin="0:24.310" end="0:24.610">沉</span><span begin="0:24.610" end="0:24.770">呐</span> <span begin="0:25.090" end="0:25.550">念旧的</span><span begin="0:25.550" end="0:25.870">人</span><span begin="0:25.870" end="0:25.978">呐</span></p><p begin="0:25.978" end="0:28.010" itunes:key="L8" ttm:agent="v2"><span begin="0:25.978" end="0:27.320">注定逃不过上天给</span><span begin="0:27.320" end="0:27.530">的</span><span begin="0:27.530" end="0:27.830">惩</span><span begin="0:27.830" end="0:28.010">罚</span></p><p begin="0:28.301" end="0:30.543" itunes:key="L9" ttm:agent="v2"><span begin="0:28.301" end="0:30.063">有些话一旦开口 就没办法</span><span begin="0:30.063" end="0:30.363">收</span><span begin="0:30.363" end="0:30.543">回</span></p><p begin="0:30.849" end="0:33.153" itunes:key="L10" ttm:agent="v2"><span begin="0:30.849" end="0:32.653">孤独感在你走后总会遍布</span><span begin="0:32.653" end="0:32.943">周</span><span begin="0:32.943" end="0:33.153">围</span></p><p begin="0:33.483" end="0:35.752" itunes:key="L11" ttm:agent="v2"><span begin="0:33.483" end="0:33.943">朋友总</span><span begin="0:33.943" end="0:34.263">问</span><span begin="0:34.263" end="0:34.473">我</span> <span begin="0:34.773" end="0:35.343">你后不后</span><span begin="0:35.572" end="0:35.752">悔</span></p><p begin="0:36.062" end="0:38.282" itunes:key="L12" ttm:agent="v2"><span begin="0:36.062" end="0:37.842">嘴上的逞强又被眼泪拖了</span><span begin="0:37.842" end="0:38.152">后</span><span begin="0:38.152" end="0:38.282">腿</span></p><p begin="0:38.652" end="0:40.822" itunes:key="L13" ttm:agent="v2"><span begin="0:38.652" end="0:40.402">生活的桩桩件件 都有你的</span><span begin="0:40.402" end="0:40.822">痕迹</span></p><p begin="0:40.941" end="0:43.271" itunes:key="L14" ttm:agent="v2"><span begin="0:40.941" end="0:43.271">青春的滴滴点点 让我在回忆里沉溺</span></p><p begin="0:43.491" end="0:45.931" itunes:key="L15" ttm:agent="v2"><span begin="0:43.491" end="0:45.531">眼泪是牵挂的载体 搭乘着回忆</span><span begin="0:45.531" end="0:45.931">往返</span></p><p begin="0:46.093" end="0:48.633" itunes:key="L16" ttm:agent="v2"><span begin="0:46.093" end="0:47.813">这回忆铺天盖地 衡量思</span><span begin="0:47.813" end="0:48.633">念的长短</span></p><p begin="0:48.633" end="0:50.973" itunes:key="L17" ttm:agent="v2"><span begin="0:48.633" end="0:50.973">那天又一次梦到你 梦到你我的初见</span></p><p begin="0:51.233" end="0:53.563" itunes:key="L18" ttm:agent="v2"><span begin="0:51.233" end="0:53.563">熟悉的声音又响起 想起经历的画面</span></p><p begin="0:53.793" end="0:56.187" itunes:key="L19" ttm:agent="v2"><span begin="0:53.793" end="0:54.223">好像这</span><span begin="0:54.223" end="0:54.643">一切</span> <span begin="0:54.777" end="0:56.187">都回到了故事的扉页</span></p><p begin="0:56.537" end="0:59.117" itunes:key="L20" ttm:agent="v2"><span begin="0:56.537" end="0:58.126">或许不能再见 你才总在我</span><span begin="0:58.137" end="0:58.287">梦</span><span begin="0:58.287" end="0:59.117">里出现</span></p></div><div begin="1:00.090" end="1:39.430" itunes:songPart="Chorus"><p begin="1:00.090" end="1:03.800" itunes:key="L21" ttm:agent="v1"><span begin="1:00.090" end="1:02.640">爱一个人要学会放</span><span begin="1:02.640" end="1:03.800">下</span></p><p begin="1:04.560" end="1:09.200" itunes:key="L22" ttm:agent="v1"><span begin="1:04.560" end="1:07.780">奢望幸福却也要不惜代</span><span begin="1:07.780" end="1:09.200">价</span></p><p begin="1:09.753" end="1:13.213" itunes:key="L23" ttm:agent="v1"><span begin="1:09.753" end="1:13.213">一场好梦经得起几次惊吓</span></p><p begin="1:13.643" end="1:20.847" itunes:key="L24" ttm:agent="v1"><span begin="1:13.643" end="1:14.603">你去哪</span> <span begin="1:14.907" end="1:17.187">问你却张不出口</span><span begin="1:17.187" end="1:18.507">来</span><span begin="1:19.037" end="1:19.427">回</span><span begin="1:19.427" end="1:20.847">答</span></p><p begin="1:21.357" end="1:24.923" itunes:key="L25" ttm:agent="v1"><span begin="1:21.357" end="1:23.347">你可知我的牵</span><span begin="1:23.347" end="1:24.247">挂</span><span begin="1:24.247" end="1:24.923">牵挂</span></p><p begin="1:25.231" end="1:31.291" itunes:key="L26" ttm:agent="v1"><span begin="1:25.231" end="1:28.491">以至于现实里的点点滴</span><span begin="1:28.491" end="1:28.701">滴</span> <span begin="1:29.141" end="1:31.051">自言自语的回</span><span begin="1:31.051" end="1:31.291">答</span></p><p begin="1:31.731" end="1:39.430" itunes:key="L27" ttm:agent="v1"><span begin="1:31.731" end="1:33.981">我记得你还有话</span><span begin="1:35.180" end="1:35.590">我</span><span begin="1:35.590" end="1:36.500">还有话</span> <span begin="1:36.910" end="1:37.900">在梦里</span><span begin="1:37.900" end="1:38.300">却</span><span begin="1:38.300" end="1:38.590">咽</span><span begin="1:38.590" end="1:39.430">哑</span></p></div><div begin="1:42.620" end="2:00.728" itunes:songPart="Verse"><p begin="1:42.620" end="1:45.250" itunes:key="L28" ttm:agent="v2"><span begin="1:42.620" end="1:44.880">多想陷入回忆做场永远叫不醒的</span><span begin="1:44.880" end="1:45.250">梦</span></p><p begin="1:45.250" end="1:47.710" itunes:key="L29" ttm:agent="v2"><span begin="1:45.250" end="1:45.360">只</span><span begin="1:45.360" end="1:47.710">能任由痛苦堆砌怎么过无尽的冬</span></p><p begin="1:48.161" end="1:50.391" itunes:key="L30" ttm:agent="v2"><span begin="1:48.161" end="1:48.291">在</span><span begin="1:48.291" end="1:48.781">我心</span><span begin="1:48.781" end="1:49.101">中</span><span begin="1:49.101" end="1:49.751">你该怎么</span><span begin="1:49.751" end="1:50.391">形容</span></p><p begin="1:50.391" end="1:52.996" itunes:key="L31" ttm:agent="v2"><span begin="1:50.391" end="1:51.351">是我把你拥入</span><span begin="1:51.351" end="1:51.661">怀</span><span begin="1:51.661" end="1:52.301">抱的那片</span><span begin="1:52.301" end="1:52.735">星</span><span begin="1:52.735" end="1:52.996">空</span></p><p begin="1:52.461" end="2:00.728" itunes:key="L32" ttm:agent="v1000"><span begin="1:52.461" end="1:52.641">我</span><span begin="1:52.641" end="1:54.261">渴望你也能</span><span begin="1:54.261" end="1:54.881">够</span> <span begin="1:54.881" end="1:55.241">再</span><span begin="1:55.558" end="1:55.888">紧</span><span begin="1:55.888" end="1:56.498">紧</span><span begin="1:56.498" end="1:56.858">的</span><span begin="1:56.858" end="1:58.148">拥抱</span><span begin="1:58.148" end="1:58.418">着</span><span begin="1:58.418" end="2:00.728">我</span></p></div><div begin="2:02.128" end="2:06.123" itunes:songPart="Chorus"><p begin="2:02.128" end="2:06.123" itunes:key="L33" ttm:agent="v1"><span begin="2:02.128" end="2:02.590">爱</span><span begin="2:02.590" end="2:04.687">一个人要学会放</span><span begin="2:04.687" end="2:06.123">下</span></p></div><div begin="2:03.778" end="2:08.715" itunes:songPart="Verse"><p begin="2:03.778" end="2:06.085" itunes:key="L34" ttm:agent="v2"><span begin="2:03.778" end="2:06.085">爱上一个人你要让我怎么舍得放</span></p><p begin="2:06.335" end="2:08.715" itunes:key="L35" ttm:agent="v2"><span begin="2:06.335" end="2:08.715">爱上一个人你要让我怎么才能忘</span></p></div><div begin="2:06.510" end="2:11.491" itunes:songPart="Chorus"><p begin="2:06.510" end="2:11.491" itunes:key="L36" ttm:agent="v1"><span begin="2:06.510" end="2:09.838">奢望幸福却也要不惜代</span><span begin="2:09.838" end="2:11.491">价</span></p></div><div begin="2:08.985" end="2:13.833" itunes:songPart="Verse"><p begin="2:08.985" end="2:11.315" itunes:key="L37" ttm:agent="v2"><span begin="2:08.985" end="2:11.315">时间总显的仓促 细数着离别的重量</span></p><p begin="2:11.553" end="2:13.833" itunes:key="L38" ttm:agent="v2"><span begin="2:11.553" end="2:13.103">梦里的遗憾化作泪水不</span><span begin="2:13.103" end="2:13.323">禁</span><span begin="2:13.323" end="2:13.443">湿</span><span begin="2:13.443" end="2:13.833">了眶</span></p></div><div begin="2:11.816" end="2:15.488" itunes:songPart="Chorus"><p begin="2:11.816" end="2:15.488" itunes:key="L39" ttm:agent="v1"><span begin="2:11.816" end="2:15.016">一场好梦经得起几次惊</span><span begin="2:15.016" end="2:15.488">吓</span></p></div><div begin="2:14.133" end="2:16.383" itunes:songPart="Verse"><p begin="2:14.133" end="2:16.383" itunes:key="L40" ttm:agent="v2"><span begin="2:14.133" end="2:14.613">想问你</span><span begin="2:14.613" end="2:14.903">在</span><span begin="2:14.903" end="2:15.873">哪 如今只剩无</span><span begin="2:15.873" end="2:16.193">奈</span><span begin="2:16.193" end="2:16.383">吧</span></p></div><div begin="2:15.741" end="2:16.699" itunes:songPart="Chorus"><p begin="2:15.741" end="2:16.699" itunes:key="L41" ttm:agent="v1"><span begin="2:15.741" end="2:16.699">你去哪</span></p></div><div begin="2:16.683" end="2:19.244" itunes:songPart="Verse"><p begin="2:16.683" end="2:19.244" itunes:key="L42" ttm:agent="v2"><span begin="2:16.683" end="2:18.363">为什么话到嘴边你却突然</span><span begin="2:18.464" end="2:18.814">害</span><span begin="2:18.814" end="2:19.244">怕</span></p></div><div begin="2:17.012" end="2:23.138" itunes:songPart="Chorus"><p begin="2:17.012" end="2:23.138" itunes:key="L43" ttm:agent="v1"><span begin="2:17.012" end="2:19.252">问你却张不出口</span><span begin="2:19.252" end="2:20.899">来</span><span begin="2:20.899" end="2:21.485">回</span><span begin="2:21.485" end="2:23.138">答</span></p></div><div begin="2:19.244" end="2:41.332" itunes:songPart="Verse"><p begin="2:19.244" end="2:21.674" itunes:key="L44" ttm:agent="v2"><span begin="2:19.244" end="2:20.064">被你改变的那</span><span begin="2:20.064" end="2:20.764">半个我 代</span><span begin="2:20.764" end="2:20.864">替</span><span begin="2:20.864" end="2:21.674">你在我身边</span></p><p begin="2:21.864" end="2:24.189" itunes:key="L45" ttm:agent="v2"><span begin="2:21.864" end="2:23.624">我做错了什么要付出这种</span><span begin="2:23.624" end="2:24.189">代价</span></p><p begin="2:23.303" end="2:26.834" itunes:key="L46" ttm:agent="v1000"><span begin="2:23.303" end="2:24.664">你可知我</span><span begin="2:24.664" end="2:24.914">的</span><span begin="2:24.914" end="2:25.254">牵</span><span begin="2:25.254" end="2:26.194">挂</span><span begin="2:26.194" end="2:26.834">牵挂</span></p><p begin="2:27.194" end="2:33.194" itunes:key="L47" ttm:agent="v1000"><span begin="2:27.194" end="2:30.654">以至于现实里的点点滴滴</span> <span begin="2:31.074" end="2:32.964">自言自语的回</span><span begin="2:32.964" end="2:33.194">答</span></p><p begin="2:33.672" end="2:41.332" itunes:key="L48" ttm:agent="v1000"><span begin="2:33.672" end="2:35.552">我记得你还有</span><span begin="2:35.552" end="2:35.992">话</span><span begin="2:37.142" end="2:37.852">我还</span><span begin="2:37.852" end="2:38.402">有话</span> <span begin="2:38.832" end="2:39.812">在梦里</span><span begin="2:39.812" end="2:40.232">却</span><span begin="2:40.232" end="2:40.542">咽</span><span begin="2:40.542" end="2:41.332">哑</span></p></div></body></tt>