<amll:meta key="appleMusicId" value="1535820679"/></metadata></head><body dur="4:58.760"><div begin="0.849" end="28.949" itunes:songPart="Intro"><p begin="0.849" end="13.259" itunes:key="L1" ttm:agent="v1"><span begin="0.849" end="2.484">太阳</span><span begin="2.484" end="3.671">系</span><span begin="3.671" end="5.737">を抜け出し</span><span begin="5.737" end="6.484">て</span><span begin="7.303" end="10.159">平行线で</span><span begin="10.159" end="11.375">交</span><span begin="11.375" end="11.915">わ</span><span begin="11.915" end="13.259">ろう</span></p><p begin="13.603" end="28.949" itunes:key="L2" ttm:agent="v1"><span begin="13.603" end="15.392">私と</span><span begin="15.392" end="16.611">君の</span><span begin="16.611" end="17.424">影</span><span begin="17.424" end="18.675">のように</span><span begin="18.675" end="20.339">伸びてい</span><span begin="20.339" end="21.841">る</span> <span begin="24.291" end="25.958">平行</span><span begin="25.958" end="28.949">线</span></p></div><div begin="39.622" end="59.157" itunes:songPart="Verse"><p begin="39.622" end="44.747" itunes:key="L3" ttm:agent="v1"><span begin="39.622" end="40.366">勇気が</span><span begin="40.366" end="40.998">ないのは</span><span begin="40.998" end="41.633">时代の</span><span begin="41.755" end="42.238">せいに</span><span begin="42.238" end="44.747">してしまえばいい</span></p><p begin="44.807" end="49.345" itunes:key="L4" ttm:agent="v1"><span begin="44.807" end="45.409">いつまで</span><span begin="45.409" end="45.873">たって</span><span begin="45.873" end="46.481">も</span><span begin="46.673" end="47.239">思いは</span><span begin="47.239" end="48.540">口に出せないま</span><span begin="48.540" end="49.345">ま</span></p><p begin="49.474" end="54.749" itunes:key="L5" ttm:agent="v1"><span begin="49.474" end="49.805">ただ</span><span begin="49.805" end="50.986">壊れないように</span><span begin="50.986" end="51.757">同じ</span><span begin="51.757" end="52.274">今日を</span><span begin="52.274" end="52.957">缲り</span><span begin="52.957" end="53.837">返し</span><span begin="53.837" end="54.749">なぞって</span></p><p begin="54.749" end="59.157" itunes:key="L6" ttm:agent="v1"><span begin="54.749" end="55.416">どこにも</span><span begin="55.416" end="55.965">いけ</span><span begin="55.965" end="56.664">ない</span> <span begin="56.664" end="57.282">愿いの</span><span begin="57.282" end="57.896">居场所を</span><span begin="57.896" end="58.563">探して</span><span begin="58.563" end="59.157">た</span></p></div><div begin="59.210" end="1:08.902" itunes:songPart="Verse"><p begin="59.210" end="1:08.902" itunes:key="L7" ttm:agent="v1"><span begin="59.210" end="1:00.330">君の</span><span begin="1:00.498" end="1:01.733">唇</span><span begin="1:01.733" end="1:02.383">から</span><span begin="1:02.639" end="1:03.239">零</span><span begin="1:03.239" end="1:03.938">れ</span><span begin="1:03.938" end="1:04.239">だ</span><span begin="1:04.239" end="1:04.839">す</span> <span begin="1:04.839" end="1:06.722">言叶になり</span><span begin="1:06.722" end="1:08.902">たい</span></p></div><div begin="1:09.839" end="1:52.970" itunes:songPart="Chorus"><p begin="1:09.839" end="1:19.630" itunes:key="L8" ttm:agent="v1"><span begin="1:09.839" end="1:11.146">太阳</span><span begin="1:11.146" end="1:12.044">系</span><span begin="1:12.044" end="1:13.015">を抜け</span><span begin="1:13.015" end="1:13.663">出し</span><span begin="1:13.663" end="1:14.629">て</span> <span begin="1:14.895" end="1:16.791">平行线</span><span begin="1:16.791" end="1:17.109">で</span><span begin="1:17.109" end="1:18.007">交</span><span begin="1:18.007" end="1:18.325">わ</span><span begin="1:18.325" end="1:19.630">ろう</span></p><p begin="1:19.805" end="1:29.905" itunes:key="L9" ttm:agent="v1"><span begin="1:19.805" end="1:20.562">そん</span><span begin="1:20.562" end="1:21.144">な</span><span begin="1:21.144" end="1:22.741">叶わない</span><span begin="1:22.741" end="1:23.538">望</span><span begin="1:23.538" end="1:24.011">みも</span><span begin="1:24.322" end="1:26.202">不甲斐ない</span><span begin="1:26.202" end="1:27.434">声も</span><span begin="1:27.434" end="1:28.735">引き连</span><span begin="1:28.735" end="1:29.905">れて</span></p><p begin="1:29.965" end="1:39.783" itunes:key="L10" ttm:agent="v1"><span begin="1:29.965" end="1:31.245">感情</span><span begin="1:31.245" end="1:32.477">全部</span><span begin="1:32.477" end="1:33.593">流し</span><span begin="1:33.593" end="1:34.335">切った</span><span begin="1:34.335" end="1:34.929">ら</span><span begin="1:34.929" end="1:35.611">描き</span><span begin="1:35.611" end="1:36.310">始</span><span begin="1:36.310" end="1:37.209">めて</span><span begin="1:37.209" end="1:37.843">み</span><span begin="1:37.843" end="1:38.441">せる</span><span begin="1:38.441" end="1:39.783">よ</span></p><p begin="1:39.783" end="1:52.970" itunes:key="L11" ttm:agent="v1"><span begin="1:39.783" end="1:40.618">私</span><span begin="1:40.618" end="1:41.284">と</span><span begin="1:41.284" end="1:42.234">君の</span><span begin="1:42.234" end="1:43.204">影に</span><span begin="1:43.204" end="1:43.820">今</span><span begin="1:43.820" end="1:45.050">手を伸ば</span><span begin="1:45.050" end="1:46.596">す</span> <span begin="1:48.247" end="1:49.466">平行</span><span begin="1:49.466" end="1:52.970">线</span></p></div><div begin="2:00.191" end="2:24.623" itunes:songPart="Verse"><p begin="2:00.191" end="2:05.171" itunes:key="L12" ttm:agent="v1"><span begin="2:00.191" end="2:00.738">勇気が</span><span begin="2:00.738" end="2:01.370">ないのは</span><span begin="2:01.370" end="2:02.154">电子の</span><span begin="2:02.154" end="2:02.623">せいに</span><span begin="2:02.623" end="2:05.171">してしまえばいい</span></p><p begin="2:05.181" end="2:09.652" itunes:key="L13" ttm:agent="v1"><span begin="2:05.181" end="2:05.642">口を</span><span begin="2:05.642" end="2:06.258">つくの</span><span begin="2:06.258" end="2:07.074">は</span><span begin="2:07.074" end="2:07.653">いつでも</span><span begin="2:07.653" end="2:08.919">里返しの言</span><span begin="2:08.919" end="2:09.652">叶</span></p><p begin="2:09.792" end="2:15.157" itunes:key="L14" ttm:agent="v1"><span begin="2:09.792" end="2:10.173">"ねえ</span><span begin="2:10.1