<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Hwang Yong Ju</songwriter><songwriter>萨吉</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我独自一人走入未知的世界</text><text for="L2">在黑暗中辨明方向</text><text for="L3">我在寻找属于我的那片草地</text><text for="L4">直到你随风而来</text><text for="L5">一种从未有过的感觉向我涌来</text><text for="L6">将我的心泼向旷野</text><text for="L7">我知道我终究会属于你</text><text for="L8">除了这匹已走入你心里的马你还会想要别的马吗</text><text for="L9">我会双手奉上我心上的鞍</text><text for="L10">我独自一人走入未知的世界</text><text for="L11">在黑暗中辨明方向</text><text for="L12">我在寻找属于我的那片草地</text><text for="L13">直到你随风而来</text><text for="L14">一种从未有过的感觉向我涌来</text><text for="L15">将我的心泼向旷野</text><text for="L16">我知道我终究会属于你</text><text for="L17">除了这匹已走入你心里的马你还会想要别的马吗</text><text for="L18">我会双手奉上我心上的鞍</text><text for="L19">一种从未有过的感觉向我涌来</text><text for="L20">将我的心泼向旷野</text><text for="L21">我知道我终究会属于你</text><text for="L22">除了这匹已走入你心里的马你还会想要别的马吗</text><text for="L23">我会双手奉上</text><text for="L24">你问我风是否会唱歌</text><text for="L25">我们一起闭上眼睛去感受</text><text for="L26">然后相视而笑</text></translation></translations></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="Saddle of My Heart"/><amll:meta key="musicName" value="Saddle of My Heart (电视剧《去有风的地方》插曲)"/><amll:meta key="artists" value="Teloupe"/><amll:meta key="album" value="去有风的地方 电视剧影视原声带"/><amll:meta key="album" value="《去有风的地方》影视原声带"/><amll:meta key="qqMusicId" value="001lbV4V3cSb6u"/><amll:meta key="appleMusicId" value="6769336633"/></metadata></head><bod