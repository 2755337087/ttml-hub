58.915">反顾</span> <span begin="2:59.056" end="3:00.466">让爱成为</span> <span begin="3:01.208" end="3:02.391">我身上</span><span begin="3:02.672" end="3:03.030">的</span><span begin="3:03.030" end="3:04.743">光</span></p><p begin="3:05.269" end="3:07.813" itunes:key="L23" ttm:agent="v1"><span begin="3:05.269" end="3:05.940">给我</span><span begin="3:05.940" end="3:06.661">温</span><span begin="3:06.661" end="3:07.813">暖</span></p><p begin="3:08.220" end="3:15.459" itunes:key="L24" ttm:agent="v1"><span begin="3:08.220" end="3:09.328">却不准</span><span begin="3:09.328" end="3:10.688">我</span> <span begin="3:12.149" end="3:12.620">遗</span><span begin="3:12.620" end="3:15.459">忘</span></p></div><div begin="3:17.620" end="3:41.154" itunes:songPart="Chorus"><p begin="3:17.620" end="3:20.764" itunes:key="L25" ttm:agent="v1"><span begin="3:17.620" end="3:18.547">有一</span><span begin="3:18.547" end="3:19.086">种</span><span begin="3:19.648" end="3:19.980">悲</span><span begin="3:19.980" end="3:20.764">伤</span></p><p begin="3:21.155" end="3:28.786" itunes:key="L26" ttm:agent="v1"><span begin="3:21.155" end="3:21.823">不想</span><span begin="3:21.823" end="3:22.451">要与</span><span begin="3:22.565" end="3:22.861">你</span><span begin="3:22.882" end="3:23.500">分开</span> <span begin="3:23.632" end="3:24.866">思念才</span><span begin="3:25.246" end="3:26.444">背对背</span><span begin="3:27.200" end="3:27.737">张</span><span begin="3:27.737" end="3:28.786">望</span></p><p begin="3:29.669" end="3:32.090" itunes:key="L27" ttm:agent="v1"><span begin="3:29.669" end="3:30.403">你是</span><span begin="3:30.403" end="3:31.176">所</span><span begin="3:31.176" end="3:32.090">有</span></p><p begin="3:32.805" end="3:41.154" itunes:key="L28" ttm:agent="v1"><span begin="3:32.805" end="3:34.171">你是合</span><span begin="3:34.171" end="3:35.827">照</span> <span begin="3:37.086" end="3:37.648">一</span><span begin="3:37.648" end="3:41.154">张</span></p></div></body></tt>