<amll:meta key="musicName" value="再见悲哀"/>
<amll:meta key="artists" value="林忆莲"/>
<amll:meta key="album" value="本色"/>
<amll:meta key="appleMusicId" value="905174544"/></metadata></head><body dur="3:35.017"><div begin="0.000" end="19.410" itunes:songPart="Chorus"><p begin="0.000" end="5.344" itunes:key="L1" ttm:agent="v1"><span begin="0.000" end="1.541">再见悲哀</span> <span begin="1.541" end="2.149">因我</span><span begin="2.149" end="2.506">不</span><span begin="2.506" end="3.234">再计</span><span begin="3.234" end="4.121">较任</span><span begin="4.121" end="4.466">何</span><span begin="4.466" end="4.971">结</span><span begin="4.971" end="5.344">果</span></p><p begin="5.354" end="10.223" itunes:key="L2" ttm:agent="v1"><span begin="5.354" end="6.900">什么都可以</span><span begin="6.900" end="7.741">坦荡</span> <span begin="7.741" end="8.080">未</span><span begin="8.080" end="8.936">在乎</span><span begin="8.936" end="9.255">谁</span><span begin="9.255" end="9.746">是</span><span begin="9.746" end="10.223">错</span></p><p begin="10.373" end="15.917" itunes:key="L3" ttm:agent="v1"><span begin="10.373" end="10.615">我</span><span begin="10.615" end="11.758">两眼合上</span><span begin="11.758" end="12.527">失去</span><span begin="12.527" end="12.950">什</span><span begin="12.950" end="13.578">么</span> <span begin="13.713" end="14.109">是与</span><span begin="14.109" end="15.041">非也</span><span begin="15.041" end="15.358">掠</span><span begin="15.358" end="15.917">过</span></p><p begin="16.087" end="19.410" itunes:key="L4" ttm:agent="v1"><span begin="16.087" end="16.512">别固</span><span begin="16.512" end="17.334">执到</span><span begin="17.334" end="17.664">问</span><span begin="17.664" end="18.536">一切</span><span begin="18.536" end="18.890">为</span><span begin="18.890" end="19.410">何</span></p></div><div begin="19.421" end="42.883" itunes:songPart="Chorus"><p begin="19.421" end="24.580" itunes:key="L5" ttm:agent="v1"><span begin="19.421" end="20.719">再见伤感</span> <span begin="20.719" end="21.351">因我</span><span begin="21.351" end="22.236">不易</span><span begin="22.236" end="22.531">被</span><span begin="22.531" end="23.346">泪流</s