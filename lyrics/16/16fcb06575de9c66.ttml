<amll:meta key="album" value="不也好好的 - Single"/>
<amll:meta key="album" value="不也好好的"/>
<amll:meta key="appleMusicId" value="1886101051"/></metadata></head><body dur="4:15.200"><div begin="33.864" end="57.792" itunes:songPart="Verse"><p begin="33.864" end="39.993" itunes:key="L1" ttm:agent="v1"><span begin="33.864" end="34.322">我之</span><span begin="34.322" end="35.575">所以咬</span><span begin="35.575" end="35.772">着</span><span begin="35.772" end="36.202">下</span><span begin="36.202" end="36.836">唇</span> <span begin="37.082" end="38.376">只微笑</span><span begin="38.376" end="38.647">不</span><span begin="38.647" end="39.130">吭</span><span begin="39.130" end="39.993">声</span></p><p begin="40.285" end="46.358" itunes:key="L2" ttm:agent="v1"><span begin="40.285" end="41.981">假扮镇定</span><span begin="41.981" end="42.241">的</span><span begin="42.241" end="42.781">水</span><span begin="42.781" end="43.312">准</span> <span begin="43.555" end="44.354">还</span><span begin="44.354" end="45.565">有待调</span><span begin="45.565" end="46.358">整</span></p><p begin="46.640" end="52.843" itunes:key="L3" ttm:agent="v1"><span begin="46.640" end="47.115">你长</span><span begin="47.115" end="48.366">出浅浅</span><span begin="48.366" end="48.576">的</span><span begin="48.576" end="49.088">笑</span><span begin="49.088" end="49.547">纹</span> <span begin="49.918" end="50.710">近</span><span begin="50.710" end="51.933">年来新</span><span begin="51.933" end="52.843">增</span></p><p begin="53.387" end="57.792" itunes:key="L4" ttm:agent="v1"><span begin="53.387" end="54.610">是我不</span><span begin="54.610" end="54.939">存</span><span begin="54.939" end="55.664">在</span><span begin="55.664" end="56.484">的人</span><span begin="56.484" end="57.792">生</span></p></div><div begin="58.669" end="1:11.311" itunes:songPart="PreChorus"><p begin="58.669" end="1:05.537" itunes:key="L5" ttm:agent="v1"><span begin="58.669" end="59.965">话筒中</span><span begin="59.965" end="1:01.146">一声</span><span begin="1:01.146" end="1:01.642">喂</span> <span begin="1:01.923" end="1:02.975">你把我</span><span begin="1:02.975" end="1:03.744">瞬</span><span begin="1:03.744" end="1:04.264">移</span><span begin="1:04.264" end="1:05.537">回</span></p><p begin="1:05.884" end="1:11.311" itunes:key="L6" ttm:agent="v1"><span begin="1:05.884" end="1:07.512">某年冰雪</span><span begin="1:07.512" end="1:08.699">在眼中</span><span begin="1:08.699" end="1:09.097">化</span><span begin="1:09.097" end="1:09.903">成</span><span begin="1:09.903" end="1:11.311">水</span></p></div><div begin="1:12.001" end="1:39.450" itunes:songPart="Chorus"><p begin="1:12.001" end="1:17.542" itunes:key="L7" ttm:agent="v1"><span begin="1:12.001" end="1:12.750">你说</span><span begin="1:12.750" end="1:13.332">爱</span><span begin="1:13.332" end="1:14.347">后来不</span><span begin="1:14.347" end="1:14.812">也</span><span begin="1:14.812" end="1:15.232">好</span><span begin="1:15.232" end="1:15.783">好</span><span begin="1:15.783" end="1:16.074">的</span><span begin="1:16.074" end="1:17.542">吗</span></p><p begin="1:18.272" end="1:24.094" itunes:key="L8" ttm:agent="v1"><span begin="1:18.272" end="1:20.822">怎麼一句问候</span><span begin="1:20.822" end="1:22.259">泪水就流</span><span begin="1:22.259" end="1:24.094">下</span></p><p begin="1:24.682" end="1:30.665" itunes:key="L9" ttm:agent="v1"><span begin="1:24.682" end="1:25.207">我</span><span begin="1:25.207" end="1:25.498">们</span><span begin="1:25.498" end="1:27.139">约定一同</span><span begin="1:27.139" end="1:28.365">让雪染</span><span begin="1:28.365" end="1:28.704">白</span><span begin="1:28.704" end="1:29.312">了</span><span begin="1:29.312" end="1:29.648">头</span><span begin="1:29.648" end="1:30.665">发</span></p><p begin="1:31.062" end="1:36.403" itunes:key="L10" ttm:agent="v1"><span begin="1:31.062" end="1:31.900">可惜</span><span begin="1:31.900" end="1:32.298">路</span><span begin="1:32.298" end="1:32.837">滑</span> <span begin="1:33.103" end="1:34.654">步伐有时</span><span begin="1:34.654" end="1:36.403">差</span></p><p begin="1:36.689" end="1:39.450" itunes:key="L11" ttm:agent="v1"><span begin="1:36.689" end="1:37.200">你幸</span><span begin="1:37.200" end="1:37.504">福</span><span begin="1:37.504" end="1:37.988">先</span><span begin="1:37.988" end="1:38.279">抵</span><span begin="1:38.279" end="1:39.450">达</span></p></div><div begin="1:57.080" end="2:08.407" itunes:songPart="Verse"><p begin="1:57.080" end="2:03.349" itunes:key="L12" ttm:agent="v1"><span begin="1:57.080" end="1:57.500">你的</span><span begin="1:57.500" end="1:58.247">事多</span><span begin="1:58.247" end="1:58.725">少</span><span begin="1:58.725" end="1:59.018">都</span><span begin="1:59.018" end="1:59.518">听</span><span begin="1:59.518" end="2:00.044">闻</span> <span begin="2:00.339" end="2:01.085">恭</span><span begin="2:01.085" end="2:02.266">喜好缤</span><span begin="2:02.266" end="2:03.349">纷</span></p><p begin="2:03.905" end="2:08.407" itunes:key="L13" ttm:agent="v1"><span begin="2:03.905" end="2:05.105">换另一</span><span begin="2:05.105" end="2:05.385">人</span><span begin="2:05.385" end="2:05.945">当</span><span begin="2:05.945" end="2:06.727">你人</span><span begin="2:06.727" end="2:08.407">证</span></p></div><div begin="2:09.427" end="2:21.733" itunes:songPart="PreChorus"><p begin="2:09.427" end="2:16.033" itunes:key="L14" ttm:agent="v1"><span begin="2:09.427" end="2:09.884">不想</span><span begin="2:09.884" end="2:10.304">听</span><span begin="2:10.304" end="2:11.438">她是</span><span begin="2:11.438" end="2:12.059">谁</span> <span begin="2:12.309" end="2:13.458">不想礼</span><span begin="2:13.458" end="2:14.677">貌恭</span><span begin="2:14.677" end="2:16.033">维</span></p><p begin="2:16.294" end="2:21.733" itunes:key="L15" ttm:agent="v1"><span begin="2:16.294" end="2:18.330">你找到永恒</span><span begin="2:18.330" end="2:19.065">我就</span><span begin="2:19.065" end="2:19.450">不</span><span begin="2:19.450" end="2:20.301">插</span><span begin="2:20.301" end="2:21.733">嘴</span></p></div><div begin="2:22.255" end="2:55.116" itunes:songPart="Chorus"><p begin="2:22.255" end="2:28.472" itunes:key="L16" ttm:agent="v1"><span begin="2:22.255" end="2:23.152">你说</span><span begin="2:23.152" end="2:23.548">爱</span><span begin="2:23.548" end="2:24.715">后来不</span><span begin="2:24.715" end="2:25.135">也</span><span begin="2:25.135" end="2:25.544">好</span><span begin="2:25.544" end="2:25.988">好</span><span begin="2:25.988" end="2:26.244">的</span><span begin="2:26.244" end="2:28.472">吗</span></p><p begin="2:28.606" end="2:34.777" itunes:key="L17" ttm:agent="v1"><span begin="2:28.606" end="2:29.523">怎麼</span><span begin="2:29.523" end="2:31.118">连微笑时</span><span begin="2:31.118" end="2:31.620">泪</span><span begin="2:31.620" end="2:32.085">水</span><span begin="2:32.085" end="2:32.309">也</span><span begin="2:32.309" end="2:32.623">流</span><span begin="2:32.623" end="2:34.777">下</span></p><p begin="2:35.063" end="2:41.232" itunes:key="L18" ttm:agent="v1"><span begin="2:35.063" end="2:35.521">我</span><span begin="2:35.521" end="2:35.895">们</span><span begin="2:35.895" end="2:37.506">约定一同</span><span begin="2:37.506" end="2:38.753">让雪染</span><span begin="2:38.753" end="2:39.115">白</span><span begin="2:39.115" end="2:39.572">了</span><span begin="2:39.572" end="2:39.864">头</span><span begin="2:39.864" end="2:41.232">发</span></p><p begin="2:41.422" end="2:46.660" itunes:key="L19" ttm:agent="v1"><span begin="2:41.422" end="2:42.260">可惜</span><span begin="2:42.260" end="2:42.658">路</span><span begin="2:42.658" end="2:43.197">滑</span> <span begin="2:43.463" end="2:45.014">步伐 有时</span><span begin="2:45.014" end="2:46.660">差</span></p><p begin="2:47.055" end="2:49.912" itunes:key="L20" ttm:agent="v1"><span begin="2:47.055" end="2:47.564">你幸</span><span begin="2:47.564" end="2:47.881">福</span><span begin="2:47.881" end="2:48.102">先</span><span begin="2:48.102" end="2:48.370">抵</span><span begin="2:48.370" end="2:49.912">达</span></p><p begin="2:50.691" end="2:55.116" itunes:key="L21" ttm:agent="v1"><span begin="2:50.691" end="2:51.507">幸福</span><span begin="2:51.507" end="2:51.776">是</span><span begin="2:51.776" end="2:52.101">你</span><span begin="2:52.101" end="2:52.381">与</span><span begin="2:52.381" end="2:55.116">她</span></p></div><div begin="3:00.623" end="3:25.695" itunes:songPart="Chorus"><p begin="3:00.623" end="3:05.880" itunes:key="L22" ttm:agent="v1"><span begin="3:00.623" end="3:01.072">没</span><span begin="3:01.072" end="3:01.550">错</span><span begin="3:01.550" end="3:02.845">爱后来</span><span begin="3:02.845" end="3:03.091">不</span><span begin="3:03.091" end="3:03.605">也</span><span begin="3:03.605" end="3:03.978">好</span><span begin="3:03.978" end="3:04.453">好</span><span begin="3:04.453" end="3:04.766">的</span><span begin="3:04.766" end="3:05.880">吗</span></p><p begin="3:07.061" end="3:12.963" itunes:key="L23" ttm:agent="v1"><span begin="3:07.061" end="3:07.908">即便</span><span begin="3:07.908" end="3:09.555">不是你加</span><span begin="3:09.555" end="3:10.010">我</span><span begin="3:10.010" end="3:10.243">的</span><span begin="3:10.243" end="3:10.612">组</span><span begin="3:10.612" end="3:10.962">合</span><span begin="3:10.962" end="3:12.963">啊</span></p><p begin="3:13.444" end="3:19.599" itunes:key="L24" ttm:agent="v1"><span begin="3:13.444" end="3:14.243">我们</span><span begin="3:14.243" end="3:15.899">分开任由</span><span begin="3:15.899" end="3:17.523">降雪染白</span><span begin="3:17.523" end="3:17.979">了</span><span begin="3:17.979" end="3:18.247">头</span><span begin="3:18.247" end="3:19.599">发</span></p><p begin="3:19.873" end="3:25.695" itunes:key="L25" ttm:agent="v1"><span begin="3:19.873" end="3:20.651">只怪</span><span begin="3:20.651" end="3:21.082">路</span><span begin="3:21.082" end="3:21.602">滑</span> <span begin="3:21.889" end="3:23.474">步伐有时</span><span begin="3:23.474" end="3:25.695">差</span></p></div><div begin="3:26.253" end="3:53.639" itunes:songPart="Chorus"><p begin="3:26.253" end="3:32.326" itunes:key="L26" ttm:agent="v1"><span begin="3:26.253" end="3:27.073">假如</span><span begin="3:27.073" end="3:28.300">再见时</span><span begin="3:28.300" end="3:29.513">不也好</span><span begin="3:29.513" end="3:29.950">好</span><span begin="3:29.950" end="3:30.241">的</span><span begin="3:30.241" end="3:32.326">吗</span></p><p begin="3:32.645" end="3:38.391" itunes:key="L27" ttm:agent="v1"><span begin="3:32.645" end="3:33.474">我的</span><span begin="3:33.474" end="3:35.519">思念该用完</span><span begin="3:35.519" end="3:35.797">借</span><span begin="3:35.797" end="3:36.148">口</span><span begin="3:36.148" end="3:36.533">了</span><span begin="3:36.533" end="3:38.391">吧</span></p><p begin="3:39.021" end="3:45.417" itunes:key="L28" ttm:agent="v1"><span begin="3:39.021" end="3:39.872">我有</span><span begin="3:39.872" end="3:41.438">着的是你</span><span begin="3:41.438" end="3:43.152">双手捂热</span><span begin="3:43.152" end="3:43.654">的</span><span begin="3:43.654" end="3:43.946">脸</span><span begin="3:43.946" end="3:45.417">颊</span></p><p begin="3:45.524" end="3:50.946" itunes:key="L29" ttm:agent="v1"><span begin="3:45.524" end="3:46.344">管他</span><span begin="3:46.344" end="3:46.777">天</span><span begin="3:46.777" end="3:47.184">涯</span> <span begin="3:47.464" end="3:49.119">天涯也有</span><span begin="3:49.119" end="3:50.946">家</span></p><p begin="3:51.135" end="3:53.639" itunes:key="L30" ttm:agent="v1"><span begin="3:51.135" end="3:52.069">我一定</span><span begin="3:52.069" end="3:52.547">会</span><span begin="3:52.547" end="3:52.827">抵</span><span begin="3:52.827" end="3:53.639">达</span></p></div></body></tt>