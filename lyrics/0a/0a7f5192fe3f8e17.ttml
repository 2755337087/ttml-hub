<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Line" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">杨丞琳</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">黄霄云</ttm:name></ttm:agent><ttm:agent type="group" xml:id="v1000"/><ttm:agent type="other" xml:id="v2000"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>唐恬</songwriter><songwriter>周以力</songwriter></songwriters></iTunesMetadata><amll:meta key="ttmlAuthorGithub" value="76586484"/><amll:meta key="ttmlAuthorGithubLogin" value="2755337087"/><amll:meta key="musicName" value="野心家 (Live)"/><amll:meta key="musicName" value="野心家 (Live版)"/><amll:meta key="musicName" value="野心家 (Live伴奏)"/><amll:meta key="artists" value="杨丞琳"/><amll:meta key="artists" value="黄霄雲"/><amll:meta key="artists" value="黄霄云"/><amll:meta key="artists" value="Rainie Yang"/><amll:meta key="artists" value="黃霄雲"/><amll:meta key="album" value="天赐的声音第七季 第7期"/><amll:meta key="album" value="天赐的声音第七季 第7期 (Live)"/><amll:meta key="qqMusicId" value="000h856j4boYlf"/><amll:meta key="ncmMusicId" value="3410661564"/><amll:meta key="appleMusicId" value="6794415402"/><amll:meta key="appleMusicId" value="6794415414"/><amll:meta key="isrc" value="HKD012914889"/><amll:meta key="isrc" value="HKD012914891"/></metadata></head><body><div begin="0:01.060" end="1:23.661" itunes:songPart="Verse"><p begin="0:01.060" end="0:03.165" itunes:key="L1" ttm:agent="v1000"><span begin="0:01.060" end="0:03.165">谁在怕</span></p><p begin="0:02.102" end="0:04.631" itunes:key="L2" ttm:agent="v2000"><span begin="0:02.102" end="0:04.631">谁在怕</span></p><p begin="0:03.565" end="0:06.855" itunes:key="L3" ttm:agent="v1000"><span begin="0:03.565" end="0:06.855">一个女子成为野心家</span></p><p begin="0:05.755" end="0:08.803" itunes:key="L4" ttm:agent="v2000"><span begin="0:05.755" end="0:08.803">野心家</span></p><p begin="0:07.194" end="0:10.434" itunes:key="L5" ttm:agent="v1000"><span begin="0:07.194" end="0:10.434">去梦去追去问一句话</span></p><p begin="0:09.374" end="0:10.820" itunes:key="L6" ttm:agent="v2000"><span begin="0:09.374" end="0:10.820">一句话</span></p><p begin="0:10.804" end="0:16.954" itunes:key="L7" ttm:agent="v1000"><span begin="0:10.804" end="0:16.954">先生与我 有何不同</span></p><p begin="0:24.064" end="0:29.614" itunes:key="L8" ttm:agent="v1"><span begin="0:24.064" end="0:29.614">困我身 举着牌匾叫我低入尘</span></p><p begin="0:31.445" end="0:37.044" itunes:key="L9" ttm:agent="v1"><span begin="0:31.445" end="0:37.044">拘我魂 条条规训叫我忍了吞</span></p><p begin="0:37.795" end="0:44.445" itunes:key="L10" ttm:agent="v2"><span begin="0:37.795" end="0:44.445">笑我的前程 迈不出家门</span></p><p begin="0:45.585" end="0:51.695" itunes:key="L11" ttm:agent="v2"><span begin="0:45.585" end="0:51.695">要不争 要我认 温顺地走完 这一生</span></p><p begin="0:52.825" end="0:56.595" itunes:key="L12" ttm:agent="v1"><span begin="0:52.825" end="0:56.595">可是我啊 听见风 来自海上和天空</span></p><p begin="0:56.723" end="1:00.134" itunes:key="L13" ttm:agent="v1"><span begin="0:56.723" end="1:00.134">它说别 别低头 低头便入牢笼</span></p><p begin="1:00.627" end="1:07.048" itunes:key="L14" ttm:agent="v1"><span begin="1:00.627" end="1:07.048">你是海浪 也是长风 怎可以上锁呢</span></p><p begin="1:07.447" end="1:11.268" itunes:key="L15" ttm:agent="v2"><span begin="1:07.447" end="1:11.268">那驯不服 关不住 是我眼中的刀锋</span></p><p begin="1:11.387" end="1:15.128" itunes:key="L16" ttm:agent="v2"><span begin="1:11.387" end="1:15.128">这世界 容不下 那就刺破它吧</span></p><p begin="1:15.287" end="1:23.661" itunes:key="L17" ttm:agent="v2"><span begin="1:15.287" end="1:23.661">我的苦修 我的疼痛 终将转身 赞颂我</span></p></div><div begin="1:22.717" end="1:40.300" itunes:songPart="Chorus"><p begin="1:22.717" end="1:28.277" itunes:key="L18" ttm:agent="v1"><span begin="1:22.717" end="1:28.277">野心家 一个女子成为野心家</span></p><p begin="1:28.728" end="1:35.616" itunes:key="L19" ttm:agent="v1"><span begin="1:28.728" end="1:35.616">他们笑我是因为害怕 我够胆啊</span></p><p begin="1:36.068" end="1:39.338" itunes:key="L20" ttm:agent="v2"><span begin="1:36.068" end="1:39.338">不认命算一种野心吗</span></p><p begin="1:38.064" end="1:40.300" itunes:key="L21" ttm:agent="v1"><span begin="1:38.064" end="1:40.300">是野心啊</span></p></div><div begin="1:39.735" end="3:05.356" itunes:songPart="Verse"><p begin="1:39.735" end="1:43.013" itunes:key="L22" ttm:agent="v2"><span begin="1:39.735" end="1:43.013">那我就是天生野心家</span></p><p begin="1:41.655" end="1:44.025" itunes:key="L23" ttm:agent="v1"><span begin="1:41.655" end="1:44.025">是野心家</span></p><p begin="1:43.311" end="1:46.718" itunes:key="L24" ttm:agent="v2"><span begin="1:43.311" end="1:46.718">去梦去追去问一句话</span></p><p begin="1:46.997" end="1:52.847" itunes:key="L25" ttm:agent="v1000"><span begin="1:46.997" end="1:52.847">先生与我 有何不同</span></p><p begin="1:55.647" end="2:00.858" itunes:key="L26" ttm:agent="v2"><span begin="1:55.647" end="2:00.858">走多少路 扑了多少空 吃了多少痛</span></p><p begin="2:02.918" end="2:07.996" itunes:key="L27" ttm:agent="v1"><span begin="2:02.918" end="2:07.996">若不够疯 怎么配得上 我负过的重</span></p><p begin="2:10.418" end="2:14.198" itunes:key="L28" ttm:agent="v1000"><span begin="2:10.418" end="2:14.198">夺走我的心爱 泼脏我的衣衫</span></p><p begin="2:14.198" end="2:17.428" itunes:key="L29" ttm:agent="v1000"><span begin="2:14.198" end="2:17.428">而我将在黑夜中生还</span></p><p begin="2:17.748" end="2:21.407" itunes:key="L30" ttm:agent="v1000"><span begin="2:17.748" end="2:21.407">眼神依然期待 双手依然洁白</span></p><p begin="2:21.407" end="2:25.237" itunes:key="L31" ttm:agent="v1000"><span begin="2:21.407" end="2:25.237">唯有天真的人永不败</span></p><p begin="2:25.537" end="2:34.937" itunes:key="L32" ttm:agent="v1000"><span begin="2:25.537" end="2:34.937">第几次站上了月台 远方都在</span></p><p begin="2:35.400" end="2:39.158" itunes:key="L33" ttm:agent="v2"><span begin="2:35.400" end="2:39.158">我听见风 我的风 来自海上和天空</span></p><p begin="2:39.268" end="2:42.947" itunes:key="L34" ttm:agent="v2"><span begin="2:39.268" end="2:42.947">它说别 别低头 低头便入牢笼</span></p><p begin="2:43.167" end="2:49.747" itunes:key="L35" ttm:agent="v2"><span begin="2:43.167" end="2:49.747">你是海浪 也是长风 怎可以上锁呢</span></p><p begin="2:50.042" end="2:53.757" itunes:key="L36" ttm:agent="v1"><span begin="2:50.042" end="2:53.757">那驯不服 关不住 是我眼中的刀锋</span></p><p begin="2:53.938" end="2:57.526" itunes:key="L37" ttm:agent="v1"><span begin="2:53.938" end="2:57.526">这世界 容不下 那就刺破它吧</span></p><p begin="2:57.865" end="3:05.356" itunes:key="L38" ttm:agent="v1"><span begin="2:57.865" end="3:05.356">我的苦修 我的疼痛 终将转身 赞颂我</span></p></div><div begin="3:05.356" end="3:10.978" itunes:songPart="Chorus"><p begin="3:05.356" end="3:10.978" itunes:key="L39" ttm:agent="v1000"><span begin="3:05.356" end="3:10.978">野心家 一个女子成为野心家</span></p></div><div begin="3:11.257" end="3:52.887" itunes:songPart="Verse"><p begin="3:11.257" end="3:18.717" itunes:key="L40" ttm:agent="v2"><span begin="3:11.257" end="3:18.717">他们笑我 是因为害怕 我够胆啊</span></p><p begin="3:13.389" end="3:18.379" itunes:key="L41" ttm:agent="v1"><span begin="3:13.389" end="3:18.379">我不害怕 啊</span></p><p begin="3:18.717" end="3:21.306" itunes:key="L42" ttm:agent="v2"><span begin="3:18.717" end="3:21.306">不认命算一种野心吗</span></p><p begin="3:20.615" end="3:23.787" itunes:key="L43" ttm:agent="v1"><span begin="3:20.615" end="3:23.787">不认命算一种野心啊</span></p><p begin="3:22.178" end="3:25.686" itunes:key="L44" ttm:agent="v2"><span begin="3:22.178" end="3:25.686">那我就是天生野心家</span></p><p begin="3:23.976" end="3:27.435" itunes:key="L45" ttm:agent="v1"><span begin="3:23.976" end="3:27.435">那我就是天生野心家</span></p><p begin="3:25.975" end="3:29.258" itunes:key="L46" ttm:agent="v1000"><span begin="3:25.975" end="3:29.258">去梦去追去问 一句话</span></p><p begin="3:29.626" end="3:35.168" itunes:key="L47" ttm:agent="v1000"><span begin="3:29.626" end="3:35.168">先生与我 有何不同</span></p><p begin="3:38.208" end="3:44.677" itunes:key="L48" ttm:agent="v1"><span begin="3:38.208" end="3:44.677">我是我 最大的 野心啊</span></p><p begin="3:44.677" end="3:47.567" itunes:key="L49" ttm:agent="v1"><span begin="3:44.677" end="3:47.567">踏黄沙 闯霓虹</span></p><p begin="3:47.946" end="3:52.887" itunes:key="L50" ttm:agent="v1"><span begin="3:47.946" end="3:52.887">深渊赶路 也无恐</span></p></div><div begin="3:52.887" end="3:58.606" itunes:songPart="Chorus"><p begin="3:52.887" end="3:58.606" itunes:key="L51" ttm:agent="v1000"><span begin="3:52.887" end="3:58.606">我是我 最爱的 野心家</span></p></div><div begin="3:59.270" end="4:35.087" itunes:songPart="Verse"><p begin="3:59.270" end="4:06.041" itunes:key="L52" ttm:agent="v1000"><span begin="3:59.270" end="4:06.041">若世界 容不下 去撞破它</span></p><p begin="4:06.466" end="4:09.450" itunes:key="L53" ttm:agent="v1000"><span begin="4:06.466" end="4:09.450">成为我</span></p><p begin="4:13.518" end="4:35.087" itunes:key="L54" ttm:agent="v1000"><span begin="4:13.518" end="4:35.087">去驯服它 平视我 去告诉它 何为我</span></p></div></body></tt>